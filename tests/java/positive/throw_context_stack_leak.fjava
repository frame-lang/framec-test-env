@@[target("java")]
@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { throw new RuntimeException("boom"); }
            depth(): int { @@:(_context_stack.size()) }
        }
}
class Main {
    public static void main(String[] args) {
        TL s = @@TL();
        for (int i = 0; i < 3; i++) { try { s.boom(); } catch (RuntimeException e) {} }
        int d = s.depth();
        System.out.println(d == 1 ? "ok 1 - no leak" : "not ok 1 - leaked depth=" + d);
    }
}
