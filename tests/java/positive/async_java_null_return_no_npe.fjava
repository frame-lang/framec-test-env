@@[target("java")]

// Java-unique — async_java_null_return_no_npe
//
// RFC-0043 (Java): a handler returning `null` should produce a
// CompletableFuture<String> that completes normally with null —
// NOT a NullPointerException, NOT a failed future.
//
// This is the boundary case where the casing's emission must not
// accidentally trip on a null return value (e.g. when constructing
// CompletableFuture.completedFuture(null)).

import java.util.concurrent.CompletableFuture;

@@[async]
@@system Sys {
    interface:
        async maybe(): String

    machine:
        $S {
            maybe(): String { @@:(null) }
        }
}

class Main {
    public static void main(String[] args) throws Exception {
        Sys s = @@Sys();
        s.init().get();

        CompletableFuture<String> f = s.maybe();
        String result = f.get();
        if (result != null) {
            throw new RuntimeException("expected null, got '" + result + "'");
        }
        if (f.isCompletedExceptionally()) {
            throw new RuntimeException("future completed exceptionally");
        }

        // Gate must be clear — next call works.
        if (s.maybe().get() != null) {
            throw new RuntimeException("second call returned non-null");
        }

        System.out.println("PASS: async_java_null_return_no_npe");
    }
}
