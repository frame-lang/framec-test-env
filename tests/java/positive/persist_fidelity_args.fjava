@@[target("java")]
@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Cart {
    interface:
        buy()
        itemname(): String
        itemqty(): int
    machine:
        $Browse {
            buy() {
                push$ -> $Paid("cola", 5)
            }
        }
        $Paid(item: String, qty: int) {
            itemname(): String { @@:(item) }
            itemqty(): int { @@:(qty) }
        }
    domain:
        marker: int = 0
}
class Main {
    public static void main(String[] a) {
        Cart c1 = new Cart();
        c1.buy();
        String snap = c1.save_state();
        Cart c2 = new Cart();
        c2.restore_state(snap);
        if (!c2.itemname().equals("cola")) throw new RuntimeException("String arg lost: " + c2.itemname());
        if (c2.itemqty() != 5) throw new RuntimeException("int arg lost: " + c2.itemqty());
        System.out.println("PASS: persist_fidelity_args");
    }
}
