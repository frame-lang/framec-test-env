@@[target("lua")]
@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { error("boom") }
            depth(): int { @@:(#self._context_stack) }
        }
}
local s = @@TL()
for _ = 1, 3 do pcall(function() s:boom() end) end
local d = s:depth()
print(d == 1 and "ok 1 - no leak" or "not ok 1 - leaked depth=" .. d)
