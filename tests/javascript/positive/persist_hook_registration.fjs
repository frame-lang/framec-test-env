@@[target("javascript")]

// RFC-0055 restore type-resolution + the registration hook (JS).
//
// A snapshot stores each object's type as a string tag; JS cannot turn that string
// back into a module-scoped class by reflection, so restore resolves it against a
// name->constructor table framec builds from lexical references it can name at
// compile time. R1 (E752) requires a declared type on every persisted field, and
// framec seeds the table from that declaration — so a MONOMORPHIC user type
// resolves with no hook (see the persist_fidelity_* fixtures).
//
// The registration hook's remaining role is POLYMORPHISM: a field declared as a
// base type but holding a SUBTYPE at save time. The declaration seeds the base
// (Shape); the snapshot's runtime tag is the concrete subtype (Circle), which the
// declaration never names, so restore cannot resolve it and fails loud (E750 — a
// fidelity signal, not a security check) until the user hands framec a lexical
// reference to the subtype via registerPersistType. This proves both halves: the
// unresolved subtype fails loud, and the hook resolves it faithfully.

class Shape {
    area() { return 0.0; }
}
class Circle extends Shape {
    constructor(r = 0.0) { super(); this.r = r; }
    // 3 stands in for pi so the round-trip check is exact integer math.
    area() { return 3.0 * this.r * this.r; }
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setshape(r)
        getarea(): double

    machine:
        $S {
            $.sv: Shape = null

            setshape(r) { $.sv = new Circle(r) }
            getarea()   { @@:($.sv.area()) }
        }

    domain:
        marker: number = 1
}

function main() {
    const s1 = @@Bag();
    s1.setshape(2.0);
    const snap = s1.save_state();

    // Polymorphic residual: $.sv is declared Shape (seeded from the declaration),
    // but the saved value's runtime type is Circle, which the declaration never
    // names -> unresolved -> fail loud.
    const s2 = @@Bag();
    let unresolved = false;
    try { s2.restore_state(snap); }
    catch (e) { unresolved = String(e.message).includes("E750"); }
    if (!unresolved) { throw new Error("polymorphic subtype Circle resolved without the hook"); }

    // Hook hands framec the concrete subtype -> faithful restore (Circle.area, not Shape.area).
    Bag.registerPersistType(Circle);
    const s3 = @@Bag();
    s3.restore_state(snap);
    const a = s3.getarea();
    if (a !== 12.0) { throw new Error(`hook restore did not round-trip: area=${a}`); }

    console.log("PASS: persist_hook_registration");
}

main();
