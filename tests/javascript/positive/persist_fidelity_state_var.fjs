@@[target("javascript")]

// RFC-0053 compartment fidelity (JS): a user-typed value held in a STATE
// VARIABLE ($.sv -> compartment.state_vars) must round-trip faithfully, not just
// a domain field. The reflective tag/revive passes run tree-wide over the whole
// snapshot, so a value nested in the serialized compartment chain is
// reconstructed while the compartment scaffolding passes through untagged.

class Vec2 {
    constructor(x = 0.0, y = 0.0) {
        this.x = x;
        this.y = y;
    }

    magSq() {
        return this.x * this.x + this.y * this.y;
    }
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x, y)
        getmag(): double

    machine:
        $S {
            $.sv: Vec2 = new Vec2(0.0, 0.0)

            setv(x, y) { $.sv = new Vec2(x, y) }
            getmag()   { @@:($.sv.magSq()) }
        }

    domain:
        marker: number = 1
}

function main() {
    const s1 = @@Bag();
    s1.setv(3.0, 4.0);
    const snap = s1.save_state();

    const s2 = @@Bag();
    s2.restore_state(snap);

    const m = s2.getmag();
    if (m !== 25.0) {
        throw new Error(`compartment state-var Vec2 did not round-trip: mag=${m}`);
    }
    console.log("PASS: persist_fidelity_state_var");
}

main();
