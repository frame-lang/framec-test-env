@@[target("javascript")]

// #185: a domain-field initializer that continues across depth-0 newlines —
// a trailing-operator arithmetic chain and a leading-dot method chain — must be
// captured whole, not truncated at the first newline.

class Builder {
    constructor() { this.n = 0; }
    add(k) { this.n = this.n + k; return this; }
    val() { return this.n; }
}

@@system Calc {
    interface:
        total(): number
        chained(): number

    machine:
        $S {
            total(): number   { @@:(this.sum) }
            chained(): number { @@:(this.built) }
        }

    domain:
        sum = 1 +
              2 +
              3
        built = new Builder()
            .add(10)
            .add(5)
            .val()
}

function main() {
    const c = @@Calc();
    if (c.total() !== 6) { throw new Error("trailing-op continuation wrong: " + c.total()); }
    if (c.chained() !== 15) { throw new Error("leading-dot continuation wrong: " + c.chained()); }
    console.log("PASS: multiline_init_continuation");
}

main();
