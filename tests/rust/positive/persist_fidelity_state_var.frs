@@[target("rust")]

// persist_fidelity_state_var — RFC-0053 compartment fidelity (Rust).
//
// A user-typed value held in a STATE VARIABLE ($.sv -> the compartment's
// typed state_context) must round-trip through save_state/restore_state as a
// genuinely-typed instance, not just a domain field. getmag() calls magSq()
// on the reconstructed state-var value, so a lossy restore fails it.

use serde::{Deserialize, Serialize};

#[derive(Serialize, Deserialize, Clone, Debug, Default)]
struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    fn new(x: f64, y: f64) -> Self {
        Vec2 { x, y }
    }

    fn magSq(&self) -> f64 {
        self.x * self.x + self.y * self.y
    }
}

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x: f64, y: f64)
        getmag(): f64

    machine:
        $S {
            $.sv: Vec2 = Vec2::new(0.0, 0.0)

            setv(x: f64, y: f64) {
                $.sv = Vec2::new(x, y)
            }
            getmag() {
                @@:($.sv.magSq())
            }
        }

    domain:
        marker: i32 = 1
}

fn main() {
    let mut s1 = @@Bag();
    s1.setv(3.0, 4.0);

    let snap: String = s1.save_state();

    let mut s2 = @@Bag();
    s2.restore_state(snap);

    let mag = s2.getmag();
    assert_eq!(mag, 25.0, "compartment state-var Vec2 did not round-trip");

    println!("PASS: persist_fidelity_state_var");
}
