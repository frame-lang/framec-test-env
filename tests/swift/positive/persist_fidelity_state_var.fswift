@@[target("swift")]

// RFC-0053 compartment fidelity (Swift): a user-typed value held in a STATE
// VARIABLE ($.sv -> compartment.state_vars) must round-trip faithfully, not just
// a domain field. getmag() calls magSq() on the reconstructed state-var value.

import Foundation

public struct Vec2: Codable {
    public var x: Double = 0.0
    public var y: Double = 0.0
    public init() {}
    public init(_ x: Double, _ y: Double) { self.x = x; self.y = y }
    public func magSq() -> Double { return x * x + y * y }
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x: Double, y: Double)
        getmag(): Double

    machine:
        $S {
            $.sv: Vec2 = Vec2(0.0, 0.0)

            setv(x: Double, y: Double) { $.sv = Vec2(x, y) }
            getmag(): Double { @@:($.sv.magSq()) }
        }

    domain:
        marker: Int = 1
}

let s1 = @@Bag()
s1.setv(3.0, 4.0)
let snap = s1.save_state()

let s2 = @@Bag()
s2.restore_state(snap)

let m = s2.getmag()
if m == 25.0 {
    print("PASS: persist_fidelity_state_var")
} else {
    print("FAIL: compartment state-var Vec2 did not round-trip: magSq=\(m)")
    exit(1)
}
