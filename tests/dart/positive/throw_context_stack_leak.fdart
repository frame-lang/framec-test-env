@@[target("dart")]
@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { throw Exception("boom"); }
            depth(): int { @@:(_context_stack.length) }
        }
}
void main() {
    final s = @@TL();
    for (var i = 0; i < 3; i++) { try { s.boom(); } catch (e) {} }
    final d = s.depth();
    print(d == 1 ? "ok 1 - no leak" : "not ok 1 - leaked depth=$d");
}
