@@[target("dart")]

// RFC-0053 foundational fidelity: a @@[persist] system with a USER-TYPED domain
// field must round-trip faithfully — the restored value is a real Vec2 instance
// (its method works), not a type-erased map. The getmag() probe calls a METHOD
// on the reconstructed value, so a lossy plain-map restore fails here even though
// a bare field read would pass.

import 'dart:convert';

class Vec2 {
    double x, y;
    Vec2([this.x = 0.0, this.y = 0.0]);
    double magSq() => x * x + y * y; // 25.0 for (3,4); a method a map cannot answer
    Map<String, dynamic> toJson() => {'x': x, 'y': y};
    factory Vec2.fromJson(Map<String, dynamic> j) =>
        Vec2((j['x'] as num).toDouble(), (j['y'] as num).toDouble());
}

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x: double, y: double)
        getx(): double
        getmag(): double

    machine:
        $S {
            setv(x: double, y: double) { @@:self.v = Vec2(x, y); }
            getx(): double { @@:(@@:self.v.x) }
            getmag(): double { @@:(@@:self.v.magSq()) }
        }

    domain:
        v: Vec2 = Vec2(0.0, 0.0)
}

void main() {
    final s1 = @@Bag();
    s1.setv(3.0, 4.0);
    final snap = s1.save_state();

    final s2 = @@Bag();
    s2.restore_state(snap);

    final x = s2.getx();
    final m = s2.getmag();
    if (x == 3.0 && m == 25.0) {
        print("PASS: persist_fidelity_value_type");
    } else {
        print("FAIL: x=$x magSq=$m (want x=3.0 magSq=25.0)");
        throw Exception("fidelity mismatch");
    }
}
