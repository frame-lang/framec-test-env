@@[target("go")]

package main

import "fmt"

@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { panic("boom") }
            depth(): int { @@:(len(s._context_stack)) }
        }
}

func main() {
    s := @@TL()
    for i := 0; i < 3; i++ {
        func() {
            defer func() { recover() }()
            s.Boom()
        }()
    }
    d := s.Depth()
    if d == 1 {
        fmt.Println("ok 1 - no leak")
    } else {
        fmt.Printf("not ok 1 - leaked depth=%v\n", d)
    }
}
