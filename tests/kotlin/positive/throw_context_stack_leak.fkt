@@[target("kotlin")]
@@system TL {
    interface:
        boom()
        depth(): Int
    machine:
        $S {
            boom() { throw RuntimeException("boom") }
            depth(): Int { @@:(_context_stack.size) }
        }
}
fun main() {
    val s = @@TL()
    for (i in 0 until 3) { try { s.boom() } catch (e: Throwable) {} }
    val d = s.depth()
    println(if (d == 1) "ok 1 - no leak" else "not ok 1 - leaked depth=$d")
}
