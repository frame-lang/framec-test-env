@@[target("kotlin")]

// Async HSM explicit `=> $^` statement forward (Kotlin). #158 remainder.

import kotlinx.coroutines.runBlocking
import kotlinx.coroutines.delay

@@[async]
@@system AsyncHsmStmt {
    interface:
        async other(data: String): String

    machine:
        $Child => $Parent {
            other(data: String): String {
                => $^
            }
        }

        $Parent {
            other(data: String): String {
                delay(0)
                @@:("parent_other:" + data.uppercase())
                return
            }
        }
}

fun main() = runBlocking {
    val s = @@AsyncHsmStmt()
    s.init()
    val r = s.other("test")
    if (r != "parent_other:TEST") throw RuntimeException("expected 'parent_other:TEST', got '$r'")
    println("PASS: async HSM explicit => \$^ statement forward")
}
