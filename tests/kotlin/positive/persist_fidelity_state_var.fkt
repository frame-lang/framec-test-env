@@[target("kotlin")]

// RFC-0053 compartment fidelity (Kotlin): a user-typed value held in a STATE
// VARIABLE ($.sv -> compartment.state_vars) must round-trip faithfully, not just
// a domain field. getmag() calls magSq() on the reconstructed state-var value,
// so a lossy restore (Jackson LinkedHashMap) fails here.

class Vec2(var x: Double = 0.0, var y: Double = 0.0) {
    fun magSq(): Double = x * x + y * y
}

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x: Double, y: Double)
        getmag(): Double

    machine:
        $S {
            $.sv: Vec2 = Vec2(0.0, 0.0)

            setv(x: Double, y: Double) { $.sv = Vec2(x, y) }
            getmag(): Double { @@:($.sv.magSq()) }
        }

    domain:
        marker: Int = 1
}

fun main() {
    val s1 = @@Bag()
    s1.setv(3.0, 4.0)
    val snap = s1.save_state()

    val s2 = @@Bag()
    s2.restore_state(snap)

    val m = s2.getmag()
    if (m == 25.0) {
        println("PASS: persist_fidelity_state_var")
    } else {
        println("FAIL: compartment state-var Vec2 did not round-trip: magSq=$m")
        throw RuntimeException("fidelity mismatch")
    }
}
