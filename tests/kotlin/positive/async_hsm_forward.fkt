@@[target("kotlin")]

// Async HSM parent forward (Kotlin). Validates the default `=> $^` forward is
// awaited (#158). Interface methods are suspend; the driver runs in runBlocking.

import kotlinx.coroutines.runBlocking
import kotlinx.coroutines.delay

@@[async]
@@system AsyncHsm {
    interface:
        async process(data: String): String
        async other(data: String): String

    machine:
        $Child => $Parent {
            process(data: String): String {
                delay(0)
                @@:("child:" + data.uppercase())
                return
            }
            => $^
        }

        $Parent {
            process(data: String): String {
                delay(0)
                @@:("parent:" + data.uppercase())
                return
            }
            other(data: String): String {
                delay(0)
                @@:("parent_other:" + data.uppercase())
                return
            }
        }
}

fun main() = runBlocking {
    val s = @@AsyncHsm()
    s.init()

    val r1 = s.process("hello")
    if (r1 != "child:HELLO") throw RuntimeException("expected 'child:HELLO', got '$r1'")

    val r2 = s.other("test")
    if (r2 != "parent_other:TEST") throw RuntimeException("expected 'parent_other:TEST', got '$r2'")

    println("PASS: async HSM forward — default forward dispatches to parent")
}
