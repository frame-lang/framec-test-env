@@[target("php")]
@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { throw new \RuntimeException("boom"); }
            depth(): int { @@:(count($this->_context_stack)) }
        }
}
$s = @@TL();
for ($i = 0; $i < 3; $i++) { try { $s->boom(); } catch (\Throwable $e) {} }
$d = $s->depth();
echo ($d === 1 ? "ok 1 - no leak\n" : "not ok 1 - leaked depth=$d\n");
