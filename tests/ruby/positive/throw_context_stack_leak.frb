@@[target("ruby")]
@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { raise "boom" }
            depth(): int { @@:(@_context_stack.length) }
        }
}
s = @@TL()
3.times { begin; s.boom; rescue; end }
d = s.depth
puts(d == 1 ? "ok 1 - no leak" : "not ok 1 - leaked depth=#{d}")
