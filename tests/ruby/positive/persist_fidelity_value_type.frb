@@[target("ruby")]

# RFC-0053 foundational fidelity: a @@[persist] system with a USER-TYPED domain
# field must round-trip faithfully — the restored value is a real Vec2 instance
# (its method works), not a type-erased map. The getmag() probe calls a METHOD
# on the reconstructed value, so a lossy restore fails here even though a bare
# field read would pass.

class Vec2
    attr_accessor :x, :y
    def initialize(x = 0.0, y = 0.0)
        @x = x
        @y = y
    end
    def mag_sq
        @x * @x + @y * @y
    end
end

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x, y)
        getx(): double
        getmag(): double

    machine:
        $S {
            setv(x, y) { @@:self.v = Vec2.new(x, y) }
            getx(): double { @@:(@@:self.v.x) }
            getmag(): double { @@:(@@:self.v.mag_sq) }
        }

    domain:
        v: Vec2 = Vec2.new(0.0, 0.0)
}

s1 = @@Bag()
s1.setv(3.0, 4.0)
snap = s1.save_state

s2 = @@Bag()
s2.restore_state(snap)

x = s2.getx
m = s2.getmag
if x == 3.0 && m == 25.0
    puts "PASS: persist_fidelity_value_type"
else
    puts "FAIL: x=#{x} magSq=#{m} (want x=3.0 magSq=25.0)"
    exit 1
end
