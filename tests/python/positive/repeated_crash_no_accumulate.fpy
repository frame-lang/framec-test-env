@@[target("python_3")]

# D-PY-1 variation: N failed dispatches must not accumulate N stale
# context-stack entries — the stack returns to baseline after each.

@@system RepeatCrash {
    interface:
        crash()
        depth(): int
    machine:
        $S {
            crash() { raise RuntimeError("x") }
            depth(): int { @@:(0) }
        }
}

def main():
    s = @@RepeatCrash()
    for _ in range(5):
        try:
            s.crash()
        except RuntimeError:
            pass
    n = len(s._context_stack)
    if n != 0:
        raise RuntimeError(f"accumulated {n} stale entries after 5 failed calls")
    print("PASS: repeated_crash_no_accumulate")

main()
