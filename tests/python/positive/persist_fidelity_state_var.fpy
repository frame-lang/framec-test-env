@@[target("python_3")]

# RFC-0053 compartment fidelity: a user-typed value can live in a STATE VARIABLE
# (compartment.state_vars), not just a domain field. It must round-trip
# faithfully too — the reflective persist pass runs tree-wide over the whole
# snapshot, so a tagged value nested inside the serialized compartment chain is
# reconstructed, while the compartment scaffolding itself passes through untagged
# to the explicit (de)serializer. getmag() calls a method on the restored state
# var, so a lossy restore fails even though the compartment structure survived.

class Vec2:
    def __init__(self, x=0.0, y=0.0):
        self.x = x
        self.y = y

    def mag_sq(self):
        return self.x * self.x + self.y * self.y

@@[persist(str)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x, y)
        getmag()

    machine:
        $S {
            $.sv = Vec2(0.0, 0.0)

            setv(x, y) { $.sv = Vec2(x, y) }
            getmag()   { @@:($.sv.mag_sq()) }
        }

    domain:
        marker = 1
}

def main():
    s1 = @@Bag()
    s1.setv(3.0, 4.0)
    snap = s1.save_state()

    s2 = @@Bag()
    s2.restore_state(snap)

    m = s2.getmag()
    assert m == 25.0, f"compartment state-var Vec2 did not round-trip: mag_sq={m}"
    print("PASS: persist_fidelity_state_var")

if __name__ == '__main__':
    main()
