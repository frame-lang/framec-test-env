@@[target("csharp")]
@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { throw new System.Exception("boom"); }
            depth(): int { @@:(_context_stack.Count) }
        }
}
class Program {
    static void Main() {
        var s = @@TL();
        for (int i = 0; i < 3; i++) { try { s.boom(); } catch {} }
        int d = s.depth();
        System.Console.WriteLine(d == 1 ? "ok 1 - no leak" : "not ok 1 - leaked depth=" + d);
    }
}
