@@[target("typescript")]

// C1 — async_exception_clears_gate
//
// RFC-0043: handler throws during await → casing's try/finally MUST
// clear busy/in_flight → next interface call succeeds (no E703).

@@[async]
@@system Crashable {
    interface:
        async boom(): str
        async peek(): str

    machine:
        $S {
            boom(): str {
                throw new Error("handler crash");
            }
            peek(): str {
                @@:("ok")
            }
        }
}

async function main(): Promise<void> {
    let s = @@Crashable();
    await s.init();

    // First call: handler throws. Gate must clear in finally.
    let caught: Error | null = null;
    try {
        await s.boom();
    } catch (e) {
        caught = e as Error;
    }
    if (caught === null) throw new Error("expected boom() to throw");
    if (caught.message !== "handler crash") {
        throw new Error(`unexpected error message: ${caught.message}`);
    }

    // Second call: must NOT see E703.
    const result = await s.peek();
    if (result !== "ok") throw new Error(`expected 'ok', got ${result}`);

    console.log("PASS: async_exception_clears_gate");
}

main();
