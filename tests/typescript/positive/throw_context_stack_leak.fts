@@[target("typescript")]
@@system TL {
    interface:
        boom()
        depth(): number
    machine:
        $S {
            boom() { throw new Error("boom"); }
            depth(): number { @@:(this._context_stack.length) }
        }
}
const s = @@TL();
for (let i = 0; i < 3; i++) { try { s.boom(); } catch (e) {} }
const d = s.depth();
console.log(d === 1 ? "ok 1 - no leak" : "not ok 1 - leaked depth=" + d);
