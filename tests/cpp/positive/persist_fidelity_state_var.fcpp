@@[target("cpp")]

// RFC-0053 compartment fidelity (C++): a user-typed value held in a STATE
// VARIABLE ($.sv -> compartment.state_vars, a std::any) must round-trip
// faithfully, not just a domain field. getmag() calls magSq() on the
// reconstructed state-var value (std::any_cast<Vec2>), so a lossy restore fails.

#include <iostream>
#include <cmath>
#include <nlohmann/json.hpp>

struct Vec2 {
    double x = 0.0;
    double y = 0.0;
    double magSq() const { return x * x + y * y; }
};

inline void to_json(nlohmann::json& j, const Vec2& v) {
    j = nlohmann::json{{"x", v.x}, {"y", v.y}};
}
inline void from_json(const nlohmann::json& j, Vec2& v) {
    j.at("x").get_to(v.x);
    j.at("y").get_to(v.y);
}

@@[persist(std::string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x: double, y: double)
        getmag(): double

    machine:
        $S {
            $.sv: Vec2 = Vec2{}

            setv(x: double, y: double) { $.sv = Vec2{x, y}; }
            getmag(): double { @@:($.sv.magSq()) }
        }

    domain:
        marker: int = 1
}

int main() {
    auto s1 = @@Bag();
    s1.setv(3.0, 4.0);
    auto snap = s1.save_state();

    auto s2 = @@Bag();
    s2.restore_state(snap);

    double m = s2.getmag();
    if (m == 25.0) {
        std::cout << "PASS: persist_fidelity_state_var" << std::endl;
        return 0;
    } else {
        std::cout << "FAIL: compartment state-var Vec2 did not round-trip: magSq=" << m << std::endl;
        return 1;
    }
}
