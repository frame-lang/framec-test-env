@@[target("cpp")]

#include <iostream>
#include <stdexcept>

@@system TL {
    interface:
        boom()
        depth(): int
    machine:
        $S {
            boom() { throw std::runtime_error("boom"); }
            depth(): int { @@:(static_cast<int>(_context_stack.size())) }
        }
}

int main() {
    auto s = @@TL();
    for (int i = 0; i < 3; i++) { try { s.boom(); } catch (...) {} }
    int d = s.depth();
    std::cout << (d == 1 ? "ok 1 - no leak" : "not ok 1 - leaked depth=" + std::to_string(d)) << "\n";
    return 0;
}
