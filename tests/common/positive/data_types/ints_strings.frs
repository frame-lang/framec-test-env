@@[target("rust")]

@@system S {
    machine:
        $A => $P {
            e() {
                let n: i32 = 42;
                let s: String = "hello".to_string();
                => $^
                s.to_uppercase();
            }
        }
        $P { }
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut s = @@S();
    s.e();
    println!("ok 1 - ints_strings");
}
