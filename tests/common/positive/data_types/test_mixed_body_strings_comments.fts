@@[target("typescript")]

@@system MixedBodyStringsComments {
    machine:
        $Init {
            start() {
                // Native TypeScript with Frame-statement-like tokens in strings and comments
                let text: string = "This mentions -> $Next and pop$ inside a string.";
                // A comment that mentions => $^ and -> $Other should not be parsed as Frame
                console.log(text);
                -> $Done
            }
        }
        $Done {}
}

function main(): void {
    console.log("TAP version 14");
    console.log("1..1");
    try {
        const s = @@MixedBodyStringsComments();
        s.start();
        console.log("ok 1 - test_mixed_body_strings_comments");
    } catch (ex) {
        console.log(`not ok 1 - test_mixed_body_strings_comments # ${ex}`);
    }
}
main();
