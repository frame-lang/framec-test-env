@@[target("swift")]

@@system MixedBodyStringsComments {
    machine:
        $Init {
            start() {
                // Native Swift with Frame-statement-like tokens in strings and comments
                let text: String = "This mentions -> $Next and pop$ inside a string."
                // A comment that mentions => $^ and -> $Other should not be parsed as Frame
                print(text)
                -> $Done
            }
        }
        $Done {}
}

print("TAP version 14")
print("1..1")
let s = @@MixedBodyStringsComments()
s.start()
print("ok 1 - test_mixed_body_strings_comments")
