@@[target("rust")]

@@system MixedBodyStringsComments {
    machine:
        $Init {
            start() {
                // Native Rust with Frame-statement-like tokens in strings and comments
                let text: String = "This mentions -> $Next and pop$ inside a string.".to_string();
                // A comment that mentions => $^ and -> $Other should not be parsed as Frame
                println!("{}", text);
                -> $Done
            }
        }
        $Done {}
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut s = @@MixedBodyStringsComments();
    s.start();
    println!("ok 1 - test_mixed_body_strings_comments");
}
