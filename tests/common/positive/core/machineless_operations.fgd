@@[target("gdscript")]

extends SceneTree

@@system Calc {
    operations:
        add(a: int, b: int): int { return a + b; }
}

func _init():
    print("TAP version 14")
    print("1..1")
    var m = @@Calc()
    if m.add(2, 3) == 5:
        print("ok 1 - machineless add")
    else:
        print("not ok 1 - add")
    quit()
