@@[target("c")]

#include <stdio.h>

@@system Calc {
    operations:
        add(a: int, b: int): int { return a + b; }
}

int main() {
    printf("TAP version 14\n1..1\n");
    Calc* m = @@Calc();
    if (Calc_add(m, 2, 3) == 5) printf("ok 1 - machineless add\n"); else printf("not ok 1 - add\n");
    return 0;
}
