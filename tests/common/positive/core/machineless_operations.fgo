@@[target("go")]

package main

import "fmt"

@@system Calc {
    operations:
        add(a: int, b: int): int { return a + b; }
}

func main() {
    fmt.Println("TAP version 14"); fmt.Println("1..1")
    m := @@Calc()
    if m.Add(2, 3) == 5 { fmt.Println("ok 1 - machineless add") } else { fmt.Printf("not ok 1 - add # got %v\n", m.Add(2, 3)) }
}
