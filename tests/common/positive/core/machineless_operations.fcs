@@[target("csharp")]
@@system Calc {
    operations:
        add(a: int, b: int): int { return a + b; }
}

class Program {
    static void Main() {
        System.Console.WriteLine("TAP version 14"); System.Console.WriteLine("1..1");
        var m = @@Calc();
        System.Console.WriteLine(m.add(2, 3) == 5 ? "ok 1 - machineless add" : "not ok 1 - add # got " + m.add(2, 3));
    }
}
