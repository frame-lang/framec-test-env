@@[target("cpp")]

#include <iostream>

@@system Calc {
    operations:
        add(a: int, b: int): int { return a + b; }
}

int main() {
    std::cout << "TAP version 14\n1..1\n";
    auto m = @@Calc();
    std::cout << (m.add(2, 3) == 5 ? "ok 1 - machineless add\n" : "not ok 1 - add\n");
    return 0;
}
