@@[target("rust")]
@@system Calc {
    operations:
        add(a: i32, b: i32): i32 { return a + b; }
}

fn main() {
    println!("TAP version 14"); println!("1..1");
    let mut m = @@Calc();
    if m.add(2, 3) == 5 { println!("ok 1 - machineless add"); } else { println!("not ok 1 - add # got {}", m.add(2, 3)); }
}
