@@[target("java")]
@@system Calc {
    operations:
        add(a: int, b: int): int { return a + b; }
}

class Main {
    public static void main(String[] a) {
        System.out.println("TAP version 14"); System.out.println("1..1");
        var m = @@Calc();
        System.out.println(m.add(2, 3) == 5 ? "ok 1 - machineless add" : "not ok 1 - add # got " + m.add(2, 3));
    }
}
