@@[target("kotlin")]

// Cookbook 90: Kerberos Ticket Lifecycle (HSM)

@@system KerberosClient {
    interface:
        authenticate(user: String, password: String)
        preauth_accepted(tgt: String, session_key: String, expiry: Int)
        preauth_rejected(reason: String)
        request_service(spn: String)
        service_ticket_received(st: String, expiry: Int)
        service_ticket_rejected(reason: String)
        tick(now: Int)
        logout()
        get_status(): String = ""
        get_tgt(): String
        get_service_ticket(): String

    machine:
        $Idle {
            authenticate(user: String, password: String) {
                this.user = user
                -> $AwaitingTgt
            }
            get_status(): String { @@:("idle") }
            get_tgt(): String { @@:(this.tgt as String) }
            get_service_ticket(): String { @@:(this.service_ticket as String) }
        }

        $AwaitingTgt {
            preauth_accepted(tgt: String, session_key: String, expiry: Int) {
                this.tgt = tgt
                this.session_key = session_key
                this.tgt_expiry = expiry
                -> $HasTgt
            }
            preauth_rejected(reason: String) { -> $Failed }
            get_status(): String { @@:("awaiting_tgt") }
            get_tgt(): String { @@:(this.tgt as String) }
            get_service_ticket(): String { @@:(this.service_ticket as String) }
        }

        $HasValidTgt {
            tick(now: Int) {
                if ((now as Int) >= (this.tgt_expiry as Int)) {
                    this.tgt = ""
                    this.session_key = ""
                    this.tgt_expiry = 0
                    this.service_ticket = ""
                    this.st_expiry = 0
                    -> $Idle
                }
            }
            logout() {
                this.tgt = ""
                this.session_key = ""
                this.tgt_expiry = 0
                this.service_ticket = ""
                this.st_expiry = 0
                -> $Idle
            }
            get_tgt(): String { @@:(this.tgt as String) }
            get_service_ticket(): String { @@:(this.service_ticket as String) }
        }

        $HasTgt => $HasValidTgt {
            request_service(spn: String) { -> $AwaitingServiceTicket }
            get_status(): String { @@:("has_tgt") }
            => $^
        }

        $AwaitingServiceTicket => $HasValidTgt {
            service_ticket_received(st: String, expiry: Int) {
                this.service_ticket = st
                this.st_expiry = expiry
                -> $HasServiceTicket
            }
            service_ticket_rejected(reason: String) { -> $HasTgt }
            get_status(): String { @@:("awaiting_st") }
            => $^
        }

        $HasServiceTicket => $HasValidTgt {
            tick(now: Int) {
                if ((now as Int) >= (this.tgt_expiry as Int)) {
                    this.tgt = ""
                    this.session_key = ""
                    this.tgt_expiry = 0
                    this.service_ticket = ""
                    this.st_expiry = 0
                    -> $Idle
                } else if ((now as Int) >= (this.st_expiry as Int)) {
                    this.service_ticket = ""
                    -> $HasTgt
                }
            }
            request_service(spn: String) { -> $AwaitingServiceTicket }
            get_status(): String { @@:("has_st") }
            => $^
        }

        $Failed {
            get_status(): String { @@:("failed") }
            get_tgt(): String { @@:(this.tgt as String) }
            get_service_ticket(): String { @@:(this.service_ticket as String) }
        }

    domain:
        user: String = ""
        tgt: String = ""
        session_key: String = ""
        tgt_expiry: Int = 0
        service_ticket: String = ""
        st_expiry: Int = 0
}

fun check(label: String, actual: String, expected: String) {
    if (actual != expected) { println("FAIL: $label expected '$expected', got '$actual'"); kotlin.system.exitProcess(1) }
}

fun main() {
    val k = @@KerberosClient()
    check("idle", k.get_status() as String, "idle")
    k.request_service("HTTP/web")
    check("idle absorbs request_service", k.get_status() as String, "idle")
    check("no service ticket in idle", k.get_service_ticket() as String, "")
    k.authenticate("alice", "pw")
    check("awaiting tgt", k.get_status() as String, "awaiting_tgt")
    k.request_service("HTTP/web")
    check("awaiting absorbs request_service", k.get_status() as String, "awaiting_tgt")
    k.preauth_accepted("TGT-abc", "K-123", 100)
    check("has tgt", k.get_status() as String, "has_tgt")
    check("tgt stored", k.get_tgt() as String, "TGT-abc")
    k.tick(50)
    check("still has tgt pre-expiry", k.get_status() as String, "has_tgt")
    k.request_service("HTTP/web")
    check("awaiting st", k.get_status() as String, "awaiting_st")
    k.service_ticket_received("ST-xyz", 80)
    check("has st", k.get_status() as String, "has_st")
    check("st stored", k.get_service_ticket() as String, "ST-xyz")
    k.tick(85)
    check("ST expired -> has_tgt", k.get_status() as String, "has_tgt")
    check("st cleared", k.get_service_ticket() as String, "")
    check("tgt still there", k.get_tgt() as String, "TGT-abc")
    k.request_service("HTTP/web")
    k.service_ticket_received("ST-2", 95)
    check("has st 2", k.get_status() as String, "has_st")
    k.tick(100)
    check("tgt expired -> idle", k.get_status() as String, "idle")
    check("tgt zeroed", k.get_tgt() as String, "")
    check("st zeroed", k.get_service_ticket() as String, "")

    val k2 = @@KerberosClient()
    k2.authenticate("alice", "pw")
    k2.preauth_accepted("TGT-xx", "K-yy", 200)
    k2.logout()
    check("logout from has_tgt -> idle", k2.get_status() as String, "idle")
    check("logout cleared tgt", k2.get_tgt() as String, "")

    val k3 = @@KerberosClient()
    k3.authenticate("alice", "pw")
    k3.preauth_accepted("TGT-1", "K-1", 500)
    k3.request_service("spn")
    k3.service_ticket_received("ST-1", 300)
    k3.logout()
    check("logout from has_st -> idle", k3.get_status() as String, "idle")
    check("logout cleared st", k3.get_service_ticket() as String, "")

    val k4 = @@KerberosClient()
    k4.authenticate("bob", "wrong")
    k4.preauth_rejected("invalid_password")
    check("preauth rejected", k4.get_status() as String, "failed")

    val k5 = @@KerberosClient()
    k5.authenticate("alice", "pw")
    k5.preauth_accepted("TGT-q", "K-q", 500)
    k5.request_service("deny_me")
    k5.service_ticket_rejected("no_access")
    check("st rejected -> has_tgt", k5.get_status() as String, "has_tgt")
    check("tgt retained", k5.get_tgt() as String, "TGT-q")

    println("PASS: kerberos")
}
