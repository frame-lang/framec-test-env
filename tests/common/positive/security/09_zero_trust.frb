@@[target("ruby")]

# Cookbook 94: Zero-Trust Session

@@system ZeroTrustSession {
    interface:
        authenticate(user_id, device_id, channel_id, mfa_factor)
        auth_result(passed, risk_score)
        request_resource(resource, channel_id, policy_ok) = "denied"
        posture_update(score)
        risk_signal_update(score)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status() = ""
        get_risk()

    machine:
        $Anonymous {
            authenticate(user_id, device_id, channel_id, mfa_factor) {
                @user_id = user_id
                @device_id = device_id
                @bound_channel = channel_id
                -> $Authenticating
            }
            get_status() { @@:("anonymous") }
            get_risk() { @@:(@current_risk) }
        }

        $Authenticating {
            auth_result(passed, risk_score) {
                if passed == 0
                    -> $Anonymous
                elsif risk_score > @high_risk_threshold
                    -> $StepUpRequired
                else
                    @current_risk = risk_score
                    -> $FullAccess
                end
            }
            get_status() { @@:("authenticating") }
            get_risk() { @@:(@current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id, device_id, channel_id, mfa_factor) {
                -> $Authenticating
            }
            request_resource(resource, channel_id, policy_ok) { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status() { @@:("step_up_required") }
            get_risk() { @@:(@current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk() { @@:(@current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource, channel_id, policy_ok) {
                if channel_id != @bound_channel
                    @@:("denied_channel")
                    -> $Terminated
                elsif policy_ok == 1
                    @@:("allowed")
                else
                    @@:("denied_policy")
                end
            }
            posture_update(score) {
                if score < @min_posture
                    -> $Degraded
                end
            }
            risk_signal_update(score) {
                @current_risk = score
                if score > @block_threshold
                    -> $Terminated
                elsif score > @high_risk_threshold
                    -> $Degraded
                end
            }
            get_status() { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource, channel_id, policy_ok) {
                if channel_id != @bound_channel
                    @@:("denied_channel")
                    -> $Terminated
                elsif policy_ok == 1
                    @@:("allowed_low_trust")
                else
                    @@:("denied_low_trust")
                end
            }
            risk_signal_update(score) {
                @current_risk = score
                if score > @block_threshold
                    -> $Terminated
                end
            }
            posture_update(score) {
                if score >= @min_posture
                    -> $FullAccess
                end
            }
            get_status() { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status() { @@:("terminated") }
            get_risk() { @@:(@current_risk) }
        }

    domain:
        user_id = ""
        device_id = ""
        bound_channel = ""
        current_risk = 0
        high_risk_threshold = 70
        block_threshold = 90
        min_posture = 60
}

def check(label, actual, expected)
    if actual != expected
        puts "FAIL: #{label} expected '#{expected}', got '#{actual}'"
        exit(1)
    end
end

s = @@ZeroTrustSession()
check("anonymous", s.get_status, "anonymous")
check("anon denied", s.request_resource("doc", "ch1", 1), "denied")
s.authenticate("alice", "dev-1", "ch-A", "totp")
check("authenticating", s.get_status, "authenticating")
check("authing denied", s.request_resource("doc", "ch-A", 1), "denied")
s.auth_result(1, 30)
check("full access", s.get_status, "full_access")
check("risk recorded", s.get_risk, 30)
check("match ok", s.request_resource("doc", "ch-A", 1), "allowed")
check("policy denied", s.request_resource("doc", "ch-A", 0), "denied_policy")
s.channel_binding_mismatch
check("hijack -> terminated", s.get_status, "terminated")
check("terminated denies", s.request_resource("doc", "ch-A", 1), "denied")

s2 = @@ZeroTrustSession()
s2.authenticate("bob", "dev-2", "ch-B", "totp")
s2.auth_result(1, 20)
check("mismatch denied", s2.request_resource("doc", "ch-WRONG", 1), "denied_channel")
check("mismatch terminates", s2.get_status, "terminated")

s3 = @@ZeroTrustSession()
s3.authenticate("carol", "dev-3", "ch-C", "totp")
s3.auth_result(1, 85)
check("step up", s3.get_status, "step_up_required")
check("step-up denies resource", s3.request_resource("doc", "ch-C", 1), "denied_stepup")
s3.authenticate("carol", "dev-3", "ch-C", "u2f")
check("re-authing", s3.get_status, "authenticating")
s3.auth_result(1, 30)
check("full access after step-up", s3.get_status, "full_access")

s4 = @@ZeroTrustSession()
s4.authenticate("dave", "dev-4", "ch-D", "totp")
s4.auth_result(1, 20)
s4.posture_update(50)
check("posture degrade", s4.get_status, "degraded")
check("degraded + allowed", s4.request_resource("doc", "ch-D", 1), "allowed_low_trust")
check("degraded + denied", s4.request_resource("doc", "ch-D", 0), "denied_low_trust")
s4.posture_update(80)
check("posture restored", s4.get_status, "full_access")
s4.risk_signal_update(95)
check("risk block -> terminated", s4.get_status, "terminated")

s5 = @@ZeroTrustSession()
s5.authenticate("eve", "dev-5", "ch-E", "totp")
s5.auth_result(1, 20)
s5.risk_signal_update(75)
check("risk degrade", s5.get_status, "degraded")

s6 = @@ZeroTrustSession()
s6.authenticate("fred", "dev-6", "ch-F", "totp")
s6.auth_result(1, 20)
s6.logout
check("logout -> anonymous", s6.get_status, "anonymous")

s7 = @@ZeroTrustSession()
s7.authenticate("greg", "dev-7", "ch-G", "totp")
s7.auth_result(1, 20)
s7.session_heartbeat
check("heartbeat noop", s7.get_status, "full_access")

puts "PASS: zero_trust"
