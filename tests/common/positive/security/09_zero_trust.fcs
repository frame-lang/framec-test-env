@@[target("csharp")]

// Cookbook 94: Zero-Trust Session

using System;

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string)
        auth_result(passed: int, risk_score: int)
        request_resource(resource: string, channel_id: string, policy_ok: int): string = "denied"
        posture_update(score: int)
        risk_signal_update(score: int)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): string = ""
        get_risk(): int

    machine:
        $Anonymous {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) {
                this.user_id = user_id;
                this.device_id = device_id;
                this.bound_channel = channel_id;
                -> $Authenticating
            }
            get_status(): string { @@:("anonymous") }
            get_risk(): int { @@:((int) this.current_risk) }
        }

        $Authenticating {
            auth_result(passed: int, risk_score: int) {
                if (passed == 0) { -> $Anonymous }
                else if (risk_score > (int) this.high_risk_threshold) { -> $StepUpRequired }
                else {
                    this.current_risk = risk_score;
                    -> $FullAccess
                }
            }
            get_status(): string { @@:("authenticating") }
            get_risk(): int { @@:((int) this.current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) { -> $Authenticating }
            request_resource(resource: string, channel_id: string, policy_ok: int): string { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): string { @@:("step_up_required") }
            get_risk(): int { @@:((int) this.current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): int { @@:((int) this.current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: int): string {
                if (channel_id != (string) this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: int) {
                if (score < (int) this.min_posture) { -> $Degraded }
            }
            risk_signal_update(score: int) {
                this.current_risk = score;
                if (score > (int) this.block_threshold) { -> $Terminated }
                else if (score > (int) this.high_risk_threshold) { -> $Degraded }
            }
            get_status(): string { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: int): string {
                if (channel_id != (string) this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: int) {
                this.current_risk = score;
                if (score > (int) this.block_threshold) { -> $Terminated }
            }
            posture_update(score: int) {
                if (score >= (int) this.min_posture) { -> $FullAccess }
            }
            get_status(): string { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): string { @@:("terminated") }
            get_risk(): int { @@:((int) this.current_risk) }
        }

    domain:
        user_id: string = ""
        device_id: string = ""
        bound_channel: string = ""
        current_risk: int = 0
        high_risk_threshold: int = 70
        block_threshold: int = 90
        min_posture: int = 60
}

public class Program {
    static void Cks(string label, string actual, string expected) {
        if (actual != expected) { Console.WriteLine($"FAIL: {label} expected '{expected}', got '{actual}'"); Environment.Exit(1); }
    }
    static void Cki(string label, int actual, int expected) {
        if (actual != expected) { Console.WriteLine($"FAIL: {label} expected {expected}, got {actual}"); Environment.Exit(1); }
    }

    public static void Main() {
        var s = @@ZeroTrustSession();
        Cks("anonymous", (string) s.get_status(), "anonymous");
        Cks("anon denied", (string) s.request_resource("doc", "ch1", 1), "denied");
        s.authenticate("alice", "dev-1", "ch-A", "totp");
        Cks("authenticating", (string) s.get_status(), "authenticating");
        Cks("authing denied", (string) s.request_resource("doc", "ch-A", 1), "denied");
        s.auth_result(1, 30);
        Cks("full access", (string) s.get_status(), "full_access");
        Cki("risk recorded", (int) s.get_risk(), 30);
        Cks("match ok", (string) s.request_resource("doc", "ch-A", 1), "allowed");
        Cks("policy denied", (string) s.request_resource("doc", "ch-A", 0), "denied_policy");
        s.channel_binding_mismatch();
        Cks("hijack -> terminated", (string) s.get_status(), "terminated");
        Cks("terminated denies", (string) s.request_resource("doc", "ch-A", 1), "denied");

        var s2 = @@ZeroTrustSession();
        s2.authenticate("bob", "dev-2", "ch-B", "totp");
        s2.auth_result(1, 20);
        Cks("mismatch denied", (string) s2.request_resource("doc", "ch-WRONG", 1), "denied_channel");
        Cks("mismatch terminates", (string) s2.get_status(), "terminated");

        var s3 = @@ZeroTrustSession();
        s3.authenticate("carol", "dev-3", "ch-C", "totp");
        s3.auth_result(1, 85);
        Cks("step up", (string) s3.get_status(), "step_up_required");
        Cks("step-up denies resource", (string) s3.request_resource("doc", "ch-C", 1), "denied_stepup");
        s3.authenticate("carol", "dev-3", "ch-C", "u2f");
        Cks("re-authing", (string) s3.get_status(), "authenticating");
        s3.auth_result(1, 30);
        Cks("full access after step-up", (string) s3.get_status(), "full_access");

        var s4 = @@ZeroTrustSession();
        s4.authenticate("dave", "dev-4", "ch-D", "totp");
        s4.auth_result(1, 20);
        s4.posture_update(50);
        Cks("posture degrade", (string) s4.get_status(), "degraded");
        Cks("degraded + allowed", (string) s4.request_resource("doc", "ch-D", 1), "allowed_low_trust");
        Cks("degraded + denied", (string) s4.request_resource("doc", "ch-D", 0), "denied_low_trust");
        s4.posture_update(80);
        Cks("posture restored", (string) s4.get_status(), "full_access");
        s4.risk_signal_update(95);
        Cks("risk block -> terminated", (string) s4.get_status(), "terminated");

        var s5 = @@ZeroTrustSession();
        s5.authenticate("eve", "dev-5", "ch-E", "totp");
        s5.auth_result(1, 20);
        s5.risk_signal_update(75);
        Cks("risk degrade", (string) s5.get_status(), "degraded");

        var s6 = @@ZeroTrustSession();
        s6.authenticate("fred", "dev-6", "ch-F", "totp");
        s6.auth_result(1, 20);
        s6.logout();
        Cks("logout -> anonymous", (string) s6.get_status(), "anonymous");

        var s7 = @@ZeroTrustSession();
        s7.authenticate("greg", "dev-7", "ch-G", "totp");
        s7.auth_result(1, 20);
        s7.session_heartbeat();
        Cks("heartbeat noop", (string) s7.get_status(), "full_access");

        Console.WriteLine("PASS: zero_trust");
    }
}
