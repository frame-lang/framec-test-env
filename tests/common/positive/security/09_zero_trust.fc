@@[target("c")]

// Cookbook 94: Zero-Trust Session

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string)
        auth_result(passed: int, risk_score: int)
        request_resource(resource: string, channel_id: string, policy_ok: int): string = "denied"
        posture_update(score: int)
        risk_signal_update(score: int)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): string = ""
        get_risk(): int

    machine:
        $Anonymous {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) {
                self->user_id = user_id;
                self->device_id = device_id;
                self->bound_channel = channel_id;
                -> $Authenticating
            }
            get_status(): string { @@:("anonymous") }
            get_risk(): int { @@:(self->current_risk) }
        }

        $Authenticating {
            auth_result(passed: int, risk_score: int) {
                if (passed == 0) { -> $Anonymous }
                else if (risk_score > self->high_risk_threshold) { -> $StepUpRequired }
                else { self->current_risk = risk_score; -> $FullAccess }
            }
            get_status(): string { @@:("authenticating") }
            get_risk(): int { @@:(self->current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) { -> $Authenticating }
            request_resource(resource: string, channel_id: string, policy_ok: int): string { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): string { @@:("step_up_required") }
            get_risk(): int { @@:(self->current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): int { @@:(self->current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: int): string {
                if (strcmp(channel_id, self->bound_channel) != 0) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: int) {
                if (score < self->min_posture) { -> $Degraded }
            }
            risk_signal_update(score: int) {
                self->current_risk = score;
                if (score > self->block_threshold) { -> $Terminated }
                else if (score > self->high_risk_threshold) { -> $Degraded }
            }
            get_status(): string { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: int): string {
                if (strcmp(channel_id, self->bound_channel) != 0) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: int) {
                self->current_risk = score;
                if (score > self->block_threshold) { -> $Terminated }
            }
            posture_update(score: int) {
                if (score >= self->min_posture) { -> $FullAccess }
            }
            get_status(): string { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): string { @@:("terminated") }
            get_risk(): int { @@:(self->current_risk) }
        }

    domain:
        user_id: string = ""
        device_id: string = ""
        bound_channel: string = ""
        current_risk: int = 0
        high_risk_threshold: int = 70
        block_threshold: int = 90
        min_posture: int = 60
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static void cks(const char* label, const char* actual, const char* expected) {
    if (strcmp(actual, expected) != 0) { fprintf(stderr, "FAIL: %s expected '%s', got '%s'\n", label, expected, actual); exit(1); }
}
static void cki(const char* label, int actual, int expected) {
    if (actual != expected) { fprintf(stderr, "FAIL: %s expected %d, got %d\n", label, expected, actual); exit(1); }
}

int main(void) {
    ZeroTrustSession s; ZeroTrustSession_init(&s);
    cks("anonymous", ZeroTrustSession_get_status(&s), "anonymous");
    cks("anon denied", ZeroTrustSession_request_resource(&s, "doc", "ch1", 1), "denied");
    ZeroTrustSession_authenticate(&s, "alice", "dev-1", "ch-A", "totp");
    cks("authenticating", ZeroTrustSession_get_status(&s), "authenticating");
    cks("authing denied", ZeroTrustSession_request_resource(&s, "doc", "ch-A", 1), "denied");
    ZeroTrustSession_auth_result(&s, 1, 30);
    cks("full access", ZeroTrustSession_get_status(&s), "full_access");
    cki("risk recorded", ZeroTrustSession_get_risk(&s), 30);
    cks("match ok", ZeroTrustSession_request_resource(&s, "doc", "ch-A", 1), "allowed");
    cks("policy denied", ZeroTrustSession_request_resource(&s, "doc", "ch-A", 0), "denied_policy");
    ZeroTrustSession_channel_binding_mismatch(&s);
    cks("hijack -> terminated", ZeroTrustSession_get_status(&s), "terminated");
    cks("terminated denies", ZeroTrustSession_request_resource(&s, "doc", "ch-A", 1), "denied");

    ZeroTrustSession s2; ZeroTrustSession_init(&s2);
    ZeroTrustSession_authenticate(&s2, "bob", "dev-2", "ch-B", "totp");
    ZeroTrustSession_auth_result(&s2, 1, 20);
    cks("mismatch denied", ZeroTrustSession_request_resource(&s2, "doc", "ch-WRONG", 1), "denied_channel");
    cks("mismatch terminates", ZeroTrustSession_get_status(&s2), "terminated");

    ZeroTrustSession s3; ZeroTrustSession_init(&s3);
    ZeroTrustSession_authenticate(&s3, "carol", "dev-3", "ch-C", "totp");
    ZeroTrustSession_auth_result(&s3, 1, 85);
    cks("step up", ZeroTrustSession_get_status(&s3), "step_up_required");
    cks("step-up denies resource", ZeroTrustSession_request_resource(&s3, "doc", "ch-C", 1), "denied_stepup");
    ZeroTrustSession_authenticate(&s3, "carol", "dev-3", "ch-C", "u2f");
    cks("re-authing", ZeroTrustSession_get_status(&s3), "authenticating");
    ZeroTrustSession_auth_result(&s3, 1, 30);
    cks("full access after step-up", ZeroTrustSession_get_status(&s3), "full_access");

    ZeroTrustSession s4; ZeroTrustSession_init(&s4);
    ZeroTrustSession_authenticate(&s4, "dave", "dev-4", "ch-D", "totp");
    ZeroTrustSession_auth_result(&s4, 1, 20);
    ZeroTrustSession_posture_update(&s4, 50);
    cks("posture degrade", ZeroTrustSession_get_status(&s4), "degraded");
    cks("degraded + allowed", ZeroTrustSession_request_resource(&s4, "doc", "ch-D", 1), "allowed_low_trust");
    cks("degraded + denied", ZeroTrustSession_request_resource(&s4, "doc", "ch-D", 0), "denied_low_trust");
    ZeroTrustSession_posture_update(&s4, 80);
    cks("posture restored", ZeroTrustSession_get_status(&s4), "full_access");
    ZeroTrustSession_risk_signal_update(&s4, 95);
    cks("risk block -> terminated", ZeroTrustSession_get_status(&s4), "terminated");

    ZeroTrustSession s5; ZeroTrustSession_init(&s5);
    ZeroTrustSession_authenticate(&s5, "eve", "dev-5", "ch-E", "totp");
    ZeroTrustSession_auth_result(&s5, 1, 20);
    ZeroTrustSession_risk_signal_update(&s5, 75);
    cks("risk degrade", ZeroTrustSession_get_status(&s5), "degraded");

    ZeroTrustSession s6; ZeroTrustSession_init(&s6);
    ZeroTrustSession_authenticate(&s6, "fred", "dev-6", "ch-F", "totp");
    ZeroTrustSession_auth_result(&s6, 1, 20);
    ZeroTrustSession_logout(&s6);
    cks("logout -> anonymous", ZeroTrustSession_get_status(&s6), "anonymous");

    ZeroTrustSession s7; ZeroTrustSession_init(&s7);
    ZeroTrustSession_authenticate(&s7, "greg", "dev-7", "ch-G", "totp");
    ZeroTrustSession_auth_result(&s7, 1, 20);
    ZeroTrustSession_session_heartbeat(&s7);
    cks("heartbeat noop", ZeroTrustSession_get_status(&s7), "full_access");

    printf("PASS: zero_trust\n");
    return 0;
}
