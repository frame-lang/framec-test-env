@@[target("lua")]

-- Cookbook 93: Macaroon-Style Capability Token Verifier

@@system MacaroonVerifier {
    interface:
        present(token, caveat_count)
        caveat_verified(passed, caveat_index)
        sig_verified(passed)
        perform(action, resource, allowed) = "denied"
        get_status() = ""
        get_caveat_index()

    machine:
        $Idle {
            present(token, caveat_count) {
                self.token = token
                self.caveats = caveat_count
                self.caveat_index = 0
                -> $CheckingSignature
            }
            get_status() { @@:("idle") }
            get_caveat_index() { @@:(self.caveat_index) }
        }

        $CheckingSignature {
            sig_verified(passed) {
                if passed == 1 then
                    -> $CheckingCaveats
                else
                    -> $Rejected
                end
            }
            get_status() { @@:("checking_sig") }
            get_caveat_index() { @@:(self.caveat_index) }
        }

        $CheckingCaveats {
            $>() {
                if self.caveat_index >= self.caveats then
                    -> $Authorized
                end
            }
            caveat_verified(passed, caveat_index) {
                if caveat_index ~= self.caveat_index then
                    -> $Rejected
                elseif passed == 0 then
                    -> $Rejected
                else
                    self.caveat_index = self.caveat_index + 1
                    -> $CheckingCaveats
                end
            }
            get_status() { @@:("checking_caveats") }
            get_caveat_index() { @@:(self.caveat_index) }
        }

        $Authorized {
            perform(action, resource, allowed) {
                if allowed == 1 then
                    @@:("allowed")
                else
                    @@:("denied")
                end
            }
            get_status() { @@:("authorized") }
            get_caveat_index() { @@:(self.caveat_index) }
        }

        $Rejected {
            get_status() { @@:("rejected") }
            get_caveat_index() { @@:(self.caveat_index) }
        }

    domain:
        token = ""
        caveats = 0
        caveat_index = 0
}

local function check(label, actual, expected)
    if actual ~= expected then
        print("FAIL: " .. label .. " expected '" .. tostring(expected) .. "', got '" .. tostring(actual) .. "'")
        os.exit(1)
    end
end

local v = @@MacaroonVerifier()
check("idle", v:get_status(), "idle")
check("idle perform denied", v:perform("read", "doc", 1), "denied")
v:present("TOK", 3)
check("checking sig", v:get_status(), "checking_sig")
check("sig-check perform denied", v:perform("read", "doc", 1), "denied")
v:sig_verified(1)
check("checking caveats", v:get_status(), "checking_caveats")
check("caveat-check perform denied", v:perform("read", "doc", 1), "denied")
v:caveat_verified(1, 0)
check("caveat 0 done, index advanced", v:get_caveat_index(), 1)
v:caveat_verified(1, 1)
v:caveat_verified(1, 2)
check("authorized", v:get_status(), "authorized")
check("in-scope perform", v:perform("read", "doc", 1), "allowed")
check("out-of-scope perform", v:perform("write", "doc", 0), "denied")
v:caveat_verified(1, 99)
check("authorized absorbs caveat", v:get_status(), "authorized")

local v2 = @@MacaroonVerifier()
v2:present("TOK", 2)
v2:sig_verified(0)
check("sig failed", v2:get_status(), "rejected")
check("rejected denies perform", v2:perform("read", "doc", 1), "denied")

local v3 = @@MacaroonVerifier()
v3:present("TOK", 3)
v3:sig_verified(1)
v3:caveat_verified(1, 0)
v3:caveat_verified(0, 1)
check("caveat failed -> rejected", v3:get_status(), "rejected")

local v4 = @@MacaroonVerifier()
v4:present("TOK", 3)
v4:sig_verified(1)
v4:caveat_verified(1, 0)
v4:caveat_verified(1, 2)
check("out-of-order -> rejected", v4:get_status(), "rejected")

local v5 = @@MacaroonVerifier()
v5:present("TOK", 0)
v5:sig_verified(1)
check("no caveats -> authorized", v5:get_status(), "authorized")

print("PASS: macaroon")
