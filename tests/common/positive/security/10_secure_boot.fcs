@@[target("csharp")]

// Cookbook 95: Secure Boot

using System;

@@system SecureBoot {
    interface:
        power_on()
        verify_result(stage: int, passed: int)
        measurement_extended(stage: int)
        antirollback_check(passed: int)
        get_stage(): int = -1

    machine:
        $Rom {
            $>() { this.current_stage = 0; }
            measurement_extended(stage: int) { if (stage == 0) { this.current_stage = 0; } }
            verify_result(stage: int, passed: int) {
                if (stage == 1 && passed != 0) { -> $VerifyingBootloader } else { -> $Halted }
            }
            get_stage(): int { @@:(0) }
        }
        $VerifyingBootloader {
            measurement_extended(stage: int) { if (stage == 1) { -> $AntirollbackBootloader } }
            get_stage(): int { @@:(1) }
        }
        $AntirollbackBootloader {
            antirollback_check(passed: int) { if (passed != 0) { -> $BootloaderRunning } else { -> $Halted } }
            get_stage(): int { @@:(1) }
        }
        $BootloaderRunning {
            verify_result(stage: int, passed: int) { if (stage == 2 && passed != 0) { -> $VerifyingKernel } else { -> $Recovery } }
            get_stage(): int { @@:(2) }
        }
        $VerifyingKernel {
            measurement_extended(stage: int) { if (stage == 2) { -> $AntirollbackKernel } }
            get_stage(): int { @@:(2) }
        }
        $AntirollbackKernel {
            antirollback_check(passed: int) { if (passed != 0) { -> $KernelRunning } else { -> $Recovery } }
            get_stage(): int { @@:(2) }
        }
        $KernelRunning {
            verify_result(stage: int, passed: int) { if (stage == 3 && passed != 0) { -> $VerifyingInit } else { -> $Recovery } }
            get_stage(): int { @@:(3) }
        }
        $VerifyingInit {
            measurement_extended(stage: int) { if (stage == 3) { -> $Booted } }
            get_stage(): int { @@:(3) }
        }
        $Booted { get_stage(): int { @@:(4) } }
        $Recovery { get_stage(): int { @@:(-2) } }
        $Halted { get_stage(): int { @@:(-1) } }

    domain:
        current_stage: int = 0
}

public class Program {
    static void Check(string label, int actual, int expected) {
        if (actual != expected) { Console.WriteLine($"FAIL: {label} expected {expected}, got {actual}"); Environment.Exit(1); }
    }
    public static void Main() {
        var b = @@SecureBoot();
        Check("rom stage", (int) b.get_stage(), 0);
        b.measurement_extended(0); b.verify_result(1, 1); Check("verifying bootloader", (int) b.get_stage(), 1);
        b.measurement_extended(1); Check("antirollback bootloader", (int) b.get_stage(), 1);
        b.antirollback_check(1); Check("bootloader running", (int) b.get_stage(), 2);
        b.verify_result(2, 1); b.measurement_extended(2); b.antirollback_check(1); Check("kernel running", (int) b.get_stage(), 3);
        b.verify_result(3, 1); b.measurement_extended(3); Check("booted", (int) b.get_stage(), 4);

        var b2 = @@SecureBoot(); b2.measurement_extended(0); b2.verify_result(1, 0);
        Check("bootloader sig bad -> halted", (int) b2.get_stage(), -1);
        b2.verify_result(2, 1); Check("halted absorbs", (int) b2.get_stage(), -1);

        var b3 = @@SecureBoot(); b3.measurement_extended(0); b3.verify_result(1, 1); b3.measurement_extended(1); b3.antirollback_check(0);
        Check("bootloader rollback -> halted", (int) b3.get_stage(), -1);

        var b4 = @@SecureBoot(); b4.measurement_extended(0); b4.verify_result(1, 1); b4.measurement_extended(1); b4.antirollback_check(1); b4.verify_result(2, 0);
        Check("kernel sig bad -> recovery", (int) b4.get_stage(), -2);

        var b5 = @@SecureBoot(); b5.measurement_extended(0); b5.verify_result(1, 1); b5.measurement_extended(1); b5.antirollback_check(1); b5.verify_result(2, 1); b5.measurement_extended(2); b5.antirollback_check(0);
        Check("kernel rollback -> recovery", (int) b5.get_stage(), -2);

        var b6 = @@SecureBoot(); b6.measurement_extended(0); b6.verify_result(1, 1); b6.measurement_extended(1); b6.antirollback_check(1); b6.verify_result(2, 1); b6.measurement_extended(2); b6.antirollback_check(1); b6.verify_result(3, 0);
        Check("init sig bad -> recovery", (int) b6.get_stage(), -2);

        var b7 = @@SecureBoot(); b7.antirollback_check(1);
        Check("antirollback in ROM absorbed", (int) b7.get_stage(), 0);
        b7.measurement_extended(5); Check("wrong-stage measurement absorbed", (int) b7.get_stage(), 0);

        var b8 = @@SecureBoot(); b8.verify_result(3, 1); Check("bogus verify at ROM halts", (int) b8.get_stage(), -1);

        Console.WriteLine("PASS: secure_boot");
    }
}
