@@[target("rust")]

// Cookbook 94: Zero-Trust Session with Continuous Verification

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String)
        auth_result(passed: i32, risk_score: i32)
        request_resource(resource: String, channel_id: String, policy_ok: i32): String = "denied"
        posture_update(score: i32)
        risk_signal_update(score: i32)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): String = ""
        get_risk(): i32

    machine:
        $Anonymous {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) {
                self.user_id = user_id;
                self.device_id = device_id;
                self.bound_channel = channel_id;
                -> $Authenticating
            }
            get_status(): String { @@:(String::from("anonymous")) }
            get_risk(): i32 { @@:(self.current_risk) }
        }

        $Authenticating {
            auth_result(passed: i32, risk_score: i32) {
                if passed == 0 {
                    -> $Anonymous
                } else if risk_score > self.high_risk_threshold {
                    -> $StepUpRequired
                } else {
                    self.current_risk = risk_score;
                    -> $FullAccess
                }
            }
            get_status(): String { @@:(String::from("authenticating")) }
            get_risk(): i32 { @@:(self.current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) {
                -> $Authenticating
            }
            request_resource(resource: String, channel_id: String, policy_ok: i32): String {
                @@:(String::from("denied_stepup"))
            }
            logout() { -> $Anonymous }
            get_status(): String { @@:(String::from("step_up_required")) }
            get_risk(): i32 { @@:(self.current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): i32 { @@:(self.current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: i32): String {
                if channel_id != self.bound_channel {
                    @@:(String::from("denied_channel"))
                    -> $Terminated
                } else if policy_ok == 1 {
                    @@:(String::from("allowed"))
                } else {
                    @@:(String::from("denied_policy"))
                }
            }
            posture_update(score: i32) {
                if score < self.min_posture {
                    -> $Degraded
                }
            }
            risk_signal_update(score: i32) {
                self.current_risk = score;
                if score > self.block_threshold {
                    -> $Terminated
                } else if score > self.high_risk_threshold {
                    -> $Degraded
                }
            }
            get_status(): String { @@:(String::from("full_access")) }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: i32): String {
                if channel_id != self.bound_channel {
                    @@:(String::from("denied_channel"))
                    -> $Terminated
                } else if policy_ok == 1 {
                    @@:(String::from("allowed_low_trust"))
                } else {
                    @@:(String::from("denied_low_trust"))
                }
            }
            risk_signal_update(score: i32) {
                self.current_risk = score;
                if score > self.block_threshold {
                    -> $Terminated
                }
            }
            posture_update(score: i32) {
                if score >= self.min_posture {
                    -> $FullAccess
                }
            }
            get_status(): String { @@:(String::from("degraded")) }
            => $^
        }

        $Terminated {
            get_status(): String { @@:(String::from("terminated")) }
            get_risk(): i32 { @@:(self.current_risk) }
        }

    domain:
        user_id: String = String::new()
        device_id: String = String::new()
        bound_channel: String = String::new()
        current_risk: i32 = 0
        high_risk_threshold: i32 = 70
        block_threshold: i32 = 90
        min_posture: i32 = 60
}

fn check_s(label: &str, actual: String, expected: &str) {
    if actual != expected { println!("FAIL: {} expected '{}', got '{}'", label, expected, actual); std::process::exit(1); }
}
fn check_i(label: &str, actual: i32, expected: i32) {
    if actual != expected { println!("FAIL: {} expected {}, got {}", label, expected, actual); std::process::exit(1); }
}

fn main() {
    let mut s = @@ZeroTrustSession();
    check_s("anonymous", s.get_status(), "anonymous");
    check_s("anon denied", s.request_resource(String::from("doc"), String::from("ch1"), 1), "denied");
    s.authenticate(String::from("alice"), String::from("dev-1"), String::from("ch-A"), String::from("totp"));
    check_s("authenticating", s.get_status(), "authenticating");
    check_s("authing denied", s.request_resource(String::from("doc"), String::from("ch-A"), 1), "denied");
    s.auth_result(1, 30);
    check_s("full access", s.get_status(), "full_access");
    check_i("risk recorded", s.get_risk(), 30);
    check_s("match ok", s.request_resource(String::from("doc"), String::from("ch-A"), 1), "allowed");
    check_s("policy denied", s.request_resource(String::from("doc"), String::from("ch-A"), 0), "denied_policy");
    s.channel_binding_mismatch();
    check_s("hijack -> terminated", s.get_status(), "terminated");
    check_s("terminated denies", s.request_resource(String::from("doc"), String::from("ch-A"), 1), "denied");

    let mut s2 = @@ZeroTrustSession();
    s2.authenticate(String::from("bob"), String::from("dev-2"), String::from("ch-B"), String::from("totp"));
    s2.auth_result(1, 20);
    check_s("mismatch denied", s2.request_resource(String::from("doc"), String::from("ch-WRONG"), 1), "denied_channel");
    check_s("mismatch terminates", s2.get_status(), "terminated");

    let mut s3 = @@ZeroTrustSession();
    s3.authenticate(String::from("carol"), String::from("dev-3"), String::from("ch-C"), String::from("totp"));
    s3.auth_result(1, 85);
    check_s("step up", s3.get_status(), "step_up_required");
    check_s("step-up denies resource", s3.request_resource(String::from("doc"), String::from("ch-C"), 1), "denied_stepup");
    s3.authenticate(String::from("carol"), String::from("dev-3"), String::from("ch-C"), String::from("u2f"));
    check_s("re-authing", s3.get_status(), "authenticating");
    s3.auth_result(1, 30);
    check_s("full access after step-up", s3.get_status(), "full_access");

    let mut s4 = @@ZeroTrustSession();
    s4.authenticate(String::from("dave"), String::from("dev-4"), String::from("ch-D"), String::from("totp"));
    s4.auth_result(1, 20);
    s4.posture_update(50);
    check_s("posture degrade", s4.get_status(), "degraded");
    check_s("degraded + allowed", s4.request_resource(String::from("doc"), String::from("ch-D"), 1), "allowed_low_trust");
    check_s("degraded + denied", s4.request_resource(String::from("doc"), String::from("ch-D"), 0), "denied_low_trust");
    s4.posture_update(80);
    check_s("posture restored", s4.get_status(), "full_access");
    s4.risk_signal_update(95);
    check_s("risk block -> terminated", s4.get_status(), "terminated");

    let mut s5 = @@ZeroTrustSession();
    s5.authenticate(String::from("eve"), String::from("dev-5"), String::from("ch-E"), String::from("totp"));
    s5.auth_result(1, 20);
    s5.risk_signal_update(75);
    check_s("risk degrade", s5.get_status(), "degraded");

    let mut s6 = @@ZeroTrustSession();
    s6.authenticate(String::from("fred"), String::from("dev-6"), String::from("ch-F"), String::from("totp"));
    s6.auth_result(1, 20);
    s6.logout();
    check_s("logout -> anonymous", s6.get_status(), "anonymous");

    let mut s7 = @@ZeroTrustSession();
    s7.authenticate(String::from("greg"), String::from("dev-7"), String::from("ch-G"), String::from("totp"));
    s7.auth_result(1, 20);
    s7.session_heartbeat();
    check_s("heartbeat noop", s7.get_status(), "full_access");

    println!("PASS: zero_trust");
}
