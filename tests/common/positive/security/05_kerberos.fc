@@[target("c")]

// Cookbook 90: Kerberos Ticket Lifecycle (HSM)

@@system KerberosClient {
    interface:
        authenticate(user: string, password: string)
        preauth_accepted(tgt: string, session_key: string, expiry: int)
        preauth_rejected(reason: string)
        request_service(spn: string)
        service_ticket_received(st: string, expiry: int)
        service_ticket_rejected(reason: string)
        tick(now: int)
        logout()
        get_status(): string = ""
        get_tgt(): string
        get_service_ticket(): string

    machine:
        $Idle {
            authenticate(user: string, password: string) {
                self->user = user;
                -> $AwaitingTgt
            }
            get_status(): string { @@:("idle") }
            get_tgt(): string { @@:(self->tgt) }
            get_service_ticket(): string { @@:(self->service_ticket) }
        }

        $AwaitingTgt {
            preauth_accepted(tgt: string, session_key: string, expiry: int) {
                self->tgt = tgt;
                self->session_key = session_key;
                self->tgt_expiry = expiry;
                -> $HasTgt
            }
            preauth_rejected(reason: string) { -> $Failed }
            get_status(): string { @@:("awaiting_tgt") }
            get_tgt(): string { @@:(self->tgt) }
            get_service_ticket(): string { @@:(self->service_ticket) }
        }

        $HasValidTgt {
            tick(now: int) {
                if (now >= self->tgt_expiry) {
                    self->tgt = "";
                    self->session_key = "";
                    self->tgt_expiry = 0;
                    self->service_ticket = "";
                    self->st_expiry = 0;
                    -> $Idle
                }
            }
            logout() {
                self->tgt = "";
                self->session_key = "";
                self->tgt_expiry = 0;
                self->service_ticket = "";
                self->st_expiry = 0;
                -> $Idle
            }
            get_tgt(): string { @@:(self->tgt) }
            get_service_ticket(): string { @@:(self->service_ticket) }
        }

        $HasTgt => $HasValidTgt {
            request_service(spn: string) { -> $AwaitingServiceTicket }
            get_status(): string { @@:("has_tgt") }
            => $^
        }

        $AwaitingServiceTicket => $HasValidTgt {
            service_ticket_received(st: string, expiry: int) {
                self->service_ticket = st;
                self->st_expiry = expiry;
                -> $HasServiceTicket
            }
            service_ticket_rejected(reason: string) { -> $HasTgt }
            get_status(): string { @@:("awaiting_st") }
            => $^
        }

        $HasServiceTicket => $HasValidTgt {
            tick(now: int) {
                if (now >= self->tgt_expiry) {
                    self->tgt = "";
                    self->session_key = "";
                    self->tgt_expiry = 0;
                    self->service_ticket = "";
                    self->st_expiry = 0;
                    -> $Idle
                } else if (now >= self->st_expiry) {
                    self->service_ticket = "";
                    -> $HasTgt
                }
            }
            request_service(spn: string) { -> $AwaitingServiceTicket }
            get_status(): string { @@:("has_st") }
            => $^
        }

        $Failed {
            get_status(): string { @@:("failed") }
            get_tgt(): string { @@:(self->tgt) }
            get_service_ticket(): string { @@:(self->service_ticket) }
        }

    domain:
        user: string = ""
        tgt: string = ""
        session_key: string = ""
        tgt_expiry: int = 0
        service_ticket: string = ""
        st_expiry: int = 0
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static void check(const char* label, const char* actual, const char* expected) {
    if (strcmp(actual, expected) != 0) { fprintf(stderr, "FAIL: %s expected '%s', got '%s'\n", label, expected, actual); exit(1); }
}

int main(void) {
    KerberosClient* k = @@KerberosClient();
    check("idle", KerberosClient_get_status(k), "idle");
    KerberosClient_request_service(k, "HTTP/web");
    check("idle absorbs request_service", KerberosClient_get_status(k), "idle");
    check("no service ticket in idle", KerberosClient_get_service_ticket(k), "");
    KerberosClient_authenticate(k, "alice", "pw");
    check("awaiting tgt", KerberosClient_get_status(k), "awaiting_tgt");
    KerberosClient_request_service(k, "HTTP/web");
    check("awaiting absorbs request_service", KerberosClient_get_status(k), "awaiting_tgt");
    KerberosClient_preauth_accepted(k, "TGT-abc", "K-123", 100);
    check("has tgt", KerberosClient_get_status(k), "has_tgt");
    check("tgt stored", KerberosClient_get_tgt(k), "TGT-abc");
    KerberosClient_tick(k, 50);
    check("still has tgt pre-expiry", KerberosClient_get_status(k), "has_tgt");
    KerberosClient_request_service(k, "HTTP/web");
    check("awaiting st", KerberosClient_get_status(k), "awaiting_st");
    KerberosClient_service_ticket_received(k, "ST-xyz", 80);
    check("has st", KerberosClient_get_status(k), "has_st");
    check("st stored", KerberosClient_get_service_ticket(k), "ST-xyz");
    KerberosClient_tick(k, 85);
    check("ST expired -> has_tgt", KerberosClient_get_status(k), "has_tgt");
    check("st cleared", KerberosClient_get_service_ticket(k), "");
    check("tgt still there", KerberosClient_get_tgt(k), "TGT-abc");
    KerberosClient_request_service(k, "HTTP/web");
    KerberosClient_service_ticket_received(k, "ST-2", 95);
    check("has st 2", KerberosClient_get_status(k), "has_st");
    KerberosClient_tick(k, 100);
    check("tgt expired -> idle", KerberosClient_get_status(k), "idle");
    check("tgt zeroed", KerberosClient_get_tgt(k), "");
    check("st zeroed", KerberosClient_get_service_ticket(k), "");

    KerberosClient* k2 = @@KerberosClient();
    KerberosClient_authenticate(k2, "alice", "pw");
    KerberosClient_preauth_accepted(k2, "TGT-xx", "K-yy", 200);
    KerberosClient_logout(k2);
    check("logout from has_tgt -> idle", KerberosClient_get_status(k2), "idle");
    check("logout cleared tgt", KerberosClient_get_tgt(k2), "");

    KerberosClient* k3 = @@KerberosClient();
    KerberosClient_authenticate(k3, "alice", "pw");
    KerberosClient_preauth_accepted(k3, "TGT-1", "K-1", 500);
    KerberosClient_request_service(k3, "spn");
    KerberosClient_service_ticket_received(k3, "ST-1", 300);
    KerberosClient_logout(k3);
    check("logout from has_st -> idle", KerberosClient_get_status(k3), "idle");
    check("logout cleared st", KerberosClient_get_service_ticket(k3), "");

    KerberosClient* k4 = @@KerberosClient();
    KerberosClient_authenticate(k4, "bob", "wrong");
    KerberosClient_preauth_rejected(k4, "invalid_password");
    check("preauth rejected", KerberosClient_get_status(k4), "failed");

    KerberosClient* k5 = @@KerberosClient();
    KerberosClient_authenticate(k5, "alice", "pw");
    KerberosClient_preauth_accepted(k5, "TGT-q", "K-q", 500);
    KerberosClient_request_service(k5, "deny_me");
    KerberosClient_service_ticket_rejected(k5, "no_access");
    check("st rejected -> has_tgt", KerberosClient_get_status(k5), "has_tgt");
    check("tgt retained", KerberosClient_get_tgt(k5), "TGT-q");

    printf("PASS: kerberos\n");
    return 0;
}
