@@[target("kotlin")]

// Cookbook 94: Zero-Trust Session

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String)
        auth_result(passed: Int, risk_score: Int)
        request_resource(resource: String, channel_id: String, policy_ok: Int): String = "denied"
        posture_update(score: Int)
        risk_signal_update(score: Int)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): String = ""
        get_risk(): Int

    machine:
        $Anonymous {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) {
                this.user_id = user_id
                this.device_id = device_id
                this.bound_channel = channel_id
                -> $Authenticating
            }
            get_status(): String { @@:("anonymous") }
            get_risk(): Int { @@:(this.current_risk as Int) }
        }

        $Authenticating {
            auth_result(passed: Int, risk_score: Int) {
                if ((passed as Int) == 0) { -> $Anonymous }
                else if ((risk_score as Int) > (this.high_risk_threshold as Int)) { -> $StepUpRequired }
                else {
                    this.current_risk = risk_score
                    -> $FullAccess
                }
            }
            get_status(): String { @@:("authenticating") }
            get_risk(): Int { @@:(this.current_risk as Int) }
        }

        $StepUpRequired {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) { -> $Authenticating }
            request_resource(resource: String, channel_id: String, policy_ok: Int): String { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): String { @@:("step_up_required") }
            get_risk(): Int { @@:(this.current_risk as Int) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): Int { @@:(this.current_risk as Int) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: Int): String {
                if (channel_id != this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if ((policy_ok as Int) == 1) {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: Int) {
                if ((score as Int) < (this.min_posture as Int)) { -> $Degraded }
            }
            risk_signal_update(score: Int) {
                this.current_risk = score
                if ((score as Int) > (this.block_threshold as Int)) { -> $Terminated }
                else if ((score as Int) > (this.high_risk_threshold as Int)) { -> $Degraded }
            }
            get_status(): String { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: Int): String {
                if (channel_id != this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if ((policy_ok as Int) == 1) {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: Int) {
                this.current_risk = score
                if ((score as Int) > (this.block_threshold as Int)) { -> $Terminated }
            }
            posture_update(score: Int) {
                if ((score as Int) >= (this.min_posture as Int)) { -> $FullAccess }
            }
            get_status(): String { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): String { @@:("terminated") }
            get_risk(): Int { @@:(this.current_risk as Int) }
        }

    domain:
        user_id: String = ""
        device_id: String = ""
        bound_channel: String = ""
        current_risk: Int = 0
        high_risk_threshold: Int = 70
        block_threshold: Int = 90
        min_posture: Int = 60
}

fun cks(label: String, actual: String, expected: String) {
    if (actual != expected) { println("FAIL: $label expected '$expected', got '$actual'"); kotlin.system.exitProcess(1) }
}
fun cki(label: String, actual: Int, expected: Int) {
    if (actual != expected) { println("FAIL: $label expected $expected, got $actual"); kotlin.system.exitProcess(1) }
}

fun main() {
    val s = @@ZeroTrustSession()
    cks("anonymous", s.get_status() as String, "anonymous")
    cks("anon denied", s.request_resource("doc", "ch1", 1) as String, "denied")
    s.authenticate("alice", "dev-1", "ch-A", "totp")
    cks("authenticating", s.get_status() as String, "authenticating")
    cks("authing denied", s.request_resource("doc", "ch-A", 1) as String, "denied")
    s.auth_result(1, 30)
    cks("full access", s.get_status() as String, "full_access")
    cki("risk recorded", s.get_risk() as Int, 30)
    cks("match ok", s.request_resource("doc", "ch-A", 1) as String, "allowed")
    cks("policy denied", s.request_resource("doc", "ch-A", 0) as String, "denied_policy")
    s.channel_binding_mismatch()
    cks("hijack -> terminated", s.get_status() as String, "terminated")
    cks("terminated denies", s.request_resource("doc", "ch-A", 1) as String, "denied")

    val s2 = @@ZeroTrustSession()
    s2.authenticate("bob", "dev-2", "ch-B", "totp")
    s2.auth_result(1, 20)
    cks("mismatch denied", s2.request_resource("doc", "ch-WRONG", 1) as String, "denied_channel")
    cks("mismatch terminates", s2.get_status() as String, "terminated")

    val s3 = @@ZeroTrustSession()
    s3.authenticate("carol", "dev-3", "ch-C", "totp")
    s3.auth_result(1, 85)
    cks("step up", s3.get_status() as String, "step_up_required")
    cks("step-up denies resource", s3.request_resource("doc", "ch-C", 1) as String, "denied_stepup")
    s3.authenticate("carol", "dev-3", "ch-C", "u2f")
    cks("re-authing", s3.get_status() as String, "authenticating")
    s3.auth_result(1, 30)
    cks("full access after step-up", s3.get_status() as String, "full_access")

    val s4 = @@ZeroTrustSession()
    s4.authenticate("dave", "dev-4", "ch-D", "totp")
    s4.auth_result(1, 20)
    s4.posture_update(50)
    cks("posture degrade", s4.get_status() as String, "degraded")
    cks("degraded + allowed", s4.request_resource("doc", "ch-D", 1) as String, "allowed_low_trust")
    cks("degraded + denied", s4.request_resource("doc", "ch-D", 0) as String, "denied_low_trust")
    s4.posture_update(80)
    cks("posture restored", s4.get_status() as String, "full_access")
    s4.risk_signal_update(95)
    cks("risk block -> terminated", s4.get_status() as String, "terminated")

    val s5 = @@ZeroTrustSession()
    s5.authenticate("eve", "dev-5", "ch-E", "totp")
    s5.auth_result(1, 20)
    s5.risk_signal_update(75)
    cks("risk degrade", s5.get_status() as String, "degraded")

    val s6 = @@ZeroTrustSession()
    s6.authenticate("fred", "dev-6", "ch-F", "totp")
    s6.auth_result(1, 20)
    s6.logout()
    cks("logout -> anonymous", s6.get_status() as String, "anonymous")

    val s7 = @@ZeroTrustSession()
    s7.authenticate("greg", "dev-7", "ch-G", "totp")
    s7.auth_result(1, 20)
    s7.session_heartbeat()
    cks("heartbeat noop", s7.get_status() as String, "full_access")

    println("PASS: zero_trust")
}
