#!/usr/bin/env escript
main(_) ->
    {ok, K} = kerberos_client:start_link(),
    "idle" = kerberos_client:get_status(K),
    kerberos_client:request_service(K, "HTTP/web"),
    "idle" = kerberos_client:get_status(K),
    "" = kerberos_client:get_service_ticket(K),
    kerberos_client:authenticate(K, "alice", "pw"),
    "awaiting_tgt" = kerberos_client:get_status(K),
    kerberos_client:request_service(K, "HTTP/web"),
    "awaiting_tgt" = kerberos_client:get_status(K),
    kerberos_client:preauth_accepted(K, "TGT-abc", "K-123", 100),
    "has_tgt" = kerberos_client:get_status(K),
    "TGT-abc" = kerberos_client:get_tgt(K),
    kerberos_client:tick(K, 50),
    "has_tgt" = kerberos_client:get_status(K),
    kerberos_client:request_service(K, "HTTP/web"),
    "awaiting_st" = kerberos_client:get_status(K),
    kerberos_client:service_ticket_received(K, "ST-xyz", 80),
    "has_st" = kerberos_client:get_status(K),
    "ST-xyz" = kerberos_client:get_service_ticket(K),
    kerberos_client:tick(K, 85),
    "has_tgt" = kerberos_client:get_status(K),
    "" = kerberos_client:get_service_ticket(K),
    "TGT-abc" = kerberos_client:get_tgt(K),
    kerberos_client:request_service(K, "HTTP/web"),
    kerberos_client:service_ticket_received(K, "ST-2", 95),
    "has_st" = kerberos_client:get_status(K),
    kerberos_client:tick(K, 100),
    "idle" = kerberos_client:get_status(K),
    "" = kerberos_client:get_tgt(K),
    "" = kerberos_client:get_service_ticket(K),

    {ok, K2} = kerberos_client:start_link(),
    kerberos_client:authenticate(K2, "alice", "pw"),
    kerberos_client:preauth_accepted(K2, "TGT-xx", "K-yy", 200),
    kerberos_client:logout(K2),
    "idle" = kerberos_client:get_status(K2),
    "" = kerberos_client:get_tgt(K2),

    {ok, K3} = kerberos_client:start_link(),
    kerberos_client:authenticate(K3, "alice", "pw"),
    kerberos_client:preauth_accepted(K3, "TGT-1", "K-1", 500),
    kerberos_client:request_service(K3, "spn"),
    kerberos_client:service_ticket_received(K3, "ST-1", 300),
    kerberos_client:logout(K3),
    "idle" = kerberos_client:get_status(K3),
    "" = kerberos_client:get_service_ticket(K3),

    {ok, K4} = kerberos_client:start_link(),
    kerberos_client:authenticate(K4, "bob", "wrong"),
    kerberos_client:preauth_rejected(K4, "invalid_password"),
    "failed" = kerberos_client:get_status(K4),

    {ok, K5} = kerberos_client:start_link(),
    kerberos_client:authenticate(K5, "alice", "pw"),
    kerberos_client:preauth_accepted(K5, "TGT-q", "K-q", 500),
    kerberos_client:request_service(K5, "deny_me"),
    kerberos_client:service_ticket_rejected(K5, "no_access"),
    "has_tgt" = kerberos_client:get_status(K5),
    "TGT-q" = kerberos_client:get_tgt(K5),

    io:format("PASS: kerberos~n"),
    halt(0).
