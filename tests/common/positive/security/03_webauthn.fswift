@@[target("swift")]

// Cookbook 88: WebAuthn / FIDO2

import Foundation

@@system WebAuthnCeremony {
    interface:
        begin_registration(user_id: String, rp_id: String)
        registration_response(chal_ok: Int, origin_ok: Int, att_ok: Int)
        begin_authentication(user_id: String, rp_id: String, uv_required: Int)
        assertion_response(chal_ok: Int, origin_ok: Int, uv_ok: Int, sig_ok: Int, counter_ok: Int)
        timeout()
        get_status(): String = "idle"
        get_user(): String
        get_rp(): String

    machine:
        $Idle {
            begin_registration(user_id: String, rp_id: String) {
                self.user_id = user_id
                self.rp_id = rp_id
                self.uv_required = 1
                -> $AwaitingRegistration
            }
            begin_authentication(user_id: String, rp_id: String, uv_required: Int) {
                self.user_id = user_id
                self.rp_id = rp_id
                self.uv_required = uv_required
                -> $AwaitingAssertion
            }
            get_status(): String { @@:("idle") }
            get_user(): String { @@:(self.user_id) }
            get_rp(): String { @@:(self.rp_id) }
        }

        $AwaitingRegistration {
            registration_response(chal_ok: Int, origin_ok: Int, att_ok: Int) {
                if chal_ok == 0 { -> $Failed }
                else if origin_ok == 0 { -> $Failed }
                else if att_ok == 0 { -> $Failed }
                else { -> $Registered }
            }
            timeout() { -> $Failed }
            get_status(): String { @@:("awaiting_registration") }
            get_user(): String { @@:(self.user_id) }
            get_rp(): String { @@:(self.rp_id) }
        }

        $AwaitingAssertion {
            assertion_response(chal_ok: Int, origin_ok: Int, uv_ok: Int, sig_ok: Int, counter_ok: Int) {
                if chal_ok == 0 { -> $Failed }
                else if origin_ok == 0 { -> $Failed }
                else if self.uv_required == 1 && uv_ok == 0 { -> $Failed }
                else if sig_ok == 0 { -> $Failed }
                else if counter_ok == 0 { -> $Failed }
                else { -> $Authenticated }
            }
            timeout() { -> $Failed }
            get_status(): String { @@:("awaiting_assertion") }
            get_user(): String { @@:(self.user_id) }
            get_rp(): String { @@:(self.rp_id) }
        }

        $Registered {
            get_status(): String { @@:("registered") }
            get_user(): String { @@:(self.user_id) }
            get_rp(): String { @@:(self.rp_id) }
        }

        $Authenticated {
            get_status(): String { @@:("authenticated") }
            get_user(): String { @@:(self.user_id) }
            get_rp(): String { @@:(self.rp_id) }
        }

        $Failed {
            get_status(): String { @@:("failed") }
            get_user(): String { @@:(self.user_id) }
            get_rp(): String { @@:(self.rp_id) }
        }

    domain:
        user_id: String = ""
        rp_id: String = ""
        uv_required: Int = 0
}

func check(_ label: String, _ actual: String, _ expected: String) {
    if actual != expected { print("FAIL: \(label) expected '\(expected)', got '\(actual)'"); exit(1) }
}

let w = @@WebAuthnCeremony()
check("idle", w.get_status() as! String, "idle")
w.begin_registration(user_id: "alice", rp_id: "example.com")
check("awaiting registration", w.get_status() as! String, "awaiting_registration")
check("user captured", w.get_user() as! String, "alice")
check("rp captured", w.get_rp() as! String, "example.com")
w.registration_response(chal_ok: 1, origin_ok: 1, att_ok: 1)
check("registered", w.get_status() as! String, "registered")
w.registration_response(chal_ok: 1, origin_ok: 1, att_ok: 1)
check("registered absorbs replay", w.get_status() as! String, "registered")

let w2 = @@WebAuthnCeremony()
w2.begin_registration(user_id: "bob", rp_id: "example.com")
w2.registration_response(chal_ok: 0, origin_ok: 1, att_ok: 1)
check("reg chal mismatch", w2.get_status() as! String, "failed")

let w3 = @@WebAuthnCeremony()
w3.begin_registration(user_id: "carol", rp_id: "evil.com")
w3.registration_response(chal_ok: 1, origin_ok: 0, att_ok: 1)
check("reg origin mismatch", w3.get_status() as! String, "failed")

let w4 = @@WebAuthnCeremony()
w4.begin_registration(user_id: "dave", rp_id: "example.com")
w4.registration_response(chal_ok: 1, origin_ok: 1, att_ok: 0)
check("reg attestation failed", w4.get_status() as! String, "failed")

let w5 = @@WebAuthnCeremony()
w5.begin_registration(user_id: "eve", rp_id: "example.com")
w5.timeout()
check("reg timeout", w5.get_status() as! String, "failed")

let w6 = @@WebAuthnCeremony()
w6.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 1)
check("awaiting assertion", w6.get_status() as! String, "awaiting_assertion")
w6.assertion_response(chal_ok: 1, origin_ok: 1, uv_ok: 1, sig_ok: 1, counter_ok: 1)
check("authenticated", w6.get_status() as! String, "authenticated")

let w7 = @@WebAuthnCeremony()
w7.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 1)
w7.assertion_response(chal_ok: 1, origin_ok: 1, uv_ok: 0, sig_ok: 1, counter_ok: 1)
check("uv gate", w7.get_status() as! String, "failed")

let w8 = @@WebAuthnCeremony()
w8.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 0)
w8.assertion_response(chal_ok: 1, origin_ok: 1, uv_ok: 0, sig_ok: 1, counter_ok: 1)
check("uv not required", w8.get_status() as! String, "authenticated")

let w9 = @@WebAuthnCeremony()
w9.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 1)
w9.assertion_response(chal_ok: 1, origin_ok: 0, uv_ok: 1, sig_ok: 1, counter_ok: 1)
check("origin confusion", w9.get_status() as! String, "failed")

let w10 = @@WebAuthnCeremony()
w10.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 1)
w10.assertion_response(chal_ok: 1, origin_ok: 1, uv_ok: 1, sig_ok: 0, counter_ok: 1)
check("signature fail", w10.get_status() as! String, "failed")

let w11 = @@WebAuthnCeremony()
w11.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 1)
w11.assertion_response(chal_ok: 1, origin_ok: 1, uv_ok: 1, sig_ok: 1, counter_ok: 0)
check("counter regression", w11.get_status() as! String, "failed")

let w12 = @@WebAuthnCeremony()
w12.begin_authentication(user_id: "alice", rp_id: "example.com", uv_required: 1)
w12.assertion_response(chal_ok: 0, origin_ok: 1, uv_ok: 1, sig_ok: 1, counter_ok: 1)
check("challenge replay", w12.get_status() as! String, "failed")

w6.assertion_response(chal_ok: 0, origin_ok: 0, uv_ok: 0, sig_ok: 0, counter_ok: 0)
check("authenticated absorbs replay", w6.get_status() as! String, "authenticated")

print("PASS: webauthn")
