@@[target("go")]

// Cookbook 90: Kerberos Ticket Lifecycle (HSM)

package main

import (
    "fmt"
    "os"
)

@@system KerberosClient {
    interface:
        authenticate(user: string, password: string)
        preauth_accepted(tgt: string, session_key: string, expiry: int)
        preauth_rejected(reason: string)
        request_service(spn: string)
        service_ticket_received(st: string, expiry: int)
        service_ticket_rejected(reason: string)
        tick(now: int)
        logout()
        get_status(): string = ""
        get_tgt(): string
        get_service_ticket(): string

    machine:
        $Idle {
            authenticate(user: string, password: string) {
                s.user = user
                -> $AwaitingTgt
            }
            get_status(): string { @@:("idle") }
            get_tgt(): string { @@:(s.tgt) }
            get_service_ticket(): string { @@:(s.service_ticket) }
        }

        $AwaitingTgt {
            preauth_accepted(tgt: string, session_key: string, expiry: int) {
                s.tgt = tgt
                s.session_key = session_key
                s.tgt_expiry = expiry
                -> $HasTgt
            }
            preauth_rejected(reason: string) { -> $Failed }
            get_status(): string { @@:("awaiting_tgt") }
            get_tgt(): string { @@:(s.tgt) }
            get_service_ticket(): string { @@:(s.service_ticket) }
        }

        $HasValidTgt {
            tick(now: int) {
                if now >= s.tgt_expiry {
                    s.tgt = ""
                    s.session_key = ""
                    s.tgt_expiry = 0
                    s.service_ticket = ""
                    s.st_expiry = 0
                    -> $Idle
                }
            }
            logout() {
                s.tgt = ""
                s.session_key = ""
                s.tgt_expiry = 0
                s.service_ticket = ""
                s.st_expiry = 0
                -> $Idle
            }
            get_tgt(): string { @@:(s.tgt) }
            get_service_ticket(): string { @@:(s.service_ticket) }
        }

        $HasTgt => $HasValidTgt {
            request_service(spn: string) { -> $AwaitingServiceTicket }
            get_status(): string { @@:("has_tgt") }
            => $^
        }

        $AwaitingServiceTicket => $HasValidTgt {
            service_ticket_received(st: string, expiry: int) {
                s.service_ticket = st
                s.st_expiry = expiry
                -> $HasServiceTicket
            }
            service_ticket_rejected(reason: string) { -> $HasTgt }
            get_status(): string { @@:("awaiting_st") }
            => $^
        }

        $HasServiceTicket => $HasValidTgt {
            tick(now: int) {
                if now >= s.tgt_expiry {
                    s.tgt = ""
                    s.session_key = ""
                    s.tgt_expiry = 0
                    s.service_ticket = ""
                    s.st_expiry = 0
                    -> $Idle
                } else if now >= s.st_expiry {
                    s.service_ticket = ""
                    -> $HasTgt
                }
            }
            request_service(spn: string) { -> $AwaitingServiceTicket }
            get_status(): string { @@:("has_st") }
            => $^
        }

        $Failed {
            get_status(): string { @@:("failed") }
            get_tgt(): string { @@:(s.tgt) }
            get_service_ticket(): string { @@:(s.service_ticket) }
        }

    domain:
        user: string = ""
        tgt: string = ""
        session_key: string = ""
        tgt_expiry: int = 0
        service_ticket: string = ""
        st_expiry: int = 0
}

func check(label, actual, expected string) {
    if actual != expected { fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual); os.Exit(1) }
}

func main() {
    k := @@KerberosClient()
    check("idle", k.get_status().(string), "idle")
    k.request_service("HTTP/web")
    check("idle absorbs request_service", k.get_status().(string), "idle")
    check("no service ticket in idle", k.get_service_ticket().(string), "")
    k.authenticate("alice", "pw")
    check("awaiting tgt", k.get_status().(string), "awaiting_tgt")
    k.request_service("HTTP/web")
    check("awaiting absorbs request_service", k.get_status().(string), "awaiting_tgt")
    k.preauth_accepted("TGT-abc", "K-123", 100)
    check("has tgt", k.get_status().(string), "has_tgt")
    check("tgt stored", k.get_tgt().(string), "TGT-abc")
    k.tick(50)
    check("still has tgt pre-expiry", k.get_status().(string), "has_tgt")
    k.request_service("HTTP/web")
    check("awaiting st", k.get_status().(string), "awaiting_st")
    k.service_ticket_received("ST-xyz", 80)
    check("has st", k.get_status().(string), "has_st")
    check("st stored", k.get_service_ticket().(string), "ST-xyz")
    k.tick(85)
    check("ST expired -> has_tgt", k.get_status().(string), "has_tgt")
    check("st cleared", k.get_service_ticket().(string), "")
    check("tgt still there", k.get_tgt().(string), "TGT-abc")
    k.request_service("HTTP/web")
    k.service_ticket_received("ST-2", 95)
    check("has st 2", k.get_status().(string), "has_st")
    k.tick(100)
    check("tgt expired -> idle", k.get_status().(string), "idle")
    check("tgt zeroed", k.get_tgt().(string), "")
    check("st zeroed", k.get_service_ticket().(string), "")

    k2 := @@KerberosClient()
    k2.authenticate("alice", "pw")
    k2.preauth_accepted("TGT-xx", "K-yy", 200)
    k2.logout()
    check("logout from has_tgt -> idle", k2.get_status().(string), "idle")
    check("logout cleared tgt", k2.get_tgt().(string), "")

    k3 := @@KerberosClient()
    k3.authenticate("alice", "pw")
    k3.preauth_accepted("TGT-1", "K-1", 500)
    k3.request_service("spn")
    k3.service_ticket_received("ST-1", 300)
    k3.logout()
    check("logout from has_st -> idle", k3.get_status().(string), "idle")
    check("logout cleared st", k3.get_service_ticket().(string), "")

    k4 := @@KerberosClient()
    k4.authenticate("bob", "wrong")
    k4.preauth_rejected("invalid_password")
    check("preauth rejected", k4.get_status().(string), "failed")

    k5 := @@KerberosClient()
    k5.authenticate("alice", "pw")
    k5.preauth_accepted("TGT-q", "K-q", 500)
    k5.request_service("deny_me")
    k5.service_ticket_rejected("no_access")
    check("st rejected -> has_tgt", k5.get_status().(string), "has_tgt")
    check("tgt retained", k5.get_tgt().(string), "TGT-q")

    fmt.Println("PASS: kerberos")
}
