@@[target("rust")]

// Cookbook 89: MFA with Lockout

@@system MfaAuth {
    interface:
        submit_username(u: String)
        submit_password(p: String)
        submit_second_factor(code: String)
        cooldown_elapsed()
        logout()
        get_status(): String = ""
        get_failures(): i32

    machine:
        $Idle {
            submit_username(u: String) {
                self.username = u;
                -> $AwaitingPassword
            }
            get_status(): String { @@:(String::from("idle")) }
            get_failures(): i32 { @@:(self.failures) }
        }

        $AwaitingPassword {
            submit_password(p: String) {
                if self.username == "alice" && p == "hunter2" {
                    -> $AwaitingSecondFactor
                } else {
                    self.failures = self.failures + 1;
                    if self.failures >= self.lockout_threshold {
                        -> $Locked
                    }
                }
            }
            get_status(): String { @@:(String::from("awaiting_password")) }
            get_failures(): i32 { @@:(self.failures) }
        }

        $AwaitingSecondFactor {
            $.attempts: i32 = 0

            submit_second_factor(code: String) {
                $.attempts = $.attempts + 1;
                if code == "123456" {
                    self.failures = 0;
                    -> $Authenticated
                } else if $.attempts >= 3 {
                    self.failures = self.failures + 1;
                    if self.failures >= self.lockout_threshold {
                        -> $Locked
                    } else {
                        -> $AwaitingPassword
                    }
                }
            }
            get_status(): String { @@:(String::from("awaiting_2fa")) }
            get_failures(): i32 { @@:(self.failures) }
        }

        $Authenticated {
            logout() { -> $Idle }
            get_status(): String { @@:(String::from("authenticated")) }
            get_failures(): i32 { @@:(self.failures) }
        }

        $Locked {
            cooldown_elapsed() {
                self.failures = self.lockout_threshold - 1;
                -> $Idle
            }
            get_status(): String { @@:(String::from("locked")) }
            get_failures(): i32 { @@:(self.failures) }
        }

    domain:
        username: String = String::new()
        failures: i32 = 0
        lockout_threshold: i32 = 5
}

fn check(label: &str, actual: String, expected: &str) {
    if actual != expected { println!("FAIL: {} expected '{}', got '{}'", label, expected, actual); std::process::exit(1); }
}
fn check_i(label: &str, actual: i32, expected: i32) {
    if actual != expected { println!("FAIL: {} expected {}, got {}", label, expected, actual); std::process::exit(1); }
}

fn main() {
    let mut m = @@MfaAuth();
    check("idle", m.get_status(), "idle");
    m.submit_second_factor(String::from("123456"));
    check("idle absorbs 2fa", m.get_status(), "idle");
    m.submit_username(String::from("alice"));
    check("awaiting password", m.get_status(), "awaiting_password");
    m.submit_second_factor(String::from("123456"));
    check("awaiting_password absorbs 2fa", m.get_status(), "awaiting_password");
    m.submit_password(String::from("hunter2"));
    check("awaiting 2fa", m.get_status(), "awaiting_2fa");
    check_i("no failures on correct password", m.get_failures(), 0);
    m.submit_second_factor(String::from("123456"));
    check("authenticated", m.get_status(), "authenticated");
    check_i("failure counter reset on success", m.get_failures(), 0);
    m.logout();
    check("logged out", m.get_status(), "idle");

    let mut m2 = @@MfaAuth();
    m2.submit_username(String::from("alice"));
    m2.submit_password(String::from("wrong"));
    check_i("1 failure", m2.get_failures(), 1);
    check("still awaiting password", m2.get_status(), "awaiting_password");
    m2.submit_password(String::from("wrong"));
    m2.submit_password(String::from("wrong"));
    m2.submit_password(String::from("wrong"));
    check_i("4 failures", m2.get_failures(), 4);
    m2.submit_password(String::from("wrong"));
    check("locked", m2.get_status(), "locked");
    check_i("5 failures", m2.get_failures(), 5);
    m2.submit_username(String::from("alice"));
    m2.submit_password(String::from("hunter2"));
    m2.submit_second_factor(String::from("123456"));
    check("locked absorbs all", m2.get_status(), "locked");
    m2.cooldown_elapsed();
    check("back to idle after cooldown", m2.get_status(), "idle");
    check_i("partial reset to threshold-1", m2.get_failures(), 4);

    let mut m3 = @@MfaAuth();
    m3.submit_username(String::from("alice"));
    m3.submit_password(String::from("hunter2"));
    check("2fa active", m3.get_status(), "awaiting_2fa");
    m3.submit_second_factor(String::from("bad1"));
    check("2fa after 1 wrong still active", m3.get_status(), "awaiting_2fa");
    m3.submit_second_factor(String::from("bad2"));
    m3.submit_second_factor(String::from("bad3"));
    check("2fa gave up", m3.get_status(), "awaiting_password");
    check_i("one failure bumped", m3.get_failures(), 1);
    m3.submit_password(String::from("hunter2"));
    m3.submit_second_factor(String::from("bad"));
    check("new session, new attempts counter", m3.get_status(), "awaiting_2fa");

    println!("PASS: mfa_lockout");
}
