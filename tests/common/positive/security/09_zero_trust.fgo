@@[target("go")]

// Cookbook 94: Zero-Trust Session

package main

import (
    "fmt"
    "os"
)

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string)
        auth_result(passed: int, risk_score: int)
        request_resource(resource: string, channel_id: string, policy_ok: int): string = "denied"
        posture_update(score: int)
        risk_signal_update(score: int)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): string = ""
        get_risk(): int

    machine:
        $Anonymous {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) {
                s.user_id = user_id
                s.device_id = device_id
                s.bound_channel = channel_id
                -> $Authenticating
            }
            get_status(): string { @@:("anonymous") }
            get_risk(): int { @@:(s.current_risk) }
        }

        $Authenticating {
            auth_result(passed: int, risk_score: int) {
                if passed == 0 { -> $Anonymous } else if risk_score > s.high_risk_threshold { -> $StepUpRequired } else { s.current_risk = risk_score; -> $FullAccess }
            }
            get_status(): string { @@:("authenticating") }
            get_risk(): int { @@:(s.current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) { -> $Authenticating }
            request_resource(resource: string, channel_id: string, policy_ok: int): string { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): string { @@:("step_up_required") }
            get_risk(): int { @@:(s.current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): int { @@:(s.current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: int): string {
                if channel_id != s.bound_channel {
                    @@:("denied_channel")
                    -> $Terminated
                } else if policy_ok == 1 {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: int) {
                if score < s.min_posture { -> $Degraded }
            }
            risk_signal_update(score: int) {
                s.current_risk = score
                if score > s.block_threshold { -> $Terminated } else if score > s.high_risk_threshold { -> $Degraded }
            }
            get_status(): string { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: int): string {
                if channel_id != s.bound_channel {
                    @@:("denied_channel")
                    -> $Terminated
                } else if policy_ok == 1 {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: int) {
                s.current_risk = score
                if score > s.block_threshold { -> $Terminated }
            }
            posture_update(score: int) {
                if score >= s.min_posture { -> $FullAccess }
            }
            get_status(): string { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): string { @@:("terminated") }
            get_risk(): int { @@:(s.current_risk) }
        }

    domain:
        user_id: string = ""
        device_id: string = ""
        bound_channel: string = ""
        current_risk: int = 0
        high_risk_threshold: int = 70
        block_threshold: int = 90
        min_posture: int = 60
}

func cks(label, actual, expected string) {
    if actual != expected { fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual); os.Exit(1) }
}
func cki(label string, actual, expected int) {
    if actual != expected { fmt.Printf("FAIL: %s expected %d, got %d\n", label, expected, actual); os.Exit(1) }
}

func main() {
    s := @@ZeroTrustSession()
    cks("anonymous", s.get_status().(string), "anonymous")
    cks("anon denied", s.request_resource("doc", "ch1", 1).(string), "denied")
    s.authenticate("alice", "dev-1", "ch-A", "totp")
    cks("authenticating", s.get_status().(string), "authenticating")
    cks("authing denied", s.request_resource("doc", "ch-A", 1).(string), "denied")
    s.auth_result(1, 30)
    cks("full access", s.get_status().(string), "full_access")
    cki("risk recorded", s.get_risk().(int), 30)
    cks("match ok", s.request_resource("doc", "ch-A", 1).(string), "allowed")
    cks("policy denied", s.request_resource("doc", "ch-A", 0).(string), "denied_policy")
    s.channel_binding_mismatch()
    cks("hijack -> terminated", s.get_status().(string), "terminated")
    cks("terminated denies", s.request_resource("doc", "ch-A", 1).(string), "denied")

    s2 := @@ZeroTrustSession()
    s2.authenticate("bob", "dev-2", "ch-B", "totp")
    s2.auth_result(1, 20)
    cks("mismatch denied", s2.request_resource("doc", "ch-WRONG", 1).(string), "denied_channel")
    cks("mismatch terminates", s2.get_status().(string), "terminated")

    s3 := @@ZeroTrustSession()
    s3.authenticate("carol", "dev-3", "ch-C", "totp")
    s3.auth_result(1, 85)
    cks("step up", s3.get_status().(string), "step_up_required")
    cks("step-up denies resource", s3.request_resource("doc", "ch-C", 1).(string), "denied_stepup")
    s3.authenticate("carol", "dev-3", "ch-C", "u2f")
    cks("re-authing", s3.get_status().(string), "authenticating")
    s3.auth_result(1, 30)
    cks("full access after step-up", s3.get_status().(string), "full_access")

    s4 := @@ZeroTrustSession()
    s4.authenticate("dave", "dev-4", "ch-D", "totp")
    s4.auth_result(1, 20)
    s4.posture_update(50)
    cks("posture degrade", s4.get_status().(string), "degraded")
    cks("degraded + allowed", s4.request_resource("doc", "ch-D", 1).(string), "allowed_low_trust")
    cks("degraded + denied", s4.request_resource("doc", "ch-D", 0).(string), "denied_low_trust")
    s4.posture_update(80)
    cks("posture restored", s4.get_status().(string), "full_access")
    s4.risk_signal_update(95)
    cks("risk block -> terminated", s4.get_status().(string), "terminated")

    s5 := @@ZeroTrustSession()
    s5.authenticate("eve", "dev-5", "ch-E", "totp")
    s5.auth_result(1, 20)
    s5.risk_signal_update(75)
    cks("risk degrade", s5.get_status().(string), "degraded")

    s6 := @@ZeroTrustSession()
    s6.authenticate("fred", "dev-6", "ch-F", "totp")
    s6.auth_result(1, 20)
    s6.logout()
    cks("logout -> anonymous", s6.get_status().(string), "anonymous")

    s7 := @@ZeroTrustSession()
    s7.authenticate("greg", "dev-7", "ch-G", "totp")
    s7.auth_result(1, 20)
    s7.session_heartbeat()
    cks("heartbeat noop", s7.get_status().(string), "full_access")

    fmt.Println("PASS: zero_trust")
}
