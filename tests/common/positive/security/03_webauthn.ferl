@@[target("erlang")]

%% Cookbook 88: WebAuthn / FIDO2

@@system WebAuthnCeremony {
    interface:
        begin_registration(user_id: string, rp_id: string)
        registration_response(chal_ok: int, origin_ok: int, att_ok: int)
        begin_authentication(user_id: string, rp_id: string, uv_required: int)
        assertion_response(chal_ok: int, origin_ok: int, uv_ok: int, sig_ok: int, counter_ok: int)
        timeout()
        get_status(): string = "idle"
        get_user(): string
        get_rp(): string

    machine:
        $Idle {
            begin_registration(user_id: string, rp_id: string) {
                self.user_id = User_id,
                self.rp_id = Rp_id,
                self.uv_required = 1,
                -> $AwaitingRegistration
            }
            begin_authentication(user_id: string, rp_id: string, uv_required: int) {
                self.user_id = User_id,
                self.rp_id = Rp_id,
                self.uv_required = Uv_required,
                -> $AwaitingAssertion
            }
            get_status(): string { @@:("idle") }
            get_user(): string { @@:(self.user_id) }
            get_rp(): string { @@:(self.rp_id) }
        }

        $AwaitingRegistration {
            registration_response(chal_ok: int, origin_ok: int, att_ok: int) {
                case Chal_ok == 0 of
                    true -> -> $Failed;
                    false ->
                        case Origin_ok == 0 of
                            true -> -> $Failed;
                            false ->
                                case Att_ok == 0 of
                                    true -> -> $Failed;
                                    false -> -> $Registered
                                end
                        end
                end
            }
            timeout() { -> $Failed }
            get_status(): string { @@:("awaiting_registration") }
            get_user(): string { @@:(self.user_id) }
            get_rp(): string { @@:(self.rp_id) }
        }

        $AwaitingAssertion {
            assertion_response(chal_ok: int, origin_ok: int, uv_ok: int, sig_ok: int, counter_ok: int) {
                case Chal_ok == 0 of
                    true -> -> $Failed;
                    false ->
                        case Origin_ok == 0 of
                            true -> -> $Failed;
                            false ->
                                case (self.uv_required == 1) andalso (Uv_ok == 0) of
                                    true -> -> $Failed;
                                    false ->
                                        case Sig_ok == 0 of
                                            true -> -> $Failed;
                                            false ->
                                                case Counter_ok == 0 of
                                                    true -> -> $Failed;
                                                    false -> -> $Authenticated
                                                end
                                        end
                                end
                        end
                end
            }
            timeout() { -> $Failed }
            get_status(): string { @@:("awaiting_assertion") }
            get_user(): string { @@:(self.user_id) }
            get_rp(): string { @@:(self.rp_id) }
        }

        $Registered {
            get_status(): string { @@:("registered") }
            get_user(): string { @@:(self.user_id) }
            get_rp(): string { @@:(self.rp_id) }
        }

        $Authenticated {
            get_status(): string { @@:("authenticated") }
            get_user(): string { @@:(self.user_id) }
            get_rp(): string { @@:(self.rp_id) }
        }

        $Failed {
            get_status(): string { @@:("failed") }
            get_user(): string { @@:(self.user_id) }
            get_rp(): string { @@:(self.rp_id) }
        }

    domain:
        user_id: string = ""
        rp_id: string = ""
        uv_required: int = 0
}
