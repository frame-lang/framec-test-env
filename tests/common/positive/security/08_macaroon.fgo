@@[target("go")]

// Cookbook 93: Macaroon-Style Capability Token Verifier

package main

import (
    "fmt"
    "os"
)

@@system MacaroonVerifier {
    interface:
        present(token: string, caveat_count: int)
        caveat_verified(passed: int, caveat_index: int)
        sig_verified(passed: int)
        perform(action: string, resource: string, allowed: int): string = "denied"
        get_status(): string = ""
        get_caveat_index(): int

    machine:
        $Idle {
            present(token: string, caveat_count: int) {
                s.token = token
                s.caveats = caveat_count
                s.caveat_index = 0
                -> $CheckingSignature
            }
            get_status(): string { @@:("idle") }
            get_caveat_index(): int { @@:(s.caveat_index) }
        }

        $CheckingSignature {
            sig_verified(passed: int) {
                if passed == 1 { -> $CheckingCaveats } else { -> $Rejected }
            }
            get_status(): string { @@:("checking_sig") }
            get_caveat_index(): int { @@:(s.caveat_index) }
        }

        $CheckingCaveats {
            $>() {
                if s.caveat_index >= s.caveats { -> $Authorized }
            }
            caveat_verified(passed: int, caveat_index: int) {
                if caveat_index != s.caveat_index {
                    -> $Rejected
                } else if passed == 0 {
                    -> $Rejected
                } else {
                    s.caveat_index = s.caveat_index + 1
                    -> $CheckingCaveats
                }
            }
            get_status(): string { @@:("checking_caveats") }
            get_caveat_index(): int { @@:(s.caveat_index) }
        }

        $Authorized {
            perform(action: string, resource: string, allowed: int): string {
                if allowed == 1 { @@:("allowed") } else { @@:("denied") }
            }
            get_status(): string { @@:("authorized") }
            get_caveat_index(): int { @@:(s.caveat_index) }
        }

        $Rejected {
            get_status(): string { @@:("rejected") }
            get_caveat_index(): int { @@:(s.caveat_index) }
        }

    domain:
        token: string = ""
        caveats: int = 0
        caveat_index: int = 0
}

func check(label, actual, expected string) {
    if actual != expected { fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual); os.Exit(1) }
}
func checkI(label string, actual, expected int) {
    if actual != expected { fmt.Printf("FAIL: %s expected %d, got %d\n", label, expected, actual); os.Exit(1) }
}

func main() {
    v := @@MacaroonVerifier()
    check("idle", v.Get_status(), "idle")
    check("idle perform denied", v.Perform("read", "doc", 1), "denied")
    v.Present("TOK", 3)
    check("checking sig", v.Get_status(), "checking_sig")
    check("sig-check perform denied", v.Perform("read", "doc", 1), "denied")
    v.Sig_verified(1)
    check("checking caveats", v.Get_status(), "checking_caveats")
    check("caveat-check perform denied", v.Perform("read", "doc", 1), "denied")
    v.Caveat_verified(1, 0)
    checkI("caveat 0 done, index advanced", v.Get_caveat_index(), 1)
    v.Caveat_verified(1, 1)
    v.Caveat_verified(1, 2)
    check("authorized", v.Get_status(), "authorized")
    check("in-scope perform", v.Perform("read", "doc", 1), "allowed")
    check("out-of-scope perform", v.Perform("write", "doc", 0), "denied")
    v.Caveat_verified(1, 99)
    check("authorized absorbs caveat", v.Get_status(), "authorized")

    v2 := @@MacaroonVerifier()
    v2.Present("TOK", 2)
    v2.Sig_verified(0)
    check("sig failed", v2.Get_status(), "rejected")
    check("rejected denies perform", v2.Perform("read", "doc", 1), "denied")

    v3 := @@MacaroonVerifier()
    v3.Present("TOK", 3)
    v3.Sig_verified(1)
    v3.Caveat_verified(1, 0)
    v3.Caveat_verified(0, 1)
    check("caveat failed -> rejected", v3.Get_status(), "rejected")

    v4 := @@MacaroonVerifier()
    v4.Present("TOK", 3)
    v4.Sig_verified(1)
    v4.Caveat_verified(1, 0)
    v4.Caveat_verified(1, 2)
    check("out-of-order -> rejected", v4.Get_status(), "rejected")

    v5 := @@MacaroonVerifier()
    v5.Present("TOK", 0)
    v5.Sig_verified(1)
    check("no caveats -> authorized", v5.Get_status(), "authorized")

    fmt.Println("PASS: macaroon")
}
