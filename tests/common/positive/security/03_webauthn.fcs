@@[target("csharp")]

// Cookbook 88: WebAuthn / FIDO2

using System;

@@system WebAuthnCeremony {
    interface:
        begin_registration(user_id: string, rp_id: string)
        registration_response(chal_ok: int, origin_ok: int, att_ok: int)
        begin_authentication(user_id: string, rp_id: string, uv_required: int)
        assertion_response(chal_ok: int, origin_ok: int, uv_ok: int, sig_ok: int, counter_ok: int)
        timeout()
        get_status(): string = "idle"
        get_user(): string
        get_rp(): string

    machine:
        $Idle {
            begin_registration(user_id: string, rp_id: string) {
                this.user_id = user_id;
                this.rp_id = rp_id;
                this.uv_required = 1;
                -> $AwaitingRegistration
            }
            begin_authentication(user_id: string, rp_id: string, uv_required: int) {
                this.user_id = user_id;
                this.rp_id = rp_id;
                this.uv_required = uv_required;
                -> $AwaitingAssertion
            }
            get_status(): string { @@:("idle") }
            get_user(): string { @@:(this.user_id) }
            get_rp(): string { @@:(this.rp_id) }
        }

        $AwaitingRegistration {
            registration_response(chal_ok: int, origin_ok: int, att_ok: int) {
                if (chal_ok == 0) { -> $Failed }
                else if (origin_ok == 0) { -> $Failed }
                else if (att_ok == 0) { -> $Failed }
                else { -> $Registered }
            }
            timeout() { -> $Failed }
            get_status(): string { @@:("awaiting_registration") }
            get_user(): string { @@:(this.user_id) }
            get_rp(): string { @@:(this.rp_id) }
        }

        $AwaitingAssertion {
            assertion_response(chal_ok: int, origin_ok: int, uv_ok: int, sig_ok: int, counter_ok: int) {
                if (chal_ok == 0) { -> $Failed }
                else if (origin_ok == 0) { -> $Failed }
                else if (this.uv_required == 1 && uv_ok == 0) { -> $Failed }
                else if (sig_ok == 0) { -> $Failed }
                else if (counter_ok == 0) { -> $Failed }
                else { -> $Authenticated }
            }
            timeout() { -> $Failed }
            get_status(): string { @@:("awaiting_assertion") }
            get_user(): string { @@:(this.user_id) }
            get_rp(): string { @@:(this.rp_id) }
        }

        $Registered {
            get_status(): string { @@:("registered") }
            get_user(): string { @@:(this.user_id) }
            get_rp(): string { @@:(this.rp_id) }
        }

        $Authenticated {
            get_status(): string { @@:("authenticated") }
            get_user(): string { @@:(this.user_id) }
            get_rp(): string { @@:(this.rp_id) }
        }

        $Failed {
            get_status(): string { @@:("failed") }
            get_user(): string { @@:(this.user_id) }
            get_rp(): string { @@:(this.rp_id) }
        }

    domain:
        user_id: string = ""
        rp_id: string = ""
        uv_required: int = 0
}

public class Program {
    static void Check(string label, string actual, string expected) {
        if (actual != expected) { Console.WriteLine($"FAIL: {label} expected '{expected}', got '{actual}'"); Environment.Exit(1); }
    }

    public static void Main() {
        var w = @@WebAuthnCeremony();
        Check("idle", (string)w.get_status(), "idle");
        w.begin_registration("alice", "example.com");
        Check("awaiting registration", (string)w.get_status(), "awaiting_registration");
        Check("user captured", (string)w.get_user(), "alice");
        Check("rp captured", (string)w.get_rp(), "example.com");
        w.registration_response(1, 1, 1);
        Check("registered", (string)w.get_status(), "registered");
        w.registration_response(1, 1, 1);
        Check("registered absorbs replay", (string)w.get_status(), "registered");

        var w2 = @@WebAuthnCeremony();
        w2.begin_registration("bob", "example.com");
        w2.registration_response(0, 1, 1);
        Check("reg chal mismatch", (string)w2.get_status(), "failed");

        var w3 = @@WebAuthnCeremony();
        w3.begin_registration("carol", "evil.com");
        w3.registration_response(1, 0, 1);
        Check("reg origin mismatch", (string)w3.get_status(), "failed");

        var w4 = @@WebAuthnCeremony();
        w4.begin_registration("dave", "example.com");
        w4.registration_response(1, 1, 0);
        Check("reg attestation failed", (string)w4.get_status(), "failed");

        var w5 = @@WebAuthnCeremony();
        w5.begin_registration("eve", "example.com");
        w5.timeout();
        Check("reg timeout", (string)w5.get_status(), "failed");

        var w6 = @@WebAuthnCeremony();
        w6.begin_authentication("alice", "example.com", 1);
        Check("awaiting assertion", (string)w6.get_status(), "awaiting_assertion");
        w6.assertion_response(1, 1, 1, 1, 1);
        Check("authenticated", (string)w6.get_status(), "authenticated");

        var w7 = @@WebAuthnCeremony();
        w7.begin_authentication("alice", "example.com", 1);
        w7.assertion_response(1, 1, 0, 1, 1);
        Check("uv gate", (string)w7.get_status(), "failed");

        var w8 = @@WebAuthnCeremony();
        w8.begin_authentication("alice", "example.com", 0);
        w8.assertion_response(1, 1, 0, 1, 1);
        Check("uv not required", (string)w8.get_status(), "authenticated");

        var w9 = @@WebAuthnCeremony();
        w9.begin_authentication("alice", "example.com", 1);
        w9.assertion_response(1, 0, 1, 1, 1);
        Check("origin confusion", (string)w9.get_status(), "failed");

        var w10 = @@WebAuthnCeremony();
        w10.begin_authentication("alice", "example.com", 1);
        w10.assertion_response(1, 1, 1, 0, 1);
        Check("signature fail", (string)w10.get_status(), "failed");

        var w11 = @@WebAuthnCeremony();
        w11.begin_authentication("alice", "example.com", 1);
        w11.assertion_response(1, 1, 1, 1, 0);
        Check("counter regression", (string)w11.get_status(), "failed");

        var w12 = @@WebAuthnCeremony();
        w12.begin_authentication("alice", "example.com", 1);
        w12.assertion_response(0, 1, 1, 1, 1);
        Check("challenge replay", (string)w12.get_status(), "failed");

        w6.assertion_response(0, 0, 0, 0, 0);
        Check("authenticated absorbs replay", (string)w6.get_status(), "authenticated");

        Console.WriteLine("PASS: webauthn");
    }
}
