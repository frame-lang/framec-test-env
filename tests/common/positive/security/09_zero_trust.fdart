@@[target("dart")]

// Cookbook 94: Zero-Trust Session

import 'dart:io';

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String)
        auth_result(passed: int, risk_score: int)
        request_resource(resource: String, channel_id: String, policy_ok: int): String = "denied"
        posture_update(score: int)
        risk_signal_update(score: int)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): String = ""
        get_risk(): int

    machine:
        $Anonymous {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) {
                this.user_id = user_id;
                this.device_id = device_id;
                this.bound_channel = channel_id;
                -> $Authenticating
            }
            get_status(): String { @@:("anonymous") }
            get_risk(): int { @@:(this.current_risk) }
        }

        $Authenticating {
            auth_result(passed: int, risk_score: int) {
                if (passed == 0) {
                    -> $Anonymous
                } else if (risk_score > this.high_risk_threshold) {
                    -> $StepUpRequired
                } else {
                    this.current_risk = risk_score;
                    -> $FullAccess
                }
            }
            get_status(): String { @@:("authenticating") }
            get_risk(): int { @@:(this.current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) { -> $Authenticating }
            request_resource(resource: String, channel_id: String, policy_ok: int): String { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): String { @@:("step_up_required") }
            get_risk(): int { @@:(this.current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): int { @@:(this.current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: int): String {
                if (channel_id != this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: int) {
                if (score < this.min_posture) {
                    -> $Degraded
                }
            }
            risk_signal_update(score: int) {
                this.current_risk = score;
                if (score > this.block_threshold) {
                    -> $Terminated
                } else if (score > this.high_risk_threshold) {
                    -> $Degraded
                }
            }
            get_status(): String { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: int): String {
                if (channel_id != this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: int) {
                this.current_risk = score;
                if (score > this.block_threshold) {
                    -> $Terminated
                }
            }
            posture_update(score: int) {
                if (score >= this.min_posture) {
                    -> $FullAccess
                }
            }
            get_status(): String { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): String { @@:("terminated") }
            get_risk(): int { @@:(this.current_risk) }
        }

    domain:
        user_id: String = ""
        device_id: String = ""
        bound_channel: String = ""
        current_risk: int = 0
        high_risk_threshold: int = 70
        block_threshold: int = 90
        min_posture: int = 60
}

void cks(String label, String actual, String expected) {
    if (actual != expected) { print("FAIL: $label expected '$expected', got '$actual'"); exit(1); }
}
void cki(String label, int actual, int expected) {
    if (actual != expected) { print("FAIL: $label expected $expected, got $actual"); exit(1); }
}

void main() {
    var s = @@ZeroTrustSession();
    cks("anonymous", s.get_status(), "anonymous");
    cks("anon denied", s.request_resource("doc", "ch1", 1), "denied");
    s.authenticate("alice", "dev-1", "ch-A", "totp");
    cks("authenticating", s.get_status(), "authenticating");
    cks("authing denied", s.request_resource("doc", "ch-A", 1), "denied");
    s.auth_result(1, 30);
    cks("full access", s.get_status(), "full_access");
    cki("risk recorded", s.get_risk(), 30);
    cks("match ok", s.request_resource("doc", "ch-A", 1), "allowed");
    cks("policy denied", s.request_resource("doc", "ch-A", 0), "denied_policy");
    s.channel_binding_mismatch();
    cks("hijack -> terminated", s.get_status(), "terminated");
    cks("terminated denies", s.request_resource("doc", "ch-A", 1), "denied");

    var s2 = @@ZeroTrustSession();
    s2.authenticate("bob", "dev-2", "ch-B", "totp");
    s2.auth_result(1, 20);
    cks("mismatch denied", s2.request_resource("doc", "ch-WRONG", 1), "denied_channel");
    cks("mismatch terminates", s2.get_status(), "terminated");

    var s3 = @@ZeroTrustSession();
    s3.authenticate("carol", "dev-3", "ch-C", "totp");
    s3.auth_result(1, 85);
    cks("step up", s3.get_status(), "step_up_required");
    cks("step-up denies resource", s3.request_resource("doc", "ch-C", 1), "denied_stepup");
    s3.authenticate("carol", "dev-3", "ch-C", "u2f");
    cks("re-authing", s3.get_status(), "authenticating");
    s3.auth_result(1, 30);
    cks("full access after step-up", s3.get_status(), "full_access");

    var s4 = @@ZeroTrustSession();
    s4.authenticate("dave", "dev-4", "ch-D", "totp");
    s4.auth_result(1, 20);
    s4.posture_update(50);
    cks("posture degrade", s4.get_status(), "degraded");
    cks("degraded + allowed", s4.request_resource("doc", "ch-D", 1), "allowed_low_trust");
    cks("degraded + denied", s4.request_resource("doc", "ch-D", 0), "denied_low_trust");
    s4.posture_update(80);
    cks("posture restored", s4.get_status(), "full_access");
    s4.risk_signal_update(95);
    cks("risk block -> terminated", s4.get_status(), "terminated");

    var s5 = @@ZeroTrustSession();
    s5.authenticate("eve", "dev-5", "ch-E", "totp");
    s5.auth_result(1, 20);
    s5.risk_signal_update(75);
    cks("risk degrade", s5.get_status(), "degraded");

    var s6 = @@ZeroTrustSession();
    s6.authenticate("fred", "dev-6", "ch-F", "totp");
    s6.auth_result(1, 20);
    s6.logout();
    cks("logout -> anonymous", s6.get_status(), "anonymous");

    var s7 = @@ZeroTrustSession();
    s7.authenticate("greg", "dev-7", "ch-G", "totp");
    s7.auth_result(1, 20);
    s7.session_heartbeat();
    cks("heartbeat noop", s7.get_status(), "full_access");

    print("PASS: zero_trust");
}
