@@[target("swift")]

// Cookbook 93: Macaroon-Style Capability Token Verifier

import Foundation

@@system MacaroonVerifier {
    interface:
        present(token: String, caveat_count: Int)
        caveat_verified(passed: Int, caveat_index: Int)
        sig_verified(passed: Int)
        perform(action: String, resource: String, allowed: Int): String = "denied"
        get_status(): String = ""
        get_caveat_index(): Int

    machine:
        $Idle {
            present(token: String, caveat_count: Int) {
                self.token = token
                self.caveats = caveat_count
                self.caveat_index = 0
                -> $CheckingSignature
            }
            get_status(): String { @@:("idle") }
            get_caveat_index(): Int { @@:(self.caveat_index) }
        }

        $CheckingSignature {
            sig_verified(passed: Int) {
                if passed == 1 { -> $CheckingCaveats } else { -> $Rejected }
            }
            get_status(): String { @@:("checking_sig") }
            get_caveat_index(): Int { @@:(self.caveat_index) }
        }

        $CheckingCaveats {
            $>() {
                if self.caveat_index >= self.caveats { -> $Authorized }
            }
            caveat_verified(passed: Int, caveat_index: Int) {
                if caveat_index != self.caveat_index {
                    -> $Rejected
                } else if passed == 0 {
                    -> $Rejected
                } else {
                    self.caveat_index = self.caveat_index + 1
                    -> $CheckingCaveats
                }
            }
            get_status(): String { @@:("checking_caveats") }
            get_caveat_index(): Int { @@:(self.caveat_index) }
        }

        $Authorized {
            perform(action: String, resource: String, allowed: Int): String {
                if allowed == 1 { @@:("allowed") } else { @@:("denied") }
            }
            get_status(): String { @@:("authorized") }
            get_caveat_index(): Int { @@:(self.caveat_index) }
        }

        $Rejected {
            get_status(): String { @@:("rejected") }
            get_caveat_index(): Int { @@:(self.caveat_index) }
        }

    domain:
        token: String = ""
        caveats: Int = 0
        caveat_index: Int = 0
}

func check(_ label: String, _ actual: String, _ expected: String) {
    if actual != expected { print("FAIL: \(label) expected '\(expected)', got '\(actual)'"); exit(1) }
}
func checkI(_ label: String, _ actual: Int, _ expected: Int) {
    if actual != expected { print("FAIL: \(label) expected \(expected), got \(actual)"); exit(1) }
}

let v = @@MacaroonVerifier()
check("idle", v.get_status() as! String, "idle")
check("idle perform denied", v.perform(action: "read", resource: "doc", allowed: 1) as! String, "denied")
v.present(token: "TOK", caveat_count: 3)
check("checking sig", v.get_status() as! String, "checking_sig")
check("sig-check perform denied", v.perform(action: "read", resource: "doc", allowed: 1) as! String, "denied")
v.sig_verified(passed: 1)
check("checking caveats", v.get_status() as! String, "checking_caveats")
check("caveat-check perform denied", v.perform(action: "read", resource: "doc", allowed: 1) as! String, "denied")
v.caveat_verified(passed: 1, caveat_index: 0)
checkI("caveat 0 done, index advanced", v.get_caveat_index() as! Int, 1)
v.caveat_verified(passed: 1, caveat_index: 1)
v.caveat_verified(passed: 1, caveat_index: 2)
check("authorized", v.get_status() as! String, "authorized")
check("in-scope perform", v.perform(action: "read", resource: "doc", allowed: 1) as! String, "allowed")
check("out-of-scope perform", v.perform(action: "write", resource: "doc", allowed: 0) as! String, "denied")
v.caveat_verified(passed: 1, caveat_index: 99)
check("authorized absorbs caveat", v.get_status() as! String, "authorized")

let v2 = @@MacaroonVerifier()
v2.present(token: "TOK", caveat_count: 2)
v2.sig_verified(passed: 0)
check("sig failed", v2.get_status() as! String, "rejected")
check("rejected denies perform", v2.perform(action: "read", resource: "doc", allowed: 1) as! String, "denied")

let v3 = @@MacaroonVerifier()
v3.present(token: "TOK", caveat_count: 3)
v3.sig_verified(passed: 1)
v3.caveat_verified(passed: 1, caveat_index: 0)
v3.caveat_verified(passed: 0, caveat_index: 1)
check("caveat failed -> rejected", v3.get_status() as! String, "rejected")

let v4 = @@MacaroonVerifier()
v4.present(token: "TOK", caveat_count: 3)
v4.sig_verified(passed: 1)
v4.caveat_verified(passed: 1, caveat_index: 0)
v4.caveat_verified(passed: 1, caveat_index: 2)
check("out-of-order -> rejected", v4.get_status() as! String, "rejected")

let v5 = @@MacaroonVerifier()
v5.present(token: "TOK", caveat_count: 0)
v5.sig_verified(passed: 1)
check("no caveats -> authorized", v5.get_status() as! String, "authorized")

print("PASS: macaroon")
