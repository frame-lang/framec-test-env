@@[target("go")]

// Cookbook 89: MFA with Lockout

package main

import (
    "fmt"
    "os"
)

@@system MfaAuth {
    interface:
        submit_username(u: string)
        submit_password(p: string)
        submit_second_factor(code: string)
        cooldown_elapsed()
        logout()
        get_status(): string = ""
        get_failures(): int

    machine:
        $Idle {
            submit_username(u: string) {
                s.username = u
                -> $AwaitingPassword
            }
            get_status(): string { @@:("idle") }
            get_failures(): int { @@:(s.failures) }
        }

        $AwaitingPassword {
            submit_password(p: string) {
                if s.username == "alice" && p == "hunter2" {
                    -> $AwaitingSecondFactor
                } else {
                    s.failures = s.failures + 1
                    if s.failures >= s.lockout_threshold {
                        -> $Locked
                    }
                }
            }
            get_status(): string { @@:("awaiting_password") }
            get_failures(): int { @@:(s.failures) }
        }

        $AwaitingSecondFactor {
            $.attempts: int = 0

            submit_second_factor(code: string) {
                $.attempts = $.attempts + 1
                if code == "123456" {
                    s.failures = 0
                    -> $Authenticated
                } else if $.attempts >= 3 {
                    s.failures = s.failures + 1
                    if s.failures >= s.lockout_threshold {
                        -> $Locked
                    } else {
                        -> $AwaitingPassword
                    }
                }
            }
            get_status(): string { @@:("awaiting_2fa") }
            get_failures(): int { @@:(s.failures) }
        }

        $Authenticated {
            logout() { -> $Idle }
            get_status(): string { @@:("authenticated") }
            get_failures(): int { @@:(s.failures) }
        }

        $Locked {
            cooldown_elapsed() {
                s.failures = s.lockout_threshold - 1
                -> $Idle
            }
            get_status(): string { @@:("locked") }
            get_failures(): int { @@:(s.failures) }
        }

    domain:
        username: string = ""
        failures: int = 0
        lockout_threshold: int = 5
}

func check(label, actual, expected string) {
    if actual != expected { fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual); os.Exit(1) }
}
func checkI(label string, actual, expected int) {
    if actual != expected { fmt.Printf("FAIL: %s expected %d, got %d\n", label, expected, actual); os.Exit(1) }
}

func main() {
    m := @@MfaAuth()
    check("idle", m.get_status().(string), "idle")
    m.submit_second_factor("123456")
    check("idle absorbs 2fa", m.get_status().(string), "idle")
    m.submit_username("alice")
    check("awaiting password", m.get_status().(string), "awaiting_password")
    m.submit_second_factor("123456")
    check("awaiting_password absorbs 2fa", m.get_status().(string), "awaiting_password")
    m.submit_password("hunter2")
    check("awaiting 2fa", m.get_status().(string), "awaiting_2fa")
    checkI("no failures on correct password", m.get_failures().(int), 0)
    m.submit_second_factor("123456")
    check("authenticated", m.get_status().(string), "authenticated")
    checkI("failure counter reset on success", m.get_failures().(int), 0)
    m.logout()
    check("logged out", m.get_status().(string), "idle")

    m2 := @@MfaAuth()
    m2.submit_username("alice")
    m2.submit_password("wrong")
    checkI("1 failure", m2.get_failures().(int), 1)
    check("still awaiting password", m2.get_status().(string), "awaiting_password")
    m2.submit_password("wrong")
    m2.submit_password("wrong")
    m2.submit_password("wrong")
    checkI("4 failures", m2.get_failures().(int), 4)
    m2.submit_password("wrong")
    check("locked", m2.get_status().(string), "locked")
    checkI("5 failures", m2.get_failures().(int), 5)
    m2.submit_username("alice")
    m2.submit_password("hunter2")
    m2.submit_second_factor("123456")
    check("locked absorbs all", m2.get_status().(string), "locked")
    m2.cooldown_elapsed()
    check("back to idle after cooldown", m2.get_status().(string), "idle")
    checkI("partial reset to threshold-1", m2.get_failures().(int), 4)

    m3 := @@MfaAuth()
    m3.submit_username("alice")
    m3.submit_password("hunter2")
    check("2fa active", m3.get_status().(string), "awaiting_2fa")
    m3.submit_second_factor("bad1")
    check("2fa after 1 wrong still active", m3.get_status().(string), "awaiting_2fa")
    m3.submit_second_factor("bad2")
    m3.submit_second_factor("bad3")
    check("2fa gave up", m3.get_status().(string), "awaiting_password")
    checkI("one failure bumped", m3.get_failures().(int), 1)
    m3.submit_password("hunter2")
    m3.submit_second_factor("bad")
    check("new session, new attempts counter", m3.get_status().(string), "awaiting_2fa")

    fmt.Println("PASS: mfa_lockout")
}
