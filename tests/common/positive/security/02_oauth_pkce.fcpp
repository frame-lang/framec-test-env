@@[target("cpp")]

// Cookbook 87: OAuth 2.0 Authorization Code + PKCE

@@system OAuthPkceFlow {
    interface:
        start(client_id: std::string, redirect_uri: std::string, scope: std::string, nonce: std::string)
        authorization_redirect(code: std::string, state: std::string)
        exchange_response(access_token: std::string, refresh_token: std::string)
        exchange_error(reason: std::string)
        use_token(): std::string = std::string("no_token")
        refresh()
        revoke()
        timeout()
        get_status(): std::string = std::string("idle")
        get_auth_code(): std::string
        get_code_verifier(): std::string

    machine:
        $Idle {
            start(client_id: std::string, redirect_uri: std::string, scope: std::string, nonce: std::string) {
                this->client_id = client_id;
                this->redirect_uri = redirect_uri;
                this->scope = scope;
                this->code_verifier = nonce;
                this->code_challenge = nonce;
                this->state_nonce = nonce;
                -> $AwaitingRedirect
            }
            get_status(): std::string { @@:(std::string("idle")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

        $AwaitingRedirect {
            authorization_redirect(code: std::string, state: std::string) {
                if state != this->state_nonce {
                    -> $Failed
                } else {
                    this->auth_code = code;
                    -> $ExchangingCode
                }
            }
            timeout() { -> $Failed }
            get_status(): std::string { @@:(std::string("awaiting_redirect")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

        $ExchangingCode {
            <$() {
                this->auth_code = std::string("");
                this->code_verifier = std::string("");
            }
            exchange_response(access_token: std::string, refresh_token: std::string) {
                this->access_token = access_token;
                this->refresh_token = refresh_token;
                -> $Authorized
            }
            exchange_error(reason: std::string) { -> $Failed }
            timeout() { -> $Failed }
            get_status(): std::string { @@:(std::string("exchanging")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

        $Authorized {
            use_token(): std::string { @@:(this->access_token) }
            refresh() { -> $Refreshing }
            revoke() { -> $Revoked }
            get_status(): std::string { @@:(std::string("authorized")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

        $Refreshing {
            exchange_response(access_token: std::string, refresh_token: std::string) {
                this->access_token = access_token;
                this->refresh_token = refresh_token;
                -> $Authorized
            }
            exchange_error(reason: std::string) { -> $Failed }
            timeout() { -> $Failed }
            get_status(): std::string { @@:(std::string("refreshing")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

        $Failed {
            get_status(): std::string { @@:(std::string("failed")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

        $Revoked {
            get_status(): std::string { @@:(std::string("revoked")) }
            get_auth_code(): std::string { @@:(this->auth_code) }
            get_code_verifier(): std::string { @@:(this->code_verifier) }
        }

    domain:
        client_id: std::string = std::string("")
        redirect_uri: std::string = std::string("")
        scope: std::string = std::string("")
        code_verifier: std::string = std::string("")
        code_challenge: std::string = std::string("")
        state_nonce: std::string = std::string("")
        auth_code: std::string = std::string("")
        access_token: std::string = std::string("")
        refresh_token: std::string = std::string("")
}

#include <iostream>
#include <string>
#include <cstdlib>

static void ck(const std::string& label, const std::string& actual, const std::string& expected) {
    if (actual != expected) { std::cerr << "FAIL: " << label << " expected '" << expected << "', got '" << actual << "'\n"; std::exit(1); }
}

int main() {
    auto f = @@OAuthPkceFlow();
    ck("idle", f.get_status(), "idle");
    ck("idle use_token default", f.use_token(), "no_token");
    f.start("myclient", "https://app/cb", "read", "nonce123");
    ck("awaiting redirect", f.get_status(), "awaiting_redirect");
    ck("PKCE verifier generated", f.get_code_verifier(), "nonce123");
    ck("use_token still denied", f.use_token(), "no_token");
    f.authorization_redirect("authcode-XYZ", "nonce123");
    ck("exchanging", f.get_status(), "exchanging");
    ck("auth code captured", f.get_auth_code(), "authcode-XYZ");
    f.exchange_response("TOKEN-A", "REFRESH-B");
    ck("authorized", f.get_status(), "authorized");
    ck("token usable", f.use_token(), "TOKEN-A");
    ck("auth_code zeroed", f.get_auth_code(), "");
    ck("code_verifier zeroed", f.get_code_verifier(), "");
    f.authorization_redirect("authcode-XYZ", "nonce123");
    ck("authorized absorbs replay", f.get_status(), "authorized");
    ck("token still usable", f.use_token(), "TOKEN-A");
    f.refresh();
    ck("refreshing", f.get_status(), "refreshing");
    f.exchange_response("TOKEN-A2", "REFRESH-B2");
    ck("authorized post-refresh", f.get_status(), "authorized");
    ck("new token", f.use_token(), "TOKEN-A2");
    f.revoke();
    ck("revoked", f.get_status(), "revoked");
    ck("revoked denies token", f.use_token(), "no_token");

    auto f2 = @@OAuthPkceFlow();
    f2.start("myclient", "https://app/cb", "read", "nonce123");
    f2.authorization_redirect("attacker-code", "WRONG-NONCE");
    ck("CSRF mismatch -> failed", f2.get_status(), "failed");
    ck("CSRF denies token", f2.use_token(), "no_token");

    auto f3 = @@OAuthPkceFlow();
    f3.start("myclient", "https://app/cb", "read", "nonce123");
    f3.timeout();
    ck("timeout failed", f3.get_status(), "failed");

    auto f4 = @@OAuthPkceFlow();
    f4.start("myclient", "https://app/cb", "read", "nonce123");
    f4.authorization_redirect("authcode", "nonce123");
    f4.exchange_error("invalid_grant");
    ck("exchange error failed", f4.get_status(), "failed");
    ck("no token on exchange error", f4.use_token(), "no_token");

    auto f5 = @@OAuthPkceFlow();
    f5.start("myclient", "https://app/cb", "read", "nonce123");
    f5.authorization_redirect("authcode", "nonce123");
    f5.timeout();
    ck("exchange timeout failed", f5.get_status(), "failed");

    auto f6 = @@OAuthPkceFlow();
    f6.start("myclient", "https://app/cb", "read", "nonce123");
    f6.authorization_redirect("authcode", "nonce123");
    f6.exchange_response("TOKEN", "REFRESH");
    f6.refresh();
    f6.exchange_error("invalid_refresh_token");
    ck("refresh error failed", f6.get_status(), "failed");

    std::cout << "PASS: oauth_pkce\n";
    return 0;
}
