@@[target("typescript")]

// Cookbook 93: Macaroon-Style Capability Token Verifier

@@system MacaroonVerifier {
    interface:
        present(token: string, caveat_count: number)
        caveat_verified(passed: number, caveat_index: number)
        sig_verified(passed: number)
        perform(action: string, resource: string, allowed: number): string = "denied"
        get_status(): string = ""
        get_caveat_index(): number

    machine:
        $Idle {
            present(token: string, caveat_count: number) {
                this.token = token;
                this.caveats = caveat_count;
                this.caveat_index = 0;
                -> $CheckingSignature
            }
            get_status(): string { @@:("idle") }
            get_caveat_index(): number { @@:(this.caveat_index) }
        }

        $CheckingSignature {
            sig_verified(passed: number) {
                if (passed == 1) { -> $CheckingCaveats } else { -> $Rejected }
            }
            get_status(): string { @@:("checking_sig") }
            get_caveat_index(): number { @@:(this.caveat_index) }
        }

        $CheckingCaveats {
            $>() {
                if (this.caveat_index >= this.caveats) { -> $Authorized }
            }
            caveat_verified(passed: number, caveat_index: number) {
                if (caveat_index !== this.caveat_index) {
                    -> $Rejected
                } else if (passed == 0) {
                    -> $Rejected
                } else {
                    this.caveat_index = this.caveat_index + 1;
                    -> $CheckingCaveats
                }
            }
            get_status(): string { @@:("checking_caveats") }
            get_caveat_index(): number { @@:(this.caveat_index) }
        }

        $Authorized {
            perform(action: string, resource: string, allowed: number): string {
                if (allowed == 1) { @@:("allowed") } else { @@:("denied") }
            }
            get_status(): string { @@:("authorized") }
            get_caveat_index(): number { @@:(this.caveat_index) }
        }

        $Rejected {
            get_status(): string { @@:("rejected") }
            get_caveat_index(): number { @@:(this.caveat_index) }
        }

    domain:
        token: string = ""
        caveats: number = 0
        caveat_index: number = 0
}

function check(label: string, actual: any, expected: any): void {
    if (actual !== expected) { console.log("FAIL: " + label + " expected '" + expected + "', got '" + actual + "'"); process.exit(1); }
}

const v = @@MacaroonVerifier();
check("idle", v.get_status(), "idle");
check("idle perform denied", v.perform("read", "doc", 1), "denied");
v.present("TOK", 3);
check("checking sig", v.get_status(), "checking_sig");
check("sig-check perform denied", v.perform("read", "doc", 1), "denied");
v.sig_verified(1);
check("checking caveats", v.get_status(), "checking_caveats");
check("caveat-check perform denied", v.perform("read", "doc", 1), "denied");
v.caveat_verified(1, 0);
check("caveat 0 done, index advanced", v.get_caveat_index(), 1);
v.caveat_verified(1, 1);
v.caveat_verified(1, 2);
check("authorized", v.get_status(), "authorized");
check("in-scope perform", v.perform("read", "doc", 1), "allowed");
check("out-of-scope perform", v.perform("write", "doc", 0), "denied");
v.caveat_verified(1, 99);
check("authorized absorbs caveat", v.get_status(), "authorized");

const v2 = @@MacaroonVerifier();
v2.present("TOK", 2);
v2.sig_verified(0);
check("sig failed", v2.get_status(), "rejected");
check("rejected denies perform", v2.perform("read", "doc", 1), "denied");

const v3 = @@MacaroonVerifier();
v3.present("TOK", 3);
v3.sig_verified(1);
v3.caveat_verified(1, 0);
v3.caveat_verified(0, 1);
check("caveat failed -> rejected", v3.get_status(), "rejected");

const v4 = @@MacaroonVerifier();
v4.present("TOK", 3);
v4.sig_verified(1);
v4.caveat_verified(1, 0);
v4.caveat_verified(1, 2);
check("out-of-order -> rejected", v4.get_status(), "rejected");

const v5 = @@MacaroonVerifier();
v5.present("TOK", 0);
v5.sig_verified(1);
check("no caveats -> authorized", v5.get_status(), "authorized");

console.log("PASS: macaroon");
