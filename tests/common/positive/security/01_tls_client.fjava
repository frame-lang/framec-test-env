@@[target("java")]

// Cookbook 86: TLS 1.3 Handshake (Client Side)

@@system TlsClient {
    interface:
        connect(server_name: String)
        server_hello_received(supported_versions_ext: int, downgrade_flag: int, cipher: String)
        encrypted_extensions_received()
        certificate_received(cert_valid: int)
        cert_verify_received(sig_valid: int)
        server_finished_received(mac_valid: int)
        send_app_data(data: String): String = "not_ready"
        close()
        timeout()
        get_status(): String = "idle"

    machine:
        $Idle {
            connect(server_name: String) {
                this.server_name = server_name;
                -> $WaitingServerHello
            }
            get_status(): String { @@:("idle") }
        }

        $WaitingServerHello {
            server_hello_received(supported_versions_ext: int, downgrade_flag: int, cipher: String) {
                if (supported_versions_ext != 772) { -> $Aborted }
                else if (downgrade_flag != 0) { -> $Aborted }
                else if (cipher.equals("RC4")) { -> $Aborted }
                else { -> $WaitingEncryptedExtensions }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting server_hello") }
        }

        $WaitingEncryptedExtensions {
            encrypted_extensions_received() { -> $WaitingCertificate }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting ee") }
        }

        $WaitingCertificate {
            certificate_received(cert_valid: int) {
                if (cert_valid == 1) { -> $WaitingCertVerify } else { -> $Aborted }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting cert") }
        }

        $WaitingCertVerify {
            cert_verify_received(sig_valid: int) {
                if (sig_valid == 1) { -> $WaitingServerFinished } else { -> $Aborted }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting cert_verify") }
        }

        $WaitingServerFinished {
            server_finished_received(mac_valid: int) {
                if (mac_valid == 1) { -> $Established } else { -> $Aborted }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting server_finished") }
        }

        $Established {
            send_app_data(data: String): String { @@:("sent") }
            close() { -> $Closed }
            get_status(): String { @@:("established") }
        }

        $Aborted {
            get_status(): String { @@:("aborted") }
        }

        $Closed {
            get_status(): String { @@:("closed") }
        }

    domain:
        server_name: String = ""
}

public class TlsClient01Test {
    static void check(String label, String actual, String expected) {
        if (!actual.equals(expected)) {
            System.out.println("FAIL: " + label + " expected '" + expected + "', got '" + actual + "'");
            System.exit(1);
        }
    }

    public static void main(String[] args) {
        TlsClient c = @@TlsClient();
        check("start idle", (String) c.get_status(), "idle");
        check("idle app_data denied", (String) c.send_app_data("hello"), "not_ready");
        c.connect("example.com");
        check("waiting SH", (String) c.get_status(), "waiting server_hello");
        check("waiting SH app_data denied", (String) c.send_app_data("hello"), "not_ready");
        c.server_hello_received(772, 0, "AES-GCM");
        check("waiting EE", (String) c.get_status(), "waiting ee");
        check("waiting EE app_data denied", (String) c.send_app_data("hello"), "not_ready");
        c.encrypted_extensions_received();
        check("waiting cert", (String) c.get_status(), "waiting cert");
        c.certificate_received(1);
        check("waiting cert_verify", (String) c.get_status(), "waiting cert_verify");
        c.cert_verify_received(1);
        check("waiting finished", (String) c.get_status(), "waiting server_finished");
        check("still denied pre-finished", (String) c.send_app_data("hello"), "not_ready");
        c.server_finished_received(1);
        check("established", (String) c.get_status(), "established");
        check("app_data allowed", (String) c.send_app_data("hello"), "sent");
        c.close();
        check("closed", (String) c.get_status(), "closed");
        check("closed denies app_data", (String) c.send_app_data("hello"), "not_ready");

        TlsClient c2 = @@TlsClient();
        c2.connect("example.com");
        c2.server_hello_received(772, 1, "AES-GCM");
        check("downgrade aborts", (String) c2.get_status(), "aborted");
        check("aborted denies app_data", (String) c2.send_app_data("hello"), "not_ready");

        TlsClient c3 = @@TlsClient();
        c3.connect("example.com");
        c3.server_hello_received(771, 0, "AES-GCM");
        check("version mismatch aborts", (String) c3.get_status(), "aborted");

        TlsClient c4 = @@TlsClient();
        c4.connect("example.com");
        c4.server_hello_received(772, 0, "RC4");
        check("weak cipher aborts", (String) c4.get_status(), "aborted");

        TlsClient c5 = @@TlsClient();
        c5.connect("example.com");
        c5.server_hello_received(772, 0, "AES-GCM");
        c5.encrypted_extensions_received();
        c5.certificate_received(0);
        check("cert fail aborts", (String) c5.get_status(), "aborted");

        TlsClient c6 = @@TlsClient();
        c6.connect("example.com");
        c6.server_hello_received(772, 0, "AES-GCM");
        c6.encrypted_extensions_received();
        c6.certificate_received(1);
        c6.cert_verify_received(0);
        check("sig fail aborts", (String) c6.get_status(), "aborted");

        TlsClient c7 = @@TlsClient();
        c7.connect("example.com");
        c7.server_hello_received(772, 0, "AES-GCM");
        c7.encrypted_extensions_received();
        c7.certificate_received(1);
        c7.cert_verify_received(1);
        c7.server_finished_received(0);
        check("mac fail aborts", (String) c7.get_status(), "aborted");
        check("failed mac denies app_data", (String) c7.send_app_data("hello"), "not_ready");

        TlsClient c8 = @@TlsClient();
        c8.connect("example.com");
        c8.timeout();
        check("timeout from SH", (String) c8.get_status(), "aborted");

        TlsClient c9 = @@TlsClient();
        c9.connect("example.com");
        c9.server_hello_received(772, 0, "AES-GCM");
        c9.timeout();
        check("timeout from EE", (String) c9.get_status(), "aborted");

        System.out.println("PASS: tls_client");
    }
}
