@@[target("cpp")]

// Cookbook 90: Kerberos Ticket Lifecycle (HSM)

@@system KerberosClient {
    interface:
        authenticate(user: std::string, password: std::string)
        preauth_accepted(tgt: std::string, session_key: std::string, expiry: int)
        preauth_rejected(reason: std::string)
        request_service(spn: std::string)
        service_ticket_received(st: std::string, expiry: int)
        service_ticket_rejected(reason: std::string)
        tick(now: int)
        logout()
        get_status(): std::string = ""
        get_tgt(): std::string
        get_service_ticket(): std::string

    machine:
        $Idle {
            authenticate(user: std::string, password: std::string) {
                this->user = user;
                -> $AwaitingTgt
            }
            get_status(): std::string { @@:("idle") }
            get_tgt(): std::string { @@:(this->tgt) }
            get_service_ticket(): std::string { @@:(this->service_ticket) }
        }

        $AwaitingTgt {
            preauth_accepted(tgt: std::string, session_key: std::string, expiry: int) {
                this->tgt = tgt;
                this->session_key = session_key;
                this->tgt_expiry = expiry;
                -> $HasTgt
            }
            preauth_rejected(reason: std::string) { -> $Failed }
            get_status(): std::string { @@:("awaiting_tgt") }
            get_tgt(): std::string { @@:(this->tgt) }
            get_service_ticket(): std::string { @@:(this->service_ticket) }
        }

        $HasValidTgt {
            tick(now: int) {
                if (now >= this->tgt_expiry) {
                    this->tgt = "";
                    this->session_key = "";
                    this->tgt_expiry = 0;
                    this->service_ticket = "";
                    this->st_expiry = 0;
                    -> $Idle
                }
            }
            logout() {
                this->tgt = "";
                this->session_key = "";
                this->tgt_expiry = 0;
                this->service_ticket = "";
                this->st_expiry = 0;
                -> $Idle
            }
            get_tgt(): std::string { @@:(this->tgt) }
            get_service_ticket(): std::string { @@:(this->service_ticket) }
        }

        $HasTgt => $HasValidTgt {
            request_service(spn: std::string) { -> $AwaitingServiceTicket }
            get_status(): std::string { @@:("has_tgt") }
            => $^
        }

        $AwaitingServiceTicket => $HasValidTgt {
            service_ticket_received(st: std::string, expiry: int) {
                this->service_ticket = st;
                this->st_expiry = expiry;
                -> $HasServiceTicket
            }
            service_ticket_rejected(reason: std::string) { -> $HasTgt }
            get_status(): std::string { @@:("awaiting_st") }
            => $^
        }

        $HasServiceTicket => $HasValidTgt {
            tick(now: int) {
                if (now >= this->tgt_expiry) {
                    this->tgt = "";
                    this->session_key = "";
                    this->tgt_expiry = 0;
                    this->service_ticket = "";
                    this->st_expiry = 0;
                    -> $Idle
                } else if (now >= this->st_expiry) {
                    this->service_ticket = "";
                    -> $HasTgt
                }
            }
            request_service(spn: std::string) { -> $AwaitingServiceTicket }
            get_status(): std::string { @@:("has_st") }
            => $^
        }

        $Failed {
            get_status(): std::string { @@:("failed") }
            get_tgt(): std::string { @@:(this->tgt) }
            get_service_ticket(): std::string { @@:(this->service_ticket) }
        }

    domain:
        user: std::string = ""
        tgt: std::string = ""
        session_key: std::string = ""
        tgt_expiry: int = 0
        service_ticket: std::string = ""
        st_expiry: int = 0
}

#include <iostream>
#include <cstdlib>

static void check(const std::string& label, const std::string& actual, const std::string& expected) {
    if (actual != expected) { std::cerr << "FAIL: " << label << " expected '" << expected << "', got '" << actual << "'\n"; std::exit(1); }
}

int main() {
    auto k = @@KerberosClient();
    check("idle", k.get_status(), "idle");
    k.request_service("HTTP/web");
    check("idle absorbs request_service", k.get_status(), "idle");
    check("no service ticket in idle", k.get_service_ticket(), "");
    k.authenticate("alice", "pw");
    check("awaiting tgt", k.get_status(), "awaiting_tgt");
    k.request_service("HTTP/web");
    check("awaiting absorbs request_service", k.get_status(), "awaiting_tgt");
    k.preauth_accepted("TGT-abc", "K-123", 100);
    check("has tgt", k.get_status(), "has_tgt");
    check("tgt stored", k.get_tgt(), "TGT-abc");
    k.tick(50);
    check("still has tgt pre-expiry", k.get_status(), "has_tgt");
    k.request_service("HTTP/web");
    check("awaiting st", k.get_status(), "awaiting_st");
    k.service_ticket_received("ST-xyz", 80);
    check("has st", k.get_status(), "has_st");
    check("st stored", k.get_service_ticket(), "ST-xyz");
    k.tick(85);
    check("ST expired -> has_tgt", k.get_status(), "has_tgt");
    check("st cleared", k.get_service_ticket(), "");
    check("tgt still there", k.get_tgt(), "TGT-abc");
    k.request_service("HTTP/web");
    k.service_ticket_received("ST-2", 95);
    check("has st 2", k.get_status(), "has_st");
    k.tick(100);
    check("tgt expired -> idle", k.get_status(), "idle");
    check("tgt zeroed", k.get_tgt(), "");
    check("st zeroed", k.get_service_ticket(), "");

    auto k2 = @@KerberosClient();
    k2.authenticate("alice", "pw");
    k2.preauth_accepted("TGT-xx", "K-yy", 200);
    k2.logout();
    check("logout from has_tgt -> idle", k2.get_status(), "idle");
    check("logout cleared tgt", k2.get_tgt(), "");

    auto k3 = @@KerberosClient();
    k3.authenticate("alice", "pw");
    k3.preauth_accepted("TGT-1", "K-1", 500);
    k3.request_service("spn");
    k3.service_ticket_received("ST-1", 300);
    k3.logout();
    check("logout from has_st -> idle", k3.get_status(), "idle");
    check("logout cleared st", k3.get_service_ticket(), "");

    auto k4 = @@KerberosClient();
    k4.authenticate("bob", "wrong");
    k4.preauth_rejected("invalid_password");
    check("preauth rejected", k4.get_status(), "failed");

    auto k5 = @@KerberosClient();
    k5.authenticate("alice", "pw");
    k5.preauth_accepted("TGT-q", "K-q", 500);
    k5.request_service("deny_me");
    k5.service_ticket_rejected("no_access");
    check("st rejected -> has_tgt", k5.get_status(), "has_tgt");
    check("tgt retained", k5.get_tgt(), "TGT-q");

    std::cout << "PASS: kerberos\n";
    return 0;
}
