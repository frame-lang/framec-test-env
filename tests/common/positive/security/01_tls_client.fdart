@@[target("dart")]

// Cookbook 86: TLS 1.3 Handshake (Client Side)

import 'dart:io';

@@system TlsClient {
    interface:
        connect(server_name: String)
        server_hello_received(supported_versions_ext: int, downgrade_flag: int, cipher: String)
        encrypted_extensions_received()
        certificate_received(cert_valid: int)
        cert_verify_received(sig_valid: int)
        server_finished_received(mac_valid: int)
        send_app_data(data: String): String = "not_ready"
        close()
        timeout()
        get_status(): String = "idle"

    machine:
        $Idle {
            connect(server_name: String) {
                this.server_name = server_name;
                -> $WaitingServerHello
            }
            get_status(): String { @@:("idle") }
        }

        $WaitingServerHello {
            server_hello_received(supported_versions_ext: int, downgrade_flag: int, cipher: String) {
                if (supported_versions_ext != 772) {
                    -> $Aborted
                } else if (downgrade_flag != 0) {
                    -> $Aborted
                } else if (cipher == "RC4") {
                    -> $Aborted
                } else {
                    -> $WaitingEncryptedExtensions
                }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting server_hello") }
        }

        $WaitingEncryptedExtensions {
            encrypted_extensions_received() { -> $WaitingCertificate }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting ee") }
        }

        $WaitingCertificate {
            certificate_received(cert_valid: int) {
                if (cert_valid == 1) {
                    -> $WaitingCertVerify
                } else {
                    -> $Aborted
                }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting cert") }
        }

        $WaitingCertVerify {
            cert_verify_received(sig_valid: int) {
                if (sig_valid == 1) {
                    -> $WaitingServerFinished
                } else {
                    -> $Aborted
                }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting cert_verify") }
        }

        $WaitingServerFinished {
            server_finished_received(mac_valid: int) {
                if (mac_valid == 1) {
                    -> $Established
                } else {
                    -> $Aborted
                }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("waiting server_finished") }
        }

        $Established {
            send_app_data(data: String): String { @@:("sent") }
            close() { -> $Closed }
            get_status(): String { @@:("established") }
        }

        $Aborted {
            get_status(): String { @@:("aborted") }
        }

        $Closed {
            get_status(): String { @@:("closed") }
        }

    domain:
        server_name: String = ""
}

void ck(String label, String actual, String expected) {
    if (actual != expected) { print("FAIL: $label expected '$expected', got '$actual'"); exit(1); }
}

void main() {
    var c = @@TlsClient();
    ck("start idle", c.get_status(), "idle");
    ck("idle app_data denied", c.send_app_data("hello"), "not_ready");
    c.connect("example.com");
    ck("waiting SH", c.get_status(), "waiting server_hello");
    ck("waiting SH app_data denied", c.send_app_data("hello"), "not_ready");
    c.server_hello_received(772, 0, "AES-GCM");
    ck("waiting EE", c.get_status(), "waiting ee");
    ck("waiting EE app_data denied", c.send_app_data("hello"), "not_ready");
    c.encrypted_extensions_received();
    ck("waiting cert", c.get_status(), "waiting cert");
    c.certificate_received(1);
    ck("waiting cert_verify", c.get_status(), "waiting cert_verify");
    c.cert_verify_received(1);
    ck("waiting finished", c.get_status(), "waiting server_finished");
    ck("still denied pre-finished", c.send_app_data("hello"), "not_ready");
    c.server_finished_received(1);
    ck("established", c.get_status(), "established");
    ck("app_data allowed", c.send_app_data("hello"), "sent");
    c.close();
    ck("closed", c.get_status(), "closed");
    ck("closed denies app_data", c.send_app_data("hello"), "not_ready");

    var c2 = @@TlsClient();
    c2.connect("example.com");
    c2.server_hello_received(772, 1, "AES-GCM");
    ck("downgrade aborts", c2.get_status(), "aborted");
    ck("aborted denies app_data", c2.send_app_data("hello"), "not_ready");

    var c3 = @@TlsClient();
    c3.connect("example.com");
    c3.server_hello_received(771, 0, "AES-GCM");
    ck("version mismatch aborts", c3.get_status(), "aborted");

    var c4 = @@TlsClient();
    c4.connect("example.com");
    c4.server_hello_received(772, 0, "RC4");
    ck("weak cipher aborts", c4.get_status(), "aborted");

    var c5 = @@TlsClient();
    c5.connect("example.com");
    c5.server_hello_received(772, 0, "AES-GCM");
    c5.encrypted_extensions_received();
    c5.certificate_received(0);
    ck("cert fail aborts", c5.get_status(), "aborted");

    var c6 = @@TlsClient();
    c6.connect("example.com");
    c6.server_hello_received(772, 0, "AES-GCM");
    c6.encrypted_extensions_received();
    c6.certificate_received(1);
    c6.cert_verify_received(0);
    ck("sig fail aborts", c6.get_status(), "aborted");

    var c7 = @@TlsClient();
    c7.connect("example.com");
    c7.server_hello_received(772, 0, "AES-GCM");
    c7.encrypted_extensions_received();
    c7.certificate_received(1);
    c7.cert_verify_received(1);
    c7.server_finished_received(0);
    ck("mac fail aborts", c7.get_status(), "aborted");
    ck("failed mac denies app_data", c7.send_app_data("hello"), "not_ready");

    var c8 = @@TlsClient();
    c8.connect("example.com");
    c8.timeout();
    ck("timeout from SH", c8.get_status(), "aborted");

    var c9 = @@TlsClient();
    c9.connect("example.com");
    c9.server_hello_received(772, 0, "AES-GCM");
    c9.timeout();
    ck("timeout from EE", c9.get_status(), "aborted");

    print("PASS: tls_client");
}
