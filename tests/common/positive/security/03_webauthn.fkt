@@[target("kotlin")]

// Cookbook 88: WebAuthn / FIDO2

@@system WebAuthnCeremony {
    interface:
        begin_registration(user_id: String, rp_id: String)
        registration_response(chal_ok: Int, origin_ok: Int, att_ok: Int)
        begin_authentication(user_id: String, rp_id: String, uv_required: Int)
        assertion_response(chal_ok: Int, origin_ok: Int, uv_ok: Int, sig_ok: Int, counter_ok: Int)
        timeout()
        get_status(): String = "idle"
        get_user(): String
        get_rp(): String

    machine:
        $Idle {
            begin_registration(user_id: String, rp_id: String) {
                this.user_id = user_id
                this.rp_id = rp_id
                this.uv_required = 1
                -> $AwaitingRegistration
            }
            begin_authentication(user_id: String, rp_id: String, uv_required: Int) {
                this.user_id = user_id
                this.rp_id = rp_id
                this.uv_required = uv_required
                -> $AwaitingAssertion
            }
            get_status(): String { @@:("idle") }
            get_user(): String { @@:(this.user_id) }
            get_rp(): String { @@:(this.rp_id) }
        }

        $AwaitingRegistration {
            registration_response(chal_ok: Int, origin_ok: Int, att_ok: Int) {
                if (chal_ok == 0) { -> $Failed }
                else if (origin_ok == 0) { -> $Failed }
                else if (att_ok == 0) { -> $Failed }
                else { -> $Registered }
            }
            timeout() { -> $Failed }
            get_status(): String { @@:("awaiting_registration") }
            get_user(): String { @@:(this.user_id) }
            get_rp(): String { @@:(this.rp_id) }
        }

        $AwaitingAssertion {
            assertion_response(chal_ok: Int, origin_ok: Int, uv_ok: Int, sig_ok: Int, counter_ok: Int) {
                if (chal_ok == 0) { -> $Failed }
                else if (origin_ok == 0) { -> $Failed }
                else if (this.uv_required == 1 && uv_ok == 0) { -> $Failed }
                else if (sig_ok == 0) { -> $Failed }
                else if (counter_ok == 0) { -> $Failed }
                else { -> $Authenticated }
            }
            timeout() { -> $Failed }
            get_status(): String { @@:("awaiting_assertion") }
            get_user(): String { @@:(this.user_id) }
            get_rp(): String { @@:(this.rp_id) }
        }

        $Registered {
            get_status(): String { @@:("registered") }
            get_user(): String { @@:(this.user_id) }
            get_rp(): String { @@:(this.rp_id) }
        }

        $Authenticated {
            get_status(): String { @@:("authenticated") }
            get_user(): String { @@:(this.user_id) }
            get_rp(): String { @@:(this.rp_id) }
        }

        $Failed {
            get_status(): String { @@:("failed") }
            get_user(): String { @@:(this.user_id) }
            get_rp(): String { @@:(this.rp_id) }
        }

    domain:
        user_id: String = ""
        rp_id: String = ""
        uv_required: Int = 0
}

fun check(label: String, actual: String, expected: String) {
    if (actual != expected) { println("FAIL: $label expected '$expected', got '$actual'"); kotlin.system.exitProcess(1) }
}

fun main() {
    val w = @@WebAuthnCeremony()
    check("idle", w.get_status() as String, "idle")
    w.begin_registration("alice", "example.com")
    check("awaiting registration", w.get_status() as String, "awaiting_registration")
    check("user captured", w.get_user() as String, "alice")
    check("rp captured", w.get_rp() as String, "example.com")
    w.registration_response(1, 1, 1)
    check("registered", w.get_status() as String, "registered")
    w.registration_response(1, 1, 1)
    check("registered absorbs replay", w.get_status() as String, "registered")

    val w2 = @@WebAuthnCeremony()
    w2.begin_registration("bob", "example.com")
    w2.registration_response(0, 1, 1)
    check("reg chal mismatch", w2.get_status() as String, "failed")

    val w3 = @@WebAuthnCeremony()
    w3.begin_registration("carol", "evil.com")
    w3.registration_response(1, 0, 1)
    check("reg origin mismatch", w3.get_status() as String, "failed")

    val w4 = @@WebAuthnCeremony()
    w4.begin_registration("dave", "example.com")
    w4.registration_response(1, 1, 0)
    check("reg attestation failed", w4.get_status() as String, "failed")

    val w5 = @@WebAuthnCeremony()
    w5.begin_registration("eve", "example.com")
    w5.timeout()
    check("reg timeout", w5.get_status() as String, "failed")

    val w6 = @@WebAuthnCeremony()
    w6.begin_authentication("alice", "example.com", 1)
    check("awaiting assertion", w6.get_status() as String, "awaiting_assertion")
    w6.assertion_response(1, 1, 1, 1, 1)
    check("authenticated", w6.get_status() as String, "authenticated")

    val w7 = @@WebAuthnCeremony()
    w7.begin_authentication("alice", "example.com", 1)
    w7.assertion_response(1, 1, 0, 1, 1)
    check("uv gate", w7.get_status() as String, "failed")

    val w8 = @@WebAuthnCeremony()
    w8.begin_authentication("alice", "example.com", 0)
    w8.assertion_response(1, 1, 0, 1, 1)
    check("uv not required", w8.get_status() as String, "authenticated")

    val w9 = @@WebAuthnCeremony()
    w9.begin_authentication("alice", "example.com", 1)
    w9.assertion_response(1, 0, 1, 1, 1)
    check("origin confusion", w9.get_status() as String, "failed")

    val w10 = @@WebAuthnCeremony()
    w10.begin_authentication("alice", "example.com", 1)
    w10.assertion_response(1, 1, 1, 0, 1)
    check("signature fail", w10.get_status() as String, "failed")

    val w11 = @@WebAuthnCeremony()
    w11.begin_authentication("alice", "example.com", 1)
    w11.assertion_response(1, 1, 1, 1, 0)
    check("counter regression", w11.get_status() as String, "failed")

    val w12 = @@WebAuthnCeremony()
    w12.begin_authentication("alice", "example.com", 1)
    w12.assertion_response(0, 1, 1, 1, 1)
    check("challenge replay", w12.get_status() as String, "failed")

    w6.assertion_response(0, 0, 0, 0, 0)
    check("authenticated absorbs replay", w6.get_status() as String, "authenticated")

    println("PASS: webauthn")
}
