@@[target("typescript")]

// Cookbook 94: Zero-Trust Session

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string)
        auth_result(passed: number, risk_score: number)
        request_resource(resource: string, channel_id: string, policy_ok: number): string = "denied"
        posture_update(score: number)
        risk_signal_update(score: number)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): string = ""
        get_risk(): number

    machine:
        $Anonymous {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) {
                this.user_id = user_id;
                this.device_id = device_id;
                this.bound_channel = channel_id;
                -> $Authenticating
            }
            get_status(): string { @@:("anonymous") }
            get_risk(): number { @@:(this.current_risk) }
        }

        $Authenticating {
            auth_result(passed: number, risk_score: number) {
                if (passed == 0) { -> $Anonymous }
                else if (risk_score > this.high_risk_threshold) { -> $StepUpRequired }
                else { this.current_risk = risk_score; -> $FullAccess }
            }
            get_status(): string { @@:("authenticating") }
            get_risk(): number { @@:(this.current_risk) }
        }

        $StepUpRequired {
            authenticate(user_id: string, device_id: string, channel_id: string, mfa_factor: string) { -> $Authenticating }
            request_resource(resource: string, channel_id: string, policy_ok: number): string { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): string { @@:("step_up_required") }
            get_risk(): number { @@:(this.current_risk) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): number { @@:(this.current_risk) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: number): string {
                if (channel_id != this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: number) {
                if (score < this.min_posture) { -> $Degraded }
            }
            risk_signal_update(score: number) {
                this.current_risk = score;
                if (score > this.block_threshold) { -> $Terminated }
                else if (score > this.high_risk_threshold) { -> $Degraded }
            }
            get_status(): string { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: string, channel_id: string, policy_ok: number): string {
                if (channel_id != this.bound_channel) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if (policy_ok == 1) {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: number) {
                this.current_risk = score;
                if (score > this.block_threshold) { -> $Terminated }
            }
            posture_update(score: number) {
                if (score >= this.min_posture) { -> $FullAccess }
            }
            get_status(): string { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): string { @@:("terminated") }
            get_risk(): number { @@:(this.current_risk) }
        }

    domain:
        user_id: string = ""
        device_id: string = ""
        bound_channel: string = ""
        current_risk: number = 0
        high_risk_threshold: number = 70
        block_threshold: number = 90
        min_posture: number = 60
}

function ck(label: string, actual: any, expected: any): void {
    if (actual !== expected) { console.log("FAIL: " + label + " expected '" + expected + "', got '" + actual + "'"); process.exit(1); }
}

const s = @@ZeroTrustSession();
ck("anonymous", s.get_status(), "anonymous");
ck("anon denied", s.request_resource("doc", "ch1", 1), "denied");
s.authenticate("alice", "dev-1", "ch-A", "totp");
ck("authenticating", s.get_status(), "authenticating");
ck("authing denied", s.request_resource("doc", "ch-A", 1), "denied");
s.auth_result(1, 30);
ck("full access", s.get_status(), "full_access");
ck("risk recorded", s.get_risk(), 30);
ck("match ok", s.request_resource("doc", "ch-A", 1), "allowed");
ck("policy denied", s.request_resource("doc", "ch-A", 0), "denied_policy");
s.channel_binding_mismatch();
ck("hijack -> terminated", s.get_status(), "terminated");
ck("terminated denies", s.request_resource("doc", "ch-A", 1), "denied");

const s2 = @@ZeroTrustSession();
s2.authenticate("bob", "dev-2", "ch-B", "totp");
s2.auth_result(1, 20);
ck("mismatch denied", s2.request_resource("doc", "ch-WRONG", 1), "denied_channel");
ck("mismatch terminates", s2.get_status(), "terminated");

const s3 = @@ZeroTrustSession();
s3.authenticate("carol", "dev-3", "ch-C", "totp");
s3.auth_result(1, 85);
ck("step up", s3.get_status(), "step_up_required");
ck("step-up denies resource", s3.request_resource("doc", "ch-C", 1), "denied_stepup");
s3.authenticate("carol", "dev-3", "ch-C", "u2f");
ck("re-authing", s3.get_status(), "authenticating");
s3.auth_result(1, 30);
ck("full access after step-up", s3.get_status(), "full_access");

const s4 = @@ZeroTrustSession();
s4.authenticate("dave", "dev-4", "ch-D", "totp");
s4.auth_result(1, 20);
s4.posture_update(50);
ck("posture degrade", s4.get_status(), "degraded");
ck("degraded + allowed", s4.request_resource("doc", "ch-D", 1), "allowed_low_trust");
ck("degraded + denied", s4.request_resource("doc", "ch-D", 0), "denied_low_trust");
s4.posture_update(80);
ck("posture restored", s4.get_status(), "full_access");
s4.risk_signal_update(95);
ck("risk block -> terminated", s4.get_status(), "terminated");

const s5 = @@ZeroTrustSession();
s5.authenticate("eve", "dev-5", "ch-E", "totp");
s5.auth_result(1, 20);
s5.risk_signal_update(75);
ck("risk degrade", s5.get_status(), "degraded");

const s6 = @@ZeroTrustSession();
s6.authenticate("fred", "dev-6", "ch-F", "totp");
s6.auth_result(1, 20);
s6.logout();
ck("logout -> anonymous", s6.get_status(), "anonymous");

const s7 = @@ZeroTrustSession();
s7.authenticate("greg", "dev-7", "ch-G", "totp");
s7.auth_result(1, 20);
s7.session_heartbeat();
ck("heartbeat noop", s7.get_status(), "full_access");

console.log("PASS: zero_trust");
