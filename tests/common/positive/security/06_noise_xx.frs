@@[target("rust")]

// Cookbook 91: Noise Protocol XX Handshake (Initiator)

@@system NoiseXxInitiator {
    interface:
        start(remote_endpoint: String)
        msg2_received(valid: i32)
        msg3_ack()
        send(plaintext: String): String = String::from("not_ready")
        recv(ciphertext: String): String = String::from("")
        timeout()
        get_status(): String = String::from("idle")

    machine:
        $Idle {
            start(remote_endpoint: String) {
                self.remote = remote_endpoint;
                -> $AwaitingMsg2
            }
            get_status(): String { @@:(String::from("idle")) }
        }

        $AwaitingMsg2 {
            msg2_received(valid: i32) {
                if valid == 1 {
                    -> $AwaitingAck
                } else {
                    -> $Aborted
                }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:(String::from("awaiting_msg2")) }
        }

        $AwaitingAck {
            msg3_ack() { -> $Transport }
            timeout() { -> $Aborted }
            get_status(): String { @@:(String::from("awaiting_ack")) }
        }

        $Transport {
            send(plaintext: String): String { @@:(String::from("sent")) }
            recv(ciphertext: String): String { @@:(String::from("decrypted")) }
            get_status(): String { @@:(String::from("transport")) }
        }

        $Aborted {
            get_status(): String { @@:(String::from("aborted")) }
        }

    domain:
        remote: String = String::new()
}

fn check(label: &str, actual: String, expected: &str) {
    if actual != expected {
        println!("FAIL: {} expected '{}', got '{}'", label, expected, actual);
        std::process::exit(1);
    }
}

fn main() {
    let mut n = @@NoiseXxInitiator();
    check("idle", n.get_status(), "idle");
    check("idle send default", n.send(String::from("hi")), "not_ready");
    check("idle recv default", n.recv(String::from("ct")), "");
    n.msg2_received(1);
    check("idle absorbs msg2", n.get_status(), "idle");
    n.msg3_ack();
    check("idle absorbs msg3_ack", n.get_status(), "idle");
    n.start(String::from("peer"));
    check("awaiting msg2", n.get_status(), "awaiting_msg2");
    check("awaiting_msg2 send default", n.send(String::from("hi")), "not_ready");
    n.msg3_ack();
    check("awaiting_msg2 absorbs msg3_ack", n.get_status(), "awaiting_msg2");
    n.msg2_received(1);
    check("awaiting ack", n.get_status(), "awaiting_ack");
    check("awaiting_ack send default", n.send(String::from("hi")), "not_ready");
    n.msg2_received(1);
    check("awaiting_ack absorbs msg2", n.get_status(), "awaiting_ack");
    n.msg3_ack();
    check("transport", n.get_status(), "transport");
    check("transport sends", n.send(String::from("hi")), "sent");
    check("transport recvs", n.recv(String::from("ct")), "decrypted");

    let mut n2 = @@NoiseXxInitiator();
    n2.start(String::from("peer"));
    n2.msg2_received(0);
    check("invalid msg2 -> aborted", n2.get_status(), "aborted");
    check("aborted send default", n2.send(String::from("hi")), "not_ready");
    check("aborted recv default", n2.recv(String::from("ct")), "");

    let mut n3 = @@NoiseXxInitiator();
    n3.start(String::from("peer"));
    n3.timeout();
    check("timeout at msg2 -> aborted", n3.get_status(), "aborted");

    let mut n4 = @@NoiseXxInitiator();
    n4.start(String::from("peer"));
    n4.msg2_received(1);
    n4.timeout();
    check("timeout at ack -> aborted", n4.get_status(), "aborted");
    n4.start(String::from("peer"));
    n4.msg2_received(1);
    n4.msg3_ack();
    check("aborted absorbs all", n4.get_status(), "aborted");

    println!("PASS: noise_xx");
}
