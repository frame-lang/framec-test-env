@@[target("swift")]

// Cookbook 94: Zero-Trust Session

import Foundation

@@system ZeroTrustSession {
    interface:
        authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String)
        auth_result(passed: Int, risk_score: Int)
        request_resource(resource: String, channel_id: String, policy_ok: Int): String = "denied"
        posture_update(score: Int)
        risk_signal_update(score: Int)
        channel_binding_mismatch()
        session_heartbeat()
        logout()
        get_status(): String = ""
        get_risk(): Int

    machine:
        $Anonymous {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) {
                self.user_id = user_id
                self.device_id = device_id
                self.bound_channel = channel_id
                -> $Authenticating
            }
            get_status(): String { @@:("anonymous") }
            get_risk(): Int { @@:(self.current_risk as! Int) }
        }

        $Authenticating {
            auth_result(passed: Int, risk_score: Int) {
                if passed == 0 { -> $Anonymous }
                else if risk_score > (self.high_risk_threshold as! Int) { -> $StepUpRequired }
                else {
                    self.current_risk = risk_score
                    -> $FullAccess
                }
            }
            get_status(): String { @@:("authenticating") }
            get_risk(): Int { @@:(self.current_risk as! Int) }
        }

        $StepUpRequired {
            authenticate(user_id: String, device_id: String, channel_id: String, mfa_factor: String) { -> $Authenticating }
            request_resource(resource: String, channel_id: String, policy_ok: Int): String { @@:("denied_stepup") }
            logout() { -> $Anonymous }
            get_status(): String { @@:("step_up_required") }
            get_risk(): Int { @@:(self.current_risk as! Int) }
        }

        $LiveSession {
            channel_binding_mismatch() { -> $Terminated }
            session_heartbeat() { }
            logout() { -> $Anonymous }
            get_risk(): Int { @@:(self.current_risk as! Int) }
        }

        $FullAccess => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: Int): String {
                if channel_id != (self.bound_channel as! String) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if policy_ok == 1 {
                    @@:("allowed")
                } else {
                    @@:("denied_policy")
                }
            }
            posture_update(score: Int) {
                if score < (self.min_posture as! Int) { -> $Degraded }
            }
            risk_signal_update(score: Int) {
                self.current_risk = score
                if score > (self.block_threshold as! Int) { -> $Terminated }
                else if score > (self.high_risk_threshold as! Int) { -> $Degraded }
            }
            get_status(): String { @@:("full_access") }
            => $^
        }

        $Degraded => $LiveSession {
            request_resource(resource: String, channel_id: String, policy_ok: Int): String {
                if channel_id != (self.bound_channel as! String) {
                    @@:("denied_channel")
                    -> $Terminated
                } else if policy_ok == 1 {
                    @@:("allowed_low_trust")
                } else {
                    @@:("denied_low_trust")
                }
            }
            risk_signal_update(score: Int) {
                self.current_risk = score
                if score > (self.block_threshold as! Int) { -> $Terminated }
            }
            posture_update(score: Int) {
                if score >= (self.min_posture as! Int) { -> $FullAccess }
            }
            get_status(): String { @@:("degraded") }
            => $^
        }

        $Terminated {
            get_status(): String { @@:("terminated") }
            get_risk(): Int { @@:(self.current_risk as! Int) }
        }

    domain:
        user_id: String = ""
        device_id: String = ""
        bound_channel: String = ""
        current_risk: Int = 0
        high_risk_threshold: Int = 70
        block_threshold: Int = 90
        min_posture: Int = 60
}

func cks(_ label: String, _ actual: String, _ expected: String) {
    if actual != expected { print("FAIL: \(label) expected '\(expected)', got '\(actual)'"); exit(1) }
}
func cki(_ label: String, _ actual: Int, _ expected: Int) {
    if actual != expected { print("FAIL: \(label) expected \(expected), got \(actual)"); exit(1) }
}

let s = @@ZeroTrustSession()
cks("anonymous", s.get_status() as! String, "anonymous")
cks("anon denied", s.request_resource(resource: "doc", channel_id: "ch1", policy_ok: 1) as! String, "denied")
s.authenticate(user_id: "alice", device_id: "dev-1", channel_id: "ch-A", mfa_factor: "totp")
cks("authenticating", s.get_status() as! String, "authenticating")
cks("authing denied", s.request_resource(resource: "doc", channel_id: "ch-A", policy_ok: 1) as! String, "denied")
s.auth_result(passed: 1, risk_score: 30)
cks("full access", s.get_status() as! String, "full_access")
cki("risk recorded", s.get_risk() as! Int, 30)
cks("match ok", s.request_resource(resource: "doc", channel_id: "ch-A", policy_ok: 1) as! String, "allowed")
cks("policy denied", s.request_resource(resource: "doc", channel_id: "ch-A", policy_ok: 0) as! String, "denied_policy")
s.channel_binding_mismatch()
cks("hijack -> terminated", s.get_status() as! String, "terminated")
cks("terminated denies", s.request_resource(resource: "doc", channel_id: "ch-A", policy_ok: 1) as! String, "denied")

let s2 = @@ZeroTrustSession()
s2.authenticate(user_id: "bob", device_id: "dev-2", channel_id: "ch-B", mfa_factor: "totp")
s2.auth_result(passed: 1, risk_score: 20)
cks("mismatch denied", s2.request_resource(resource: "doc", channel_id: "ch-WRONG", policy_ok: 1) as! String, "denied_channel")
cks("mismatch terminates", s2.get_status() as! String, "terminated")

let s3 = @@ZeroTrustSession()
s3.authenticate(user_id: "carol", device_id: "dev-3", channel_id: "ch-C", mfa_factor: "totp")
s3.auth_result(passed: 1, risk_score: 85)
cks("step up", s3.get_status() as! String, "step_up_required")
cks("step-up denies resource", s3.request_resource(resource: "doc", channel_id: "ch-C", policy_ok: 1) as! String, "denied_stepup")
s3.authenticate(user_id: "carol", device_id: "dev-3", channel_id: "ch-C", mfa_factor: "u2f")
cks("re-authing", s3.get_status() as! String, "authenticating")
s3.auth_result(passed: 1, risk_score: 30)
cks("full access after step-up", s3.get_status() as! String, "full_access")

let s4 = @@ZeroTrustSession()
s4.authenticate(user_id: "dave", device_id: "dev-4", channel_id: "ch-D", mfa_factor: "totp")
s4.auth_result(passed: 1, risk_score: 20)
s4.posture_update(score: 50)
cks("posture degrade", s4.get_status() as! String, "degraded")
cks("degraded + allowed", s4.request_resource(resource: "doc", channel_id: "ch-D", policy_ok: 1) as! String, "allowed_low_trust")
cks("degraded + denied", s4.request_resource(resource: "doc", channel_id: "ch-D", policy_ok: 0) as! String, "denied_low_trust")
s4.posture_update(score: 80)
cks("posture restored", s4.get_status() as! String, "full_access")
s4.risk_signal_update(score: 95)
cks("risk block -> terminated", s4.get_status() as! String, "terminated")

let s5 = @@ZeroTrustSession()
s5.authenticate(user_id: "eve", device_id: "dev-5", channel_id: "ch-E", mfa_factor: "totp")
s5.auth_result(passed: 1, risk_score: 20)
s5.risk_signal_update(score: 75)
cks("risk degrade", s5.get_status() as! String, "degraded")

let s6 = @@ZeroTrustSession()
s6.authenticate(user_id: "fred", device_id: "dev-6", channel_id: "ch-F", mfa_factor: "totp")
s6.auth_result(passed: 1, risk_score: 20)
s6.logout()
cks("logout -> anonymous", s6.get_status() as! String, "anonymous")

let s7 = @@ZeroTrustSession()
s7.authenticate(user_id: "greg", device_id: "dev-7", channel_id: "ch-G", mfa_factor: "totp")
s7.auth_result(passed: 1, risk_score: 20)
s7.session_heartbeat()
cks("heartbeat noop", s7.get_status() as! String, "full_access")

print("PASS: zero_trust")
