@@[target("swift")]

// Cookbook 91: Noise Protocol XX Handshake (Initiator)

import Foundation

@@system NoiseXxInitiator {
    interface:
        start(remote_endpoint: String)
        msg2_received(valid: Int)
        msg3_ack()
        send(plaintext: String): String = "not_ready"
        recv(ciphertext: String): String = ""
        timeout()
        get_status(): String = "idle"

    machine:
        $Idle {
            start(remote_endpoint: String) {
                self.remote = remote_endpoint
                -> $AwaitingMsg2
            }
            get_status(): String { @@:("idle") }
        }

        $AwaitingMsg2 {
            msg2_received(valid: Int) {
                if valid == 1 { -> $AwaitingAck } else { -> $Aborted }
            }
            timeout() { -> $Aborted }
            get_status(): String { @@:("awaiting_msg2") }
        }

        $AwaitingAck {
            msg3_ack() { -> $Transport }
            timeout() { -> $Aborted }
            get_status(): String { @@:("awaiting_ack") }
        }

        $Transport {
            send(plaintext: String): String { @@:("sent") }
            recv(ciphertext: String): String { @@:("decrypted") }
            get_status(): String { @@:("transport") }
        }

        $Aborted {
            get_status(): String { @@:("aborted") }
        }

    domain:
        remote: String = ""
}

func check(_ label: String, _ actual: String, _ expected: String) {
    if actual != expected { print("FAIL: \(label) expected '\(expected)', got '\(actual)'"); exit(1) }
}

let n = @@NoiseXxInitiator()
check("idle", n.get_status() as! String, "idle")
check("idle send default", n.send(plaintext: "hi") as! String, "not_ready")
check("idle recv default", n.recv(ciphertext: "ct") as! String, "")
n.msg2_received(valid: 1)
check("idle absorbs msg2", n.get_status() as! String, "idle")
n.msg3_ack()
check("idle absorbs msg3_ack", n.get_status() as! String, "idle")
n.start(remote_endpoint: "peer")
check("awaiting msg2", n.get_status() as! String, "awaiting_msg2")
check("awaiting_msg2 send default", n.send(plaintext: "hi") as! String, "not_ready")
n.msg3_ack()
check("awaiting_msg2 absorbs msg3_ack", n.get_status() as! String, "awaiting_msg2")
n.msg2_received(valid: 1)
check("awaiting ack", n.get_status() as! String, "awaiting_ack")
check("awaiting_ack send default", n.send(plaintext: "hi") as! String, "not_ready")
n.msg2_received(valid: 1)
check("awaiting_ack absorbs msg2", n.get_status() as! String, "awaiting_ack")
n.msg3_ack()
check("transport", n.get_status() as! String, "transport")
check("transport sends", n.send(plaintext: "hi") as! String, "sent")
check("transport recvs", n.recv(ciphertext: "ct") as! String, "decrypted")

let n2 = @@NoiseXxInitiator()
n2.start(remote_endpoint: "peer")
n2.msg2_received(valid: 0)
check("invalid msg2 -> aborted", n2.get_status() as! String, "aborted")
check("aborted send default", n2.send(plaintext: "hi") as! String, "not_ready")
check("aborted recv default", n2.recv(ciphertext: "ct") as! String, "")

let n3 = @@NoiseXxInitiator()
n3.start(remote_endpoint: "peer")
n3.timeout()
check("timeout at msg2 -> aborted", n3.get_status() as! String, "aborted")

let n4 = @@NoiseXxInitiator()
n4.start(remote_endpoint: "peer")
n4.msg2_received(valid: 1)
n4.timeout()
check("timeout at ack -> aborted", n4.get_status() as! String, "aborted")
n4.start(remote_endpoint: "peer")
n4.msg2_received(valid: 1)
n4.msg3_ack()
check("aborted absorbs all", n4.get_status() as! String, "aborted")

print("PASS: noise_xx")
