@@[target("kotlin")]

// Cookbook 87: OAuth 2.0 Authorization Code + PKCE

@@system OAuthPkceFlow {
    interface:
        start(client_id: String, redirect_uri: String, scope: String, nonce: String)
        authorization_redirect(code: String, state: String)
        exchange_response(access_token: String, refresh_token: String)
        exchange_error(reason: String)
        use_token(): String = "no_token"
        refresh()
        revoke()
        timeout()
        get_status(): String = "idle"
        get_auth_code(): String
        get_code_verifier(): String

    machine:
        $Idle {
            start(client_id: String, redirect_uri: String, scope: String, nonce: String) {
                this.client_id = client_id
                this.redirect_uri = redirect_uri
                this.scope = scope
                this.code_verifier = nonce
                this.code_challenge = nonce
                this.state_nonce = nonce
                -> $AwaitingRedirect
            }
            get_status(): String { @@:("idle") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

        $AwaitingRedirect {
            authorization_redirect(code: String, state: String) {
                if (state != this.state_nonce) {
                    -> $Failed
                } else {
                    this.auth_code = code
                    -> $ExchangingCode
                }
            }
            timeout() { -> $Failed }
            get_status(): String { @@:("awaiting_redirect") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

        $ExchangingCode {
            <$() {
                this.auth_code = ""
                this.code_verifier = ""
            }
            exchange_response(access_token: String, refresh_token: String) {
                this.access_token = access_token
                this.refresh_token = refresh_token
                -> $Authorized
            }
            exchange_error(reason: String) { -> $Failed }
            timeout() { -> $Failed }
            get_status(): String { @@:("exchanging") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

        $Authorized {
            use_token(): String { @@:(this.access_token) }
            refresh() { -> $Refreshing }
            revoke() { -> $Revoked }
            get_status(): String { @@:("authorized") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

        $Refreshing {
            exchange_response(access_token: String, refresh_token: String) {
                this.access_token = access_token
                this.refresh_token = refresh_token
                -> $Authorized
            }
            exchange_error(reason: String) { -> $Failed }
            timeout() { -> $Failed }
            get_status(): String { @@:("refreshing") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

        $Failed {
            get_status(): String { @@:("failed") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

        $Revoked {
            get_status(): String { @@:("revoked") }
            get_auth_code(): String { @@:(this.auth_code) }
            get_code_verifier(): String { @@:(this.code_verifier) }
        }

    domain:
        client_id: String = ""
        redirect_uri: String = ""
        scope: String = ""
        code_verifier: String = ""
        code_challenge: String = ""
        state_nonce: String = ""
        auth_code: String = ""
        access_token: String = ""
        refresh_token: String = ""
}

fun check(label: String, actual: String, expected: String) {
    if (actual != expected) { println("FAIL: $label expected '$expected', got '$actual'"); kotlin.system.exitProcess(1) }
}

fun main() {
    val f = @@OAuthPkceFlow()
    check("idle", f.get_status() as String, "idle")
    check("idle use_token default", f.use_token() as String, "no_token")
    f.start("myclient", "https://app/cb", "read", "nonce123")
    check("awaiting redirect", f.get_status() as String, "awaiting_redirect")
    check("PKCE verifier generated", f.get_code_verifier() as String, "nonce123")
    check("use_token still denied", f.use_token() as String, "no_token")
    f.authorization_redirect("authcode-XYZ", "nonce123")
    check("exchanging", f.get_status() as String, "exchanging")
    check("auth code captured", f.get_auth_code() as String, "authcode-XYZ")
    f.exchange_response("TOKEN-A", "REFRESH-B")
    check("authorized", f.get_status() as String, "authorized")
    check("token usable", f.use_token() as String, "TOKEN-A")
    check("auth_code zeroed", f.get_auth_code() as String, "")
    check("code_verifier zeroed", f.get_code_verifier() as String, "")
    f.authorization_redirect("authcode-XYZ", "nonce123")
    check("authorized absorbs replay", f.get_status() as String, "authorized")
    check("token still usable", f.use_token() as String, "TOKEN-A")
    f.refresh()
    check("refreshing", f.get_status() as String, "refreshing")
    f.exchange_response("TOKEN-A2", "REFRESH-B2")
    check("authorized post-refresh", f.get_status() as String, "authorized")
    check("new token", f.use_token() as String, "TOKEN-A2")
    f.revoke()
    check("revoked", f.get_status() as String, "revoked")
    check("revoked denies token", f.use_token() as String, "no_token")

    val f2 = @@OAuthPkceFlow()
    f2.start("myclient", "https://app/cb", "read", "nonce123")
    f2.authorization_redirect("attacker-code", "WRONG-NONCE")
    check("CSRF mismatch -> failed", f2.get_status() as String, "failed")
    check("CSRF denies token", f2.use_token() as String, "no_token")

    val f3 = @@OAuthPkceFlow()
    f3.start("myclient", "https://app/cb", "read", "nonce123")
    f3.timeout()
    check("timeout failed", f3.get_status() as String, "failed")

    val f4 = @@OAuthPkceFlow()
    f4.start("myclient", "https://app/cb", "read", "nonce123")
    f4.authorization_redirect("authcode", "nonce123")
    f4.exchange_error("invalid_grant")
    check("exchange error failed", f4.get_status() as String, "failed")
    check("no token on exchange error", f4.use_token() as String, "no_token")

    val f5 = @@OAuthPkceFlow()
    f5.start("myclient", "https://app/cb", "read", "nonce123")
    f5.authorization_redirect("authcode", "nonce123")
    f5.timeout()
    check("exchange timeout failed", f5.get_status() as String, "failed")

    val f6 = @@OAuthPkceFlow()
    f6.start("myclient", "https://app/cb", "read", "nonce123")
    f6.authorization_redirect("authcode", "nonce123")
    f6.exchange_response("TOKEN", "REFRESH")
    f6.refresh()
    f6.exchange_error("invalid_refresh_token")
    check("refresh error failed", f6.get_status() as String, "failed")

    println("PASS: oauth_pkce")
}
