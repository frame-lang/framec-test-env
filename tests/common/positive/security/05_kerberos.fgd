@@[target("gdscript")]

extends SceneTree

# Cookbook 90: Kerberos Ticket Lifecycle (HSM)

@@system KerberosClient {
    interface:
        authenticate(user: String, password: String)
        preauth_accepted(tgt: String, session_key: String, expiry: int)
        preauth_rejected(reason: String)
        request_service(spn: String)
        service_ticket_received(st: String, expiry: int)
        service_ticket_rejected(reason: String)
        tick(now: int)
        logout()
        get_status(): String = ""
        get_tgt(): String
        get_service_ticket(): String

    machine:
        $Idle {
            authenticate(user: String, password: String) {
                self.user = user
                -> $AwaitingTgt
            }
            get_status(): String { @@:("idle") }
            get_tgt(): String { @@:(self.tgt) }
            get_service_ticket(): String { @@:(self.service_ticket) }
        }

        $AwaitingTgt {
            preauth_accepted(tgt: String, session_key: String, expiry: int) {
                self.tgt = tgt
                self.session_key = session_key
                self.tgt_expiry = expiry
                -> $HasTgt
            }
            preauth_rejected(reason: String) { -> $Failed }
            get_status(): String { @@:("awaiting_tgt") }
            get_tgt(): String { @@:(self.tgt) }
            get_service_ticket(): String { @@:(self.service_ticket) }
        }

        $HasValidTgt {
            tick(now: int) {
                if now >= self.tgt_expiry:
                    self.tgt = ""
                    self.session_key = ""
                    self.tgt_expiry = 0
                    self.service_ticket = ""
                    self.st_expiry = 0
                    -> $Idle
            }
            logout() {
                self.tgt = ""
                self.session_key = ""
                self.tgt_expiry = 0
                self.service_ticket = ""
                self.st_expiry = 0
                -> $Idle
            }
            get_tgt(): String { @@:(self.tgt) }
            get_service_ticket(): String { @@:(self.service_ticket) }
        }

        $HasTgt => $HasValidTgt {
            request_service(spn: String) { -> $AwaitingServiceTicket }
            get_status(): String { @@:("has_tgt") }
            => $^
        }

        $AwaitingServiceTicket => $HasValidTgt {
            service_ticket_received(st: String, expiry: int) {
                self.service_ticket = st
                self.st_expiry = expiry
                -> $HasServiceTicket
            }
            service_ticket_rejected(reason: String) { -> $HasTgt }
            get_status(): String { @@:("awaiting_st") }
            => $^
        }

        $HasServiceTicket => $HasValidTgt {
            tick(now: int) {
                if now >= self.tgt_expiry:
                    self.tgt = ""
                    self.session_key = ""
                    self.tgt_expiry = 0
                    self.service_ticket = ""
                    self.st_expiry = 0
                    -> $Idle
                elif now >= self.st_expiry:
                    self.service_ticket = ""
                    -> $HasTgt
            }
            request_service(spn: String) { -> $AwaitingServiceTicket }
            get_status(): String { @@:("has_st") }
            => $^
        }

        $Failed {
            get_status(): String { @@:("failed") }
            get_tgt(): String { @@:(self.tgt) }
            get_service_ticket(): String { @@:(self.service_ticket) }
        }

    domain:
        user: String = ""
        tgt: String = ""
        session_key: String = ""
        tgt_expiry: int = 0
        service_ticket: String = ""
        st_expiry: int = 0
}

func ck(label, actual, expected):
    if actual != expected:
        print("FAIL: ", label, " expected '", expected, "', got '", actual, "'")
        OS.kill(OS.get_process_id())

func _init() -> void:
    var k = @@KerberosClient()
    ck("idle", k.get_status(), "idle")
    k.request_service("HTTP/web")
    ck("idle absorbs request_service", k.get_status(), "idle")
    ck("no service ticket in idle", k.get_service_ticket(), "")
    k.authenticate("alice", "pw")
    ck("awaiting tgt", k.get_status(), "awaiting_tgt")
    k.request_service("HTTP/web")
    ck("awaiting absorbs request_service", k.get_status(), "awaiting_tgt")
    k.preauth_accepted("TGT-abc", "K-123", 100)
    ck("has tgt", k.get_status(), "has_tgt")
    ck("tgt stored", k.get_tgt(), "TGT-abc")
    k.tick(50)
    ck("still has tgt pre-expiry", k.get_status(), "has_tgt")
    k.request_service("HTTP/web")
    ck("awaiting st", k.get_status(), "awaiting_st")
    k.service_ticket_received("ST-xyz", 80)
    ck("has st", k.get_status(), "has_st")
    ck("st stored", k.get_service_ticket(), "ST-xyz")
    k.tick(85)
    ck("ST expired -> has_tgt", k.get_status(), "has_tgt")
    ck("st cleared", k.get_service_ticket(), "")
    ck("tgt still there", k.get_tgt(), "TGT-abc")
    k.request_service("HTTP/web")
    k.service_ticket_received("ST-2", 95)
    ck("has st 2", k.get_status(), "has_st")
    k.tick(100)
    ck("tgt expired -> idle", k.get_status(), "idle")
    ck("tgt zeroed", k.get_tgt(), "")
    ck("st zeroed", k.get_service_ticket(), "")

    var k2 = @@KerberosClient()
    k2.authenticate("alice", "pw")
    k2.preauth_accepted("TGT-xx", "K-yy", 200)
    k2.logout()
    ck("logout from has_tgt -> idle", k2.get_status(), "idle")
    ck("logout cleared tgt", k2.get_tgt(), "")

    var k3 = @@KerberosClient()
    k3.authenticate("alice", "pw")
    k3.preauth_accepted("TGT-1", "K-1", 500)
    k3.request_service("spn")
    k3.service_ticket_received("ST-1", 300)
    k3.logout()
    ck("logout from has_st -> idle", k3.get_status(), "idle")
    ck("logout cleared st", k3.get_service_ticket(), "")

    var k4 = @@KerberosClient()
    k4.authenticate("bob", "wrong")
    k4.preauth_rejected("invalid_password")
    ck("preauth rejected", k4.get_status(), "failed")

    var k5 = @@KerberosClient()
    k5.authenticate("alice", "pw")
    k5.preauth_accepted("TGT-q", "K-q", 500)
    k5.request_service("deny_me")
    k5.service_ticket_rejected("no_access")
    ck("st rejected -> has_tgt", k5.get_status(), "has_tgt")
    ck("tgt retained", k5.get_tgt(), "TGT-q")

    print("PASS: kerberos")
