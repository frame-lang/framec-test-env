@@[target("erlang")]

%% Cookbook 89: MFA with Lockout

@@system MfaAuth {
    interface:
        submit_username(u: string)
        submit_password(p: string)
        submit_second_factor(code: string)
        cooldown_elapsed()
        logout()
        get_status(): string = ""
        get_failures(): int

    machine:
        $Idle {
            submit_username(u: string) {
                self.username = U,
                -> $AwaitingPassword
            }
            get_status(): string { @@:("idle") }
            get_failures(): int { @@:(self.failures) }
        }

        $AwaitingPassword {
            submit_password(p: string) {
                case (self.username == "alice") andalso (P == "hunter2") of
                    true -> -> $AwaitingSecondFactor;
                    false ->
                        self.failures = self.failures + 1,
                        case self.failures >= self.lockout_threshold of
                            true -> -> $Locked;
                            false -> ok
                        end
                end
            }
            get_status(): string { @@:("awaiting_password") }
            get_failures(): int { @@:(self.failures) }
        }

        $AwaitingSecondFactor {
            $.attempts: int = 0

            submit_second_factor(code: string) {
                $.attempts = $.attempts + 1,
                case Code == "123456" of
                    true ->
                        self.failures = 0,
                        -> $Authenticated;
                    false ->
                        case $.attempts >= 3 of
                            true ->
                                self.failures = self.failures + 1,
                                case self.failures >= self.lockout_threshold of
                                    true -> -> $Locked;
                                    false -> -> $AwaitingPassword
                                end;
                            false -> ok
                        end
                end
            }
            get_status(): string { @@:("awaiting_2fa") }
            get_failures(): int { @@:(self.failures) }
        }

        $Authenticated {
            logout() { -> $Idle }
            get_status(): string { @@:("authenticated") }
            get_failures(): int { @@:(self.failures) }
        }

        $Locked {
            cooldown_elapsed() {
                self.failures = self.lockout_threshold - 1,
                -> $Idle
            }
            get_status(): string { @@:("locked") }
            get_failures(): int { @@:(self.failures) }
        }

    domain:
        username: string = ""
        failures: int = 0
        lockout_threshold: int = 5
}
