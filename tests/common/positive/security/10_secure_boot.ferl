@@[target("erlang")]

%% Cookbook 95: Secure Boot

@@system SecureBoot {
    interface:
        power_on()
        verify_result(stage, passed)
        measurement_extended(stage)
        antirollback_check(passed)
        get_stage() = -1

    machine:
        $Rom {
            $>() { self.current_stage = 0 }
            measurement_extended(stage) {
                if Stage == 0
                    self.current_stage = 0
                end
            }
            verify_result(stage, passed) {
                if Stage == 1 andalso Passed =/= 0
                    -> $VerifyingBootloader
                else
                    -> $Halted
                end
            }
            get_stage() { @@:(0) }
        }
        $VerifyingBootloader {
            measurement_extended(stage) { if Stage == 1 -> $AntirollbackBootloader end }
            get_stage() { @@:(1) }
        }
        $AntirollbackBootloader {
            antirollback_check(passed) { if Passed =/= 0 -> $BootloaderRunning else -> $Halted end }
            get_stage() { @@:(1) }
        }
        $BootloaderRunning {
            verify_result(stage, passed) { if Stage == 2 andalso Passed =/= 0 -> $VerifyingKernel else -> $Recovery end }
            get_stage() { @@:(2) }
        }
        $VerifyingKernel {
            measurement_extended(stage) { if Stage == 2 -> $AntirollbackKernel end }
            get_stage() { @@:(2) }
        }
        $AntirollbackKernel {
            antirollback_check(passed) { if Passed =/= 0 -> $KernelRunning else -> $Recovery end }
            get_stage() { @@:(2) }
        }
        $KernelRunning {
            verify_result(stage, passed) { if Stage == 3 andalso Passed =/= 0 -> $VerifyingInit else -> $Recovery end }
            get_stage() { @@:(3) }
        }
        $VerifyingInit {
            measurement_extended(stage) { if Stage == 3 -> $Booted end }
            get_stage() { @@:(3) }
        }
        $Booted { get_stage() { @@:(4) } }
        $Recovery { get_stage() { @@:(-2) } }
        $Halted { get_stage() { @@:(-1) } }

    domain:
        current_stage = 0
}
