@@[target("cpp")]

// Cookbook 93: Macaroon-Style Capability Token Verifier

@@system MacaroonVerifier {
    interface:
        present(token: std::string, caveat_count: int)
        caveat_verified(passed: int, caveat_index: int)
        sig_verified(passed: int)
        perform(action: std::string, resource: std::string, allowed: int): std::string = "denied"
        get_status(): std::string = ""
        get_caveat_index(): int

    machine:
        $Idle {
            present(token: std::string, caveat_count: int) {
                this->token = token;
                this->caveats = caveat_count;
                this->caveat_index = 0;
                -> $CheckingSignature
            }
            get_status(): std::string { @@:("idle") }
            get_caveat_index(): int { @@:(this->caveat_index) }
        }

        $CheckingSignature {
            sig_verified(passed: int) {
                if (passed == 1) { -> $CheckingCaveats } else { -> $Rejected }
            }
            get_status(): std::string { @@:("checking_sig") }
            get_caveat_index(): int { @@:(this->caveat_index) }
        }

        $CheckingCaveats {
            $>() {
                if (this->caveat_index >= this->caveats) { -> $Authorized }
            }
            caveat_verified(passed: int, caveat_index: int) {
                if (caveat_index != this->caveat_index) {
                    -> $Rejected
                } else if (passed == 0) {
                    -> $Rejected
                } else {
                    this->caveat_index = this->caveat_index + 1;
                    -> $CheckingCaveats
                }
            }
            get_status(): std::string { @@:("checking_caveats") }
            get_caveat_index(): int { @@:(this->caveat_index) }
        }

        $Authorized {
            perform(action: std::string, resource: std::string, allowed: int): std::string {
                if (allowed == 1) { @@:("allowed") } else { @@:("denied") }
            }
            get_status(): std::string { @@:("authorized") }
            get_caveat_index(): int { @@:(this->caveat_index) }
        }

        $Rejected {
            get_status(): std::string { @@:("rejected") }
            get_caveat_index(): int { @@:(this->caveat_index) }
        }

    domain:
        token: std::string = ""
        caveats: int = 0
        caveat_index: int = 0
}

#include <iostream>
#include <cstdlib>

static void check(const std::string& label, const std::string& actual, const std::string& expected) {
    if (actual != expected) { std::cout << "FAIL: " << label << " expected '" << expected << "', got '" << actual << "'\n"; std::exit(1); }
}
static void check_i(const std::string& label, int actual, int expected) {
    if (actual != expected) { std::cout << "FAIL: " << label << " expected " << expected << ", got " << actual << "\n"; std::exit(1); }
}

int main() {
    auto v = @@MacaroonVerifier();
    check("idle", v.get_status(), "idle");
    check("idle perform denied", v.perform("read", "doc", 1), "denied");
    v.present("TOK", 3);
    check("checking sig", v.get_status(), "checking_sig");
    check("sig-check perform denied", v.perform("read", "doc", 1), "denied");
    v.sig_verified(1);
    check("checking caveats", v.get_status(), "checking_caveats");
    check("caveat-check perform denied", v.perform("read", "doc", 1), "denied");
    v.caveat_verified(1, 0);
    check_i("caveat 0 done, index advanced", v.get_caveat_index(), 1);
    v.caveat_verified(1, 1);
    v.caveat_verified(1, 2);
    check("authorized", v.get_status(), "authorized");
    check("in-scope perform", v.perform("read", "doc", 1), "allowed");
    check("out-of-scope perform", v.perform("write", "doc", 0), "denied");
    v.caveat_verified(1, 99);
    check("authorized absorbs caveat", v.get_status(), "authorized");

    auto v2 = @@MacaroonVerifier();
    v2.present("TOK", 2);
    v2.sig_verified(0);
    check("sig failed", v2.get_status(), "rejected");
    check("rejected denies perform", v2.perform("read", "doc", 1), "denied");

    auto v3 = @@MacaroonVerifier();
    v3.present("TOK", 3);
    v3.sig_verified(1);
    v3.caveat_verified(1, 0);
    v3.caveat_verified(0, 1);
    check("caveat failed -> rejected", v3.get_status(), "rejected");

    auto v4 = @@MacaroonVerifier();
    v4.present("TOK", 3);
    v4.sig_verified(1);
    v4.caveat_verified(1, 0);
    v4.caveat_verified(1, 2);
    check("out-of-order -> rejected", v4.get_status(), "rejected");

    auto v5 = @@MacaroonVerifier();
    v5.present("TOK", 0);
    v5.sig_verified(1);
    check("no caveats -> authorized", v5.get_status(), "authorized");

    std::cout << "PASS: macaroon\n";
    return 0;
}
