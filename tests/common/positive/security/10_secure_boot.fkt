@@[target("kotlin")]

// Cookbook 95: Secure Boot

@@system SecureBoot {
    interface:
        power_on()
        verify_result(stage: Int, passed: Int)
        measurement_extended(stage: Int)
        antirollback_check(passed: Int)
        get_stage(): Int = -1

    machine:
        $Rom {
            $>() { this.current_stage = 0 }
            measurement_extended(stage: Int) { if ((stage as Int) == 0) { this.current_stage = 0 } }
            verify_result(stage: Int, passed: Int) {
                if ((stage as Int) == 1 && (passed as Int) != 0) { -> $VerifyingBootloader } else { -> $Halted }
            }
            get_stage(): Int { @@:(0) }
        }
        $VerifyingBootloader {
            measurement_extended(stage: Int) { if ((stage as Int) == 1) { -> $AntirollbackBootloader } }
            get_stage(): Int { @@:(1) }
        }
        $AntirollbackBootloader {
            antirollback_check(passed: Int) { if ((passed as Int) != 0) { -> $BootloaderRunning } else { -> $Halted } }
            get_stage(): Int { @@:(1) }
        }
        $BootloaderRunning {
            verify_result(stage: Int, passed: Int) { if ((stage as Int) == 2 && (passed as Int) != 0) { -> $VerifyingKernel } else { -> $Recovery } }
            get_stage(): Int { @@:(2) }
        }
        $VerifyingKernel {
            measurement_extended(stage: Int) { if ((stage as Int) == 2) { -> $AntirollbackKernel } }
            get_stage(): Int { @@:(2) }
        }
        $AntirollbackKernel {
            antirollback_check(passed: Int) { if ((passed as Int) != 0) { -> $KernelRunning } else { -> $Recovery } }
            get_stage(): Int { @@:(2) }
        }
        $KernelRunning {
            verify_result(stage: Int, passed: Int) { if ((stage as Int) == 3 && (passed as Int) != 0) { -> $VerifyingInit } else { -> $Recovery } }
            get_stage(): Int { @@:(3) }
        }
        $VerifyingInit {
            measurement_extended(stage: Int) { if ((stage as Int) == 3) { -> $Booted } }
            get_stage(): Int { @@:(3) }
        }
        $Booted { get_stage(): Int { @@:(4) } }
        $Recovery { get_stage(): Int { @@:(-2) } }
        $Halted { get_stage(): Int { @@:(-1) } }

    domain:
        current_stage: Int = 0
}

fun check(label: String, actual: Int, expected: Int) {
    if (actual != expected) { println("FAIL: $label expected $expected, got $actual"); kotlin.system.exitProcess(1) }
}

fun main() {
    val b = @@SecureBoot()
    check("rom stage", b.get_stage() as Int, 0)
    b.measurement_extended(0); b.verify_result(1, 1); check("verifying bootloader", b.get_stage() as Int, 1)
    b.measurement_extended(1); check("antirollback bootloader", b.get_stage() as Int, 1)
    b.antirollback_check(1); check("bootloader running", b.get_stage() as Int, 2)
    b.verify_result(2, 1); b.measurement_extended(2); b.antirollback_check(1); check("kernel running", b.get_stage() as Int, 3)
    b.verify_result(3, 1); b.measurement_extended(3); check("booted", b.get_stage() as Int, 4)

    val b2 = @@SecureBoot(); b2.measurement_extended(0); b2.verify_result(1, 0)
    check("bootloader sig bad -> halted", b2.get_stage() as Int, -1)
    b2.verify_result(2, 1); check("halted absorbs", b2.get_stage() as Int, -1)

    val b3 = @@SecureBoot(); b3.measurement_extended(0); b3.verify_result(1, 1); b3.measurement_extended(1); b3.antirollback_check(0)
    check("bootloader rollback -> halted", b3.get_stage() as Int, -1)

    val b4 = @@SecureBoot(); b4.measurement_extended(0); b4.verify_result(1, 1); b4.measurement_extended(1); b4.antirollback_check(1); b4.verify_result(2, 0)
    check("kernel sig bad -> recovery", b4.get_stage() as Int, -2)

    val b5 = @@SecureBoot(); b5.measurement_extended(0); b5.verify_result(1, 1); b5.measurement_extended(1); b5.antirollback_check(1); b5.verify_result(2, 1); b5.measurement_extended(2); b5.antirollback_check(0)
    check("kernel rollback -> recovery", b5.get_stage() as Int, -2)

    val b6 = @@SecureBoot(); b6.measurement_extended(0); b6.verify_result(1, 1); b6.measurement_extended(1); b6.antirollback_check(1); b6.verify_result(2, 1); b6.measurement_extended(2); b6.antirollback_check(1); b6.verify_result(3, 0)
    check("init sig bad -> recovery", b6.get_stage() as Int, -2)

    val b7 = @@SecureBoot(); b7.antirollback_check(1)
    check("antirollback in ROM absorbed", b7.get_stage() as Int, 0)
    b7.measurement_extended(5); check("wrong-stage measurement absorbed", b7.get_stage() as Int, 0)

    val b8 = @@SecureBoot(); b8.verify_result(3, 1); check("bogus verify at ROM halts", b8.get_stage() as Int, -1)

    println("PASS: secure_boot")
}
