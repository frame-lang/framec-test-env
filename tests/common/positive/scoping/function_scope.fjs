@@[target("javascript")]
@@exec-ok

@@system S {
    machine:
        $A => $P {
            e() {
                function f() { return 1; }
                => $^
                f();
            }
        }
        $P { }
}

function main() {
    console.log("TAP version 14");
    console.log("1..1");
    try {
        const s = @@S();
        s.e();
        console.log("ok 1 - function_scope");
    } catch (ex) {
        console.log(`not ok 1 - function_scope # ${ex}`);
    }
}
main();
