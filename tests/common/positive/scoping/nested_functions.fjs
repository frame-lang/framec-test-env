@@[target("javascript")]
@@exec-ok

@@system S {
    machine:
        $A => $P {
            e() {
                function outer() {
                    const v = 1;
                    function inner() { return v + 1; }
                    return inner();
                }
                => $^
                outer();
            }
        }
        $P { }
}

function main() {
    console.log("TAP version 14");
    console.log("1..1");
    try {
        const s = @@S();
        s.e();
        console.log("ok 1 - nested_functions");
    } catch (ex) {
        console.log(`not ok 1 - nested_functions # ${ex}`);
    }
}
main();
