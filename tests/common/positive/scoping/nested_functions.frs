@@[target("rust")]
@@exec-ok

@@system S {
    machine:
        $A => $P {
            e() {
                fn outer() -> i32 {
                    let v: i32 = 1;
                    fn inner(v: i32) -> i32 { v + 1 }
                    inner(v)
                }
                => $^
                outer();
            }
        }
        $P { }
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut s = @@S();
    s.e();
    println!("ok 1 - nested_functions");
}
