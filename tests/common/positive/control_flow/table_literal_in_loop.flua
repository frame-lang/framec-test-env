@@[target("lua")]
@@[main]
-- #122 regression: Lua table constructors {...} inside control-flow handler
-- bodies must keep their braces (only Frame block braces become do/then...end).
@@system Field {
    interface:
        spawn(n: number)
        count(): number
        firstTag(): number
    machine:
        $Active {
            spawn(n: number) {
                local i = 0
                while i < n {
                    table.insert(@@:self.rocks, {size = i + 1, alive = true, tags = {1, 2}})
                    i = i + 1
                }
            }
            count(): number { @@:(#@@:self.rocks) }
            firstTag(): number { @@:(@@:self.rocks[1].tags[2]) }
        }
    domain:
        rocks: any = {}
}

print("TAP version 14")
print("1..2")
local f = @@Field()
f:spawn(3)
print(f:count() == 3 and "ok 1 - table literals built in while loop" or ("not ok 1 # got " .. tostring(f:count())))
print(f:firstTag() == 2 and "ok 2 - nested table literal {1, 2} intact" or "not ok 2 - nested table broken")
