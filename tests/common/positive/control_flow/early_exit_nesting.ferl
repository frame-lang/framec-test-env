@@[target("erlang")]

%% #123 / nest_early_exits: an `if` (no else) followed by more code means
%% "if the condition holds, transition and STOP; else run the trailing code".
%% In Erlang that trailing code must land in the `case`'s false arm. These
%% handlers pin every nesting (basic, nested, else-if + trailing) so the fold
%% of the early-exit nesting into ErlangBlockParserFsm is proven, not assumed.

@@system EarlyExit {
    interface:
        basic(c: int)
        nested(a: int, b: int)
        x(): int
        tb(): int
        ta(): int
        bb(): int
        trail(): int

    machine:
        $Idle {
            basic(c: int) {
                if c == 1 {
                    -> $Done
                }
                self.vx = 1
            }
            nested(a: int, b: int) {
                if a == 1 {
                    if b == 1 {
                        -> $Done
                    }
                    self.vtb = 1
                }
                self.vta = 1
            }
            x(): int { @@:(self.vx) }
            tb(): int { @@:(self.vtb) }
            ta(): int { @@:(self.vta) }
            bb(): int { @@:(self.vbb) }
            trail(): int { @@:(self.vtrail) }
        }
        $Done {
            x(): int { @@:(self.vx) }
            tb(): int { @@:(self.vtb) }
            ta(): int { @@:(self.vta) }
            bb(): int { @@:(self.vbb) }
            trail(): int { @@:(self.vtrail) }
        }

    domain:
        vx: int = 0
        vtb: int = 0
        vta: int = 0
        vbb: int = 0
        vtrail: int = 0
}
