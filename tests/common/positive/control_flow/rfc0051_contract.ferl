@@[target("erlang")]
@@system Flow {
    interface:
        ex(c: int)
        xfer(v: int)
        cross(c: int)
        read_after(c: int)
        nested(a: int, b: int)
        elif_trail(a: int, b: int)
        va(): int
        vb(): int
        vc(): int
        vd(): int
        ve(): int
    machine:
        $Idle {
            ex(c: int) {
                if c == 1 {
                    -> $Done
                }
                self.a = 1
            }
            xfer(v: int) {
                self.a = v
                -> $Done
            }
            cross(c: int) {
                if c == 1 {
                    self.a = 1
                    -> $Done
                } else {
                    self.a = 2
                }
            }
            read_after(c: int) {
                if c == 1 {
                    self.a = 5
                }
                self.b = self.a + 10
            }
            nested(a: int, b: int) {
                if a == 1 {
                    if b == 1 {
                        -> $Done
                    }
                    self.d = 1
                }
                self.e = 1
            }
            elif_trail(a: int, b: int) {
                if a == 1 {
                    -> $Done
                } else if b == 1 {
                    self.c = 1
                }
                self.b = 1
            }
            va(): int { @@:(self.a) }
            vb(): int { @@:(self.b) }
            vc(): int { @@:(self.c) }
            vd(): int { @@:(self.d) }
            ve(): int { @@:(self.e) }
        }
        $Done {
            va(): int { @@:(self.a) }
            vb(): int { @@:(self.b) }
            vc(): int { @@:(self.c) }
            vd(): int { @@:(self.d) }
            ve(): int { @@:(self.e) }
        }
    domain:
        a: int = 0
        b: int = 0
        c: int = 0
        d: int = 0
        e: int = 0
}
