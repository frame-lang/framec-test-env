@@[target("swift")]

// Test: Comparison operators in Frame handlers

@@system ComparisonTest {
    interface:
        test_greater(): Bool
        test_less(): Bool
        test_greater_equal(): Bool
        test_less_equal(): Bool
        test_equal(): Bool
        test_not_equal(): Bool
        set_values(x: Int, y: Int)

    machine:
        $Ready {
            test_greater(): Bool { if (self.a > self.b) { @@:(true) } else { @@:(false) } }
            test_less(): Bool { if (self.a < self.b) { @@:(true) } else { @@:(false) } }
            test_greater_equal(): Bool { if (self.a >= self.b) { @@:(true) } else { @@:(false) } }
            test_less_equal(): Bool { if (self.a <= self.b) { @@:(true) } else { @@:(false) } }
            test_equal(): Bool { if (self.a == self.b) { @@:(true) } else { @@:(false) } }
            test_not_equal(): Bool { if (self.a != self.b) { @@:(true) } else { @@:(false) } }
            set_values(x: Int, y: Int) { self.a = x; self.b = y }
        }

    domain:
        a: Int = 5
        b: Int = 3
}

// main
    print("TAP version 14")
    print("1..6")
    let s = @@ComparisonTest()

    if s.test_greater() { print("ok 1 - 5 > 3 is true") } else { print("not ok 1 - 5 > 3 is true") }
    if !s.test_less() { print("ok 2 - 5 < 3 is false") } else { print("not ok 2 - 5 < 3 is false") }
    if s.test_greater_equal() { print("ok 3 - 5 >= 3 is true") } else { print("not ok 3 - 5 >= 3 is true") }
    if !s.test_less_equal() { print("ok 4 - 5 <= 3 is false") } else { print("not ok 4 - 5 <= 3 is false") }
    if !s.test_equal() { print("ok 5 - 5 == 3 is false") } else { print("not ok 5 - 5 == 3 is false") }
    if s.test_not_equal() { print("ok 6 - 5 != 3 is true") } else { print("not ok 6 - 5 != 3 is true") }
