@@[target("csharp")]

// Cookbook 81: Infusion Pump (safety-critical)

using System;

@@system InfusionPump {
    interface:
        power_on()
        set_rate(ml_per_hr: double)
        prime()
        start_infusion()
        occlusion_detected()
        acknowledge_alarm()
        tick_minute()
        volume_delivered(): double = 0.0
        rate_mL_per_hr(): double
        alarm_reason(): string
        status(): string

    machine:
        $Off {
            power_on() { -> $Idle }
            status(): string { @@:("off") }
            rate_mL_per_hr(): double { @@:(this.rate) }
            volume_delivered(): double { @@:(this.volume) }
            alarm_reason(): string { @@:("") }
        }

        $Operational {
            occlusion_detected() { -> ("occlusion") $Alarm }
        }

        $Idle => $Operational {
            set_rate(ml_per_hr: double) { this.rate = ml_per_hr; }
            prime() {
                if (this.rate > 0.0) {
                    -> $Primed
                }
            }
            status(): string { @@:("idle") }
            rate_mL_per_hr(): double { @@:(this.rate) }
            volume_delivered(): double { @@:(this.volume) }
            alarm_reason(): string { @@:("") }
            => $^
        }

        $Primed => $Operational {
            start_infusion() { -> $Running }
            status(): string { @@:("primed") }
            rate_mL_per_hr(): double { @@:(this.rate) }
            volume_delivered(): double { @@:(this.volume) }
            alarm_reason(): string { @@:("") }
            => $^
        }

        $Running => $Operational {
            tick_minute() { this.volume = this.volume + this.rate / 60.0; }
            status(): string { @@:("running") }
            rate_mL_per_hr(): double { @@:(this.rate) }
            volume_delivered(): double { @@:(this.volume) }
            alarm_reason(): string { @@:("") }
            => $^
        }

        $Alarm {
            $.reason: string = "unknown"
            $>(reason: string) { $.reason = reason; }
            acknowledge_alarm() { -> $Idle }
            status(): string { @@:("alarm") }
            alarm_reason(): string { @@:($.reason) }
            rate_mL_per_hr(): double { @@:(this.rate) }
            volume_delivered(): double { @@:(this.volume) }
        }

    domain:
        rate: double = 0.0
        volume: double = 0.0
}

public class Program {
    static void Check(string label, string actual, string expected) {
        if (actual != expected) {
            Console.WriteLine($"FAIL: {label} expected '{expected}', got '{actual}'");
            Environment.Exit(1);
        }
    }
    static void CheckF(string label, double actual, double expected) {
        if (Math.Abs(actual - expected) > 1e-9) {
            Console.WriteLine($"FAIL: {label} expected {expected}, got {actual}");
            Environment.Exit(1);
        }
    }

    public static void Main() {
        var p = @@InfusionPump();
        Check("start off", (string)p.status(), "off");
        p.set_rate(100.0);
        CheckF("rate unchanged in Off", (double)p.rate_mL_per_hr(), 0.0);
        p.start_infusion();
        Check("still off", (string)p.status(), "off");
        p.power_on();
        Check("idle", (string)p.status(), "idle");
        p.set_rate(100.0);
        CheckF("rate set", (double)p.rate_mL_per_hr(), 100.0);
        p.start_infusion();
        Check("idle cannot start", (string)p.status(), "idle");
        CheckF("no volume yet", (double)p.volume_delivered(), 0.0);
        p.prime();
        Check("primed", (string)p.status(), "primed");
        p.start_infusion();
        Check("running", (string)p.status(), "running");
        for (int i = 0; i < 10; i = i + 1) p.tick_minute();
        Check("running still", (string)p.status(), "running");
        double volAfter10 = (double)p.volume_delivered();
        CheckF("volume ≈ 10*100/60", volAfter10, 10.0 * 100.0 / 60.0);
        p.occlusion_detected();
        Check("alarm on occlusion", (string)p.status(), "alarm");
        Check("alarm reason via state var", (string)p.alarm_reason(), "occlusion");
        p.start_infusion();
        p.prime();
        p.tick_minute();
        Check("alarm still alarm", (string)p.status(), "alarm");
        CheckF("volume locked in alarm", (double)p.volume_delivered(), volAfter10);
        p.acknowledge_alarm();
        Check("ack returns to idle", (string)p.status(), "idle");
        CheckF("rate persisted across alarm", (double)p.rate_mL_per_hr(), 100.0);
        p.prime();
        p.start_infusion();
        p.tick_minute();
        CheckF("volume continues from prior", (double)p.volume_delivered(), volAfter10 + 100.0 / 60.0);
        Console.WriteLine("PASS: infusion_pump");
    }
}
