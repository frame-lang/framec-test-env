@@[target("cpp")]

// Cookbook 85: Sepsis Hour-1 Bundle

@@system SepsisBundle {
    interface:
        recognize_sepsis()
        lactate_drawn(value: double)
        cultures_drawn()
        antibiotics_given()
        fluids_complete()
        reassess_map(map_mmhg: int)
        pressors_started()
        tick_minute()
        status(): std::string
        bundle_complete(): bool = false
        elapsed_min(): int
        pressors_indicated(): bool

    machine:
        $PreRecognition {
            recognize_sepsis() {
                this->elapsed = 0;
                this->lactate = 0.0;
                this->cultures = false;
                this->abx = false;
                this->fluids = false;
                this->reassessed = false;
                this->pressors_needed = false;
                this->pressors = false;
                -> $BundleActive
            }
            status(): std::string { @@:("pre-recognition") }
            elapsed_min(): int { @@:(this->elapsed) }
            pressors_indicated(): bool { @@:(this->pressors_needed) }
        }

        $BundleActive {
            lactate_drawn(value: double) {
                this->lactate = value;
                if (this->is_complete()) {
                    if (this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            cultures_drawn() {
                this->cultures = true;
                if (this->is_complete()) {
                    if (this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            antibiotics_given() {
                this->abx = true;
                if (this->is_complete()) {
                    if (this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            fluids_complete() {
                this->fluids = true;
                if (this->is_complete()) {
                    if (this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            reassess_map(map_mmhg: int) {
                this->reassessed = true;
                this->pressors_needed = map_mmhg < 65;
                if (this->is_complete()) {
                    if (this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            pressors_started() {
                this->pressors = true;
                if (this->is_complete()) {
                    if (this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            tick_minute() { this->elapsed = this->elapsed + 1; }
            status(): std::string { @@:("active") }
            elapsed_min(): int { @@:(this->elapsed) }
            pressors_indicated(): bool { @@:(this->pressors_needed) }
        }

        $OnTime {
            bundle_complete(): bool { @@:(true) }
            status(): std::string { @@:("on time") }
            elapsed_min(): int { @@:(this->elapsed) }
            pressors_indicated(): bool { @@:(this->pressors_needed) }
        }

        $Late {
            bundle_complete(): bool { @@:(true) }
            status(): std::string { @@:("late") }
            elapsed_min(): int { @@:(this->elapsed) }
            pressors_indicated(): bool { @@:(this->pressors_needed) }
        }

    actions:
        is_complete(): bool {
            bool base = this->cultures && this->abx && this->fluids && this->lactate > 0.0 && this->reassessed;
            if (this->pressors_needed) {
                return base && this->pressors;
            }
            return base;
        }

    domain:
        elapsed: int = 0
        lactate: double = 0.0
        cultures: bool = false
        abx: bool = false
        fluids: bool = false
        reassessed: bool = false
        pressors_needed: bool = false
        pressors: bool = false
}

#include <iostream>
#include <cstdlib>

static void check_str(const std::string& label, const std::string& actual, const std::string& expected) {
    if (actual != expected) { std::cout << "FAIL: " << label << " expected '" << expected << "', got '" << actual << "'\n"; std::exit(1); }
}
static void check_b(const std::string& label, bool actual, bool expected) {
    if (actual != expected) { std::cout << "FAIL: " << label << " expected " << expected << ", got " << actual << "\n"; std::exit(1); }
}

int main() {
    auto a = @@SepsisBundle();
    check_str("pre-recognition", a.status(), "pre-recognition");
    check_b("bundle_complete default false before recognize", a.bundle_complete(), false);
    a.lactate_drawn(3.4);
    a.antibiotics_given();
    check_str("pre-rec absorbs events", a.status(), "pre-recognition");
    a.recognize_sepsis();
    check_str("active", a.status(), "active");
    a.lactate_drawn(3.4);
    a.cultures_drawn();
    for (int i = 0; i < 15; i = i + 1) a.tick_minute();
    a.antibiotics_given();
    a.fluids_complete();
    check_str("still active after fluids", a.status(), "active");
    a.reassess_map(75);
    check_str("on time", a.status(), "on time");
    check_b("complete", a.bundle_complete(), true);
    check_b("no pressors indicated", a.pressors_indicated(), false);
    if (a.elapsed_min() > 60) { std::cout << "FAIL: over 60\n"; std::exit(1); }
    a.antibiotics_given();
    a.tick_minute();
    check_str("on time absorbs events", a.status(), "on time");

    auto b = @@SepsisBundle();
    b.recognize_sepsis();
    b.lactate_drawn(4.2);
    b.cultures_drawn();
    b.antibiotics_given();
    b.fluids_complete();
    for (int i = 0; i < 70; i = i + 1) b.tick_minute();
    b.reassess_map(58);
    check_str("active -- pressors pending", b.status(), "active");
    check_b("pressors flagged", b.pressors_indicated(), true);
    b.pressors_started();
    check_str("late terminal", b.status(), "late");
    check_b("complete (late)", b.bundle_complete(), true);
    if (b.elapsed_min() <= 60) { std::cout << "FAIL: under 60\n"; std::exit(1); }

    auto c = @@SepsisBundle();
    c.recognize_sepsis();
    c.lactate_drawn(2.0);
    c.cultures_drawn();
    c.antibiotics_given();
    c.fluids_complete();
    c.reassess_map(80);
    check_str("reassess completes w/o pressors", c.status(), "on time");

    std::cout << "PASS: sepsis_bundle\n";
    return 0;
}
