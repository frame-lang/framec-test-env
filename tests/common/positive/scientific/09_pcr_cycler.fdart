@@[target("dart")]

// Cookbook 80: PCR Thermal Cycler

import 'dart:io';

@@system PCRCycler(total_cycles: int) {
    interface:
        start()
        tick_minute()
        temperature(): double
        current_cycle(): int
        phase(): String

    machine:
        $Idle {
            start() {
                this.cycle = 0;
                -> $Denature
            }
            temperature(): double { @@:(25.0) }
            current_cycle(): int { @@:(this.cycle) }
            phase(): String { @@:("idle") }
        }

        $Running {
            current_cycle(): int { @@:(this.cycle) }
        }

        $Denature => $Running {
            $>() {
                this.cycle = this.cycle + 1;
                this.phase_min = 0;
            }
            tick_minute() {
                this.phase_min = this.phase_min + 1;
                if (this.phase_min >= 1) {
                    -> $Anneal
                }
            }
            temperature(): double { @@:(95.0) }
            phase(): String { @@:("denature") }
            => $^
        }

        $Anneal => $Running {
            $>() { this.phase_min = 0; }
            tick_minute() {
                this.phase_min = this.phase_min + 1;
                if (this.phase_min >= 1) {
                    -> $Extend
                }
            }
            temperature(): double { @@:(55.0) }
            phase(): String { @@:("anneal") }
            => $^
        }

        $Extend => $Running {
            $>() { this.phase_min = 0; }
            tick_minute() {
                this.phase_min = this.phase_min + 1;
                if (this.phase_min >= 2) {
                    if (this.cycle >= this.target) {
                        -> $FinalHold
                    } else {
                        -> $Denature
                    }
                }
            }
            temperature(): double { @@:(72.0) }
            phase(): String { @@:("extend") }
            => $^
        }

        $FinalHold {
            temperature(): double { @@:(4.0) }
            current_cycle(): int { @@:(this.cycle) }
            phase(): String { @@:("final hold") }
        }

    domain:
        target: int = total_cycles
        cycle: int = 0
        phase_min: int = 0
}

void check(String label, dynamic actual, dynamic expected) {
    if (actual != expected) {
        print("FAIL: $label expected '$expected', got '$actual'");
        exit(1);
    }
}
void checkF(String label, double actual, double expected) {
    if ((actual - expected).abs() > 1e-9) {
        print("FAIL: $label expected $expected, got $actual");
        exit(1);
    }
}

void main() {
    var p = @@PCRCycler(3);
    check("idle", p.phase(), "idle");
    checkF("idle temperature", p.temperature() as double, 25.0);
    check("idle cycle", p.current_cycle(), 0);
    p.tick_minute();
    check("idle absorbs tick", p.phase(), "idle");
    p.start();
    check("denature 1", p.phase(), "denature");
    check("cycle 1", p.current_cycle(), 1);
    checkF("95C", p.temperature() as double, 95.0);
    p.tick_minute();
    check("anneal 1", p.phase(), "anneal");
    checkF("55C", p.temperature() as double, 55.0);
    p.tick_minute();
    check("extend 1", p.phase(), "extend");
    checkF("72C", p.temperature() as double, 72.0);
    p.tick_minute();
    check("extend partway", p.phase(), "extend");
    p.tick_minute();
    check("denature 2", p.phase(), "denature");
    check("cycle 2", p.current_cycle(), 2);
    p.tick_minute(); check("anneal 2", p.phase(), "anneal");
    p.tick_minute(); check("extend 2", p.phase(), "extend");
    p.tick_minute(); p.tick_minute();
    check("denature 3", p.phase(), "denature");
    check("cycle 3", p.current_cycle(), 3);
    p.tick_minute(); p.tick_minute(); p.tick_minute();
    p.tick_minute();
    check("final hold", p.phase(), "final hold");
    checkF("4C", p.temperature() as double, 4.0);
    p.tick_minute();
    check("hold absorbs tick", p.phase(), "final hold");
    p.start();
    check("hold absorbs start", p.phase(), "final hold");
    print("PASS: pcr_cycler");
}
