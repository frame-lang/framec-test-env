@@[target("go")]

// Cookbook 82: Ventilator Breath Cycle

package main

import (
    "fmt"
    "os"
)

@@system Ventilator {
    interface:
        power_on()
        tick_ms(ms: int)
        patient_effort_detected()
        stop()
        phase(): string
        breath_count(): int

    machine:
        $Off {
            power_on() { -> $Inspiration }
            phase(): string { @@:("off") }
            breath_count(): int { @@:(s.breaths) }
        }

        $Ventilating {
            stop() { -> $Off }
            breath_count(): int { @@:(s.breaths) }
        }

        $Inspiration => $Ventilating {
            $>() {
                s.phase_ms = 0
                s.breaths = s.breaths + 1
            }
            tick_ms(ms: int) {
                s.phase_ms = s.phase_ms + ms
                if s.phase_ms >= 1000 {
                    -> $Expiration
                }
            }
            patient_effort_detected() { }
            phase(): string { @@:("inspiration") }
            => $^
        }

        $Expiration => $Ventilating {
            $>() { s.phase_ms = 0 }
            tick_ms(ms: int) {
                s.phase_ms = s.phase_ms + ms
                if s.phase_ms >= 1500 {
                    -> $Pause
                }
            }
            patient_effort_detected() { }
            phase(): string { @@:("expiration") }
            => $^
        }

        $Pause => $Ventilating {
            $>() { s.phase_ms = 0 }
            tick_ms(ms: int) {
                s.phase_ms = s.phase_ms + ms
                if s.phase_ms >= 500 {
                    -> $Inspiration
                }
            }
            patient_effort_detected() { -> $Inspiration }
            phase(): string { @@:("pause") }
            => $^
        }

    domain:
        phase_ms: int = 0
        breaths: int = 0
}

func check(label, actual, expected string) {
    if actual != expected {
        fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual)
        os.Exit(1)
    }
}
func checkI(label string, actual, expected int) {
    if actual != expected {
        fmt.Printf("FAIL: %s expected %d, got %d\n", label, expected, actual)
        os.Exit(1)
    }
}

func main() {
    v := @@Ventilator()
    check("start off", v.phase().(string), "off")
    v.power_on()
    check("inspiration on power-on", v.phase().(string), "inspiration")
    checkI("first breath counted", v.breath_count().(int), 1)
    v.patient_effort_detected()
    check("inspiration absorbs effort", v.phase().(string), "inspiration")
    v.tick_ms(500)
    check("mid inspiration", v.phase().(string), "inspiration")
    v.tick_ms(500)
    check("expiration", v.phase().(string), "expiration")
    v.patient_effort_detected()
    check("expiration absorbs effort", v.phase().(string), "expiration")
    v.tick_ms(1500)
    check("pause", v.phase().(string), "pause")
    v.patient_effort_detected()
    check("pause triggers next breath", v.phase().(string), "inspiration")
    checkI("breath 2 counted", v.breath_count().(int), 2)
    v.tick_ms(1000)
    check("expiration 2", v.phase().(string), "expiration")
    v.tick_ms(1500)
    check("pause 2", v.phase().(string), "pause")
    v.tick_ms(500)
    check("inspiration 3 passive", v.phase().(string), "inspiration")
    checkI("breath 3 counted", v.breath_count().(int), 3)
    v.stop()
    check("stopped", v.phase().(string), "off")
    checkI("breath count persists across stop", v.breath_count().(int), 3)
    v.tick_ms(10000)
    v.patient_effort_detected()
    check("off absorbs ticks and effort", v.phase().(string), "off")
    fmt.Println("PASS: ventilator")
}
