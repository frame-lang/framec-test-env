@@[target("c")]

// Cookbook 80: PCR Thermal Cycler

@@system PCRCycler(total_cycles: int) {
    interface:
        start()
        tick_minute()
        temperature(): double
        current_cycle(): int
        phase(): char*

    machine:
        $Idle {
            start() {
                self->cycle = 0;
                -> $Denature
            }
            temperature(): double { @@:(25.0) }
            current_cycle(): int { @@:(self->cycle) }
            phase(): char* { @@:("idle") }
        }

        $Running {
            current_cycle(): int { @@:(self->cycle) }
        }

        $Denature => $Running {
            $>() {
                self->cycle = self->cycle + 1;
                self->phase_min = 0;
            }
            tick_minute() {
                self->phase_min = self->phase_min + 1;
                if (self->phase_min >= 1) {
                    -> $Anneal
                }
            }
            temperature(): double { @@:(95.0) }
            phase(): char* { @@:("denature") }
            => $^
        }

        $Anneal => $Running {
            $>() { self->phase_min = 0; }
            tick_minute() {
                self->phase_min = self->phase_min + 1;
                if (self->phase_min >= 1) {
                    -> $Extend
                }
            }
            temperature(): double { @@:(55.0) }
            phase(): char* { @@:("anneal") }
            => $^
        }

        $Extend => $Running {
            $>() { self->phase_min = 0; }
            tick_minute() {
                self->phase_min = self->phase_min + 1;
                if (self->phase_min >= 2) {
                    if (self->cycle >= self->target) {
                        -> $FinalHold
                    } else {
                        -> $Denature
                    }
                }
            }
            temperature(): double { @@:(72.0) }
            phase(): char* { @@:("extend") }
            => $^
        }

        $FinalHold {
            temperature(): double { @@:(4.0) }
            current_cycle(): int { @@:(self->cycle) }
            phase(): char* { @@:("final hold") }
        }

    domain:
        target: int = total_cycles
        cycle: int = 0
        phase_min: int = 0
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

static void check_str(const char* label, const char* actual, const char* expected) {
    if (strcmp(actual, expected) != 0) {
        printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual);
        exit(1);
    }
}
static void check_f(const char* label, double actual, double expected) {
    if (fabs(actual - expected) > 1e-9) {
        printf("FAIL: %s expected %f, got %f\n", label, expected, actual);
        exit(1);
    }
}
static void check_i(const char* label, int actual, int expected) {
    if (actual != expected) {
        printf("FAIL: %s expected %d, got %d\n", label, expected, actual);
        exit(1);
    }
}

int main(void) {
    PCRCycler* p = @@PCRCycler(3);
    check_str("idle", PCRCycler_phase(p), "idle");
    check_f("idle temperature", PCRCycler_temperature(p), 25.0);
    check_i("idle cycle", PCRCycler_current_cycle(p), 0);
    PCRCycler_tick_minute(p);
    check_str("idle absorbs tick", PCRCycler_phase(p), "idle");
    PCRCycler_start(p);
    check_str("denature 1", PCRCycler_phase(p), "denature");
    check_i("cycle 1", PCRCycler_current_cycle(p), 1);
    check_f("95C", PCRCycler_temperature(p), 95.0);
    PCRCycler_tick_minute(p);
    check_str("anneal 1", PCRCycler_phase(p), "anneal");
    check_f("55C", PCRCycler_temperature(p), 55.0);
    PCRCycler_tick_minute(p);
    check_str("extend 1", PCRCycler_phase(p), "extend");
    check_f("72C", PCRCycler_temperature(p), 72.0);
    PCRCycler_tick_minute(p);
    check_str("extend partway", PCRCycler_phase(p), "extend");
    PCRCycler_tick_minute(p);
    check_str("denature 2", PCRCycler_phase(p), "denature");
    check_i("cycle 2", PCRCycler_current_cycle(p), 2);
    PCRCycler_tick_minute(p); check_str("anneal 2", PCRCycler_phase(p), "anneal");
    PCRCycler_tick_minute(p); check_str("extend 2", PCRCycler_phase(p), "extend");
    PCRCycler_tick_minute(p); PCRCycler_tick_minute(p);
    check_str("denature 3", PCRCycler_phase(p), "denature");
    check_i("cycle 3", PCRCycler_current_cycle(p), 3);
    PCRCycler_tick_minute(p); PCRCycler_tick_minute(p); PCRCycler_tick_minute(p);
    PCRCycler_tick_minute(p);
    check_str("final hold", PCRCycler_phase(p), "final hold");
    check_f("4C", PCRCycler_temperature(p), 4.0);
    PCRCycler_tick_minute(p);
    check_str("hold absorbs tick", PCRCycler_phase(p), "final hold");
    PCRCycler_start(p);
    check_str("hold absorbs start", PCRCycler_phase(p), "final hold");
    printf("PASS: pcr_cycler\n");
    PCRCycler_destroy(p);
    return 0;
}
