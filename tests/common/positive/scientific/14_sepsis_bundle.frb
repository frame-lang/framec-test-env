@@[target("ruby")]

# Cookbook 85: Sepsis Hour-1 Bundle

@@system SepsisBundle {
    interface:
        recognize_sepsis()
        lactate_drawn(value)
        cultures_drawn()
        antibiotics_given()
        fluids_complete()
        reassess_map(map_mmhg)
        pressors_started()
        tick_minute()
        status()
        bundle_complete() = false
        elapsed_min()
        pressors_indicated()

    machine:
        $PreRecognition {
            recognize_sepsis() {
                @elapsed = 0
                @lactate = 0.0
                @cultures = false
                @abx = false
                @fluids = false
                @reassessed = false
                @pressors_needed = false
                @pressors = false
                -> $BundleActive
            }
            status() { @@:("pre-recognition") }
            elapsed_min() { @@:(@elapsed) }
            pressors_indicated() { @@:(@pressors_needed) }
        }

        $BundleActive {
            lactate_drawn(value) {
                @lactate = value
                if self.is_complete
                    if @elapsed <= 60
                        -> $OnTime
                    else
                        -> $Late
                    end
                end
            }
            cultures_drawn() {
                @cultures = true
                if self.is_complete
                    if @elapsed <= 60
                        -> $OnTime
                    else
                        -> $Late
                    end
                end
            }
            antibiotics_given() {
                @abx = true
                if self.is_complete
                    if @elapsed <= 60
                        -> $OnTime
                    else
                        -> $Late
                    end
                end
            }
            fluids_complete() {
                @fluids = true
                if self.is_complete
                    if @elapsed <= 60
                        -> $OnTime
                    else
                        -> $Late
                    end
                end
            }
            reassess_map(map_mmhg) {
                @reassessed = true
                @pressors_needed = map_mmhg < 65
                if self.is_complete
                    if @elapsed <= 60
                        -> $OnTime
                    else
                        -> $Late
                    end
                end
            }
            pressors_started() {
                @pressors = true
                if self.is_complete
                    if @elapsed <= 60
                        -> $OnTime
                    else
                        -> $Late
                    end
                end
            }
            tick_minute() { @elapsed = @elapsed + 1 }
            status() { @@:("active") }
            elapsed_min() { @@:(@elapsed) }
            pressors_indicated() { @@:(@pressors_needed) }
        }

        $OnTime {
            bundle_complete() { @@:(true) }
            status() { @@:("on time") }
            elapsed_min() { @@:(@elapsed) }
            pressors_indicated() { @@:(@pressors_needed) }
        }

        $Late {
            bundle_complete() { @@:(true) }
            status() { @@:("late") }
            elapsed_min() { @@:(@elapsed) }
            pressors_indicated() { @@:(@pressors_needed) }
        }

    actions:
        is_complete() {
            base = @cultures && @abx && @fluids && @lactate > 0.0 && @reassessed
            if @pressors_needed
                return base && @pressors
            end
            return base
        }

    domain:
        elapsed = 0
        lactate = 0.0
        cultures = false
        abx = false
        fluids = false
        reassessed = false
        pressors_needed = false
        pressors = false
}

def check(label, actual, expected)
    if actual != expected
        puts "FAIL: #{label} expected '#{expected}', got '#{actual}'"
        exit(1)
    end
end

a = @@SepsisBundle()
check("pre-recognition", a.status, "pre-recognition")
check("bundle_complete default false before recognize", a.bundle_complete, false)
a.lactate_drawn(3.4)
a.antibiotics_given
check("pre-rec absorbs events", a.status, "pre-recognition")
a.recognize_sepsis
check("active", a.status, "active")
a.lactate_drawn(3.4)
a.cultures_drawn
15.times { a.tick_minute }
a.antibiotics_given
a.fluids_complete
check("still active after fluids", a.status, "active")
a.reassess_map(75)
check("on time", a.status, "on time")
check("complete", a.bundle_complete, true)
check("no pressors indicated", a.pressors_indicated, false)
if a.elapsed_min > 60
    puts "FAIL: over 60"
    exit(1)
end
a.antibiotics_given
a.tick_minute
check("on time absorbs events", a.status, "on time")

b = @@SepsisBundle()
b.recognize_sepsis
b.lactate_drawn(4.2)
b.cultures_drawn
b.antibiotics_given
b.fluids_complete
70.times { b.tick_minute }
b.reassess_map(58)
check("active — pressors pending", b.status, "active")
check("pressors flagged", b.pressors_indicated, true)
b.pressors_started
check("late terminal", b.status, "late")
check("complete (late)", b.bundle_complete, true)
if b.elapsed_min <= 60
    puts "FAIL: under 60"
    exit(1)
end

c = @@SepsisBundle()
c.recognize_sepsis
c.lactate_drawn(2.0)
c.cultures_drawn
c.antibiotics_given
c.fluids_complete
c.reassess_map(80)
check("reassess completes w/o pressors", c.status, "on time")

puts "PASS: sepsis_bundle"
