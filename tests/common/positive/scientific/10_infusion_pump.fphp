@@[target("php")]

// Cookbook 81: Infusion Pump (safety-critical)

@@system InfusionPump {
    interface:
        power_on()
        set_rate(ml_per_hr)
        prime()
        start_infusion()
        occlusion_detected()
        acknowledge_alarm()
        tick_minute()
        volume_delivered() = 0.0
        rate_mL_per_hr()
        alarm_reason()
        status()

    machine:
        $Off {
            power_on() { -> $Idle }
            status() { @@:("off") }
            rate_mL_per_hr() { @@:($this->rate) }
            volume_delivered() { @@:($this->volume) }
            alarm_reason() { @@:("") }
        }

        $Operational {
            occlusion_detected() { -> ("occlusion") $Alarm }
        }

        $Idle => $Operational {
            set_rate(ml_per_hr) { $this->rate = $ml_per_hr; }
            prime() {
                if ($this->rate > 0.0) {
                    -> $Primed
                }
            }
            status() { @@:("idle") }
            rate_mL_per_hr() { @@:($this->rate) }
            volume_delivered() { @@:($this->volume) }
            alarm_reason() { @@:("") }
            => $^
        }

        $Primed => $Operational {
            start_infusion() { -> $Running }
            status() { @@:("primed") }
            rate_mL_per_hr() { @@:($this->rate) }
            volume_delivered() { @@:($this->volume) }
            alarm_reason() { @@:("") }
            => $^
        }

        $Running => $Operational {
            tick_minute() { $this->volume = $this->volume + $this->rate / 60.0; }
            status() { @@:("running") }
            rate_mL_per_hr() { @@:($this->rate) }
            volume_delivered() { @@:($this->volume) }
            alarm_reason() { @@:("") }
            => $^
        }

        $Alarm {
            $.reason = "unknown"
            $>(reason) { $.reason = $reason; }
            acknowledge_alarm() { -> $Idle }
            status() { @@:("alarm") }
            alarm_reason() { @@:($.reason) }
            rate_mL_per_hr() { @@:($this->rate) }
            volume_delivered() { @@:($this->volume) }
        }

    domain:
        rate = 0.0
        volume = 0.0
}

function check($label, $actual, $expected) {
    if ($actual !== $expected) {
        echo "FAIL: $label expected '$expected', got '$actual'\n";
        exit(1);
    }
}
function check_f($label, $actual, $expected) {
    if (abs($actual - $expected) > 1e-9) {
        echo "FAIL: $label expected $expected, got $actual\n";
        exit(1);
    }
}

$p = @@InfusionPump();
check("start off", $p->status(), "off");
$p->set_rate(100.0);
check_f("rate unchanged in Off", $p->rate_mL_per_hr(), 0.0);
$p->start_infusion();
check("still off", $p->status(), "off");
$p->power_on();
check("idle", $p->status(), "idle");
$p->set_rate(100.0);
check_f("rate set", $p->rate_mL_per_hr(), 100.0);
$p->start_infusion();
check("idle cannot start", $p->status(), "idle");
check_f("no volume yet", $p->volume_delivered(), 0.0);
$p->prime();
check("primed", $p->status(), "primed");
$p->start_infusion();
check("running", $p->status(), "running");
for ($i = 0; $i < 10; $i = $i + 1) $p->tick_minute();
check("running still", $p->status(), "running");
$vol_after_10 = $p->volume_delivered();
check_f("volume ≈ 10*100/60", $vol_after_10, 10.0 * 100.0 / 60.0);
$p->occlusion_detected();
check("alarm on occlusion", $p->status(), "alarm");
check("alarm reason via state var", $p->alarm_reason(), "occlusion");
$p->start_infusion();
$p->prime();
$p->tick_minute();
check("alarm still alarm", $p->status(), "alarm");
check_f("volume locked in alarm", $p->volume_delivered(), $vol_after_10);
$p->acknowledge_alarm();
check("ack returns to idle", $p->status(), "idle");
check_f("rate persisted across alarm", $p->rate_mL_per_hr(), 100.0);
$p->prime();
$p->start_infusion();
$p->tick_minute();
check_f("volume continues from prior", $p->volume_delivered(), $vol_after_10 + 100.0 / 60.0);
echo "PASS: infusion_pump\n";
