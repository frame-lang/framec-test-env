@@[target("cpp")]

// Cookbook 82: Ventilator Breath Cycle

@@system Ventilator {
    interface:
        power_on()
        tick_ms(ms: int)
        patient_effort_detected()
        stop()
        phase(): std::string
        breath_count(): int

    machine:
        $Off {
            power_on() { -> $Inspiration }
            phase(): std::string { @@:("off") }
            breath_count(): int { @@:(this->breaths) }
        }

        $Ventilating {
            stop() { -> $Off }
            breath_count(): int { @@:(this->breaths) }
        }

        $Inspiration => $Ventilating {
            $>() {
                this->phase_ms = 0;
                this->breaths = this->breaths + 1;
            }
            tick_ms(ms: int) {
                this->phase_ms = this->phase_ms + ms;
                if (this->phase_ms >= 1000) {
                    -> $Expiration
                }
            }
            patient_effort_detected() { }
            phase(): std::string { @@:("inspiration") }
            => $^
        }

        $Expiration => $Ventilating {
            $>() { this->phase_ms = 0; }
            tick_ms(ms: int) {
                this->phase_ms = this->phase_ms + ms;
                if (this->phase_ms >= 1500) {
                    -> $Pause
                }
            }
            patient_effort_detected() { }
            phase(): std::string { @@:("expiration") }
            => $^
        }

        $Pause => $Ventilating {
            $>() { this->phase_ms = 0; }
            tick_ms(ms: int) {
                this->phase_ms = this->phase_ms + ms;
                if (this->phase_ms >= 500) {
                    -> $Inspiration
                }
            }
            patient_effort_detected() { -> $Inspiration }
            phase(): std::string { @@:("pause") }
            => $^
        }

    domain:
        phase_ms: int = 0
        breaths: int = 0
}

#include <iostream>
#include <cstdlib>

static void check_str(const std::string& label, const std::string& actual, const std::string& expected) {
    if (actual != expected) {
        std::cout << "FAIL: " << label << " expected '" << expected << "', got '" << actual << "'\n";
        std::exit(1);
    }
}
static void check_i(const std::string& label, int actual, int expected) {
    if (actual != expected) {
        std::cout << "FAIL: " << label << " expected " << expected << ", got " << actual << "\n";
        std::exit(1);
    }
}

int main() {
    auto v = @@Ventilator();
    check_str("start off", v.phase(), "off");
    v.power_on();
    check_str("inspiration on power-on", v.phase(), "inspiration");
    check_i("first breath counted", v.breath_count(), 1);
    v.patient_effort_detected();
    check_str("inspiration absorbs effort", v.phase(), "inspiration");
    v.tick_ms(500);
    check_str("mid inspiration", v.phase(), "inspiration");
    v.tick_ms(500);
    check_str("expiration", v.phase(), "expiration");
    v.patient_effort_detected();
    check_str("expiration absorbs effort", v.phase(), "expiration");
    v.tick_ms(1500);
    check_str("pause", v.phase(), "pause");
    v.patient_effort_detected();
    check_str("pause triggers next breath", v.phase(), "inspiration");
    check_i("breath 2 counted", v.breath_count(), 2);
    v.tick_ms(1000);
    check_str("expiration 2", v.phase(), "expiration");
    v.tick_ms(1500);
    check_str("pause 2", v.phase(), "pause");
    v.tick_ms(500);
    check_str("inspiration 3 passive", v.phase(), "inspiration");
    check_i("breath 3 counted", v.breath_count(), 3);
    v.stop();
    check_str("stopped", v.phase(), "off");
    check_i("breath count persists across stop", v.breath_count(), 3);
    v.tick_ms(10000);
    v.patient_effort_detected();
    check_str("off absorbs ticks and effort", v.phase(), "off");
    std::cout << "PASS: ventilator\n";
    return 0;
}
