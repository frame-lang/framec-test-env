@@[target("typescript")]

// Cookbook 83: AED / Defibrillator

@@system AED {
    interface:
        power_on()
        pads_attached()
        rhythm_detected(rhythm: string)
        tick_ms(ms: number)
        press_shock()
        confirm_clear()
        status(): string
        shock_count(): number
        charge_pct(): number

    machine:
        $Off {
            power_on() { -> $AwaitingPads }
            status(): string { @@:("off") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

        $AwaitingPads {
            pads_attached() { -> $Analyzing }
            status(): string { @@:("attach pads") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

        $Analyzing {
            rhythm_detected(rhythm: string) {
                this.last_rhythm = rhythm;
                if (rhythm === "VF" || rhythm === "VT") {
                    -> $Charging
                } else {
                    -> $NotAdvised
                }
            }
            status(): string { @@:("analyzing") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

        $Charging {
            $>() { this.charge_pct_dom = 0; }
            tick_ms(ms: number) {
                this.charge_pct_dom = this.charge_pct_dom + ms;
                if (this.charge_pct_dom >= 100) {
                    -> $AwaitingClear
                }
            }
            status(): string { @@:("charging") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

        $AwaitingClear {
            confirm_clear() { -> $ReadyToShock }
            status(): string { @@:("awaiting clear") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

        $ReadyToShock {
            press_shock() {
                this.shocks = this.shocks + 1;
                -> $Analyzing
            }
            status(): string { @@:("ready to shock") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

        $NotAdvised {
            status(): string { @@:("no shock advised") }
            shock_count(): number { @@:(this.shocks) }
            charge_pct(): number { @@:(this.charge_pct_dom) }
        }

    domain:
        last_rhythm: string = ""
        charge_pct_dom: number = 0
        shocks: number = 0
}

function check(label: string, actual: any, expected: any): void {
    if (actual !== expected) {
        console.log("FAIL: " + label + " expected '" + expected + "', got '" + actual + "'");
        process.exit(1);
    }
}

const a = @@AED();
check("start off", a.status(), "off");
a.press_shock();
check("off cannot shock", a.shock_count(), 0);
a.power_on();
check("awaiting pads", a.status(), "attach pads");
a.press_shock();
check("awaiting pads cannot shock", a.shock_count(), 0);
a.pads_attached();
check("analyzing", a.status(), "analyzing");
a.press_shock();
check("analyzing cannot shock", a.shock_count(), 0);
a.rhythm_detected("VF");
check("charging", a.status(), "charging");
a.press_shock();
check("charging cannot shock", a.shock_count(), 0);
a.tick_ms(50);
check("still charging", a.status(), "charging");
check("charge 50", a.charge_pct(), 50);
a.press_shock();
check("still cannot shock half-charged", a.shock_count(), 0);
a.tick_ms(50);
check("awaiting clear", a.status(), "awaiting clear");
a.press_shock();
check("awaiting clear cannot shock", a.shock_count(), 0);
a.confirm_clear();
check("ready", a.status(), "ready to shock");
a.press_shock();
check("shocked", a.shock_count(), 1);
check("back to analyzing", a.status(), "analyzing");
a.rhythm_detected("asystole");
check("no shock advised", a.status(), "no shock advised");
a.press_shock();
a.tick_ms(100);
a.confirm_clear();
check("not-advised absorbs everything", a.status(), "no shock advised");
check("still 1 shock total", a.shock_count(), 1);
console.log("PASS: aed");
