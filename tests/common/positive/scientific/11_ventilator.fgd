@@[target("gdscript")]

# Cookbook 82: Ventilator Breath Cycle

@@system Ventilator : RefCounted {
    interface:
        power_on()
        tick_ms(ms: int)
        patient_effort_detected()
        stop()
        phase(): String
        breath_count(): int

    machine:
        $Off {
            power_on() { -> $Inspiration }
            phase(): String { @@:("off") }
            breath_count(): int { @@:(self.breaths) }
        }

        $Ventilating {
            stop() { -> $Off }
            breath_count(): int { @@:(self.breaths) }
        }

        $Inspiration => $Ventilating {
            $>() {
                self.phase_ms = 0
                self.breaths = self.breaths + 1
            }
            tick_ms(ms: int) {
                self.phase_ms = self.phase_ms + ms
                if self.phase_ms >= 1000:
                    -> $Expiration
            }
            patient_effort_detected() { }
            phase(): String { @@:("inspiration") }
            => $^
        }

        $Expiration => $Ventilating {
            $>() { self.phase_ms = 0 }
            tick_ms(ms: int) {
                self.phase_ms = self.phase_ms + ms
                if self.phase_ms >= 1500:
                    -> $Pause
            }
            patient_effort_detected() { }
            phase(): String { @@:("expiration") }
            => $^
        }

        $Pause => $Ventilating {
            $>() { self.phase_ms = 0 }
            tick_ms(ms: int) {
                self.phase_ms = self.phase_ms + ms
                if self.phase_ms >= 500:
                    -> $Inspiration
            }
            patient_effort_detected() { -> $Inspiration }
            phase(): String { @@:("pause") }
            => $^
        }

    domain:
        phase_ms: int = 0
        breaths: int = 0
}

func check_str(label: String, actual: String, expected: String) -> void:
    if actual != expected:
        print("FAIL: %s expected '%s', got '%s'" % [label, expected, actual])
        quit(1)
func check_i(label: String, actual: int, expected: int) -> void:
    if actual != expected:
        print("FAIL: %s expected %d, got %d" % [label, expected, actual])
        quit(1)

func _init() -> void:
    var v = @@Ventilator()
    check_str("start off", v.phase(), "off")
    v.power_on()
    check_str("inspiration on power-on", v.phase(), "inspiration")
    check_i("first breath counted", v.breath_count(), 1)
    v.patient_effort_detected()
    check_str("inspiration absorbs effort", v.phase(), "inspiration")
    v.tick_ms(500)
    check_str("mid inspiration", v.phase(), "inspiration")
    v.tick_ms(500)
    check_str("expiration", v.phase(), "expiration")
    v.patient_effort_detected()
    check_str("expiration absorbs effort", v.phase(), "expiration")
    v.tick_ms(1500)
    check_str("pause", v.phase(), "pause")
    v.patient_effort_detected()
    check_str("pause triggers next breath", v.phase(), "inspiration")
    check_i("breath 2 counted", v.breath_count(), 2)
    v.tick_ms(1000)
    check_str("expiration 2", v.phase(), "expiration")
    v.tick_ms(1500)
    check_str("pause 2", v.phase(), "pause")
    v.tick_ms(500)
    check_str("inspiration 3 passive", v.phase(), "inspiration")
    check_i("breath 3 counted", v.breath_count(), 3)
    v.stop()
    check_str("stopped", v.phase(), "off")
    check_i("breath count persists across stop", v.breath_count(), 3)
    v.tick_ms(10000)
    v.patient_effort_detected()
    check_str("off absorbs ticks and effort", v.phase(), "off")
    print("PASS: ventilator")
    quit(0)
