@@[target("kotlin")]

// Cookbook 84: ACLS Cardiac Arrest Algorithm

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: String)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): String
        shocks_given(): Int
        cpr_cycles_done(): Int

    machine:
        $PreArrest {
            start_code() {
                this.shocks = 0
                this.cpr_cycles = 0
                -> $Analyzing
            }
            phase(): String { @@:("pre-arrest") }
            shocks_given(): Int { @@:(this.shocks) }
            cpr_cycles_done(): Int { @@:(this.cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): Int { @@:(this.shocks) }
            cpr_cycles_done(): Int { @@:(this.cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: String) {
                this.last_rhythm = rhythm
                if (rhythm == "VF" || rhythm == "pulseless_VT") {
                    this.shocks = this.shocks + 1
                    -> $CPR_Shockable
                } else {
                    -> $CPR_NonShockable
                }
            }
            phase(): String { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                this.cpr_cycles = this.cpr_cycles + 1
                -> $Analyzing
            }
            phase(): String { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                this.cpr_cycles = this.cpr_cycles + 1
                -> $Analyzing
            }
            phase(): String { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase(): String { @@:("rosc") }
            shocks_given(): Int { @@:(this.shocks) }
            cpr_cycles_done(): Int { @@:(this.cpr_cycles) }
        }

        $Terminated {
            phase(): String { @@:("terminated") }
            shocks_given(): Int { @@:(this.shocks) }
            cpr_cycles_done(): Int { @@:(this.cpr_cycles) }
        }

    domain:
        last_rhythm: String = ""
        shocks: Int = 0
        cpr_cycles: Int = 0
}

fun check(label: String, actual: String, expected: String) {
    if (actual != expected) {
        println("FAIL: $label expected '$expected', got '$actual'")
        kotlin.system.exitProcess(1)
    }
}
fun checkI(label: String, actual: Int, expected: Int) {
    if (actual != expected) {
        println("FAIL: $label expected $expected, got $actual")
        kotlin.system.exitProcess(1)
    }
}

fun main() {
    val c = @@ACLS()
    check("pre-arrest", c.phase() as String, "pre-arrest")
    c.rhythm_check("VF")
    c.cpr_cycle_complete()
    c.rosc_achieved()
    check("pre-arrest absorbs", c.phase() as String, "pre-arrest")
    c.start_code()
    check("analyzing", c.phase() as String, "analyzing")
    c.rhythm_check("VF")
    check("cpr shockable", c.phase() as String, "cpr shockable")
    checkI("1 shock", c.shocks_given() as Int, 1)
    c.give_epinephrine()
    check("epi no-op", c.phase() as String, "cpr shockable")
    c.cpr_cycle_complete()
    check("back to analyzing", c.phase() as String, "analyzing")
    checkI("1 cycle done", c.cpr_cycles_done() as Int, 1)
    c.rhythm_check("asystole")
    check("non-shockable cpr", c.phase() as String, "cpr non-shockable")
    checkI("still 1 shock", c.shocks_given() as Int, 1)
    c.cpr_cycle_complete()
    checkI("2 cycles done", c.cpr_cycles_done() as Int, 2)
    c.rhythm_check("pulseless_VT")
    check("shockable via VT", c.phase() as String, "cpr shockable")
    checkI("2 shocks", c.shocks_given() as Int, 2)
    c.rosc_achieved()
    check("rosc reached", c.phase() as String, "rosc")
    c.rhythm_check("VF")
    c.cpr_cycle_complete()
    c.rosc_achieved()
    check("rosc absorbs all", c.phase() as String, "rosc")
    checkI("final shock count", c.shocks_given() as Int, 2)

    val c2 = @@ACLS()
    c2.start_code()
    c2.rhythm_check("asystole")
    c2.pronounce()
    check("pronounced", c2.phase() as String, "terminated")
    c2.rosc_achieved()
    c2.rhythm_check("VF")
    check("terminated absorbs", c2.phase() as String, "terminated")

    println("PASS: acls")
}
