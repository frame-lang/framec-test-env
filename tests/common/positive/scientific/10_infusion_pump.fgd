@@[target("gdscript")]

extends SceneTree

# Cookbook 81: Infusion Pump (safety-critical)

@@system InfusionPump {
    interface:
        power_on()
        set_rate(ml_per_hr: float)
        prime()
        start_infusion()
        occlusion_detected()
        acknowledge_alarm()
        tick_minute()
        volume_delivered(): float = 0.0
        rate_mL_per_hr(): float
        alarm_reason(): String
        status(): String

    machine:
        $Off {
            power_on() { -> $Idle }
            status(): String { @@:("off") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): String { @@:("") }
        }

        $Operational {
            occlusion_detected() { -> ("occlusion") $Alarm }
        }

        $Idle => $Operational {
            set_rate(ml_per_hr: float) { self.rate = ml_per_hr }
            prime() {
                if self.rate > 0.0:
                    -> $Primed
            }
            status(): String { @@:("idle") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): String { @@:("") }
            => $^
        }

        $Primed => $Operational {
            start_infusion() { -> $Running }
            status(): String { @@:("primed") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): String { @@:("") }
            => $^
        }

        $Running => $Operational {
            tick_minute() { self.volume = self.volume + self.rate / 60.0 }
            status(): String { @@:("running") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): String { @@:("") }
            => $^
        }

        $Alarm {
            $.reason: String = "unknown"
            $>(reason: String) { $.reason = reason }
            acknowledge_alarm() { -> $Idle }
            status(): String { @@:("alarm") }
            alarm_reason(): String { @@:($.reason) }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
        }

    domain:
        rate: float = 0.0
        volume: float = 0.0
}

func check_str(label: String, actual: String, expected: String) -> void:
    if actual != expected:
        print("FAIL: %s expected '%s', got '%s'" % [label, expected, actual])
        quit(1)
func check_f(label: String, actual: float, expected: float) -> void:
    if abs(actual - expected) > 1e-9:
        print("FAIL: %s expected %f, got %f" % [label, expected, actual])
        quit(1)

func _init() -> void:
    var p = @@InfusionPump()
    check_str("start off", p.status(), "off")
    p.set_rate(100.0)
    check_f("rate unchanged in Off", p.rate_mL_per_hr(), 0.0)
    p.start_infusion()
    check_str("still off", p.status(), "off")
    p.power_on()
    check_str("idle", p.status(), "idle")
    p.set_rate(100.0)
    check_f("rate set", p.rate_mL_per_hr(), 100.0)
    p.start_infusion()
    check_str("idle cannot start", p.status(), "idle")
    check_f("no volume yet", p.volume_delivered(), 0.0)
    p.prime()
    check_str("primed", p.status(), "primed")
    p.start_infusion()
    check_str("running", p.status(), "running")
    for i in range(10):
        p.tick_minute()
    check_str("running still", p.status(), "running")
    var vol_after_10 = p.volume_delivered()
    check_f("volume ≈ 10*100/60", vol_after_10, 10.0 * 100.0 / 60.0)
    p.occlusion_detected()
    check_str("alarm on occlusion", p.status(), "alarm")
    check_str("alarm reason via state var", p.alarm_reason(), "occlusion")
    p.start_infusion()
    p.prime()
    p.tick_minute()
    check_str("alarm still alarm", p.status(), "alarm")
    check_f("volume locked in alarm", p.volume_delivered(), vol_after_10)
    p.acknowledge_alarm()
    check_str("ack returns to idle", p.status(), "idle")
    check_f("rate persisted across alarm", p.rate_mL_per_hr(), 100.0)
    p.prime()
    p.start_infusion()
    p.tick_minute()
    check_f("volume continues from prior", p.volume_delivered(), vol_after_10 + 100.0 / 60.0)
    print("PASS: infusion_pump")
    quit(0)
