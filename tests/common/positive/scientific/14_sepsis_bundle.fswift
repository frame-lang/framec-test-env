@@[target("swift")]

// Cookbook 85: Sepsis Hour-1 Bundle

import Foundation

@@system SepsisBundle {
    interface:
        recognize_sepsis()
        lactate_drawn(value: Double)
        cultures_drawn()
        antibiotics_given()
        fluids_complete()
        reassess_map(map_mmhg: Int)
        pressors_started()
        tick_minute()
        status(): String
        bundle_complete(): Bool = false
        elapsed_min(): Int
        pressors_indicated(): Bool

    machine:
        $PreRecognition {
            recognize_sepsis() {
                self.elapsed = 0
                self.lactate = 0.0
                self.cultures = false
                self.abx = false
                self.fluids = false
                self.reassessed = false
                self.pressors_needed = false
                self.pressors = false
                -> $BundleActive
            }
            status(): String { @@:("pre-recognition") }
            elapsed_min(): Int { @@:(self.elapsed) }
            pressors_indicated(): Bool { @@:(self.pressors_needed) }
        }

        $BundleActive {
            lactate_drawn(value: Double) {
                self.lactate = value
                if self.is_complete() {
                    if self.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            cultures_drawn() {
                self.cultures = true
                if self.is_complete() {
                    if self.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            antibiotics_given() {
                self.abx = true
                if self.is_complete() {
                    if self.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            fluids_complete() {
                self.fluids = true
                if self.is_complete() {
                    if self.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            reassess_map(map_mmhg: Int) {
                self.reassessed = true
                self.pressors_needed = map_mmhg < 65
                if self.is_complete() {
                    if self.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            pressors_started() {
                self.pressors = true
                if self.is_complete() {
                    if self.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            tick_minute() { self.elapsed = self.elapsed + 1 }
            status(): String { @@:("active") }
            elapsed_min(): Int { @@:(self.elapsed) }
            pressors_indicated(): Bool { @@:(self.pressors_needed) }
        }

        $OnTime {
            bundle_complete(): Bool { @@:(true) }
            status(): String { @@:("on time") }
            elapsed_min(): Int { @@:(self.elapsed) }
            pressors_indicated(): Bool { @@:(self.pressors_needed) }
        }

        $Late {
            bundle_complete(): Bool { @@:(true) }
            status(): String { @@:("late") }
            elapsed_min(): Int { @@:(self.elapsed) }
            pressors_indicated(): Bool { @@:(self.pressors_needed) }
        }

    actions:
        is_complete(): Bool {
            let base = self.cultures && self.abx && self.fluids && self.lactate > 0.0 && self.reassessed
            if self.pressors_needed {
                return base && self.pressors
            }
            return base
        }

    domain:
        elapsed: Int = 0
        lactate: Double = 0.0
        cultures: Bool = false
        abx: Bool = false
        fluids: Bool = false
        reassessed: Bool = false
        pressors_needed: Bool = false
        pressors: Bool = false
}

func check(_ label: String, _ actual: String, _ expected: String) {
    if actual != expected { print("FAIL: \(label) expected '\(expected)', got '\(actual)'"); exit(1) }
}
func checkB(_ label: String, _ actual: Bool, _ expected: Bool) {
    if actual != expected { print("FAIL: \(label) expected \(expected), got \(actual)"); exit(1) }
}

let a = @@SepsisBundle()
check("pre-recognition", a.status(), "pre-recognition")
checkB("bundle_complete default false before recognize", a.bundle_complete(), false)
a.lactate_drawn(3.4)
a.antibiotics_given()
check("pre-rec absorbs events", a.status(), "pre-recognition")
a.recognize_sepsis()
check("active", a.status(), "active")
a.lactate_drawn(3.4)
a.cultures_drawn()
var i = 0
while i < 15 { a.tick_minute(); i = i + 1 }
a.antibiotics_given()
a.fluids_complete()
check("still active after fluids", a.status(), "active")
a.reassess_map(75)
check("on time", a.status(), "on time")
checkB("complete", a.bundle_complete(), true)
checkB("no pressors indicated", a.pressors_indicated(), false)
if (a.elapsed_min()) > 60 { print("FAIL: over 60"); exit(1) }
a.antibiotics_given()
a.tick_minute()
check("on time absorbs events", a.status(), "on time")

let b = @@SepsisBundle()
b.recognize_sepsis()
b.lactate_drawn(4.2)
b.cultures_drawn()
b.antibiotics_given()
b.fluids_complete()
i = 0
while i < 70 { b.tick_minute(); i = i + 1 }
b.reassess_map(58)
check("active — pressors pending", b.status(), "active")
checkB("pressors flagged", b.pressors_indicated(), true)
b.pressors_started()
check("late terminal", b.status(), "late")
checkB("complete (late)", b.bundle_complete(), true)
if (b.elapsed_min()) <= 60 { print("FAIL: under 60"); exit(1) }

let c = @@SepsisBundle()
c.recognize_sepsis()
c.lactate_drawn(2.0)
c.cultures_drawn()
c.antibiotics_given()
c.fluids_complete()
c.reassess_map(80)
check("reassess completes w/o pressors", c.status(), "on time")

print("PASS: sepsis_bundle")
