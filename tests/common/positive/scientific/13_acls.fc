@@[target("c")]

// Cookbook 84: ACLS Cardiac Arrest Algorithm

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: char*)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): char*
        shocks_given(): int
        cpr_cycles_done(): int

    machine:
        $PreArrest {
            start_code() {
                self->shocks = 0;
                self->cpr_cycles = 0;
                -> $Analyzing
            }
            phase(): char* { @@:("pre-arrest") }
            shocks_given(): int { @@:(self->shocks) }
            cpr_cycles_done(): int { @@:(self->cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): int { @@:(self->shocks) }
            cpr_cycles_done(): int { @@:(self->cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: char*) {
                self->last_rhythm = rhythm;
                if (strcmp(rhythm, "VF") == 0 || strcmp(rhythm, "pulseless_VT") == 0) {
                    self->shocks = self->shocks + 1;
                    -> $CPR_Shockable
                } else {
                    -> $CPR_NonShockable
                }
            }
            phase(): char* { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                self->cpr_cycles = self->cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): char* { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                self->cpr_cycles = self->cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): char* { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase(): char* { @@:("rosc") }
            shocks_given(): int { @@:(self->shocks) }
            cpr_cycles_done(): int { @@:(self->cpr_cycles) }
        }

        $Terminated {
            phase(): char* { @@:("terminated") }
            shocks_given(): int { @@:(self->shocks) }
            cpr_cycles_done(): int { @@:(self->cpr_cycles) }
        }

    domain:
        last_rhythm: char* = ""
        shocks: int = 0
        cpr_cycles: int = 0
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static void check_str(const char* label, const char* actual, const char* expected) {
    if (strcmp(actual, expected) != 0) {
        printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual);
        exit(1);
    }
}
static void check_i(const char* label, int actual, int expected) {
    if (actual != expected) {
        printf("FAIL: %s expected %d, got %d\n", label, expected, actual);
        exit(1);
    }
}

int main(void) {
    ACLS* c = @@ACLS();
    check_str("pre-arrest", ACLS_phase(c), "pre-arrest");
    ACLS_rhythm_check(c, "VF");
    ACLS_cpr_cycle_complete(c);
    ACLS_rosc_achieved(c);
    check_str("pre-arrest absorbs", ACLS_phase(c), "pre-arrest");
    ACLS_start_code(c);
    check_str("analyzing", ACLS_phase(c), "analyzing");
    ACLS_rhythm_check(c, "VF");
    check_str("cpr shockable", ACLS_phase(c), "cpr shockable");
    check_i("1 shock", ACLS_shocks_given(c), 1);
    ACLS_give_epinephrine(c);
    check_str("epi no-op", ACLS_phase(c), "cpr shockable");
    ACLS_cpr_cycle_complete(c);
    check_str("back to analyzing", ACLS_phase(c), "analyzing");
    check_i("1 cycle done", ACLS_cpr_cycles_done(c), 1);
    ACLS_rhythm_check(c, "asystole");
    check_str("non-shockable cpr", ACLS_phase(c), "cpr non-shockable");
    check_i("still 1 shock", ACLS_shocks_given(c), 1);
    ACLS_cpr_cycle_complete(c);
    check_i("2 cycles done", ACLS_cpr_cycles_done(c), 2);
    ACLS_rhythm_check(c, "pulseless_VT");
    check_str("shockable via VT", ACLS_phase(c), "cpr shockable");
    check_i("2 shocks", ACLS_shocks_given(c), 2);
    ACLS_rosc_achieved(c);
    check_str("rosc reached", ACLS_phase(c), "rosc");
    ACLS_rhythm_check(c, "VF");
    ACLS_cpr_cycle_complete(c);
    ACLS_rosc_achieved(c);
    check_str("rosc absorbs all", ACLS_phase(c), "rosc");
    check_i("final shock count", ACLS_shocks_given(c), 2);

    ACLS* c2 = @@ACLS();
    ACLS_start_code(c2);
    ACLS_rhythm_check(c2, "asystole");
    ACLS_pronounce(c2);
    check_str("pronounced", ACLS_phase(c2), "terminated");
    ACLS_rosc_achieved(c2);
    ACLS_rhythm_check(c2, "VF");
    check_str("terminated absorbs", ACLS_phase(c2), "terminated");

    printf("PASS: acls\n");
    ACLS_destroy(c);
    ACLS_destroy(c2);
    return 0;
}
