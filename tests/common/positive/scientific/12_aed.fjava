@@[target("java")]

// Cookbook 83: AED / Defibrillator

@@system AED {
    interface:
        power_on()
        pads_attached()
        rhythm_detected(rhythm: String)
        tick_ms(ms: int)
        press_shock()
        confirm_clear()
        status(): String
        shock_count(): int
        charge_pct(): int

    machine:
        $Off {
            power_on() { -> $AwaitingPads }
            status(): String { @@:("off") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

        $AwaitingPads {
            pads_attached() { -> $Analyzing }
            status(): String { @@:("attach pads") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

        $Analyzing {
            rhythm_detected(rhythm: String) {
                this.last_rhythm = rhythm;
                if (rhythm.equals("VF") || rhythm.equals("VT")) {
                    -> $Charging
                } else {
                    -> $NotAdvised
                }
            }
            status(): String { @@:("analyzing") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

        $Charging {
            $>() { this.charge_pct_dom = 0; }
            tick_ms(ms: int) {
                this.charge_pct_dom = this.charge_pct_dom + ms;
                if (this.charge_pct_dom >= 100) {
                    -> $AwaitingClear
                }
            }
            status(): String { @@:("charging") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

        $AwaitingClear {
            confirm_clear() { -> $ReadyToShock }
            status(): String { @@:("awaiting clear") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

        $ReadyToShock {
            press_shock() {
                this.shocks = this.shocks + 1;
                -> $Analyzing
            }
            status(): String { @@:("ready to shock") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

        $NotAdvised {
            status(): String { @@:("no shock advised") }
            shock_count(): int { @@:(this.shocks) }
            charge_pct(): int { @@:(this.charge_pct_dom) }
        }

    domain:
        last_rhythm: String = ""
        charge_pct_dom: int = 0
        shocks: int = 0
}

public class AED12Test {
    static void check(String label, String actual, String expected) {
        if (!actual.equals(expected)) {
            System.out.println("FAIL: " + label + " expected '" + expected + "', got '" + actual + "'");
            System.exit(1);
        }
    }
    static void checkI(String label, int actual, int expected) {
        if (actual != expected) {
            System.out.println("FAIL: " + label + " expected " + expected + ", got " + actual);
            System.exit(1);
        }
    }

    public static void main(String[] args) {
        AED a = @@AED();
        check("start off", (String) a.status(), "off");
        a.press_shock();
        checkI("off cannot shock", (int) a.shock_count(), 0);
        a.power_on();
        check("awaiting pads", (String) a.status(), "attach pads");
        a.press_shock();
        checkI("awaiting pads cannot shock", (int) a.shock_count(), 0);
        a.pads_attached();
        check("analyzing", (String) a.status(), "analyzing");
        a.press_shock();
        checkI("analyzing cannot shock", (int) a.shock_count(), 0);
        a.rhythm_detected("VF");
        check("charging", (String) a.status(), "charging");
        a.press_shock();
        checkI("charging cannot shock", (int) a.shock_count(), 0);
        a.tick_ms(50);
        check("still charging", (String) a.status(), "charging");
        checkI("charge 50", (int) a.charge_pct(), 50);
        a.press_shock();
        checkI("still cannot shock half-charged", (int) a.shock_count(), 0);
        a.tick_ms(50);
        check("awaiting clear", (String) a.status(), "awaiting clear");
        a.press_shock();
        checkI("awaiting clear cannot shock", (int) a.shock_count(), 0);
        a.confirm_clear();
        check("ready", (String) a.status(), "ready to shock");
        a.press_shock();
        checkI("shocked", (int) a.shock_count(), 1);
        check("back to analyzing", (String) a.status(), "analyzing");
        a.rhythm_detected("asystole");
        check("no shock advised", (String) a.status(), "no shock advised");
        a.press_shock();
        a.tick_ms(100);
        a.confirm_clear();
        check("not-advised absorbs everything", (String) a.status(), "no shock advised");
        checkI("still 1 shock total", (int) a.shock_count(), 1);
        System.out.println("PASS: aed");
    }
}
