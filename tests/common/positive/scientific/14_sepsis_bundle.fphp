@@[target("php")]

// Cookbook 85: Sepsis Hour-1 Bundle

@@system SepsisBundle {
    interface:
        recognize_sepsis()
        lactate_drawn(value)
        cultures_drawn()
        antibiotics_given()
        fluids_complete()
        reassess_map(map_mmhg)
        pressors_started()
        tick_minute()
        status()
        bundle_complete() = false
        elapsed_min()
        pressors_indicated()

    machine:
        $PreRecognition {
            recognize_sepsis() {
                $this->elapsed = 0;
                $this->lactate = 0.0;
                $this->cultures = false;
                $this->abx = false;
                $this->fluids = false;
                $this->reassessed = false;
                $this->pressors_needed = false;
                $this->pressors = false;
                -> $BundleActive
            }
            status() { @@:("pre-recognition") }
            elapsed_min() { @@:($this->elapsed) }
            pressors_indicated() { @@:($this->pressors_needed) }
        }

        $BundleActive {
            lactate_drawn(value) {
                $this->lactate = $value;
                if ($this->is_complete()) {
                    if ($this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            cultures_drawn() {
                $this->cultures = true;
                if ($this->is_complete()) {
                    if ($this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            antibiotics_given() {
                $this->abx = true;
                if ($this->is_complete()) {
                    if ($this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            fluids_complete() {
                $this->fluids = true;
                if ($this->is_complete()) {
                    if ($this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            reassess_map(map_mmhg) {
                $this->reassessed = true;
                $this->pressors_needed = $map_mmhg < 65;
                if ($this->is_complete()) {
                    if ($this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            pressors_started() {
                $this->pressors = true;
                if ($this->is_complete()) {
                    if ($this->elapsed <= 60) { -> $OnTime } else { -> $Late }
                }
            }
            tick_minute() { $this->elapsed = $this->elapsed + 1; }
            status() { @@:("active") }
            elapsed_min() { @@:($this->elapsed) }
            pressors_indicated() { @@:($this->pressors_needed) }
        }

        $OnTime {
            bundle_complete() { @@:(true) }
            status() { @@:("on time") }
            elapsed_min() { @@:($this->elapsed) }
            pressors_indicated() { @@:($this->pressors_needed) }
        }

        $Late {
            bundle_complete() { @@:(true) }
            status() { @@:("late") }
            elapsed_min() { @@:($this->elapsed) }
            pressors_indicated() { @@:($this->pressors_needed) }
        }

    actions:
        is_complete() {
            $base = $this->cultures && $this->abx && $this->fluids && $this->lactate > 0.0 && $this->reassessed;
            if ($this->pressors_needed) {
                return $base && $this->pressors;
            }
            return $base;
        }

    domain:
        elapsed = 0
        lactate = 0.0
        cultures = false
        abx = false
        fluids = false
        reassessed = false
        pressors_needed = false
        pressors = false
}

function check($label, $actual, $expected) {
    if ($actual !== $expected) { echo "FAIL: $label expected '$expected', got '$actual'\n"; exit(1); }
}

$a = @@SepsisBundle();
check("pre-recognition", $a->status(), "pre-recognition");
check("bundle_complete default false before recognize", $a->bundle_complete(), false);
$a->lactate_drawn(3.4);
$a->antibiotics_given();
check("pre-rec absorbs events", $a->status(), "pre-recognition");
$a->recognize_sepsis();
check("active", $a->status(), "active");
$a->lactate_drawn(3.4);
$a->cultures_drawn();
for ($i = 0; $i < 15; $i = $i + 1) $a->tick_minute();
$a->antibiotics_given();
$a->fluids_complete();
check("still active after fluids", $a->status(), "active");
$a->reassess_map(75);
check("on time", $a->status(), "on time");
check("complete", $a->bundle_complete(), true);
check("no pressors indicated", $a->pressors_indicated(), false);
if ($a->elapsed_min() > 60) { echo "FAIL: over 60\n"; exit(1); }
$a->antibiotics_given();
$a->tick_minute();
check("on time absorbs events", $a->status(), "on time");

$b = @@SepsisBundle();
$b->recognize_sepsis();
$b->lactate_drawn(4.2);
$b->cultures_drawn();
$b->antibiotics_given();
$b->fluids_complete();
for ($i = 0; $i < 70; $i = $i + 1) $b->tick_minute();
$b->reassess_map(58);
check("active — pressors pending", $b->status(), "active");
check("pressors flagged", $b->pressors_indicated(), true);
$b->pressors_started();
check("late terminal", $b->status(), "late");
check("complete (late)", $b->bundle_complete(), true);
if ($b->elapsed_min() <= 60) { echo "FAIL: under 60\n"; exit(1); }

$c = @@SepsisBundle();
$c->recognize_sepsis();
$c->lactate_drawn(2.0);
$c->cultures_drawn();
$c->antibiotics_given();
$c->fluids_complete();
$c->reassess_map(80);
check("reassess completes w/o pressors", $c->status(), "on time");

echo "PASS: sepsis_bundle\n";
