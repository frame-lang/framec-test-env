@@[target("dart")]

// Cookbook 84: ACLS Cardiac Arrest Algorithm

import 'dart:io';

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: String)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): String
        shocks_given(): int
        cpr_cycles_done(): int

    machine:
        $PreArrest {
            start_code() {
                this.shocks = 0;
                this.cpr_cycles = 0;
                -> $Analyzing
            }
            phase(): String { @@:("pre-arrest") }
            shocks_given(): int { @@:(this.shocks) }
            cpr_cycles_done(): int { @@:(this.cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): int { @@:(this.shocks) }
            cpr_cycles_done(): int { @@:(this.cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: String) {
                this.last_rhythm = rhythm;
                if (rhythm == "VF" || rhythm == "pulseless_VT") {
                    this.shocks = this.shocks + 1;
                    -> $CPR_Shockable
                } else {
                    -> $CPR_NonShockable
                }
            }
            phase(): String { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                this.cpr_cycles = this.cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): String { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                this.cpr_cycles = this.cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): String { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase(): String { @@:("rosc") }
            shocks_given(): int { @@:(this.shocks) }
            cpr_cycles_done(): int { @@:(this.cpr_cycles) }
        }

        $Terminated {
            phase(): String { @@:("terminated") }
            shocks_given(): int { @@:(this.shocks) }
            cpr_cycles_done(): int { @@:(this.cpr_cycles) }
        }

    domain:
        last_rhythm: String = ""
        shocks: int = 0
        cpr_cycles: int = 0
}

void check(String label, dynamic actual, dynamic expected) {
    if (actual != expected) {
        print("FAIL: $label expected '$expected', got '$actual'");
        exit(1);
    }
}

void main() {
    var c = @@ACLS();
    check("pre-arrest", c.phase(), "pre-arrest");
    c.rhythm_check("VF");
    c.cpr_cycle_complete();
    c.rosc_achieved();
    check("pre-arrest absorbs", c.phase(), "pre-arrest");
    c.start_code();
    check("analyzing", c.phase(), "analyzing");
    c.rhythm_check("VF");
    check("cpr shockable", c.phase(), "cpr shockable");
    check("1 shock", c.shocks_given(), 1);
    c.give_epinephrine();
    check("epi no-op", c.phase(), "cpr shockable");
    c.cpr_cycle_complete();
    check("back to analyzing", c.phase(), "analyzing");
    check("1 cycle done", c.cpr_cycles_done(), 1);
    c.rhythm_check("asystole");
    check("non-shockable cpr", c.phase(), "cpr non-shockable");
    check("still 1 shock", c.shocks_given(), 1);
    c.cpr_cycle_complete();
    check("2 cycles done", c.cpr_cycles_done(), 2);
    c.rhythm_check("pulseless_VT");
    check("shockable via VT", c.phase(), "cpr shockable");
    check("2 shocks", c.shocks_given(), 2);
    c.rosc_achieved();
    check("rosc reached", c.phase(), "rosc");
    c.rhythm_check("VF");
    c.cpr_cycle_complete();
    c.rosc_achieved();
    check("rosc absorbs all", c.phase(), "rosc");
    check("final shock count", c.shocks_given(), 2);

    var c2 = @@ACLS();
    c2.start_code();
    c2.rhythm_check("asystole");
    c2.pronounce();
    check("pronounced", c2.phase(), "terminated");
    c2.rosc_achieved();
    c2.rhythm_check("VF");
    check("terminated absorbs", c2.phase(), "terminated");

    print("PASS: acls");
}
