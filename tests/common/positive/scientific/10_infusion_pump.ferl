@@[target("erlang")]

%% Cookbook 81: Infusion Pump (safety-critical)

@@system InfusionPump {
    interface:
        power_on()
        set_rate(ml_per_hr: float)
        prime()
        start_infusion()
        occlusion_detected()
        acknowledge_alarm()
        tick_minute()
        volume_delivered(): float = 0.0
        rate_mL_per_hr(): float
        alarm_reason(): string
        status(): string

    machine:
        $Off {
            power_on() { -> $Idle }
            status(): string { @@:("off") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): string { @@:("") }
        }

        $Operational {
            occlusion_detected() { -> ("occlusion") $Alarm }
        }

        $Idle => $Operational {
            set_rate(ml_per_hr: float) { self.rate = Ml_per_hr }
            prime() {
                case self.rate > 0.0 of
                    true -> -> $Primed;
                    false -> ok
                end
            }
            status(): string { @@:("idle") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): string { @@:("") }
            => $^
        }

        $Primed => $Operational {
            start_infusion() { -> $Running }
            status(): string { @@:("primed") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): string { @@:("") }
            => $^
        }

        $Running => $Operational {
            tick_minute() { self.volume = self.volume + self.rate / 60.0 }
            status(): string { @@:("running") }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
            alarm_reason(): string { @@:("") }
            => $^
        }

        $Alarm {
            $.reason: string = "unknown"
            $>(reason: string) { $.reason = Reason }
            acknowledge_alarm() { -> $Idle }
            status(): string { @@:("alarm") }
            alarm_reason(): string { @@:($.reason) }
            rate_mL_per_hr(): float { @@:(self.rate) }
            volume_delivered(): float { @@:(self.volume) }
        }

    domain:
        rate: float = 0.0
        volume: float = 0.0
}
