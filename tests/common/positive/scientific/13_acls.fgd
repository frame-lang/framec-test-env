@@[target("gdscript")]

extends SceneTree

# Cookbook 84: ACLS Cardiac Arrest Algorithm

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: String)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): String
        shocks_given(): int
        cpr_cycles_done(): int

    machine:
        $PreArrest {
            start_code() {
                self.shocks = 0
                self.cpr_cycles = 0
                -> $Analyzing
            }
            phase(): String { @@:("pre-arrest") }
            shocks_given(): int { @@:(self.shocks) }
            cpr_cycles_done(): int { @@:(self.cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): int { @@:(self.shocks) }
            cpr_cycles_done(): int { @@:(self.cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: String) {
                self.last_rhythm = rhythm
                if rhythm == "VF" or rhythm == "pulseless_VT":
                    self.shocks = self.shocks + 1
                    -> $CPR_Shockable
                else:
                    -> $CPR_NonShockable
            }
            phase(): String { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                self.cpr_cycles = self.cpr_cycles + 1
                -> $Analyzing
            }
            phase(): String { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                self.cpr_cycles = self.cpr_cycles + 1
                -> $Analyzing
            }
            phase(): String { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase(): String { @@:("rosc") }
            shocks_given(): int { @@:(self.shocks) }
            cpr_cycles_done(): int { @@:(self.cpr_cycles) }
        }

        $Terminated {
            phase(): String { @@:("terminated") }
            shocks_given(): int { @@:(self.shocks) }
            cpr_cycles_done(): int { @@:(self.cpr_cycles) }
        }

    domain:
        last_rhythm: String = ""
        shocks: int = 0
        cpr_cycles: int = 0
}

func check_str(label: String, actual: String, expected: String) -> void:
    if actual != expected:
        print("FAIL: %s expected '%s', got '%s'" % [label, expected, actual])
        quit(1)
func check_i(label: String, actual: int, expected: int) -> void:
    if actual != expected:
        print("FAIL: %s expected %d, got %d" % [label, expected, actual])
        quit(1)

func _init() -> void:
    var c = @@ACLS()
    check_str("pre-arrest", c.phase(), "pre-arrest")
    c.rhythm_check("VF")
    c.cpr_cycle_complete()
    c.rosc_achieved()
    check_str("pre-arrest absorbs", c.phase(), "pre-arrest")
    c.start_code()
    check_str("analyzing", c.phase(), "analyzing")
    c.rhythm_check("VF")
    check_str("cpr shockable", c.phase(), "cpr shockable")
    check_i("1 shock", c.shocks_given(), 1)
    c.give_epinephrine()
    check_str("epi no-op", c.phase(), "cpr shockable")
    c.cpr_cycle_complete()
    check_str("back to analyzing", c.phase(), "analyzing")
    check_i("1 cycle done", c.cpr_cycles_done(), 1)
    c.rhythm_check("asystole")
    check_str("non-shockable cpr", c.phase(), "cpr non-shockable")
    check_i("still 1 shock", c.shocks_given(), 1)
    c.cpr_cycle_complete()
    check_i("2 cycles done", c.cpr_cycles_done(), 2)
    c.rhythm_check("pulseless_VT")
    check_str("shockable via VT", c.phase(), "cpr shockable")
    check_i("2 shocks", c.shocks_given(), 2)
    c.rosc_achieved()
    check_str("rosc reached", c.phase(), "rosc")
    c.rhythm_check("VF")
    c.cpr_cycle_complete()
    c.rosc_achieved()
    check_str("rosc absorbs all", c.phase(), "rosc")
    check_i("final shock count", c.shocks_given(), 2)

    var c2 = @@ACLS()
    c2.start_code()
    c2.rhythm_check("asystole")
    c2.pronounce()
    check_str("pronounced", c2.phase(), "terminated")
    c2.rosc_achieved()
    c2.rhythm_check("VF")
    check_str("terminated absorbs", c2.phase(), "terminated")

    print("PASS: acls")
    quit(0)
