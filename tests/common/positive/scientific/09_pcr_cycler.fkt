@@[target("kotlin")]

// Cookbook 80: PCR Thermal Cycler

@@system PCRCycler(total_cycles: Int) {
    interface:
        start()
        tick_minute()
        temperature(): Double
        current_cycle(): Int
        phase(): String

    machine:
        $Idle {
            start() {
                this.cycle = 0
                -> $Denature
            }
            temperature(): Double { @@:(25.0) }
            current_cycle(): Int { @@:(this.cycle) }
            phase(): String { @@:("idle") }
        }

        $Running {
            current_cycle(): Int { @@:(this.cycle) }
        }

        $Denature => $Running {
            $>() {
                this.cycle = this.cycle + 1
                this.phase_min = 0
            }
            tick_minute() {
                this.phase_min = this.phase_min + 1
                if (this.phase_min >= 1) {
                    -> $Anneal
                }
            }
            temperature(): Double { @@:(95.0) }
            phase(): String { @@:("denature") }
            => $^
        }

        $Anneal => $Running {
            $>() { this.phase_min = 0 }
            tick_minute() {
                this.phase_min = this.phase_min + 1
                if (this.phase_min >= 1) {
                    -> $Extend
                }
            }
            temperature(): Double { @@:(55.0) }
            phase(): String { @@:("anneal") }
            => $^
        }

        $Extend => $Running {
            $>() { this.phase_min = 0 }
            tick_minute() {
                this.phase_min = this.phase_min + 1
                if (this.phase_min >= 2) {
                    if (this.cycle >= this.target) {
                        -> $FinalHold
                    } else {
                        -> $Denature
                    }
                }
            }
            temperature(): Double { @@:(72.0) }
            phase(): String { @@:("extend") }
            => $^
        }

        $FinalHold {
            temperature(): Double { @@:(4.0) }
            current_cycle(): Int { @@:(this.cycle) }
            phase(): String { @@:("final hold") }
        }

    domain:
        target: Int = total_cycles
        cycle: Int = 0
        phase_min: Int = 0
}

fun check(label: String, actual: String, expected: String) {
    if (actual != expected) {
        println("FAIL: $label expected '$expected', got '$actual'")
        kotlin.system.exitProcess(1)
    }
}
fun checkF(label: String, actual: Double, expected: Double) {
    if (kotlin.math.abs(actual - expected) > 1e-9) {
        println("FAIL: $label expected $expected, got $actual")
        kotlin.system.exitProcess(1)
    }
}
fun checkI(label: String, actual: Int, expected: Int) {
    if (actual != expected) {
        println("FAIL: $label expected $expected, got $actual")
        kotlin.system.exitProcess(1)
    }
}

fun main() {
    val p = @@PCRCycler(3)
    check("idle", p.phase() as String, "idle")
    checkF("idle temperature", p.temperature() as Double, 25.0)
    checkI("idle cycle", p.current_cycle() as Int, 0)
    p.tick_minute()
    check("idle absorbs tick", p.phase() as String, "idle")
    p.start()
    check("denature 1", p.phase() as String, "denature")
    checkI("cycle 1", p.current_cycle() as Int, 1)
    checkF("95C", p.temperature() as Double, 95.0)
    p.tick_minute()
    check("anneal 1", p.phase() as String, "anneal")
    checkF("55C", p.temperature() as Double, 55.0)
    p.tick_minute()
    check("extend 1", p.phase() as String, "extend")
    checkF("72C", p.temperature() as Double, 72.0)
    p.tick_minute()
    check("extend partway", p.phase() as String, "extend")
    p.tick_minute()
    check("denature 2", p.phase() as String, "denature")
    checkI("cycle 2", p.current_cycle() as Int, 2)
    p.tick_minute(); check("anneal 2", p.phase() as String, "anneal")
    p.tick_minute(); check("extend 2", p.phase() as String, "extend")
    p.tick_minute(); p.tick_minute()
    check("denature 3", p.phase() as String, "denature")
    checkI("cycle 3", p.current_cycle() as Int, 3)
    p.tick_minute(); p.tick_minute(); p.tick_minute()
    p.tick_minute()
    check("final hold", p.phase() as String, "final hold")
    checkF("4C", p.temperature() as Double, 4.0)
    p.tick_minute()
    check("hold absorbs tick", p.phase() as String, "final hold")
    p.start()
    check("hold absorbs start", p.phase() as String, "final hold")
    println("PASS: pcr_cycler")
}
