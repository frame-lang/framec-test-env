@@[target("typescript")]

// Cookbook 80: PCR Thermal Cycler

@@system PCRCycler(total_cycles: number) {
    interface:
        start()
        tick_minute()
        temperature(): number
        current_cycle(): number
        phase(): string

    machine:
        $Idle {
            start() {
                this.cycle = 0;
                -> $Denature
            }
            temperature(): number { @@:(25.0) }
            current_cycle(): number { @@:(this.cycle) }
            phase(): string { @@:("idle") }
        }

        $Running {
            current_cycle(): number { @@:(this.cycle) }
        }

        $Denature => $Running {
            $>() {
                this.cycle = this.cycle + 1;
                this.phase_min = 0;
            }
            tick_minute() {
                this.phase_min = this.phase_min + 1;
                if (this.phase_min >= 1) {
                    -> $Anneal
                }
            }
            temperature(): number { @@:(95.0) }
            phase(): string { @@:("denature") }
            => $^
        }

        $Anneal => $Running {
            $>() { this.phase_min = 0; }
            tick_minute() {
                this.phase_min = this.phase_min + 1;
                if (this.phase_min >= 1) {
                    -> $Extend
                }
            }
            temperature(): number { @@:(55.0) }
            phase(): string { @@:("anneal") }
            => $^
        }

        $Extend => $Running {
            $>() { this.phase_min = 0; }
            tick_minute() {
                this.phase_min = this.phase_min + 1;
                if (this.phase_min >= 2) {
                    if (this.cycle >= this.target) {
                        -> $FinalHold
                    } else {
                        -> $Denature
                    }
                }
            }
            temperature(): number { @@:(72.0) }
            phase(): string { @@:("extend") }
            => $^
        }

        $FinalHold {
            temperature(): number { @@:(4.0) }
            current_cycle(): number { @@:(this.cycle) }
            phase(): string { @@:("final hold") }
        }

    domain:
        target: number = total_cycles
        cycle: number = 0
        phase_min: number = 0
}

function check(label: string, actual: any, expected: any): void {
    if (actual !== expected) {
        console.log("FAIL: " + label + " expected '" + expected + "', got '" + actual + "'");
        process.exit(1);
    }
}
function checkF(label: string, actual: number, expected: number): void {
    if (Math.abs(actual - expected) > 1e-9) {
        console.log("FAIL: " + label + " expected " + expected + ", got " + actual);
        process.exit(1);
    }
}

const p = @@PCRCycler(3);
check("idle", p.phase(), "idle");
checkF("idle temperature", p.temperature(), 25.0);
check("idle cycle", p.current_cycle(), 0);
p.tick_minute();
check("idle absorbs tick", p.phase(), "idle");
p.start();
check("denature 1", p.phase(), "denature");
check("cycle 1", p.current_cycle(), 1);
checkF("95C", p.temperature(), 95.0);
p.tick_minute();
check("anneal 1", p.phase(), "anneal");
checkF("55C", p.temperature(), 55.0);
p.tick_minute();
check("extend 1", p.phase(), "extend");
checkF("72C", p.temperature(), 72.0);
p.tick_minute();
check("extend partway", p.phase(), "extend");
p.tick_minute();
check("denature 2", p.phase(), "denature");
check("cycle 2", p.current_cycle(), 2);
p.tick_minute(); check("anneal 2", p.phase(), "anneal");
p.tick_minute(); check("extend 2", p.phase(), "extend");
p.tick_minute(); p.tick_minute();
check("denature 3", p.phase(), "denature");
check("cycle 3", p.current_cycle(), 3);
p.tick_minute(); p.tick_minute(); p.tick_minute();
p.tick_minute();
check("final hold", p.phase(), "final hold");
checkF("4C", p.temperature(), 4.0);
p.tick_minute();
check("hold absorbs tick", p.phase(), "final hold");
p.start();
check("hold absorbs start", p.phase(), "final hold");
console.log("PASS: pcr_cycler");
