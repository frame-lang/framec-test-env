@@[target("cpp")]

// Cookbook 84: ACLS Cardiac Arrest Algorithm

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: string)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): string
        shocks_given(): int
        cpr_cycles_done(): int

    machine:
        $PreArrest {
            start_code() {
                this->shocks = 0;
                this->cpr_cycles = 0;
                -> $Analyzing
            }
            phase(): string { @@:("pre-arrest") }
            shocks_given(): int { @@:(this->shocks) }
            cpr_cycles_done(): int { @@:(this->cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): int { @@:(this->shocks) }
            cpr_cycles_done(): int { @@:(this->cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: string) {
                this->last_rhythm = rhythm;
                if (rhythm == "VF" || rhythm == "pulseless_VT") {
                    this->shocks = this->shocks + 1;
                    -> $CPR_Shockable
                } else {
                    -> $CPR_NonShockable
                }
            }
            phase(): string { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                this->cpr_cycles = this->cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): string { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                this->cpr_cycles = this->cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): string { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase(): string { @@:("rosc") }
            shocks_given(): int { @@:(this->shocks) }
            cpr_cycles_done(): int { @@:(this->cpr_cycles) }
        }

        $Terminated {
            phase(): string { @@:("terminated") }
            shocks_given(): int { @@:(this->shocks) }
            cpr_cycles_done(): int { @@:(this->cpr_cycles) }
        }

    domain:
        last_rhythm: std::string = ""
        shocks: int = 0
        cpr_cycles: int = 0
}

#include <iostream>
#include <cstdlib>

static void check_str(const std::string& label, const std::string& actual, const std::string& expected) {
    if (actual != expected) {
        std::cout << "FAIL: " << label << " expected '" << expected << "', got '" << actual << "'\n";
        std::exit(1);
    }
}
static void check_i(const std::string& label, int actual, int expected) {
    if (actual != expected) {
        std::cout << "FAIL: " << label << " expected " << expected << ", got " << actual << "\n";
        std::exit(1);
    }
}

int main() {
    auto c = @@ACLS();
    check_str("pre-arrest", c.phase(), "pre-arrest");
    c.rhythm_check("VF");
    c.cpr_cycle_complete();
    c.rosc_achieved();
    check_str("pre-arrest absorbs", c.phase(), "pre-arrest");
    c.start_code();
    check_str("analyzing", c.phase(), "analyzing");
    c.rhythm_check("VF");
    check_str("cpr shockable", c.phase(), "cpr shockable");
    check_i("1 shock", c.shocks_given(), 1);
    c.give_epinephrine();
    check_str("epi no-op", c.phase(), "cpr shockable");
    c.cpr_cycle_complete();
    check_str("back to analyzing", c.phase(), "analyzing");
    check_i("1 cycle done", c.cpr_cycles_done(), 1);
    c.rhythm_check("asystole");
    check_str("non-shockable cpr", c.phase(), "cpr non-shockable");
    check_i("still 1 shock", c.shocks_given(), 1);
    c.cpr_cycle_complete();
    check_i("2 cycles done", c.cpr_cycles_done(), 2);
    c.rhythm_check("pulseless_VT");
    check_str("shockable via VT", c.phase(), "cpr shockable");
    check_i("2 shocks", c.shocks_given(), 2);
    c.rosc_achieved();
    check_str("rosc reached", c.phase(), "rosc");
    c.rhythm_check("VF");
    c.cpr_cycle_complete();
    c.rosc_achieved();
    check_str("rosc absorbs all", c.phase(), "rosc");
    check_i("final shock count", c.shocks_given(), 2);

    auto c2 = @@ACLS();
    c2.start_code();
    c2.rhythm_check("asystole");
    c2.pronounce();
    check_str("pronounced", c2.phase(), "terminated");
    c2.rosc_achieved();
    c2.rhythm_check("VF");
    check_str("terminated absorbs", c2.phase(), "terminated");

    std::cout << "PASS: acls\n";
    return 0;
}
