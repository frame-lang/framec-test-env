@@[target("go")]

// Cookbook 85: Sepsis Hour-1 Bundle

package main

import (
    "fmt"
    "os"
)

@@system SepsisBundle {
    interface:
        recognize_sepsis()
        lactate_drawn(value: float64)
        cultures_drawn()
        antibiotics_given()
        fluids_complete()
        reassess_map(map_mmhg: int)
        pressors_started()
        tick_minute()
        status(): string
        bundle_complete(): bool = false
        elapsed_min(): int
        pressors_indicated(): bool

    machine:
        $PreRecognition {
            recognize_sepsis() {
                s.elapsed = 0
                s.lactate = 0.0
                s.cultures = false
                s.abx = false
                s.fluids = false
                s.reassessed = false
                s.pressors_needed = false
                s.pressors = false
                -> $BundleActive
            }
            status(): string { @@:("pre-recognition") }
            elapsed_min(): int { @@:(s.elapsed) }
            pressors_indicated(): bool { @@:(s.pressors_needed) }
        }

        $BundleActive {
            lactate_drawn(value: float64) {
                s.lactate = value
                if s.is_complete() {
                    if s.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            cultures_drawn() {
                s.cultures = true
                if s.is_complete() {
                    if s.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            antibiotics_given() {
                s.abx = true
                if s.is_complete() {
                    if s.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            fluids_complete() {
                s.fluids = true
                if s.is_complete() {
                    if s.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            reassess_map(map_mmhg: int) {
                s.reassessed = true
                s.pressors_needed = map_mmhg < 65
                if s.is_complete() {
                    if s.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            pressors_started() {
                s.pressors = true
                if s.is_complete() {
                    if s.elapsed <= 60 { -> $OnTime } else { -> $Late }
                }
            }
            tick_minute() { s.elapsed = s.elapsed + 1 }
            status(): string { @@:("active") }
            elapsed_min(): int { @@:(s.elapsed) }
            pressors_indicated(): bool { @@:(s.pressors_needed) }
        }

        $OnTime {
            bundle_complete(): bool { @@:(true) }
            status(): string { @@:("on time") }
            elapsed_min(): int { @@:(s.elapsed) }
            pressors_indicated(): bool { @@:(s.pressors_needed) }
        }

        $Late {
            bundle_complete(): bool { @@:(true) }
            status(): string { @@:("late") }
            elapsed_min(): int { @@:(s.elapsed) }
            pressors_indicated(): bool { @@:(s.pressors_needed) }
        }

    actions:
        is_complete(): bool {
            base := s.cultures && s.abx && s.fluids && s.lactate > 0.0 && s.reassessed
            if s.pressors_needed {
                return base && s.pressors
            }
            return base
        }

    domain:
        elapsed: int = 0
        lactate: float64 = 0.0
        cultures: bool = false
        abx: bool = false
        fluids: bool = false
        reassessed: bool = false
        pressors_needed: bool = false
        pressors: bool = false
}

func check(label, actual, expected string) {
    if actual != expected { fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual); os.Exit(1) }
}
func checkB(label string, actual, expected bool) {
    if actual != expected { fmt.Printf("FAIL: %s expected %v, got %v\n", label, expected, actual); os.Exit(1) }
}

func main() {
    a := @@SepsisBundle()
    check("pre-recognition", a.Status(), "pre-recognition")
    checkB("bundle_complete default false before recognize", a.Bundle_complete(), false)
    a.Lactate_drawn(3.4)
    a.Antibiotics_given()
    check("pre-rec absorbs events", a.Status(), "pre-recognition")
    a.Recognize_sepsis()
    check("active", a.Status(), "active")
    a.Lactate_drawn(3.4)
    a.Cultures_drawn()
    for i := 0; i < 15; i = i + 1 { a.Tick_minute() }
    a.Antibiotics_given()
    a.Fluids_complete()
    check("still active after fluids", a.Status(), "active")
    a.Reassess_map(75)
    check("on time", a.Status(), "on time")
    checkB("complete", a.Bundle_complete(), true)
    checkB("no pressors indicated", a.Pressors_indicated(), false)
    if a.Elapsed_min() > 60 { fmt.Println("FAIL: over 60"); os.Exit(1) }
    a.Antibiotics_given()
    a.Tick_minute()
    check("on time absorbs events", a.Status(), "on time")

    b := @@SepsisBundle()
    b.Recognize_sepsis()
    b.Lactate_drawn(4.2)
    b.Cultures_drawn()
    b.Antibiotics_given()
    b.Fluids_complete()
    for i := 0; i < 70; i = i + 1 { b.Tick_minute() }
    b.Reassess_map(58)
    check("active — pressors pending", b.Status(), "active")
    checkB("pressors flagged", b.Pressors_indicated(), true)
    b.Pressors_started()
    check("late terminal", b.Status(), "late")
    checkB("complete (late)", b.Bundle_complete(), true)
    if b.Elapsed_min() <= 60 { fmt.Println("FAIL: under 60"); os.Exit(1) }

    c := @@SepsisBundle()
    c.Recognize_sepsis()
    c.Lactate_drawn(2.0)
    c.Cultures_drawn()
    c.Antibiotics_given()
    c.Fluids_complete()
    c.Reassess_map(80)
    check("reassess completes w/o pressors", c.Status(), "on time")

    fmt.Println("PASS: sepsis_bundle")
}
