@@[target("go")]

// Cookbook 84: ACLS Cardiac Arrest Algorithm

package main

import (
    "fmt"
    "os"
)

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: string)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): string
        shocks_given(): int
        cpr_cycles_done(): int

    machine:
        $PreArrest {
            start_code() {
                s.shocks = 0
                s.cpr_cycles = 0
                -> $Analyzing
            }
            phase(): string { @@:("pre-arrest") }
            shocks_given(): int { @@:(s.shocks) }
            cpr_cycles_done(): int { @@:(s.cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): int { @@:(s.shocks) }
            cpr_cycles_done(): int { @@:(s.cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: string) {
                s.last_rhythm = rhythm
                if rhythm == "VF" || rhythm == "pulseless_VT" {
                    s.shocks = s.shocks + 1
                    -> $CPR_Shockable
                } else {
                    -> $CPR_NonShockable
                }
            }
            phase(): string { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                s.cpr_cycles = s.cpr_cycles + 1
                -> $Analyzing
            }
            phase(): string { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                s.cpr_cycles = s.cpr_cycles + 1
                -> $Analyzing
            }
            phase(): string { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase(): string { @@:("rosc") }
            shocks_given(): int { @@:(s.shocks) }
            cpr_cycles_done(): int { @@:(s.cpr_cycles) }
        }

        $Terminated {
            phase(): string { @@:("terminated") }
            shocks_given(): int { @@:(s.shocks) }
            cpr_cycles_done(): int { @@:(s.cpr_cycles) }
        }

    domain:
        last_rhythm: string = ""
        shocks: int = 0
        cpr_cycles: int = 0
}

func check(label, actual, expected string) {
    if actual != expected {
        fmt.Printf("FAIL: %s expected '%s', got '%s'\n", label, expected, actual)
        os.Exit(1)
    }
}
func checkI(label string, actual, expected int) {
    if actual != expected {
        fmt.Printf("FAIL: %s expected %d, got %d\n", label, expected, actual)
        os.Exit(1)
    }
}

func main() {
    c := @@ACLS()
    check("pre-arrest", c.Phase(), "pre-arrest")
    c.Rhythm_check("VF")
    c.Cpr_cycle_complete()
    c.Rosc_achieved()
    check("pre-arrest absorbs", c.Phase(), "pre-arrest")
    c.Start_code()
    check("analyzing", c.Phase(), "analyzing")
    c.Rhythm_check("VF")
    check("cpr shockable", c.Phase(), "cpr shockable")
    checkI("1 shock", c.Shocks_given(), 1)
    c.Give_epinephrine()
    check("epi no-op", c.Phase(), "cpr shockable")
    c.Cpr_cycle_complete()
    check("back to analyzing", c.Phase(), "analyzing")
    checkI("1 cycle done", c.Cpr_cycles_done(), 1)
    c.Rhythm_check("asystole")
    check("non-shockable cpr", c.Phase(), "cpr non-shockable")
    checkI("still 1 shock", c.Shocks_given(), 1)
    c.Cpr_cycle_complete()
    checkI("2 cycles done", c.Cpr_cycles_done(), 2)
    c.Rhythm_check("pulseless_VT")
    check("shockable via VT", c.Phase(), "cpr shockable")
    checkI("2 shocks", c.Shocks_given(), 2)
    c.Rosc_achieved()
    check("rosc reached", c.Phase(), "rosc")
    c.Rhythm_check("VF")
    c.Cpr_cycle_complete()
    c.Rosc_achieved()
    check("rosc absorbs all", c.Phase(), "rosc")
    checkI("final shock count", c.Shocks_given(), 2)

    c2 := @@ACLS()
    c2.Start_code()
    c2.Rhythm_check("asystole")
    c2.Pronounce()
    check("pronounced", c2.Phase(), "terminated")
    c2.Rosc_achieved()
    c2.Rhythm_check("VF")
    check("terminated absorbs", c2.Phase(), "terminated")

    fmt.Println("PASS: acls")
}
