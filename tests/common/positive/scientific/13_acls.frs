@@[target("rust")]

// Cookbook 84: ACLS Cardiac Arrest Algorithm

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm: String)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase(): String
        shocks_given(): i32
        cpr_cycles_done(): i32

    machine:
        $PreArrest {
            start_code() {
                self.shocks = 0;
                self.cpr_cycles = 0;
                -> $Analyzing
            }
            phase(): String { @@:(String::from("pre-arrest")) }
            shocks_given(): i32 { @@:(self.shocks) }
            cpr_cycles_done(): i32 { @@:(self.cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given(): i32 { @@:(self.shocks) }
            cpr_cycles_done(): i32 { @@:(self.cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm: String) {
                self.last_rhythm = rhythm.clone();
                if rhythm == "VF" || rhythm == "pulseless_VT" {
                    self.shocks = self.shocks + 1;
                    -> $CPR_Shockable
                } else {
                    -> $CPR_NonShockable
                }
            }
            phase(): String { @@:(String::from("analyzing")) }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                self.cpr_cycles = self.cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): String { @@:(String::from("cpr shockable")) }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                self.cpr_cycles = self.cpr_cycles + 1;
                -> $Analyzing
            }
            phase(): String { @@:(String::from("cpr non-shockable")) }
            => $^
        }

        $ROSC {
            phase(): String { @@:(String::from("rosc")) }
            shocks_given(): i32 { @@:(self.shocks) }
            cpr_cycles_done(): i32 { @@:(self.cpr_cycles) }
        }

        $Terminated {
            phase(): String { @@:(String::from("terminated")) }
            shocks_given(): i32 { @@:(self.shocks) }
            cpr_cycles_done(): i32 { @@:(self.cpr_cycles) }
        }

    domain:
        last_rhythm: String = String::new()
        shocks: i32 = 0
        cpr_cycles: i32 = 0
}

fn check(label: &str, actual: String, expected: &str) {
    if actual != expected {
        println!("FAIL: {} expected '{}', got '{}'", label, expected, actual);
        std::process::exit(1);
    }
}
fn check_i(label: &str, actual: i32, expected: i32) {
    if actual != expected {
        println!("FAIL: {} expected {}, got {}", label, expected, actual);
        std::process::exit(1);
    }
}

fn main() {
    let mut c = @@ACLS();
    check("pre-arrest", c.phase(), "pre-arrest");
    c.rhythm_check(String::from("VF"));
    c.cpr_cycle_complete();
    c.rosc_achieved();
    check("pre-arrest absorbs", c.phase(), "pre-arrest");
    c.start_code();
    check("analyzing", c.phase(), "analyzing");
    c.rhythm_check(String::from("VF"));
    check("cpr shockable", c.phase(), "cpr shockable");
    check_i("1 shock", c.shocks_given(), 1);
    c.give_epinephrine();
    check("epi no-op", c.phase(), "cpr shockable");
    c.cpr_cycle_complete();
    check("back to analyzing", c.phase(), "analyzing");
    check_i("1 cycle done", c.cpr_cycles_done(), 1);
    c.rhythm_check(String::from("asystole"));
    check("non-shockable cpr", c.phase(), "cpr non-shockable");
    check_i("still 1 shock", c.shocks_given(), 1);
    c.cpr_cycle_complete();
    check_i("2 cycles done", c.cpr_cycles_done(), 2);
    c.rhythm_check(String::from("pulseless_VT"));
    check("shockable via VT", c.phase(), "cpr shockable");
    check_i("2 shocks", c.shocks_given(), 2);
    c.rosc_achieved();
    check("rosc reached", c.phase(), "rosc");
    c.rhythm_check(String::from("VF"));
    c.cpr_cycle_complete();
    c.rosc_achieved();
    check("rosc absorbs all", c.phase(), "rosc");
    check_i("final shock count", c.shocks_given(), 2);

    let mut c2 = @@ACLS();
    c2.start_code();
    c2.rhythm_check(String::from("asystole"));
    c2.pronounce();
    check("pronounced", c2.phase(), "terminated");
    c2.rosc_achieved();
    c2.rhythm_check(String::from("VF"));
    check("terminated absorbs", c2.phase(), "terminated");

    println!("PASS: acls");
}
