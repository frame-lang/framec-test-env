@@[target("ruby")]

# Cookbook 84: ACLS Cardiac Arrest Algorithm

@@system ACLS {
    interface:
        start_code()
        rhythm_check(rhythm)
        cpr_cycle_complete()
        give_epinephrine()
        rosc_achieved()
        pronounce()
        phase()
        shocks_given()
        cpr_cycles_done()

    machine:
        $PreArrest {
            start_code() {
                @shocks = 0
                @cpr_cycles = 0
                -> $Analyzing
            }
            phase() { @@:("pre-arrest") }
            shocks_given() { @@:(@shocks) }
            cpr_cycles_done() { @@:(@cpr_cycles) }
        }

        $Coding {
            rosc_achieved() { -> $ROSC }
            pronounce() { -> $Terminated }
            shocks_given() { @@:(@shocks) }
            cpr_cycles_done() { @@:(@cpr_cycles) }
        }

        $Analyzing => $Coding {
            rhythm_check(rhythm) {
                @last_rhythm = rhythm
                if rhythm == "VF" || rhythm == "pulseless_VT"
                    @shocks = @shocks + 1
                    -> $CPR_Shockable
                else
                    -> $CPR_NonShockable
                end
            }
            phase() { @@:("analyzing") }
            => $^
        }

        $CPR_Shockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                @cpr_cycles = @cpr_cycles + 1
                -> $Analyzing
            }
            phase() { @@:("cpr shockable") }
            => $^
        }

        $CPR_NonShockable => $Coding {
            give_epinephrine() { }
            cpr_cycle_complete() {
                @cpr_cycles = @cpr_cycles + 1
                -> $Analyzing
            }
            phase() { @@:("cpr non-shockable") }
            => $^
        }

        $ROSC {
            phase() { @@:("rosc") }
            shocks_given() { @@:(@shocks) }
            cpr_cycles_done() { @@:(@cpr_cycles) }
        }

        $Terminated {
            phase() { @@:("terminated") }
            shocks_given() { @@:(@shocks) }
            cpr_cycles_done() { @@:(@cpr_cycles) }
        }

    domain:
        last_rhythm = ""
        shocks = 0
        cpr_cycles = 0
}

def check(label, actual, expected)
    if actual != expected
        puts "FAIL: #{label} expected '#{expected}', got '#{actual}'"
        exit(1)
    end
end

c = @@ACLS()
check("pre-arrest", c.phase, "pre-arrest")
c.rhythm_check("VF")
c.cpr_cycle_complete
c.rosc_achieved
check("pre-arrest absorbs", c.phase, "pre-arrest")
c.start_code
check("analyzing", c.phase, "analyzing")
c.rhythm_check("VF")
check("cpr shockable", c.phase, "cpr shockable")
check("1 shock", c.shocks_given, 1)
c.give_epinephrine
check("epi no-op", c.phase, "cpr shockable")
c.cpr_cycle_complete
check("back to analyzing", c.phase, "analyzing")
check("1 cycle done", c.cpr_cycles_done, 1)
c.rhythm_check("asystole")
check("non-shockable cpr", c.phase, "cpr non-shockable")
check("still 1 shock", c.shocks_given, 1)
c.cpr_cycle_complete
check("2 cycles done", c.cpr_cycles_done, 2)
c.rhythm_check("pulseless_VT")
check("shockable via VT", c.phase, "cpr shockable")
check("2 shocks", c.shocks_given, 2)
c.rosc_achieved
check("rosc reached", c.phase, "rosc")
c.rhythm_check("VF")
c.cpr_cycle_complete
c.rosc_achieved
check("rosc absorbs all", c.phase, "rosc")
check("final shock count", c.shocks_given, 2)

c2 = @@ACLS()
c2.start_code
c2.rhythm_check("asystole")
c2.pronounce
check("pronounced", c2.phase, "terminated")
c2.rosc_achieved
c2.rhythm_check("VF")
check("terminated absorbs", c2.phase, "terminated")

puts "PASS: acls"
