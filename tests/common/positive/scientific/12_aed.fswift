@@[target("swift")]

// Cookbook 83: AED / Defibrillator

import Foundation

@@system AED {
    interface:
        power_on()
        pads_attached()
        rhythm_detected(rhythm: String)
        tick_ms(ms: Int)
        press_shock()
        confirm_clear()
        status(): String
        shock_count(): Int
        charge_pct(): Int

    machine:
        $Off {
            power_on() { -> $AwaitingPads }
            status(): String { @@:("off") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

        $AwaitingPads {
            pads_attached() { -> $Analyzing }
            status(): String { @@:("attach pads") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

        $Analyzing {
            rhythm_detected(rhythm: String) {
                self.last_rhythm = rhythm
                if rhythm == "VF" || rhythm == "VT" {
                    -> $Charging
                } else {
                    -> $NotAdvised
                }
            }
            status(): String { @@:("analyzing") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

        $Charging {
            $>() { self.charge_pct_dom = 0 }
            tick_ms(ms: Int) {
                self.charge_pct_dom = self.charge_pct_dom + ms
                if self.charge_pct_dom >= 100 {
                    -> $AwaitingClear
                }
            }
            status(): String { @@:("charging") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

        $AwaitingClear {
            confirm_clear() { -> $ReadyToShock }
            status(): String { @@:("awaiting clear") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

        $ReadyToShock {
            press_shock() {
                self.shocks = self.shocks + 1
                -> $Analyzing
            }
            status(): String { @@:("ready to shock") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

        $NotAdvised {
            status(): String { @@:("no shock advised") }
            shock_count(): Int { @@:(self.shocks) }
            charge_pct(): Int { @@:(self.charge_pct_dom) }
        }

    domain:
        last_rhythm: String = ""
        charge_pct_dom: Int = 0
        shocks: Int = 0
}

func check(_ label: String, _ actual: String, _ expected: String) {
    if actual != expected {
        print("FAIL: \(label) expected '\(expected)', got '\(actual)'")
        exit(1)
    }
}
func checkI(_ label: String, _ actual: Int, _ expected: Int) {
    if actual != expected {
        print("FAIL: \(label) expected \(expected), got \(actual)")
        exit(1)
    }
}

let a = @@AED()
check("start off", a.status(), "off")
a.press_shock()
checkI("off cannot shock", a.shock_count(), 0)
a.power_on()
check("awaiting pads", a.status(), "attach pads")
a.press_shock()
checkI("awaiting pads cannot shock", a.shock_count(), 0)
a.pads_attached()
check("analyzing", a.status(), "analyzing")
a.press_shock()
checkI("analyzing cannot shock", a.shock_count(), 0)
a.rhythm_detected("VF")
check("charging", a.status(), "charging")
a.press_shock()
checkI("charging cannot shock", a.shock_count(), 0)
a.tick_ms(50)
check("still charging", a.status(), "charging")
checkI("charge 50", a.charge_pct(), 50)
a.press_shock()
checkI("still cannot shock half-charged", a.shock_count(), 0)
a.tick_ms(50)
check("awaiting clear", a.status(), "awaiting clear")
a.press_shock()
checkI("awaiting clear cannot shock", a.shock_count(), 0)
a.confirm_clear()
check("ready", a.status(), "ready to shock")
a.press_shock()
checkI("shocked", a.shock_count(), 1)
check("back to analyzing", a.status(), "analyzing")
a.rhythm_detected("asystole")
check("no shock advised", a.status(), "no shock advised")
a.press_shock()
a.tick_ms(100)
a.confirm_clear()
check("not-advised absorbs everything", a.status(), "no shock advised")
checkI("still 1 shock total", a.shock_count(), 1)
print("PASS: aed")
