@@[target("javascript")]

@@system CallMismatch {
    machine:
        $S {
            e() { this.handle() }
        }
    actions:
        log(message) {
            // log sink
            this.last = message;
        }
        handle() {
            // Calls 'log' by its FRM name; wrappers should preserve FRM names
            this.log("hello");
        }
    domain:
        last = ""
}

function main() {
    console.log("TAP version 14");
    console.log("1..1");
    try {
        const s = @@CallMismatch();
        s.e();
        console.log("ok 1 - actions_call_wrappers");
    } catch (ex) {
        console.log(`not ok 1 - actions_call_wrappers # ${ex}`);
    }
}
main();
