@@[target("typescript")]

// capability: @@:return header defaults and handler returns (TypeScript).
//
// This fixture exercises:
// - Interface header defaults: a1(): number = 10, a2(a): number = a,
//   a3(a): number = self.x + a
// - Handler bodies that use:
//   - bare `return` (leave @@:return at the header default)
//   - `@@:(expr)` (override the header default)

@@system SystemReturnHeaderDefaults {
    interface:
        a1(): number = 10
        a2(a: number): number = a
        a3(a: number): number = this.x + a

    machine:
        $Idle {
            a1() {
                if (this.x < 5) {
                    return
                } else {
                    @@:(0)
                    return
                }
            }

            a2(a: number) {
                return
            }

            a3(a: number) {
                @@:(a)
                return
            }
        }

    actions:
        bump_x(delta: number) {
            this.x = this.x + delta;
        }

    domain:
        x: number = 3
}

function main(): void {
    console.log("TAP version 14");
    console.log("1..1");
    try {
        const s = @@SystemReturnHeaderDefaults();
        const r1 = s.a1();
        const r2 = s.a2(7);
        const r3 = s.a3(4);
        if (r1 === 10 && r2 === 7 && r3 === 4) {
            console.log("ok 1 - system_return_header_defaults");
        } else {
            console.log(`not ok 1 - system_return_header_defaults # r1=${r1} r2=${r2} r3=${r3}`);
        }
    } catch (ex) {
        console.log(`not ok 1 - system_return_header_defaults # ${ex}`);
    }
}
main();
