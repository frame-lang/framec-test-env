@@[target("javascript")]

// capability: @@:return header defaults and handler returns (JavaScript).

@@system SystemReturnHeaderDefaults {
    interface:
        a1(): int = 10
        a2(a): int = a
        a3(a): int = this.x + a

    machine:
        $Idle {
            a1() {
                if (this.x < 5) {
                    return
                } else {
                    @@:(0)
                    return
                }
            }

            a2(a) {
                return
            }

            a3(a) {
                @@:(a)
                return
            }
        }

    actions:
        bump_x(delta) {
            this.x = this.x + delta;
        }

    domain:
        x = 3
}

function main() {
    console.log("TAP version 14");
    console.log("1..1");
    try {
        const s = @@SystemReturnHeaderDefaults();
        const r1 = s.a1();
        const r2 = s.a2(7);
        const r3 = s.a3(4);
        if (r1 === 10 && r2 === 7 && r3 === 4) {
            console.log("ok 1 - system_return_header_defaults");
        } else {
            console.log(`not ok 1 - system_return_header_defaults # r1=${r1} r2=${r2} r3=${r3}`);
        }
    } catch (ex) {
        console.log(`not ok 1 - system_return_header_defaults # ${ex}`);
    }
}
main();
