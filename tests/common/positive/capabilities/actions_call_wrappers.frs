@@[target("rust")]

@@system CallMismatch {
    machine:
        $S {
            e() { self.handle() }
        }
    actions:
        log(message: String) {
            // log sink
            self.last = message;
        }
        handle() {
            // Calls 'log' by its FRM name; wrappers should preserve FRM names
            self.log("hello".to_string());
        }
    domain:
        last: String = ""
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut s = @@CallMismatch();
    s.e();
    println!("ok 1 - actions_call_wrappers");
}
