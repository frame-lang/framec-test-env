@@[target("swift")]

@@system CallMismatch {
    machine:
        $S {
            e() { self.handle() }
        }
    actions:
        log(message: String) {
            // log sink
            self.last = message
        }
        handle() {
            // Calls 'log' by its FRM name; wrappers should preserve FRM names
            self.log("hello")
        }
    domain:
        last: String = ""
}

// TAP test harness
// main
    print("TAP version 14")
    print("1..1")
    let s = @@CallMismatch()
    s.e()
    print("ok 1 - actions_call_wrappers")
