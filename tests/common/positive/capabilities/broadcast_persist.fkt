@@[target("kotlin")]

// RFC-0052 broadcast persist: `@@[*persist]` + `@@[*save]`/`@@[*load]` at module
// position stamp EVERY system in the file (no per-system attrs). Round-trips
// BOTH systems: domain field, machine state, and post-restore liveness on the
// first; domain field on the second (proves the broadcast reached it).
@@[*persist(String)]
@@[*save(save_state)]
@@[*load(restore_state)]

@@[main]
@@system Counter {
    interface:
        inc()
        n(): Int
        st(): String

    machine:
        $A {
            inc() {
                this.count = this.count + 1
                -> $B
            }
            n(): Int { @@:(this.count) }
            st(): String { @@:("A") }
        }
        $B {
            inc() {
                this.count = this.count + 1
            }
            n(): Int { @@:(this.count) }
            st(): String { @@:("B") }
        }

    domain:
        count: Int = 0
}

@@system Tagger {
    interface:
        tag(t: String)
        probe(): String

    machine:
        $S {
            tag(t: String) {
                this.label = t
            }
            probe(): String { @@:(this.label) }
        }

    domain:
        label: String = ""
}

fun main() {
    val c = @@Counter()
    c.inc()
    c.inc()
    val t = @@Tagger()
    t.tag("x")

    val blobC = c.save_state()
    val blobT = t.save_state()

    val c2 = @@Counter()
    c2.restore_state(blobC)
    if (c2.n() as Int != 2) { throw RuntimeException("counter domain") }
    if (c2.st() as String != "B") { throw RuntimeException("counter state") }
    c2.inc()
    if (c2.n() as Int != 3) { throw RuntimeException("restored machine not live") }

    val t2 = @@Tagger()
    t2.restore_state(blobT)
    if (t2.probe() as String != "x") { throw RuntimeException("broadcast second system") }
    println("PASS: broadcast_persist")
}
