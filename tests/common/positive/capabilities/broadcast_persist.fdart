@@[target("dart")]

import 'dart:convert';
import 'dart:io';
// RFC-0052 broadcast persist: `@@[*persist]` + `@@[*save]`/`@@[*load]` at module
// position stamp EVERY system in the file (no per-system attrs). Round-trips
// BOTH systems: domain field, machine state, and post-restore liveness on the
// first; domain field on the second (proves the broadcast reached it).
@@[*persist(String)]
@@[*save(saveState)]
@@[*load(restoreState)]

@@[main]
@@system Counter {
    interface:
        inc()
        n(): int
        st(): String

    machine:
        $A {
            inc() {
                this.count = this.count + 1;
                -> $B
            }
            n(): int { @@:(this.count) }
            st(): String { @@:("A") }
        }
        $B {
            inc() {
                this.count = this.count + 1;
            }
            n(): int { @@:(this.count) }
            st(): String { @@:("B") }
        }

    domain:
        count: int = 0
}

@@system Tagger {
    interface:
        tag(t: String)
        probe(): String

    machine:
        $S {
            tag(t: String) {
                this.label = t;
            }
            probe(): String { @@:(this.label) }
        }

    domain:
        label: String = ""
}

void main() {
    final c = @@Counter();
    c.inc();
    c.inc();
    final t = @@Tagger();
    t.tag("x");

    final blobC = c.saveState();
    final blobT = t.saveState();

    final c2 = @@Counter();
    c2.restoreState(blobC);
    if (c2.n() != 2) { print("FAIL: counter domain"); exit(1); }
    if (c2.st() != "B") { print("FAIL: counter state"); exit(1); }
    c2.inc();
    if (c2.n() != 3) { print("FAIL: restored machine not live"); exit(1); }

    final t2 = @@Tagger();
    t2.restoreState(blobT);
    if (t2.probe() != "x") { print("FAIL: broadcast second system"); exit(1); }
    print("PASS: broadcast_persist");
}
