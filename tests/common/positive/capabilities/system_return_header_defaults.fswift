@@[target("swift")]

// capability: @@:return header defaults and handler returns (Swift).
//
// This fixture exercises:
// - Interface header defaults: a1(): Int = 10, a2(a): Int = a,
//   a3(a): Int = self.x + a
// - Handler bodies that use:
//   - bare `return` (leave @@:return at the header default)
//   - `@@:(expr)` (override the header default)

@@system SystemReturnHeaderDefaults {
    interface:
        a1(): Int = 10
        a2(a: Int): Int = a
        a3(a: Int): Int = self.x + a

    machine:
        $Idle {
            a1() {
                if self.x < 5 {
                    return
                } else {
                    @@:(0)
                    return
                }
            }

            a2(a: Int) {
                return
            }

            a3(a: Int) {
                @@:(a)
                return
            }
        }

    actions:
        bump_x(delta: Int) {
            self.x = self.x + delta
        }

    domain:
        x: Int = 3
}

// TAP test harness
// main
    print("TAP version 14")
    print("1..1")
    let s = @@SystemReturnHeaderDefaults()
    let r1 = s.a1()
    let r2 = s.a2(7)
    let r3 = s.a3(4)
    if r1 == 10 && r2 == 7 && r3 == 4 {
        print("ok 1 - system_return_header_defaults")
    } else {
        print("not ok 1 - system_return_header_defaults # r1=\(r1) r2=\(r2) r3=\(r3)")
    }
