@@[target("python_3")]

# RFC-0052 broadcast persist: `@@[*persist]` + `@@[*save]`/`@@[*load]` at module
# position stamp EVERY system in the file (no per-system attrs). Round-trips
# BOTH systems: domain field, machine state, and post-restore liveness on the
# first; domain field on the second (proves the broadcast reached it).
@@[*persist(bytes)]
@@[*save(save_state)]
@@[*load(restore_state)]

@@[main]
@@system Counter {
    interface:
        inc()
        n(): int
        st(): str

    machine:
        $A {
            inc() {
                self.count = self.count + 1
                -> $B
            }
            n(): int { @@:(self.count) }
            st(): str { @@:("A") }
        }
        $B {
            inc() {
                self.count = self.count + 1
            }
            n(): int { @@:(self.count) }
            st(): str { @@:("B") }
        }

    domain:
        count: int = 0
}

@@system Tagger {
    interface:
        tag(t: str)
        probe(): str

    machine:
        $S {
            tag(t: str) {
                self.label = t
            }
            probe(): str { @@:(self.label) }
        }

    domain:
        label: str = ""
}

if __name__ == '__main__':
    c = @@Counter()
    c.inc()
    c.inc()
    t = @@Tagger()
    t.tag("x")

    blob_c = c.save_state()
    blob_t = t.save_state()

    c2 = @@Counter()
    c2.restore_state(blob_c)
    assert c2.n() == 2, f"counter domain: expected 2, got {c2.n()}"
    assert c2.st() == "B", f"counter state: expected B, got {c2.st()}"
    c2.inc()
    assert c2.n() == 3, f"restored machine live: expected 3, got {c2.n()}"

    t2 = @@Tagger()
    t2.restore_state(blob_t)
    assert t2.probe() == "x", f"broadcast second system: expected x, got {t2.probe()}"
    print("PASS: broadcast_persist")
