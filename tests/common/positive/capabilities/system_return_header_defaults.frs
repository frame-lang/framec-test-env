@@[target("rust")]

// capability: @@:return header defaults and handler returns (Rust).
//
// This fixture exercises:
// - Interface header defaults: a1(): i32 = 10, a2(a): i32 = a,
//   a3(a): i32 = self.x + a
// - Handler bodies that use:
//   - bare `return` (leave @@:return at the header default)
//   - `@@:(expr)` (override the header default)

@@system SystemReturnHeaderDefaults {
    interface:
        a1(): i32 = 10
        a2(a: i32): i32 = a
        a3(a: i32): i32 = self.x + a

    machine:
        $Idle {
            a1() {
                if self.x < 5 {
                    return;
                } else {
                    @@:(0)
                    return;
                }
            }

            a2(a: i32) {
                return;
            }

            a3(a: i32) {
                @@:(a)
                return;
            }
        }

    actions:
        bump_x(delta: i32) {
            self.x = self.x + delta;
        }

    domain:
        x: i32 = 3
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut s = @@SystemReturnHeaderDefaults();
    let r1 = s.a1();
    let r2 = s.a2(7);
    let r3 = s.a3(4);
    if r1 == 10 && r2 == 7 && r3 == 4 {
        println!("ok 1 - system_return_header_defaults");
    } else {
        println!("not ok 1 - system_return_header_defaults # r1={} r2={} r3={}", r1, r2, r3);
    }
}
