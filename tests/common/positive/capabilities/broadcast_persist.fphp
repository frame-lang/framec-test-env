@@[target("php")]

// RFC-0052 broadcast persist: `@@[*persist]` + `@@[*save]`/`@@[*load]` at module
// position stamp EVERY system in the file (no per-system attrs). Round-trips
// BOTH systems: domain field, machine state, and post-restore liveness on the
// first; domain field on the second (proves the broadcast reached it).
@@[*persist(string)]
@@[*save(save_state)]
@@[*load(restore_state)]

@@[main]
@@system Counter {
    interface:
        inc()
        n(): int
        st(): str

    machine:
        $A {
            inc() {
                $this->count = $this->count + 1;
                -> $B
            }
            n(): int { @@:($this->count) }
            st(): str { @@:("A") }
        }
        $B {
            inc() {
                $this->count = $this->count + 1;
            }
            n(): int { @@:($this->count) }
            st(): str { @@:("B") }
        }

    domain:
        count: int = 0
}

@@system Tagger {
    interface:
        tag(t: str)
        probe(): str

    machine:
        $S {
            tag(t: str) {
                $this->label = $t;
            }
            probe(): str { @@:($this->label) }
        }

    domain:
        label: str = ""
}

$c = @@Counter();
$c->inc();
$c->inc();
$t = @@Tagger();
$t->tag("x");

$blobC = $c->save_state();
$blobT = $t->save_state();

$c2 = @@Counter();
$c2->restore_state($blobC);
if ($c2->n() !== 2) { echo "FAIL: counter domain\n"; exit(1); }
if ($c2->st() !== "B") { echo "FAIL: counter state\n"; exit(1); }
$c2->inc();
if ($c2->n() !== 3) { echo "FAIL: restored machine not live\n"; exit(1); }

$t2 = @@Tagger();
$t2->restore_state($blobT);
if ($t2->probe() !== "x") { echo "FAIL: broadcast second system\n"; exit(1); }
echo "PASS: broadcast_persist\n";
