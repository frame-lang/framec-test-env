// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 111_inline_flag_dotall
# ============================================================================
# Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

def main():
    r0 = M("a\nb")
    assert r0.accepted == True, "111_inline_flag_dotall a\nb: accepted"
    assert r0.cursor == 3, "111_inline_flag_dotall a\nb: cursor"
    assert r0.return_value == True, "111_inline_flag_dotall a\nb: return_value"
    r1 = M("axb")
    assert r1.accepted == True, "111_inline_flag_dotall axb: accepted"
    assert r1.cursor == 3, "111_inline_flag_dotall axb: cursor"
    assert r1.return_value == True, "111_inline_flag_dotall axb: return_value"
    r2 = M("ab")
    assert r2.accepted == False, "111_inline_flag_dotall ab: accepted"
    print("PASS: 111_inline_flag_dotall")

if __name__ == "__main__":
    main()
