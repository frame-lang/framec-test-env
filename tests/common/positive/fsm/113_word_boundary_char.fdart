@@[target("dart")]

// ============================================================================
// FSM-MATRIX 113_word_boundary_char
// ============================================================================
// Word boundary `\bcat\b` on the `char` alphabet (Pike VM with the Unicode `\w` word table).
// ============================================================================

@@fsm M(text: char) : bool = false { /\bcat\b/ true }

void main() {
    var r0 = M("cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        throw Exception("113_word_boundary_char cat");
    }
    var r1 = M("cats");
    if (r1.accepted != false) {
        throw Exception("113_word_boundary_char cats");
    }
    print("PASS: 113_word_boundary_char");
}
