@@[target("java")]

// ============================================================================
// FSM-MATRIX 106_interior_anchor
// ============================================================================
// Interior anchor (Pike VM): `$` mid-pattern is unsatisfiable.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a$b/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("ab");
        if (r0.accepted != false) {
            throw new RuntimeException("106_interior_anchor ab");
        }
        System.out.println("PASS: 106_interior_anchor");
    }
}
