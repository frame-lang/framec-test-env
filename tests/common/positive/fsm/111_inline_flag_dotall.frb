// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 111_inline_flag_dotall
# ============================================================================
# Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

def main
  r0 = M.new("a\nb")
  raise "111_inline_flag_dotall a\nb: accepted" unless r0.accepted == true
  raise "111_inline_flag_dotall a\nb: cursor" unless r0.cursor == 3
  raise "111_inline_flag_dotall a\nb: return_value" unless r0.return_value == true
  r1 = M.new("axb")
  raise "111_inline_flag_dotall axb: accepted" unless r1.accepted == true
  raise "111_inline_flag_dotall axb: cursor" unless r1.cursor == 3
  raise "111_inline_flag_dotall axb: return_value" unless r1.return_value == true
  r2 = M.new("ab")
  raise "111_inline_flag_dotall ab: accepted" unless r2.accepted == false
  puts "PASS: 111_inline_flag_dotall"
end

main
