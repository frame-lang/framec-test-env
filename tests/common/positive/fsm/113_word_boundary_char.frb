// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 113_word_boundary_char
# ============================================================================
# Word boundary `\bcat\b` on the `char` alphabet (Pike VM with the Unicode `\w` word table).
# ============================================================================

@@fsm M(text: char) : bool = false { /\bcat\b/ true }

def main
  r0 = M.new("cat")
  raise "113_word_boundary_char cat: accepted" unless r0.accepted == true
  raise "113_word_boundary_char cat: cursor" unless r0.cursor == 3
  raise "113_word_boundary_char cat: return_value" unless r0.return_value == true
  r1 = M.new("cats")
  raise "113_word_boundary_char cats: accepted" unless r1.accepted == false
  puts "PASS: 113_word_boundary_char"
end

main
