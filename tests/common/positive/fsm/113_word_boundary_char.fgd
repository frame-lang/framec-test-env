@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 113_word_boundary_char
# ============================================================================
# Word boundary `\bcat\b` on the `char` alphabet (Pike VM with the Unicode `\w` word table).
# ============================================================================

@@fsm M(text: char) : bool = false { /\bcat\b/ true }

func main():
	var r0 = M.new("cat")
	if r0.accepted != true or r0.cursor != 3 or r0.return_value != true:
		push_error("113_word_boundary_char cat")
		return
	var r1 = M.new("cats")
	if r1.accepted != false:
		push_error("113_word_boundary_char cats")
		return
	print("PASS: 113_word_boundary_char")

func _init():
	main()
	quit()
