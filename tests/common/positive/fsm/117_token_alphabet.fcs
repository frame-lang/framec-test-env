// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("csharp")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

class Program {
    static void Main(string[] args) {
        M ok = new M(new string[]{"IDENT", "LPAREN"});
        if (ok.accepted != true || ok.cursor != 2 || ok.return_value != true) throw new Exception("117 ok");
        M bad = new M(new string[]{"IDENT", "IDENT"});
        if (bad.accepted != false) throw new Exception("117 bad");
        Console.WriteLine("PASS: 117_token_alphabet");
    }
}
