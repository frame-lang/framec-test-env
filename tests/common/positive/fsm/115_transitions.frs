@@[target("rust")]

// ============================================================================
// FSM-MATRIX 115_transitions
// ============================================================================
// Multi-state recognizer with failure branches: `/a/` → $next → `/b/` accepts; any mismatch routes to $error (reject). "ab" accepts (cursor 2).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a/ -> $next : -> $error  $next: /b/ true : -> $error  $error: false }

fn main() {
    let r0 = M::new("ab".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 2);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("ax".chars().collect());
    assert_eq!(r1.accepted, false);
    let r2 = M::new("x".chars().collect());
    assert_eq!(r2.accepted, false);
    println!("PASS: 115_transitions");
}
