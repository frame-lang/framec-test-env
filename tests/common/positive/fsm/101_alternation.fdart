@@[target("dart")]

// ============================================================================
// FSM-MATRIX 101_alternation
// ============================================================================
// Alternation `cat|dog` — first-match-wins (RE2 leftmost).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

void main() {
    var r0 = M("cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        throw Exception("101_alternation cat");
    }
    var r1 = M("dog");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        throw Exception("101_alternation dog");
    }
    var r2 = M("cow");
    if (r2.accepted != false) {
        throw Exception("101_alternation cow");
    }
    print("PASS: 101_alternation");
}
