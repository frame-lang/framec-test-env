// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 101_alternation
# ============================================================================
# Alternation `cat|dog` — first-match-wins (RE2 leftmost).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

def main():
    r0 = M("cat")
    assert r0.accepted == True, "101_alternation cat: accepted"
    assert r0.cursor == 3, "101_alternation cat: cursor"
    assert r0.return_value == True, "101_alternation cat: return_value"
    r1 = M("dog")
    assert r1.accepted == True, "101_alternation dog: accepted"
    assert r1.cursor == 3, "101_alternation dog: cursor"
    assert r1.return_value == True, "101_alternation dog: return_value"
    r2 = M("cow")
    assert r2.accepted == False, "101_alternation cow: accepted"
    print("PASS: 101_alternation")

if __name__ == "__main__":
    main()
