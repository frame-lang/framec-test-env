@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 108_lazy_quantifier
// ============================================================================
// Lazy `.*?,` (Pike VM): stops at the FIRST comma; matched="ab,".
// ============================================================================

@@fsm M(text: bytes) : bytes = "" { /.*?,/ @@:matched }

int main() {
    M r0("ab,cd,ef");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != "ab,") {
        std::cout << "FAIL: 108_lazy_quantifier ab,cd,ef" << std::endl;
        return 1;
    }
    std::cout << "PASS: 108_lazy_quantifier" << std::endl;
    return 0;
}
