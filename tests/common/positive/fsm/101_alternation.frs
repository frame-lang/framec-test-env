@@[target("rust")]

// ============================================================================
// FSM-MATRIX 101_alternation
// ============================================================================
// Alternation `cat|dog` — first-match-wins (RE2 leftmost).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

fn main() {
    let r0 = M::new("cat".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 3);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("dog".chars().collect());
    assert_eq!(r1.accepted, true);
    assert_eq!(r1.cursor, 3);
    assert_eq!(r1.return_value, true);
    let r2 = M::new("cow".chars().collect());
    assert_eq!(r2.accepted, false);
    println!("PASS: 101_alternation");
}
