// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 104_start_anchor
// ============================================================================
// Start anchor `^foo` — matches only at input start (cursor 0).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

int main() {
    struct M r0;
    M_init(&r0, "foo");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        printf("FAIL: 104_start_anchor foo\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "xfoo");
    if (r1.accepted != false) {
        printf("FAIL: 104_start_anchor xfoo\n");
        return 1;
    }
    printf("PASS: 104_start_anchor\n");
    return 0;
}
