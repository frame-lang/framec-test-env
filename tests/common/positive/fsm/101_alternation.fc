@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 101_alternation
// ============================================================================
// Alternation `cat|dog` — first-match-wins (RE2 leftmost).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

int main() {
    struct M r0;
    M_init(&r0, "cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        printf("FAIL: 101_alternation cat\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "dog");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        printf("FAIL: 101_alternation dog\n");
        return 1;
    }
    struct M r2;
    M_init(&r2, "cow");
    if (r2.accepted != false) {
        printf("FAIL: 101_alternation cow\n");
        return 1;
    }
    printf("PASS: 101_alternation\n");
    return 0;
}
