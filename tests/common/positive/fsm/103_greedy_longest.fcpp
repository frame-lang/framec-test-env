@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 103_greedy_longest
// ============================================================================
// Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

int main() {
    M r0("aaab");
    if (r0.accepted != true || r0.cursor != 4 || r0.return_value != true) {
        std::cout << "FAIL: 103_greedy_longest aaab" << std::endl;
        return 1;
    }
    M r1("b");
    if (r1.accepted != true || r1.cursor != 1 || r1.return_value != true) {
        std::cout << "FAIL: 103_greedy_longest b" << std::endl;
        return 1;
    }
    M r2("aaa");
    if (r2.accepted != false) {
        std::cout << "FAIL: 103_greedy_longest aaa" << std::endl;
        return 1;
    }
    std::cout << "PASS: 103_greedy_longest" << std::endl;
    return 0;
}
