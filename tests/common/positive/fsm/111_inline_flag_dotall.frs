@@[target("rust")]

// ============================================================================
// FSM-MATRIX 111_inline_flag_dotall
// ============================================================================
// Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

fn main() {
    let r0 = M::new("a\nb".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 3);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("axb".chars().collect());
    assert_eq!(r1.accepted, true);
    assert_eq!(r1.cursor, 3);
    assert_eq!(r1.return_value, true);
    let r2 = M::new("ab".chars().collect());
    assert_eq!(r2.accepted, false);
    println!("PASS: 111_inline_flag_dotall");
}
