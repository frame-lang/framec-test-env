// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 112_inline_flag_multiline
# ============================================================================
# Inline flag `(?m)` multiline — `$` matches before a `\n` (Pike VM LineEnd assert). `a$` matches the `a` just before the newline.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?m)a$/ true }

def main
  r0 = M.new("a\nb")
  raise "112_inline_flag_multiline a\nb: accepted" unless r0.accepted == true
  raise "112_inline_flag_multiline a\nb: cursor" unless r0.cursor == 1
  raise "112_inline_flag_multiline a\nb: return_value" unless r0.return_value == true
  r1 = M.new("ab")
  raise "112_inline_flag_multiline ab: accepted" unless r1.accepted == false
  puts "PASS: 112_inline_flag_multiline"
end

main
