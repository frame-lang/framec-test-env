@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 104_start_anchor
# ============================================================================
# Start anchor `^foo` — matches only at input start (cursor 0).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

func main():
	var r0 = M.new("foo")
	if r0.accepted != true or r0.cursor != 3 or r0.return_value != true:
		push_error("104_start_anchor foo")
		return
	var r1 = M.new("xfoo")
	if r1.accepted != false:
		push_error("104_start_anchor xfoo")
		return
	print("PASS: 104_start_anchor")

func _init():
	main()
	quit()
