@@[target("csharp")]

// ============================================================================
// FSM-MATRIX 107_word_boundary
// ============================================================================
// Edge word boundaries `\bcat\b` (bytes): free-standing word.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

class Program {
    static void Main(string[] args) {
        M r0 = new M("cat");
        if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
            throw new Exception("107_word_boundary cat");
        }
        M r1 = new M("cats");
        if (r1.accepted != false) {
            throw new Exception("107_word_boundary cats");
        }
        Console.WriteLine("PASS: 107_word_boundary");
    }
}
