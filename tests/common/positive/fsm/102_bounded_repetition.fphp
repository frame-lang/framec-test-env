// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("php")]

# ============================================================================
# FSM-MATRIX 102_bounded_repetition
# ============================================================================
# Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

$r0 = new M("a");
if ($r0->accepted !== false) {
    echo "FAIL: 102_bounded_repetition a\n";
    throw new \Exception("102_bounded_repetition a");
}
$r1 = new M("aaa");
if ($r1->accepted !== true || $r1->cursor !== 3 || $r1->return_value !== true) {
    echo "FAIL: 102_bounded_repetition aaa\n";
    throw new \Exception("102_bounded_repetition aaa");
}
$r2 = new M("aaaaa");
if ($r2->accepted !== true || $r2->cursor !== 4 || $r2->return_value !== true) {
    echo "FAIL: 102_bounded_repetition aaaaa\n";
    throw new \Exception("102_bounded_repetition aaaaa");
}
echo "PASS: 102_bounded_repetition\n";
