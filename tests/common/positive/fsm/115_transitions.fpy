@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 115_transitions
# ============================================================================
# Multi-state recognizer with failure branches: `/a/` → $next → `/b/` accepts; any mismatch routes to $error (reject). "ab" accepts (cursor 2).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a/ -> $next : -> $error  $next: /b/ true : -> $error  $error: false }

def main():
    r0 = M("ab")
    assert r0.accepted == True, "115_transitions ab: accepted"
    assert r0.cursor == 2, "115_transitions ab: cursor"
    assert r0.return_value == True, "115_transitions ab: return_value"
    r1 = M("ax")
    assert r1.accepted == False, "115_transitions ax: accepted"
    r2 = M("x")
    assert r2.accepted == False, "115_transitions x: accepted"
    print("PASS: 115_transitions")

if __name__ == "__main__":
    main()
