// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 101_alternation
# ============================================================================
# Alternation `cat|dog` — first-match-wins (RE2 leftmost).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

def main
  r0 = M.new("cat")
  raise "101_alternation cat: accepted" unless r0.accepted == true
  raise "101_alternation cat: cursor" unless r0.cursor == 3
  raise "101_alternation cat: return_value" unless r0.return_value == true
  r1 = M.new("dog")
  raise "101_alternation dog: accepted" unless r1.accepted == true
  raise "101_alternation dog: cursor" unless r1.cursor == 3
  raise "101_alternation dog: return_value" unless r1.return_value == true
  r2 = M.new("cow")
  raise "101_alternation cow: accepted" unless r2.accepted == false
  puts "PASS: 101_alternation"
end

main
