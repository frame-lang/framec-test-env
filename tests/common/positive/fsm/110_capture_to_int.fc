// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 110_capture_to_int
// ============================================================================
// Stage capture `.n` + to_int($s.n) → return_value is the integer.
// ============================================================================

@@fsm M(text: bytes) : int = 0 { $s: .n/[0-9]+/ to_int($s.n) }

int main() {
    struct M r0;
    M_init(&r0, "42");
    if (r0.accepted != true || r0.cursor != 2 || r0.return_value != 42) {
        printf("FAIL: 110_capture_to_int 42\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "x");
    if (r1.accepted != false) {
        printf("FAIL: 110_capture_to_int x\n");
        return 1;
    }
    printf("PASS: 110_capture_to_int\n");
    return 0;
}
