// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 115_transitions
# ============================================================================
# Multi-state recognizer with failure branches: `/a/` → $next → `/b/` accepts; any mismatch routes to $error (reject). "ab" accepts (cursor 2).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a/ -> $next : -> $error  $next: /b/ true : -> $error  $error: false }

func main():
	var r0 = M.new("ab")
	if r0.accepted != true or r0.cursor != 2 or r0.return_value != true:
		push_error("115_transitions ab")
		return
	var r1 = M.new("ax")
	if r1.accepted != false:
		push_error("115_transitions ax")
		return
	var r2 = M.new("x")
	if r2.accepted != false:
		push_error("115_transitions x")
		return
	print("PASS: 115_transitions")

func _init():
	main()
	quit()
