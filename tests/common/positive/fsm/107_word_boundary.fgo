@@[target("go")]

package main

import "fmt"
import "os"

// ============================================================================
// FSM-MATRIX 107_word_boundary
// ============================================================================
// Edge word boundaries `\bcat\b` (bytes): free-standing word.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

func main() {
    r0 := NewM("cat")
    if r0.accepted != true || r0.cursor != 3 || r0.return_value != true {
        fmt.Println("FAIL: 107_word_boundary cat")
        os.Exit(1)
    }
    r1 := NewM("cats")
    if r1.accepted != false {
        fmt.Println("FAIL: 107_word_boundary cats")
        os.Exit(1)
    }
    fmt.Println("PASS: 107_word_boundary")
}
