@@[target("lua")]

-- ============================================================================
-- FSM-MATRIX 103_greedy_longest
-- ============================================================================
-- Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
-- ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

local r0 = M.new("aaab")
assert(r0.accepted == true, "103_greedy_longest aaab: accepted")
assert(r0.cursor == 4, "103_greedy_longest aaab: cursor")
assert(r0.return_value == true, "103_greedy_longest aaab: return_value")
local r1 = M.new("b")
assert(r1.accepted == true, "103_greedy_longest b: accepted")
assert(r1.cursor == 1, "103_greedy_longest b: cursor")
assert(r1.return_value == true, "103_greedy_longest b: return_value")
local r2 = M.new("aaa")
assert(r2.accepted == false, "103_greedy_longest aaa: accepted")
print("PASS: 103_greedy_longest")
