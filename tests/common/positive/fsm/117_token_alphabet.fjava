@@[target("java")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

class Main {
    public static void main(String[] args) {
        M ok = new M(new String[]{"IDENT", "LPAREN"});
        if (ok.accepted != true || ok.cursor != 2 || ok.return_value != true) throw new RuntimeException("117 ok");
        M bad = new M(new String[]{"IDENT", "IDENT"});
        if (bad.accepted != false) throw new RuntimeException("117 bad");
        System.out.println("PASS: 117_token_alphabet");
    }
}
