// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 107_word_boundary
# ============================================================================
# Edge word boundaries `\bcat\b` (bytes): free-standing word.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

func main():
	var r0 = M.new("cat")
	if r0.accepted != true or r0.cursor != 3 or r0.return_value != true:
		push_error("107_word_boundary cat")
		return
	var r1 = M.new("cats")
	if r1.accepted != false:
		push_error("107_word_boundary cats")
		return
	print("PASS: 107_word_boundary")

func _init():
	main()
	quit()
