@@[target("java")]

// ============================================================================
// FSM-MATRIX 108_lazy_quantifier
// ============================================================================
// Lazy `.*?,` (Pike VM): stops at the FIRST comma; matched="ab,".
// ============================================================================

@@fsm M(text: bytes) : bytes = "" { /.*?,/ @@:matched }

class Main {
    public static void main(String[] args) {
        M r0 = new M("ab,cd,ef");
        if (r0.accepted != true || r0.cursor != 3 || !r0.return_value.equals("ab,")) {
            throw new RuntimeException("108_lazy_quantifier ab,cd,ef");
        }
        System.out.println("PASS: 108_lazy_quantifier");
    }
}
