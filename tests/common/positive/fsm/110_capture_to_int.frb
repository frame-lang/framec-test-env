// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 110_capture_to_int
# ============================================================================
# Stage capture `.n` + to_int($s.n) → return_value is the integer.
# ============================================================================

@@fsm M(text: bytes) : int = 0 { $s: .n/[0-9]+/ to_int($s.n) }

def main
  r0 = M.new("42")
  raise "110_capture_to_int 42: accepted" unless r0.accepted == true
  raise "110_capture_to_int 42: cursor" unless r0.cursor == 2
  raise "110_capture_to_int 42: return_value" unless r0.return_value == 42
  r1 = M.new("x")
  raise "110_capture_to_int x: accepted" unless r1.accepted == false
  puts "PASS: 110_capture_to_int"
end

main
