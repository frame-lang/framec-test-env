@@[target("java")]

// ============================================================================
// FSM-MATRIX 112_inline_flag_multiline
// ============================================================================
// Inline flag `(?m)` multiline — `$` matches before a `\n` (Pike VM LineEnd assert). `a$` matches the `a` just before the newline.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?m)a$/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("a\nb");
        if (r0.accepted != true || r0.cursor != 1 || r0.return_value != true) {
            throw new RuntimeException("112_inline_flag_multiline a\nb");
        }
        M r1 = new M("ab");
        if (r1.accepted != false) {
            throw new RuntimeException("112_inline_flag_multiline ab");
        }
        System.out.println("PASS: 112_inline_flag_multiline");
    }
}
