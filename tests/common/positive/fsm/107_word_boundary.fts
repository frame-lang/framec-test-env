// ============================================================================
// FSM-MATRIX 107_word_boundary
// ============================================================================
// Edge word boundaries `\bcat\b` (bytes): free-standing word.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

function main(): void {
    const r0 = new M("cat");
    if (r0.accepted !== true || r0.cursor !== 3 || r0.return_value !== true) {
        throw new Error("107_word_boundary cat");
    }
    const r1 = new M("cats");
    if (r1.accepted !== false) {
        throw new Error("107_word_boundary cats");
    }
    console.log("PASS: 107_word_boundary");
}

main();
