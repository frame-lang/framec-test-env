@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 114_unicode_class
// ============================================================================
// Unicode general-category class `\p{L}+` on `char` (opt-in `@@[allow(unicode_classes)]`). ASCII letters are in \p{L}; multibyte input is a per-backend char-width matter, kept out of the uniform matrix.
// ============================================================================

@@[allow(unicode_classes)]
@@fsm M(text: char) : bool = false { /\p{L}+/ true }

int main() {
    M r0("abc");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        std::cout << "FAIL: 114_unicode_class abc" << std::endl;
        return 1;
    }
    M r1("1a");
    if (r1.accepted != false) {
        std::cout << "FAIL: 114_unicode_class 1a" << std::endl;
        return 1;
    }
    std::cout << "PASS: 114_unicode_class" << std::endl;
    return 0;
}
