@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 114_unicode_class
# ============================================================================
# Unicode general-category class `\p{L}+` on `char` (opt-in `@@[allow(unicode_classes)]`). ASCII letters are in \p{L}; multibyte input is a per-backend char-width matter, kept out of the uniform matrix.
# ============================================================================

@@[allow(unicode_classes)]
@@fsm M(text: char) : bool = false { /\p{L}+/ true }

def main():
    r0 = M("abc")
    assert r0.accepted == True, "114_unicode_class abc: accepted"
    assert r0.cursor == 3, "114_unicode_class abc: cursor"
    assert r0.return_value == True, "114_unicode_class abc: return_value"
    r1 = M("1a")
    assert r1.accepted == False, "114_unicode_class 1a: accepted"
    print("PASS: 114_unicode_class")

if __name__ == "__main__":
    main()
