@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 109_inline_flag_caseless
# ============================================================================
# Inline flag `(?i)` — case-insensitive literal match.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

func main():
	var r0 = M.new("CAT")
	if r0.accepted != true or r0.cursor != 3 or r0.return_value != true:
		push_error("109_inline_flag_caseless CAT")
		return
	var r1 = M.new("Cat")
	if r1.accepted != true or r1.cursor != 3 or r1.return_value != true:
		push_error("109_inline_flag_caseless Cat")
		return
	var r2 = M.new("dog")
	if r2.accepted != false:
		push_error("109_inline_flag_caseless dog")
		return
	print("PASS: 109_inline_flag_caseless")

func _init():
	main()
	quit()
