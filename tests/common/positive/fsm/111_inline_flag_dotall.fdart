@@[target("dart")]

// ============================================================================
// FSM-MATRIX 111_inline_flag_dotall
// ============================================================================
// Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

void main() {
    var r0 = M("a\nb");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        throw Exception("111_inline_flag_dotall a\nb");
    }
    var r1 = M("axb");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        throw Exception("111_inline_flag_dotall axb");
    }
    var r2 = M("ab");
    if (r2.accepted != false) {
        throw Exception("111_inline_flag_dotall ab");
    }
    print("PASS: 111_inline_flag_dotall");
}
