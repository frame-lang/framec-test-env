// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 105_end_anchor
// ============================================================================
// End anchor `[0-9]+$` — the digit run must reach end of input.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /[0-9]+$/ true }

int main() {
    M r0("123");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        std::cout << "FAIL: 105_end_anchor 123" << std::endl;
        return 1;
    }
    M r1("123x");
    if (r1.accepted != false) {
        std::cout << "FAIL: 105_end_anchor 123x" << std::endl;
        return 1;
    }
    std::cout << "PASS: 105_end_anchor" << std::endl;
    return 0;
}
