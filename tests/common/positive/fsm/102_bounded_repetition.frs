// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("rust")]

// ============================================================================
// FSM-MATRIX 102_bounded_repetition
// ============================================================================
// Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

fn main() {
    let r0 = M::new("a".chars().collect());
    assert_eq!(r0.accepted, false);
    let r1 = M::new("aaa".chars().collect());
    assert_eq!(r1.accepted, true);
    assert_eq!(r1.cursor, 3);
    assert_eq!(r1.return_value, true);
    let r2 = M::new("aaaaa".chars().collect());
    assert_eq!(r2.accepted, true);
    assert_eq!(r2.cursor, 4);
    assert_eq!(r2.return_value, true);
    println!("PASS: 102_bounded_repetition");
}
