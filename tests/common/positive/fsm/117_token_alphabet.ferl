@@[target("erlang")]

%% FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.
%% Erlang emits module `m` with recognize/1; token kinds are atoms
%% (m:recognize(['IDENT','LPAREN'])). Harness-driven like the other erl fixtures.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }
