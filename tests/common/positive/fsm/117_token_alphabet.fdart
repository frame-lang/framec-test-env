@@[target("dart")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

void main() {
    var ok = M(["IDENT", "LPAREN"]);
    if (ok.accepted != true || ok.cursor != 2 || ok.return_value != true) throw Exception("117 ok");
    var bad = M(["IDENT", "IDENT"]);
    if (bad.accepted != false) throw Exception("117 bad");
    print("PASS: 117_token_alphabet");
}
