@@[target("java")]

// ============================================================================
// FSM-MATRIX 113_word_boundary_char
// ============================================================================
// Word boundary `\bcat\b` on the `char` alphabet (Pike VM with the Unicode `\w` word table).
// ============================================================================

@@fsm M(text: char) : bool = false { /\bcat\b/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("cat");
        if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
            throw new RuntimeException("113_word_boundary_char cat");
        }
        M r1 = new M("cats");
        if (r1.accepted != false) {
            throw new RuntimeException("113_word_boundary_char cats");
        }
        System.out.println("PASS: 113_word_boundary_char");
    }
}
