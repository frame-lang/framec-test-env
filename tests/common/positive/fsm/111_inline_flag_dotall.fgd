// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 111_inline_flag_dotall
# ============================================================================
# Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

func main():
	var r0 = M.new("a\nb")
	if r0.accepted != true or r0.cursor != 3 or r0.return_value != true:
		push_error("111_inline_flag_dotall a\nb")
		return
	var r1 = M.new("axb")
	if r1.accepted != true or r1.cursor != 3 or r1.return_value != true:
		push_error("111_inline_flag_dotall axb")
		return
	var r2 = M.new("ab")
	if r2.accepted != false:
		push_error("111_inline_flag_dotall ab")
		return
	print("PASS: 111_inline_flag_dotall")

func _init():
	main()
	quit()
