// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# FSM-MATRIX 117_token_alphabet — the token alphabet: regex elements are token
# kinds, input is a sequence of token-kind names. /IDENT LPAREN/ matches the
# two-token sequence.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

def main():
    ok = M(["IDENT", "LPAREN"])
    assert ok.accepted == True, "117 accepted"
    assert ok.cursor == 2, "117 cursor"
    assert ok.return_value == True, "117 return_value"
    bad = M(["IDENT", "IDENT"])
    assert bad.accepted == False, "117 bad"
    print("PASS: 117_token_alphabet")

if __name__ == "__main__":
    main()
