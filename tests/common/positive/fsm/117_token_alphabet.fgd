@@[target("gdscript")]
extends SceneTree

# FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

func main():
	var ok = M.new(["IDENT", "LPAREN"])
	if ok.accepted != true or ok.cursor != 2 or ok.return_value != true:
		push_error("117 ok")
		return
	var bad = M.new(["IDENT", "IDENT"])
	if bad.accepted != false:
		push_error("117 bad")
		return
	print("PASS: 117_token_alphabet")

func _init():
	main()
	quit()
