// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 102_bounded_repetition
# ============================================================================
# Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

def main():
    r0 = M("a")
    assert r0.accepted == False, "102_bounded_repetition a: accepted"
    r1 = M("aaa")
    assert r1.accepted == True, "102_bounded_repetition aaa: accepted"
    assert r1.cursor == 3, "102_bounded_repetition aaa: cursor"
    assert r1.return_value == True, "102_bounded_repetition aaa: return_value"
    r2 = M("aaaaa")
    assert r2.accepted == True, "102_bounded_repetition aaaaa: accepted"
    assert r2.cursor == 4, "102_bounded_repetition aaaaa: cursor"
    assert r2.return_value == True, "102_bounded_repetition aaaaa: return_value"
    print("PASS: 102_bounded_repetition")

if __name__ == "__main__":
    main()
