// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 115_transitions
# ============================================================================
# Multi-state recognizer with failure branches: `/a/` → $next → `/b/` accepts; any mismatch routes to $error (reject). "ab" accepts (cursor 2).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a/ -> $next : -> $error  $next: /b/ true : -> $error  $error: false }

def main
  r0 = M.new("ab")
  raise "115_transitions ab: accepted" unless r0.accepted == true
  raise "115_transitions ab: cursor" unless r0.cursor == 2
  raise "115_transitions ab: return_value" unless r0.return_value == true
  r1 = M.new("ax")
  raise "115_transitions ax: accepted" unless r1.accepted == false
  r2 = M.new("x")
  raise "115_transitions x: accepted" unless r2.accepted == false
  puts "PASS: 115_transitions"
end

main
