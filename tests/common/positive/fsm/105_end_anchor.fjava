@@[target("java")]

// ============================================================================
// FSM-MATRIX 105_end_anchor
// ============================================================================
// End anchor `[0-9]+$` — the digit run must reach end of input.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /[0-9]+$/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("123");
        if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
            throw new RuntimeException("105_end_anchor 123");
        }
        M r1 = new M("123x");
        if (r1.accepted != false) {
            throw new RuntimeException("105_end_anchor 123x");
        }
        System.out.println("PASS: 105_end_anchor");
    }
}
