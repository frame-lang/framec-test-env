@@[target("java")]

// ============================================================================
// FSM-MATRIX 103_greedy_longest
// ============================================================================
// Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("aaab");
        if (r0.accepted != true || r0.cursor != 4 || r0.return_value != true) {
            throw new RuntimeException("103_greedy_longest aaab");
        }
        M r1 = new M("b");
        if (r1.accepted != true || r1.cursor != 1 || r1.return_value != true) {
            throw new RuntimeException("103_greedy_longest b");
        }
        M r2 = new M("aaa");
        if (r2.accepted != false) {
            throw new RuntimeException("103_greedy_longest aaa");
        }
        System.out.println("PASS: 103_greedy_longest");
    }
}
