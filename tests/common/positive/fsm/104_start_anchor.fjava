@@[target("java")]

// ============================================================================
// FSM-MATRIX 104_start_anchor
// ============================================================================
// Start anchor `^foo` — matches only at input start (cursor 0).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("foo");
        if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
            throw new RuntimeException("104_start_anchor foo");
        }
        M r1 = new M("xfoo");
        if (r1.accepted != false) {
            throw new RuntimeException("104_start_anchor xfoo");
        }
        System.out.println("PASS: 104_start_anchor");
    }
}
