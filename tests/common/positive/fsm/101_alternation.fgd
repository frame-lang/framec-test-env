// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 101_alternation
# ============================================================================
# Alternation `cat|dog` — first-match-wins (RE2 leftmost).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

func main():
	var r0 = M.new("cat")
	if r0.accepted != true or r0.cursor != 3 or r0.return_value != true:
		push_error("101_alternation cat")
		return
	var r1 = M.new("dog")
	if r1.accepted != true or r1.cursor != 3 or r1.return_value != true:
		push_error("101_alternation dog")
		return
	var r2 = M.new("cow")
	if r2.accepted != false:
		push_error("101_alternation cow")
		return
	print("PASS: 101_alternation")

func _init():
	main()
	quit()
