@@[target("php")]

# ============================================================================
# FSM-MATRIX 108_lazy_quantifier
# ============================================================================
# Lazy `.*?,` (Pike VM): stops at the FIRST comma; matched="ab,".
# ============================================================================

@@fsm M(text: bytes) : bytes = "" { /.*?,/ @@:matched }

$r0 = new M("ab,cd,ef");
if ($r0->accepted !== true || $r0->cursor !== 3 || $r0->return_value !== "ab,") {
    echo "FAIL: 108_lazy_quantifier ab,cd,ef\n";
    throw new \Exception("108_lazy_quantifier ab,cd,ef");
}
echo "PASS: 108_lazy_quantifier\n";
