@@[target("erlang")]

%% =============================================================================
%% FSM-MATRIX 100: match digits — core DFA recognizer
%% =============================================================================
%% `/[0-9]+/` accepts a digit run at the cursor. The Erlang backend emits a
%% single module `digits` exporting `recognize/1`, which returns the final
%% recognizer state map (`accepted`, `cursor`, `return_value`, ...). Like the
%% other Erlang primary fixtures this block is harness-driven (no inline main);
%% a sidecar escript drives `digits:recognize("123")` for behavioral checks.
%% =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }
