@@[target("rust")]

// ============================================================================
// FSM-MATRIX 103_greedy_longest
// ============================================================================
// Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

fn main() {
    let r0 = M::new("aaab".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 4);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("b".chars().collect());
    assert_eq!(r1.accepted, true);
    assert_eq!(r1.cursor, 1);
    assert_eq!(r1.return_value, true);
    let r2 = M::new("aaa".chars().collect());
    assert_eq!(r2.accepted, false);
    println!("PASS: 103_greedy_longest");
}
