@@[target("php")]

# ============================================================================
# FSM-MATRIX 103_greedy_longest
# ============================================================================
# Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

$r0 = new M("aaab");
if ($r0->accepted !== true || $r0->cursor !== 4 || $r0->return_value !== true) {
    echo "FAIL: 103_greedy_longest aaab\n";
    throw new \Exception("103_greedy_longest aaab");
}
$r1 = new M("b");
if ($r1->accepted !== true || $r1->cursor !== 1 || $r1->return_value !== true) {
    echo "FAIL: 103_greedy_longest b\n";
    throw new \Exception("103_greedy_longest b");
}
$r2 = new M("aaa");
if ($r2->accepted !== false) {
    echo "FAIL: 103_greedy_longest aaa\n";
    throw new \Exception("103_greedy_longest aaa");
}
echo "PASS: 103_greedy_longest\n";
