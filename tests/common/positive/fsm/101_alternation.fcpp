@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 101_alternation
// ============================================================================
// Alternation `cat|dog` — first-match-wins (RE2 leftmost).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

int main() {
    M r0("cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        std::cout << "FAIL: 101_alternation cat" << std::endl;
        return 1;
    }
    M r1("dog");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        std::cout << "FAIL: 101_alternation dog" << std::endl;
        return 1;
    }
    M r2("cow");
    if (r2.accepted != false) {
        std::cout << "FAIL: 101_alternation cow" << std::endl;
        return 1;
    }
    std::cout << "PASS: 101_alternation" << std::endl;
    return 0;
}
