// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 108_lazy_quantifier
// ============================================================================
// Lazy `.*?,` (Pike VM): stops at the FIRST comma; matched="ab,".
// ============================================================================

@@fsm M(text: bytes) : bytes = "" { /.*?,/ @@:matched }

int main() {
    struct M r0;
    M_init(&r0, "ab,cd,ef");
    if (r0.accepted != true || r0.cursor != 3 || strcmp(r0.return_value, "ab,") != 0) {
        printf("FAIL: 108_lazy_quantifier ab,cd,ef\n");
        return 1;
    }
    printf("PASS: 108_lazy_quantifier\n");
    return 0;
}
