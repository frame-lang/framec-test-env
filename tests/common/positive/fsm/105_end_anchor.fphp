@@[target("php")]

# ============================================================================
# FSM-MATRIX 105_end_anchor
# ============================================================================
# End anchor `[0-9]+$` — the digit run must reach end of input.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /[0-9]+$/ true }

$r0 = new M("123");
if ($r0->accepted !== true || $r0->cursor !== 3 || $r0->return_value !== true) {
    echo "FAIL: 105_end_anchor 123\n";
    throw new \Exception("105_end_anchor 123");
}
$r1 = new M("123x");
if ($r1->accepted !== false) {
    echo "FAIL: 105_end_anchor 123x\n";
    throw new \Exception("105_end_anchor 123x");
}
echo "PASS: 105_end_anchor\n";
