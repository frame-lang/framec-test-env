// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 108_lazy_quantifier
# ============================================================================
# Lazy `.*?,` (Pike VM): stops at the FIRST comma; matched="ab,".
# ============================================================================

@@fsm M(text: bytes) : bytes = "" { /.*?,/ @@:matched }

def main():
    r0 = M("ab,cd,ef")
    assert r0.accepted == True, "108_lazy_quantifier ab,cd,ef: accepted"
    assert r0.cursor == 3, "108_lazy_quantifier ab,cd,ef: cursor"
    assert r0.return_value == "ab,", "108_lazy_quantifier ab,cd,ef: return_value"
    print("PASS: 108_lazy_quantifier")

if __name__ == "__main__":
    main()
