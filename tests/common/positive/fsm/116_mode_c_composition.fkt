@@[target("kotlin")]

// ============================================================================
// FSM-MATRIX 116_mode_c_composition
// ============================================================================
// Mode C composition: `/@Inner/` calls the `Inner` recognizer at the cursor; `Outer` accepts when `Inner` does and advances by its cursor. "123" → Inner matches, Outer accepts (cursor 3).
// ============================================================================

@@fsm Inner(text: bytes) : bool = false { /[0-9]+/ true }
@@fsm Outer(text: bytes) : bool = false { /@Inner/ true }

fun main() {
    val r0 = Outer("123")
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        throw RuntimeException("116_mode_c_composition 123")
    }
    val r1 = Outer("xy")
    if (r1.accepted != false) {
        throw RuntimeException("116_mode_c_composition xy")
    }
    println("PASS: 116_mode_c_composition")
}
