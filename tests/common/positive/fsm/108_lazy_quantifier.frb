@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 108_lazy_quantifier
# ============================================================================
# Lazy `.*?,` (Pike VM): stops at the FIRST comma; matched="ab,".
# ============================================================================

@@fsm M(text: bytes) : bytes = "" { /.*?,/ @@:matched }

def main
  r0 = M.new("ab,cd,ef")
  raise "108_lazy_quantifier ab,cd,ef: accepted" unless r0.accepted == true
  raise "108_lazy_quantifier ab,cd,ef: cursor" unless r0.cursor == 3
  raise "108_lazy_quantifier ab,cd,ef: return_value" unless r0.return_value == "ab,"
  puts "PASS: 108_lazy_quantifier"
end

main
