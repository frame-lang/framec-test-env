@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 109_inline_flag_caseless
// ============================================================================
// Inline flag `(?i)` — case-insensitive literal match.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

int main() {
    M r0("CAT");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        std::cout << "FAIL: 109_inline_flag_caseless CAT" << std::endl;
        return 1;
    }
    M r1("Cat");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        std::cout << "FAIL: 109_inline_flag_caseless Cat" << std::endl;
        return 1;
    }
    M r2("dog");
    if (r2.accepted != false) {
        std::cout << "FAIL: 109_inline_flag_caseless dog" << std::endl;
        return 1;
    }
    std::cout << "PASS: 109_inline_flag_caseless" << std::endl;
    return 0;
}
