// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 116_mode_c_composition
# ============================================================================
# Mode C composition: `/@Inner/` calls the `Inner` recognizer at the cursor; `Outer` accepts when `Inner` does and advances by its cursor. "123" → Inner matches, Outer accepts (cursor 3).
# ============================================================================

@@fsm Inner(text: bytes) : bool = false { /[0-9]+/ true }
@@fsm Outer(text: bytes) : bool = false { /@Inner/ true }

def main():
    r0 = Outer("123")
    assert r0.accepted == True, "116_mode_c_composition 123: accepted"
    assert r0.cursor == 3, "116_mode_c_composition 123: cursor"
    assert r0.return_value == True, "116_mode_c_composition 123: return_value"
    r1 = Outer("xy")
    assert r1.accepted == False, "116_mode_c_composition xy: accepted"
    print("PASS: 116_mode_c_composition")

if __name__ == "__main__":
    main()
