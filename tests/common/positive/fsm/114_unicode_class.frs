// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("rust")]

// ============================================================================
// FSM-MATRIX 114_unicode_class
// ============================================================================
// Unicode general-category class `\p{L}+` on `char` (opt-in `@@[allow(unicode_classes)]`). ASCII letters are in \p{L}; multibyte input is a per-backend char-width matter, kept out of the uniform matrix.
// ============================================================================

@@[allow(unicode_classes)]
@@fsm M(text: char) : bool = false { /\p{L}+/ true }

fn main() {
    let r0 = M::new("abc".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 3);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("1a".chars().collect());
    assert_eq!(r1.accepted, false);
    println!("PASS: 114_unicode_class");
}
