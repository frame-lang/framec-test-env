@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.
// The C backend takes a const char** token array plus an explicit length.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

int main() {
    const char* t_ok[] = {"IDENT", "LPAREN"};
    struct M ok;
    M_init(&ok, t_ok, 2);
    if (ok.accepted != true || ok.cursor != 2 || ok.return_value != true) { printf("FAIL: 117 ok\n"); return 1; }
    const char* t_bad[] = {"IDENT", "IDENT"};
    struct M bad;
    M_init(&bad, t_bad, 2);
    if (bad.accepted != false) { printf("FAIL: 117 bad\n"); return 1; }
    printf("PASS: 117_token_alphabet\n");
    return 0;
}
