// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("kotlin")]

// ============================================================================
// FSM-MATRIX 101_alternation
// ============================================================================
// Alternation `cat|dog` — first-match-wins (RE2 leftmost).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

fun main() {
    val r0 = M("cat")
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        throw RuntimeException("101_alternation cat")
    }
    val r1 = M("dog")
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        throw RuntimeException("101_alternation dog")
    }
    val r2 = M("cow")
    if (r2.accepted != false) {
        throw RuntimeException("101_alternation cow")
    }
    println("PASS: 101_alternation")
}
