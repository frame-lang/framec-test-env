@@[target("dart")]

// ============================================================================
// FSM-MATRIX 106_interior_anchor
// ============================================================================
// Interior anchor (Pike VM): `$` mid-pattern is unsatisfiable.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a$b/ true }

void main() {
    var r0 = M("ab");
    if (r0.accepted != false) {
        throw Exception("106_interior_anchor ab");
    }
    print("PASS: 106_interior_anchor");
}
