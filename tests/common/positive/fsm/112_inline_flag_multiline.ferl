// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("erlang")]

%% ============================================================================
%% FSM-MATRIX 112_inline_flag_multiline
%% ============================================================================
%% Inline flag `(?m)` multiline — `$` matches before a `\n` (Pike VM LineEnd assert). `a$` matches the `a` just before the newline.
%% ============================================================================

@@fsm M(text: bytes) : bool = false { /(?m)a$/ true }
