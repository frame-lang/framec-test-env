@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 110_capture_to_int
# ============================================================================
# Stage capture `.n` + to_int($s.n) → return_value is the integer.
# ============================================================================

@@fsm M(text: bytes) : int = 0 { $s: .n/[0-9]+/ to_int($s.n) }

func main():
	var r0 = M.new("42")
	if r0.accepted != true or r0.cursor != 2 or r0.return_value != 42:
		push_error("110_capture_to_int 42")
		return
	var r1 = M.new("x")
	if r1.accepted != false:
		push_error("110_capture_to_int x")
		return
	print("PASS: 110_capture_to_int")

func _init():
	main()
	quit()
