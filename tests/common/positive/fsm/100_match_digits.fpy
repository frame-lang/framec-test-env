// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# =============================================================================
# FSM-MATRIX 100: match digits — core DFA recognizer
# =============================================================================
# The recognizer `/[0-9]+/` accepts a run of digits at the cursor. Observable
# result fields (§5.1): accepted (bool), cursor (int), return_value, and
# reject_position. "123" matches (accepted, cursor=3); "xyz" rejects.
# =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }

def main():
    ok = Digits("123")
    assert ok.accepted == True, f"accepted={ok.accepted}"
    assert ok.cursor == 3, f"cursor={ok.cursor}"
    assert ok.return_value == True, f"return_value={ok.return_value}"
    bad = Digits("xyz")
    assert bad.accepted == False, f"bad.accepted={bad.accepted}"
    print("PASS: 100_match_digits")

if __name__ == '__main__':
    main()
