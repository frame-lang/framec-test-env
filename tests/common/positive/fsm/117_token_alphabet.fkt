@@[target("kotlin")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

fun main() {
    val ok = M(arrayOf("IDENT", "LPAREN"))
    if (ok.accepted != true || ok.cursor != 2 || ok.return_value != true) throw RuntimeException("117 ok")
    val bad = M(arrayOf("IDENT", "IDENT"))
    if (bad.accepted != false) throw RuntimeException("117 bad")
    println("PASS: 117_token_alphabet")
}
