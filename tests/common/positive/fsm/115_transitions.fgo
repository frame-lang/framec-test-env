@@[target("go")]

package main

import "fmt"
import "os"

// ============================================================================
// FSM-MATRIX 115_transitions
// ============================================================================
// Multi-state recognizer with failure branches: `/a/` → $next → `/b/` accepts; any mismatch routes to $error (reject). "ab" accepts (cursor 2).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a/ -> $next : -> $error  $next: /b/ true : -> $error  $error: false }

func main() {
    r0 := NewM("ab")
    if r0.accepted != true || r0.cursor != 2 || r0.return_value != true {
        fmt.Println("FAIL: 115_transitions ab")
        os.Exit(1)
    }
    r1 := NewM("ax")
    if r1.accepted != false {
        fmt.Println("FAIL: 115_transitions ax")
        os.Exit(1)
    }
    r2 := NewM("x")
    if r2.accepted != false {
        fmt.Println("FAIL: 115_transitions x")
        os.Exit(1)
    }
    fmt.Println("PASS: 115_transitions")
}
