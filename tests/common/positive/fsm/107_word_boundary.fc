@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 107_word_boundary
// ============================================================================
// Edge word boundaries `\bcat\b` (bytes): free-standing word.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

int main() {
    struct M r0;
    M_init(&r0, "cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        printf("FAIL: 107_word_boundary cat\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "cats");
    if (r1.accepted != false) {
        printf("FAIL: 107_word_boundary cats\n");
        return 1;
    }
    printf("PASS: 107_word_boundary\n");
    return 0;
}
