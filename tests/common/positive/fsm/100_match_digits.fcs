@@[target("csharp")]

// =============================================================================
// FSM-MATRIX 100: match digits — core DFA recognizer
// =============================================================================
// `/[0-9]+/` accepts a digit run at the cursor. "123" matches (cursor=3);
// "xyz" rejects.
// =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }

class Program {
    static void Main(string[] args) {
        Digits ok = new Digits("123");
        if (ok.accepted != true || ok.cursor != 3 || ok.return_value != true) {
            throw new Exception("123 should match (cursor 3)");
        }
        Digits bad = new Digits("xyz");
        if (bad.accepted != false) {
            throw new Exception("xyz should reject");
        }
        Console.WriteLine("PASS: 100_match_digits");
    }
}
