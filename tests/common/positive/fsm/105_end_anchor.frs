@@[target("rust")]

// ============================================================================
// FSM-MATRIX 105_end_anchor
// ============================================================================
// End anchor `[0-9]+$` — the digit run must reach end of input.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /[0-9]+$/ true }

fn main() {
    let r0 = M::new("123".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 3);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("123x".chars().collect());
    assert_eq!(r1.accepted, false);
    println!("PASS: 105_end_anchor");
}
