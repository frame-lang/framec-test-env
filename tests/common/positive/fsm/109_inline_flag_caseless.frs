// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("rust")]

// ============================================================================
// FSM-MATRIX 109_inline_flag_caseless
// ============================================================================
// Inline flag `(?i)` — case-insensitive literal match.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

fn main() {
    let r0 = M::new("CAT".chars().collect());
    assert_eq!(r0.accepted, true);
    assert_eq!(r0.cursor, 3);
    assert_eq!(r0.return_value, true);
    let r1 = M::new("Cat".chars().collect());
    assert_eq!(r1.accepted, true);
    assert_eq!(r1.cursor, 3);
    assert_eq!(r1.return_value, true);
    let r2 = M::new("dog".chars().collect());
    assert_eq!(r2.accepted, false);
    println!("PASS: 109_inline_flag_caseless");
}
