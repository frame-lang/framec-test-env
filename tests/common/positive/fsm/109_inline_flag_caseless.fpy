// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 109_inline_flag_caseless
# ============================================================================
# Inline flag `(?i)` — case-insensitive literal match.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

def main():
    r0 = M("CAT")
    assert r0.accepted == True, "109_inline_flag_caseless CAT: accepted"
    assert r0.cursor == 3, "109_inline_flag_caseless CAT: cursor"
    assert r0.return_value == True, "109_inline_flag_caseless CAT: return_value"
    r1 = M("Cat")
    assert r1.accepted == True, "109_inline_flag_caseless Cat: accepted"
    assert r1.cursor == 3, "109_inline_flag_caseless Cat: cursor"
    assert r1.return_value == True, "109_inline_flag_caseless Cat: return_value"
    r2 = M("dog")
    assert r2.accepted == False, "109_inline_flag_caseless dog: accepted"
    print("PASS: 109_inline_flag_caseless")

if __name__ == "__main__":
    main()
