@@[target("php")]

# ============================================================================
# FSM-MATRIX 112_inline_flag_multiline
# ============================================================================
# Inline flag `(?m)` multiline — `$` matches before a `\n` (Pike VM LineEnd assert). `a$` matches the `a` just before the newline.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?m)a$/ true }

$r0 = new M("a\nb");
if ($r0->accepted !== true || $r0->cursor !== 1 || $r0->return_value !== true) {
    echo "FAIL: 112_inline_flag_multiline a\nb\n";
    throw new \Exception("112_inline_flag_multiline a\nb");
}
$r1 = new M("ab");
if ($r1->accepted !== false) {
    echo "FAIL: 112_inline_flag_multiline ab\n";
    throw new \Exception("112_inline_flag_multiline ab");
}
echo "PASS: 112_inline_flag_multiline\n";
