@@[target("go")]

package main

import "fmt"
import "os"

// ============================================================================
// FSM-MATRIX 110_capture_to_int
// ============================================================================
// Stage capture `.n` + to_int($s.n) → return_value is the integer.
// ============================================================================

@@fsm M(text: bytes) : int = 0 { $s: .n/[0-9]+/ to_int($s.n) }

func main() {
    r0 := NewM("42")
    if r0.accepted != true || r0.cursor != 2 || r0.return_value != 42 {
        fmt.Println("FAIL: 110_capture_to_int 42")
        os.Exit(1)
    }
    r1 := NewM("x")
    if r1.accepted != false {
        fmt.Println("FAIL: 110_capture_to_int x")
        os.Exit(1)
    }
    fmt.Println("PASS: 110_capture_to_int")
}
