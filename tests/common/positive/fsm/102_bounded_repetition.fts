@@[target("typescript")]

// ============================================================================
// FSM-MATRIX 102_bounded_repetition
// ============================================================================
// Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

function main(): void {
    const r0 = new M("a");
    if (r0.accepted !== false) {
        throw new Error("102_bounded_repetition a");
    }
    const r1 = new M("aaa");
    if (r1.accepted !== true || r1.cursor !== 3 || r1.return_value !== true) {
        throw new Error("102_bounded_repetition aaa");
    }
    const r2 = new M("aaaaa");
    if (r2.accepted !== true || r2.cursor !== 4 || r2.return_value !== true) {
        throw new Error("102_bounded_repetition aaaaa");
    }
    console.log("PASS: 102_bounded_repetition");
}

main();
