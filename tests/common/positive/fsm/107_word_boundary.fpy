// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("python_3")]

# ============================================================================
# FSM-MATRIX 107_word_boundary
# ============================================================================
# Edge word boundaries `\bcat\b` (bytes): free-standing word.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

def main():
    r0 = M("cat")
    assert r0.accepted == True, "107_word_boundary cat: accepted"
    assert r0.cursor == 3, "107_word_boundary cat: cursor"
    assert r0.return_value == True, "107_word_boundary cat: return_value"
    r1 = M("cats")
    assert r1.accepted == False, "107_word_boundary cats: accepted"
    print("PASS: 107_word_boundary")

if __name__ == "__main__":
    main()
