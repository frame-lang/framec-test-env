// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("typescript")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

function main(): void {
    const ok = new M(["IDENT", "LPAREN"]);
    if (ok.accepted !== true || ok.cursor !== 2 || ok.return_value !== true) throw new Error("117 ok");
    const bad = new M(["IDENT", "IDENT"]);
    if (bad.accepted !== false) throw new Error("117 bad");
    console.log("PASS: 117_token_alphabet");
}
main();
