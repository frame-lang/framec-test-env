@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 113_word_boundary_char
// ============================================================================
// Word boundary `\bcat\b` on the `char` alphabet (Pike VM with the Unicode `\w` word table).
// ============================================================================

@@fsm M(text: char) : bool = false { /\bcat\b/ true }

int main() {
    struct M r0;
    M_init(&r0, "cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        printf("FAIL: 113_word_boundary_char cat\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "cats");
    if (r1.accepted != false) {
        printf("FAIL: 113_word_boundary_char cats\n");
        return 1;
    }
    printf("PASS: 113_word_boundary_char\n");
    return 0;
}
