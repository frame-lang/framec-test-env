// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// =============================================================================
// FSM-MATRIX 100: match digits — core DFA recognizer
// =============================================================================
// `/[0-9]+/` accepts a digit run at the cursor. "123" matches (cursor=3);
// "xyz" rejects. The C backend exposes the recognizer as a struct + free
// functions; `Digits_init(&m, text)` runs the scan.
// =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }

int main() {
    struct Digits ok;
    Digits_init(&ok, "123");
    if (ok.accepted != true || ok.cursor != 3 || ok.return_value != true) {
        printf("FAIL: 123 should match (cursor 3)\n");
        return 1;
    }
    struct Digits bad;
    Digits_init(&bad, "xyz");
    if (bad.accepted != false) {
        printf("FAIL: xyz should reject\n");
        return 1;
    }
    printf("PASS: 100_match_digits\n");
    return 0;
}
