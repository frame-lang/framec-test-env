// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 103_greedy_longest
# ============================================================================
# Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

func main():
	var r0 = M.new("aaab")
	if r0.accepted != true or r0.cursor != 4 or r0.return_value != true:
		push_error("103_greedy_longest aaab")
		return
	var r1 = M.new("b")
	if r1.accepted != true or r1.cursor != 1 or r1.return_value != true:
		push_error("103_greedy_longest b")
		return
	var r2 = M.new("aaa")
	if r2.accepted != false:
		push_error("103_greedy_longest aaa")
		return
	print("PASS: 103_greedy_longest")

func _init():
	main()
	quit()
