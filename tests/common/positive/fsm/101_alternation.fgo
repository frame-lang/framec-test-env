@@[target("go")]

package main

import "fmt"
import "os"

// ============================================================================
// FSM-MATRIX 101_alternation
// ============================================================================
// Alternation `cat|dog` — first-match-wins (RE2 leftmost).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /cat|dog/ true }

func main() {
    r0 := NewM("cat")
    if r0.accepted != true || r0.cursor != 3 || r0.return_value != true {
        fmt.Println("FAIL: 101_alternation cat")
        os.Exit(1)
    }
    r1 := NewM("dog")
    if r1.accepted != true || r1.cursor != 3 || r1.return_value != true {
        fmt.Println("FAIL: 101_alternation dog")
        os.Exit(1)
    }
    r2 := NewM("cow")
    if r2.accepted != false {
        fmt.Println("FAIL: 101_alternation cow")
        os.Exit(1)
    }
    fmt.Println("PASS: 101_alternation")
}
