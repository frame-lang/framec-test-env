// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 111_inline_flag_dotall
// ============================================================================
// Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

int main() {
    struct M r0;
    M_init(&r0, "a\nb");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        printf("FAIL: 111_inline_flag_dotall a\nb\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "axb");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        printf("FAIL: 111_inline_flag_dotall axb\n");
        return 1;
    }
    struct M r2;
    M_init(&r2, "ab");
    if (r2.accepted != false) {
        printf("FAIL: 111_inline_flag_dotall ab\n");
        return 1;
    }
    printf("PASS: 111_inline_flag_dotall\n");
    return 0;
}
