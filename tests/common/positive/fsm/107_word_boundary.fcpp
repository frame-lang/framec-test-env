@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 107_word_boundary
// ============================================================================
// Edge word boundaries `\bcat\b` (bytes): free-standing word.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

int main() {
    M r0("cat");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        std::cout << "FAIL: 107_word_boundary cat" << std::endl;
        return 1;
    }
    M r1("cats");
    if (r1.accepted != false) {
        std::cout << "FAIL: 107_word_boundary cats" << std::endl;
        return 1;
    }
    std::cout << "PASS: 107_word_boundary" << std::endl;
    return 0;
}
