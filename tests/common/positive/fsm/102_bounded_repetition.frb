// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 102_bounded_repetition
# ============================================================================
# Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

def main
  r0 = M.new("a")
  raise "102_bounded_repetition a: accepted" unless r0.accepted == false
  r1 = M.new("aaa")
  raise "102_bounded_repetition aaa: accepted" unless r1.accepted == true
  raise "102_bounded_repetition aaa: cursor" unless r1.cursor == 3
  raise "102_bounded_repetition aaa: return_value" unless r1.return_value == true
  r2 = M.new("aaaaa")
  raise "102_bounded_repetition aaaaa: accepted" unless r2.accepted == true
  raise "102_bounded_repetition aaaaa: cursor" unless r2.cursor == 4
  raise "102_bounded_repetition aaaaa: return_value" unless r2.return_value == true
  puts "PASS: 102_bounded_repetition"
end

main
