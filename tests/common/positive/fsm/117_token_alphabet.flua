@@[target("lua")]

-- FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

local ok = M.new({"IDENT", "LPAREN"})
assert(ok.accepted == true, "accepted")
assert(ok.cursor == 2, "cursor")
assert(ok.return_value == true, "rv")
local bad = M.new({"IDENT", "IDENT"})
assert(bad.accepted == false, "bad")
print("PASS: 117_token_alphabet")
