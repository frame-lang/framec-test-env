// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("go")]

package main

import "fmt"
import "os"

// ============================================================================
// FSM-MATRIX 109_inline_flag_caseless
// ============================================================================
// Inline flag `(?i)` — case-insensitive literal match.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

func main() {
    r0 := NewM("CAT")
    if r0.accepted != true || r0.cursor != 3 || r0.return_value != true {
        fmt.Println("FAIL: 109_inline_flag_caseless CAT")
        os.Exit(1)
    }
    r1 := NewM("Cat")
    if r1.accepted != true || r1.cursor != 3 || r1.return_value != true {
        fmt.Println("FAIL: 109_inline_flag_caseless Cat")
        os.Exit(1)
    }
    r2 := NewM("dog")
    if r2.accepted != false {
        fmt.Println("FAIL: 109_inline_flag_caseless dog")
        os.Exit(1)
    }
    fmt.Println("PASS: 109_inline_flag_caseless")
}
