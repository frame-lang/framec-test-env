// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("go")]

package main

import "fmt"
import "os"

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

func main() {
    ok := NewM([]string{"IDENT", "LPAREN"})
    if !ok.accepted || ok.cursor != 2 || ok.return_value != true {
        fmt.Println("FAIL: 117 ok"); os.Exit(1)
    }
    bad := NewM([]string{"IDENT", "IDENT"})
    if bad.accepted { fmt.Println("FAIL: 117 bad"); os.Exit(1) }
    fmt.Println("PASS: 117_token_alphabet")
}
