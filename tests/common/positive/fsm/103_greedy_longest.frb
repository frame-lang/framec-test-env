// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 103_greedy_longest
# ============================================================================
# Greedy `a*b` longest-match: `a*` consumes all `a`s before `b`.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a*b/ true }

def main
  r0 = M.new("aaab")
  raise "103_greedy_longest aaab: accepted" unless r0.accepted == true
  raise "103_greedy_longest aaab: cursor" unless r0.cursor == 4
  raise "103_greedy_longest aaab: return_value" unless r0.return_value == true
  r1 = M.new("b")
  raise "103_greedy_longest b: accepted" unless r1.accepted == true
  raise "103_greedy_longest b: cursor" unless r1.cursor == 1
  raise "103_greedy_longest b: return_value" unless r1.return_value == true
  r2 = M.new("aaa")
  raise "103_greedy_longest aaa: accepted" unless r2.accepted == false
  puts "PASS: 103_greedy_longest"
end

main
