// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# =============================================================================
# FSM-MATRIX 100: match digits — core DFA recognizer
# =============================================================================
# `/[0-9]+/` accepts a digit run at the cursor. "123" matches (cursor=3);
# "xyz" rejects.
# =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }

func main():
	var ok = Digits.new("123")
	if ok.accepted != true or ok.cursor != 3 or ok.return_value != true:
		push_error("123 should match (cursor 3)")
		return
	var bad = Digits.new("xyz")
	if bad.accepted != false:
		push_error("xyz should reject")
		return
	print("PASS: 100_match_digits")

func _init():
	main()
	quit()
