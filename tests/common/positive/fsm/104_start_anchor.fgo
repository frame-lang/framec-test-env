@@[target("go")]

package main

import "fmt"
import "os"

// ============================================================================
// FSM-MATRIX 104_start_anchor
// ============================================================================
// Start anchor `^foo` — matches only at input start (cursor 0).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

func main() {
    r0 := NewM("foo")
    if r0.accepted != true || r0.cursor != 3 || r0.return_value != true {
        fmt.Println("FAIL: 104_start_anchor foo")
        os.Exit(1)
    }
    r1 := NewM("xfoo")
    if r1.accepted != false {
        fmt.Println("FAIL: 104_start_anchor xfoo")
        os.Exit(1)
    }
    fmt.Println("PASS: 104_start_anchor")
}
