// @@skip: @@fsm removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 107_word_boundary
# ============================================================================
# Edge word boundaries `\bcat\b` (bytes): free-standing word.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /\bcat\b/ true }

def main
  r0 = M.new("cat")
  raise "107_word_boundary cat: accepted" unless r0.accepted == true
  raise "107_word_boundary cat: cursor" unless r0.cursor == 3
  raise "107_word_boundary cat: return_value" unless r0.return_value == true
  r1 = M.new("cats")
  raise "107_word_boundary cats: accepted" unless r1.accepted == false
  puts "PASS: 107_word_boundary"
end

main
