// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 105_end_anchor
# ============================================================================
# End anchor `[0-9]+$` — the digit run must reach end of input.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /[0-9]+$/ true }

def main
  r0 = M.new("123")
  raise "105_end_anchor 123: accepted" unless r0.accepted == true
  raise "105_end_anchor 123: cursor" unless r0.cursor == 3
  raise "105_end_anchor 123: return_value" unless r0.return_value == true
  r1 = M.new("123x")
  raise "105_end_anchor 123x: accepted" unless r1.accepted == false
  puts "PASS: 105_end_anchor"
end

main
