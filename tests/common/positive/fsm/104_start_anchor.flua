// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("lua")]

-- ============================================================================
-- FSM-MATRIX 104_start_anchor
-- ============================================================================
-- Start anchor `^foo` — matches only at input start (cursor 0).
-- ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

local r0 = M.new("foo")
assert(r0.accepted == true, "104_start_anchor foo: accepted")
assert(r0.cursor == 3, "104_start_anchor foo: cursor")
assert(r0.return_value == true, "104_start_anchor foo: return_value")
local r1 = M.new("xfoo")
assert(r1.accepted == false, "104_start_anchor xfoo: accepted")
print("PASS: 104_start_anchor")
