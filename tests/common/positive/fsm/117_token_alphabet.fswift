@@[target("swift")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

let ok = M(["IDENT", "LPAREN"])
if ok.accepted != true || ok.cursor != 2 || ok.return_value != true { fatalError("117 ok") }
let bad = M(["IDENT", "IDENT"])
if bad.accepted != false { fatalError("117 bad") }
print("PASS: 117_token_alphabet")
