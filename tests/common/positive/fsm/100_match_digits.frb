@@[target("ruby")]

# =============================================================================
# FSM-MATRIX 100: match digits — core DFA recognizer
# =============================================================================
# `/[0-9]+/` accepts a digit run at the cursor. "123" matches (cursor=3);
# "xyz" rejects.
# =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }

def main
  ok = Digits.new("123")
  raise "accepted=#{ok.accepted}" unless ok.accepted == true
  raise "cursor=#{ok.cursor}" unless ok.cursor == 3
  raise "return_value=#{ok.return_value}" unless ok.return_value == true
  bad = Digits.new("xyz")
  raise "bad.accepted=#{bad.accepted}" unless bad.accepted == false
  puts "PASS: 100_match_digits"
end

main
