@@[target("c")]

#include <stdbool.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// ============================================================================
// FSM-MATRIX 112_inline_flag_multiline
// ============================================================================
// Inline flag `(?m)` multiline — `$` matches before a `\n` (Pike VM LineEnd assert). `a$` matches the `a` just before the newline.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?m)a$/ true }

int main() {
    struct M r0;
    M_init(&r0, "a\nb");
    if (r0.accepted != true || r0.cursor != 1 || r0.return_value != true) {
        printf("FAIL: 112_inline_flag_multiline a\nb\n");
        return 1;
    }
    struct M r1;
    M_init(&r1, "ab");
    if (r1.accepted != false) {
        printf("FAIL: 112_inline_flag_multiline ab\n");
        return 1;
    }
    printf("PASS: 112_inline_flag_multiline\n");
    return 0;
}
