@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 106_interior_anchor
# ============================================================================
# Interior anchor (Pike VM): `$` mid-pattern is unsatisfiable.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a$b/ true }

def main
  r0 = M.new("ab")
  raise "106_interior_anchor ab: accepted" unless r0.accepted == false
  puts "PASS: 106_interior_anchor"
end

main
