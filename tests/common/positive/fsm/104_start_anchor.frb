@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 104_start_anchor
# ============================================================================
# Start anchor `^foo` — matches only at input start (cursor 0).
# ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

def main
  r0 = M.new("foo")
  raise "104_start_anchor foo: accepted" unless r0.accepted == true
  raise "104_start_anchor foo: cursor" unless r0.cursor == 3
  raise "104_start_anchor foo: return_value" unless r0.return_value == true
  r1 = M.new("xfoo")
  raise "104_start_anchor xfoo: accepted" unless r1.accepted == false
  puts "PASS: 104_start_anchor"
end

main
