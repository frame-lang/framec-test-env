@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 102_bounded_repetition
// ============================================================================
// Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

int main() {
    M r0("a");
    if (r0.accepted != false) {
        std::cout << "FAIL: 102_bounded_repetition a" << std::endl;
        return 1;
    }
    M r1("aaa");
    if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
        std::cout << "FAIL: 102_bounded_repetition aaa" << std::endl;
        return 1;
    }
    M r2("aaaaa");
    if (r2.accepted != true || r2.cursor != 4 || r2.return_value != true) {
        std::cout << "FAIL: 102_bounded_repetition aaaaa" << std::endl;
        return 1;
    }
    std::cout << "PASS: 102_bounded_repetition" << std::endl;
    return 0;
}
