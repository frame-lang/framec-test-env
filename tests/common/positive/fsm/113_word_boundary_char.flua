@@[target("lua")]

-- ============================================================================
-- FSM-MATRIX 113_word_boundary_char
-- ============================================================================
-- Word boundary `\bcat\b` on the `char` alphabet (Pike VM with the Unicode `\w` word table).
-- ============================================================================

@@fsm M(text: char) : bool = false { /\bcat\b/ true }

local r0 = M.new("cat")
assert(r0.accepted == true, "113_word_boundary_char cat: accepted")
assert(r0.cursor == 3, "113_word_boundary_char cat: cursor")
assert(r0.return_value == true, "113_word_boundary_char cat: return_value")
local r1 = M.new("cats")
assert(r1.accepted == false, "113_word_boundary_char cats: accepted")
print("PASS: 113_word_boundary_char")
