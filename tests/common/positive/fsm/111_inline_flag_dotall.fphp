@@[target("php")]

# ============================================================================
# FSM-MATRIX 111_inline_flag_dotall
# ============================================================================
# Inline flag `(?s)` dotall — `.` matches `\n` (Pike VM not needed; the class widens). `a.b` spans the newline in "a\nb".
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?s)a.b/ true }

$r0 = new M("a\nb");
if ($r0->accepted !== true || $r0->cursor !== 3 || $r0->return_value !== true) {
    echo "FAIL: 111_inline_flag_dotall a\nb\n";
    throw new \Exception("111_inline_flag_dotall a\nb");
}
$r1 = new M("axb");
if ($r1->accepted !== true || $r1->cursor !== 3 || $r1->return_value !== true) {
    echo "FAIL: 111_inline_flag_dotall axb\n";
    throw new \Exception("111_inline_flag_dotall axb");
}
$r2 = new M("ab");
if ($r2->accepted !== false) {
    echo "FAIL: 111_inline_flag_dotall ab\n";
    throw new \Exception("111_inline_flag_dotall ab");
}
echo "PASS: 111_inline_flag_dotall\n";
