@@[target("cpp_17")]

#include <iostream>

// ============================================================================
// FSM-MATRIX 104_start_anchor
// ============================================================================
// Start anchor `^foo` — matches only at input start (cursor 0).
// ============================================================================

@@fsm M(text: bytes) : bool = false { /^foo/ true }

int main() {
    M r0("foo");
    if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
        std::cout << "FAIL: 104_start_anchor foo" << std::endl;
        return 1;
    }
    M r1("xfoo");
    if (r1.accepted != false) {
        std::cout << "FAIL: 104_start_anchor xfoo" << std::endl;
        return 1;
    }
    std::cout << "PASS: 104_start_anchor" << std::endl;
    return 0;
}
