// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("cpp_17")]

#include <iostream>
#include <vector>
#include <string>

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

int main() {
    M ok(std::vector<std::string>{"IDENT", "LPAREN"});
    if (ok.accepted != true || ok.cursor != 2 || ok.return_value != true) { std::cout << "FAIL: 117 ok" << std::endl; return 1; }
    M bad(std::vector<std::string>{"IDENT", "IDENT"});
    if (bad.accepted != false) { std::cout << "FAIL: 117 bad" << std::endl; return 1; }
    std::cout << "PASS: 117_token_alphabet" << std::endl;
    return 0;
}
