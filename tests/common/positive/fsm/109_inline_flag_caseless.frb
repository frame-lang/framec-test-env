// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("ruby")]

# ============================================================================
# FSM-MATRIX 109_inline_flag_caseless
# ============================================================================
# Inline flag `(?i)` — case-insensitive literal match.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

def main
  r0 = M.new("CAT")
  raise "109_inline_flag_caseless CAT: accepted" unless r0.accepted == true
  raise "109_inline_flag_caseless CAT: cursor" unless r0.cursor == 3
  raise "109_inline_flag_caseless CAT: return_value" unless r0.return_value == true
  r1 = M.new("Cat")
  raise "109_inline_flag_caseless Cat: accepted" unless r1.accepted == true
  raise "109_inline_flag_caseless Cat: cursor" unless r1.cursor == 3
  raise "109_inline_flag_caseless Cat: return_value" unless r1.return_value == true
  r2 = M.new("dog")
  raise "109_inline_flag_caseless dog: accepted" unless r2.accepted == false
  puts "PASS: 109_inline_flag_caseless"
end

main
