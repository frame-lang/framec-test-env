// @@skip — `@@fsm` removed from the validation plan (owner ruling 2026-07-30); the regex DSL is out of scope for the milestone grid.
@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 112_inline_flag_multiline
# ============================================================================
# Inline flag `(?m)` multiline — `$` matches before a `\n` (Pike VM LineEnd assert). `a$` matches the `a` just before the newline.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /(?m)a$/ true }

func main():
	var r0 = M.new("a\nb")
	if r0.accepted != true or r0.cursor != 1 or r0.return_value != true:
		push_error("112_inline_flag_multiline a\nb")
		return
	var r1 = M.new("ab")
	if r1.accepted != false:
		push_error("112_inline_flag_multiline ab")
		return
	print("PASS: 112_inline_flag_multiline")

func _init():
	main()
	quit()
