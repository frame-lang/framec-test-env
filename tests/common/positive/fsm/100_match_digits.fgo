@@[target("go")]

package main

import "fmt"
import "os"

// =============================================================================
// FSM-MATRIX 100: match digits — core DFA recognizer
// =============================================================================
// `/[0-9]+/` accepts a digit run at the cursor. "123" matches (cursor=3);
// "xyz" rejects. Recognizer fields are package-private (same-package access).
// =============================================================================

@@fsm Digits(text: bytes) : bool = false { /[0-9]+/ true }

func main() {
    ok := NewDigits("123")
    if !ok.accepted || ok.cursor != 3 || ok.return_value != true {
        fmt.Println("FAIL: 123 should match (cursor 3)")
        os.Exit(1)
    }
    bad := NewDigits("xyz")
    if bad.accepted {
        fmt.Println("FAIL: xyz should reject")
        os.Exit(1)
    }
    fmt.Println("PASS: 100_match_digits")
}
