@@[target("java")]

// ============================================================================
// FSM-MATRIX 109_inline_flag_caseless
// ============================================================================
// Inline flag `(?i)` — case-insensitive literal match.
// ============================================================================

@@fsm M(text: bytes) : bool = false { /(?i)cat/ true }

class Main {
    public static void main(String[] args) {
        M r0 = new M("CAT");
        if (r0.accepted != true || r0.cursor != 3 || r0.return_value != true) {
            throw new RuntimeException("109_inline_flag_caseless CAT");
        }
        M r1 = new M("Cat");
        if (r1.accepted != true || r1.cursor != 3 || r1.return_value != true) {
            throw new RuntimeException("109_inline_flag_caseless Cat");
        }
        M r2 = new M("dog");
        if (r2.accepted != false) {
            throw new RuntimeException("109_inline_flag_caseless dog");
        }
        System.out.println("PASS: 109_inline_flag_caseless");
    }
}
