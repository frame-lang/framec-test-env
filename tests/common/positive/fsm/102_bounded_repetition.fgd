@@[target("gdscript")]
extends SceneTree

# ============================================================================
# FSM-MATRIX 102_bounded_repetition
# ============================================================================
# Bounded repetition `a{2,4}` — greedy within [2,4]; <2 rejects.
# ============================================================================

@@fsm M(text: bytes) : bool = false { /a{2,4}/ true }

func main():
	var r0 = M.new("a")
	if r0.accepted != false:
		push_error("102_bounded_repetition a")
		return
	var r1 = M.new("aaa")
	if r1.accepted != true or r1.cursor != 3 or r1.return_value != true:
		push_error("102_bounded_repetition aaa")
		return
	var r2 = M.new("aaaaa")
	if r2.accepted != true or r2.cursor != 4 or r2.return_value != true:
		push_error("102_bounded_repetition aaaaa")
		return
	print("PASS: 102_bounded_repetition")

func _init():
	main()
	quit()
