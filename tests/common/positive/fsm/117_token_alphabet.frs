@@[target("rust")]

// FSM-MATRIX 117_token_alphabet — token alphabet: /IDENT LPAREN/ over a token seq.

@@fsm M(text: token) : bool = false { /IDENT LPAREN/ true }

fn main() {
    let ok = M::new(vec!["IDENT".to_string(), "LPAREN".to_string()]);
    assert_eq!(ok.accepted, true);
    assert_eq!(ok.cursor, 2);
    assert_eq!(ok.return_value, true);
    let bad = M::new(vec!["IDENT".to_string(), "IDENT".to_string()]);
    assert_eq!(bad.accepted, false);
    println!("PASS: 117_token_alphabet");
}
