@@[target("csharp")]


@@system Editor {
    interface:
        type_char(c: string)
        undo()
        get_buffer(): string

    machine:
        $Editing {
            $.buffer: string = ""

            type_char(c: string) {
                push$
                $.buffer = $.buffer + c
            }
            undo() {
                -> pop$
            }
            get_buffer(): string { @@:($.buffer) }
        }
}

class Program {
    static void Main(string[] args) {
        var e = @@Editor();
        e.type_char("H");
        e.type_char("i");
        if ((string) e.get_buffer() != "Hi") throw new Exception("FAIL");
        e.undo();
        if ((string) e.get_buffer() != "Hi") throw new Exception("FAIL");
        e.undo();
        if ((string) e.get_buffer() != "Hi") throw new Exception("FAIL");
        Console.WriteLine("PASS: undo_redo");
    }
}
