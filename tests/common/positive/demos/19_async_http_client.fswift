@@[target("swift")]


@@[async]
@@system AsyncWorker {
    operations:
        has_log_entry(needle: String): Bool {
            @@:(self.log.contains(needle))
        }

    interface:
        async start()
        async process(data: String): String
        async stop()
        async get_status(): String

    machine:
        $Idle {
            $>() { self.log.append("idle:ready") }
            start() { -> $Working }
            get_status(): String { @@:("idle") }
        }
        $Working {
            $>() { self.log.append("working:entered") }
            <$() { self.log.append("working:exited") }
            process(data: String): String {
                let result = "processed:" + data
                self.log.append(result)
                @@:(result)
            }
            stop() { -> $Idle }
            get_status(): String { @@:("working") }
        }

    domain:
        log: [String] = []
}

// Swift top-level async: wrap in a Task and semaphore to keep the program
// alive until all awaits resolve, without requiring a @main-decorated type.
//
// RFC-0043 D2: AsyncWorker's gated interface methods are `async throws`.
// They throw `AsyncWorker.FrameE703Error.busy(...)` on concurrent entry;
// this single-driver script never triggers it, so every call uses `try`
// without a do/catch wrapper. A real production caller would catch.
// Line-buffer stdout: async drivers' buffered `print` can race exit
// and lose the final PASS line under a redirected stdout (test-env #11).
setvbuf(stdout, nil, _IOLBF, 0)
let __sem = DispatchSemaphore(value: 0)
Task {
    do {
        let w = @@AsyncWorker()
        await w.initAsync()

        var status = try await w.get_status()
        guard status == "idle" else { fatalError("Expected idle, got \(status)") }
        guard w.has_log_entry("idle:ready") else { fatalError("Expected idle:ready in log") }

        try await w.start()
        status = try await w.get_status()
        guard status == "working" else { fatalError("Expected working, got \(status)") }

        let result = try await w.process("hello")
        guard result == "processed:hello" else { fatalError("Expected processed:hello, got \(result)") }

        try await w.stop()
        status = try await w.get_status()
        guard status == "idle" else { fatalError("Expected idle, got \(status)") }
        guard w.has_log_entry("working:exited") else { fatalError("Expected working:exited in log") }

        print("PASS: async_http_client")
    } catch {
        fatalError("Unexpected error: \(error)")
    }
    __sem.signal()
}
__sem.wait()
