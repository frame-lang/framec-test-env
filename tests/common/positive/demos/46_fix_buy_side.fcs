@@[target("csharp")]


@@system FixBuySideOrder {
    interface:
        send_new(cl_ord_id: string)
        exec_new(exec_id: string)
        exec_partial_fill(qty: double, px: double)
        exec_fill(qty: double, px: double)
        exec_canceled(exec_id: string)
        get_status(): string
        get_cum_qty(): double
        get_leaves_qty(): double

    machine:
        $Pending {
            send_new(cl_ord_id: string) {
                this.cl_ord_id = cl_ord_id;
                this.leaves_qty = this.order_qty;
                -> $PendingNew
            }
            get_status(): string { @@:("Pending") }
            get_cum_qty(): double { @@:(this.cum_qty) }
            get_leaves_qty(): double { @@:(this.leaves_qty) }
        }

        $PendingNew {
            exec_new(exec_id: string) { -> $New }
            get_status(): string { @@:("PendingNew") }
            get_cum_qty(): double { @@:(this.cum_qty) }
            get_leaves_qty(): double { @@:(this.leaves_qty) }
        }

        $New {
            exec_partial_fill(qty: double, px: double) {
                this.cum_qty = this.cum_qty + qty;
                this.leaves_qty = this.order_qty - this.cum_qty;
                -> $PartiallyFilled
            }
            exec_fill(qty: double, px: double) {
                this.cum_qty = this.cum_qty + qty;
                this.leaves_qty = 0.0;
                -> $Filled
            }
            exec_canceled(exec_id: string) { -> $Canceled }
            get_status(): string { @@:("New") }
            get_cum_qty(): double { @@:(this.cum_qty) }
            get_leaves_qty(): double { @@:(this.leaves_qty) }
        }

        $PartiallyFilled {
            exec_partial_fill(qty: double, px: double) {
                this.cum_qty = this.cum_qty + qty;
                this.leaves_qty = this.order_qty - this.cum_qty;
                -> $PartiallyFilled
            }
            exec_fill(qty: double, px: double) {
                this.cum_qty = this.cum_qty + qty;
                this.leaves_qty = 0.0;
                -> $Filled
            }
            exec_canceled(exec_id: string) { -> $Canceled }
            get_status(): string { @@:("PartiallyFilled") }
            get_cum_qty(): double { @@:(this.cum_qty) }
            get_leaves_qty(): double { @@:(this.leaves_qty) }
        }

        $Filled {
            get_status(): string { @@:("Filled") }
            get_cum_qty(): double { @@:(this.cum_qty) }
            get_leaves_qty(): double { @@:(this.leaves_qty) }
        }

        $Canceled {
            get_status(): string { @@:("Canceled") }
            get_cum_qty(): double { @@:(this.cum_qty) }
            get_leaves_qty(): double { @@:(this.leaves_qty) }
        }

    domain:
        cl_ord_id: string = ""
        order_qty: double = 100.0
        cum_qty: double = 0.0
        leaves_qty: double = 0.0
}

class Program {
    static void Main(string[] args) {
        var o = @@FixBuySideOrder();
        if ((string) o.get_status() != "Pending") throw new Exception("expected Pending");
        o.send_new("CL-1");
        if ((string) o.get_status() != "PendingNew") throw new Exception("expected PendingNew");
        if ((double) o.get_leaves_qty() != 100.0) throw new Exception("expected leaves=100");
        o.exec_new("E-1");
        if ((string) o.get_status() != "New") throw new Exception("expected New");
        o.exec_partial_fill(40.0, 100.5);
        if ((string) o.get_status() != "PartiallyFilled") throw new Exception("expected PartiallyFilled");
        if ((double) o.get_cum_qty() != 40.0) throw new Exception("expected cum=40");
        o.exec_partial_fill(30.0, 100.6);
        if ((double) o.get_cum_qty() != 70.0) throw new Exception("expected cum=70");
        o.exec_fill(30.0, 100.7);
        if ((string) o.get_status() != "Filled") throw new Exception("expected Filled");
        if ((double) o.get_cum_qty() != 100.0) throw new Exception("expected cum=100");
        if ((double) o.get_leaves_qty() != 0.0) throw new Exception("expected leaves=0");
        Console.WriteLine("PASS: fix_buy_side");
    }
}
