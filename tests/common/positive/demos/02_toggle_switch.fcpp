@@[target("cpp_17")]

#include <iostream>
#include <cassert>

@@system Switch {
    interface:
        toggle(): std::string
        status(): std::string

    machine:
        $Off {
            toggle(): std::string {
                @@:(std::string("on"))
                -> $On
            }
            status(): std::string { @@:(std::string("off")) }
        }
        $On {
            toggle(): std::string {
                @@:(std::string("off"))
                -> $Off
            }
            status(): std::string { @@:(std::string("on")) }
        }
}

int main() {
    auto sw = @@Switch();
    assert(std::any_cast<std::string>(sw.status()) == "off");
    assert(std::any_cast<std::string>(sw.toggle()) == "on");
    assert(std::any_cast<std::string>(sw.toggle()) == "off");
    printf("PASS: toggle_switch\n");
    return 0;
}
