@@[target("cpp_17")]

#include <iostream>
#include <cassert>
#include <nlohmann/json.hpp>

@@[persist(std::string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Session {
    interface:
        login(user: std::string)
        logout()
        who(): std::string

    machine:
        $LoggedOut {
            login(user: std::string) {
                this->user = user;
                -> $LoggedIn
            }
            who(): std::string { @@:(std::string("nobody")) }
        }
        $LoggedIn {
            logout() {
                this->user = "";
                -> $LoggedOut
            }
            who(): std::string { @@:(this->user) }
        }

    domain:
        user: std::string = ""
}

int main() {
    auto s = @@Session();
    s.login("alice");
    assert(std::any_cast<std::string>(s.who()) == "alice");

    auto data = s.save_state();
    auto s2 = @@Session();

    s2.restore_state(data);
    assert(std::any_cast<std::string>(s2.who()) == "alice");
    printf("PASS: session_persistence\n");
    return 0;
}
