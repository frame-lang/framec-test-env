@@[target("rust")]

use tokio;

@@[async]
@@system AsyncWorker {
    interface:
        async start()
        async process(data: String): String
        async stop()
        get_status(): String

    machine:
        $Idle {
            $>() {
                self.log.push("idle:ready".to_string());
            }
            start() {
                -> $Working
            }
            get_status(): String { @@:("idle".to_string()) }
        }
        $Working {
            $>() {
                self.log.push("working:entered".to_string());
            }
            <$() {
                self.log.push("working:exited".to_string());
            }
            process(data: String): String {
                let result = format!("processed:{}", data);
                self.log.push(result.clone());
                @@:(result)
            }
            stop() {
                -> $Idle
            }
            get_status(): String { @@:("working".to_string()) }
        }

    domain:
        log: Vec<String> = Vec::new()
}

// NOTE: this demo's `w.log.contains(...)` assertions reach DIRECTLY
// into the casing's domain field. Under RFC-0043's layered emission,
// domain fields live on the private `_AsyncWorkerMachine`, not on the
// casing — so this demo no longer compiles. The fix (cross-backend) is
// to add a `get_log()` interface method to the Frame source and call
// it from the test driver. Tracked separately; not in scope for D5's
// Rust-only refactor.
//
// `.await` calls are D5-migrated to use `?` for forward-compat once
// the log-access issue is fixed.

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut w = @@AsyncWorker();
    w.init().await;

    assert_eq!(w.get_status().await?, "idle");
    assert!(w.log.contains(&"idle:ready".to_string()));

    w.start().await?;
    assert_eq!(w.get_status().await?, "working");

    let result = w.process("hello".to_string()).await?;
    assert_eq!(result, "processed:hello");

    w.stop().await?;
    assert_eq!(w.get_status().await?, "idle");
    assert!(w.log.contains(&"working:exited".to_string()));

    println!("PASS: async_http_client");
    Ok(())
}
