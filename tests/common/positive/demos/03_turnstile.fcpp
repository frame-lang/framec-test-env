@@[target("cpp_17")]

#include <iostream>
#include <cassert>

@@system Turnstile {
    interface:
        coin()
        push(): std::string

    machine:
        $Locked {
            coin() { -> $Unlocked }
            push(): std::string { @@:(std::string("locked - insert coin")) }
        }
        $Unlocked {
            coin() { }
            push(): std::string {
                @@:(std::string("welcome"))
                -> $Locked
            }
        }
}

int main() {
    auto t = @@Turnstile();
    assert(std::any_cast<std::string>(t.push()) == "locked - insert coin");
    t.coin();
    assert(std::any_cast<std::string>(t.push()) == "welcome");
    assert(std::any_cast<std::string>(t.push()) == "locked - insert coin");
    printf("PASS: turnstile\n");
    return 0;
}
