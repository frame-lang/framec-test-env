@@[target("c")]

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <cjson/cJSON.h>

@@[persist(char*)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Session {
    interface:
        login(user: char*)
        logout()
        who(): char*

    machine:
        $LoggedOut {
            login(user: char*) {
                self->user = user;
                -> $LoggedIn
            }
            who(): char* { @@:("nobody") }
        }
        $LoggedIn {
            logout() {
                self->user = "";
                -> $LoggedOut
            }
            who(): char* { @@:(self->user) }
        }

    domain:
        user: char* = ""
}

int main() {
    Session* s = @@Session();
    Session_login(s, "alice");
    if (strcmp(Session_who(s), "alice") != 0) {
        printf("FAIL: expected 'alice'\n");
        return 1;
    }
    char* data = Session_save_state(s);
    Session* s2 = @@Session();

    Session_restore_state(s2, data);
    if (strcmp(Session_who(s2), "alice") != 0) {
        printf("FAIL: expected 'alice' after restore\n");
        free(data);
        return 1;
    }
    printf("PASS: session_persistence\n");
    free(data);
    Session_destroy(s);
    Session_destroy(s2);
    return 0;
}
