@@[target("gdscript")]

extends SceneTree

@@system DialogManager {
    interface:
        open(name: String)
        close(): String
        current(): String

    machine:
        $Main {
            open(name: String) {
                push$
                -> (name) $Dialog
            }
            current(): String { @@:("main") }
        }
        $Dialog {
            $.name: String = ""

            $>(name: String) { $.name = name }

            open(name: String) {
                push$
                -> (name) $Dialog
            }
            close(): String {
                @@:($.name)
                -> pop$
            }
            current(): String { @@:($.name) }
        }
}

func _init():
    var dm = @@DialogManager()
    assert(dm.current() == "main", "Expected 'main'")
    dm.open("Settings")
    assert(dm.current() == "Settings", "Expected 'Settings'")
    dm.open("Confirm")
    assert(dm.current() == "Confirm", "Expected 'Confirm'")
    var closed = dm.close()
    assert(closed == "Confirm", "Expected 'Confirm'")
    assert(dm.current() == "Settings", "Expected 'Settings'")
    closed = dm.close()
    assert(closed == "Settings", "Expected 'Settings'")
    assert(dm.current() == "main", "Expected 'main'")
    print("PASS: modal_dialog_stack")
    quit()
