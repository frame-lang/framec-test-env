@@[target("gdscript")]

extends SceneTree

@@system Editor {
    interface:
        type_char(c: String)
        undo()
        get_buffer(): String

    machine:
        $Editing {
            $.buffer: String = ""

            type_char(c: String) {
                push$
                $.buffer = $.buffer + c
            }
            undo() {
                -> pop$
            }
            get_buffer(): String { @@:($.buffer) }
        }
}

func _init():
    var e = @@Editor()
    e.type_char("H")
    e.type_char("i")
    assert(e.get_buffer() == "Hi")
    e.undo()
    assert(e.get_buffer() == "Hi")
    e.undo()
    assert(e.get_buffer() == "Hi")
    print("PASS: undo_redo")
    quit()
