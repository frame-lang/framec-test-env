@@[target("go")]

package main

import (
	"encoding/json"
	"fmt"
	"strings"
)

// json is referenced only inside generated persist code in some build
// configurations; keep the import live so `go build` never trips on an
// "imported and not used" hard error when a system omits persist.
var _ = json.Marshal

// ============================================================================
// MAXIMAL FRAME COVERAGE FIXTURE — go
// CONTRACT: governed by tests/common/positive/max_coverage/README.md
// (brought to contract 2026-07-03: R1 portable composition + Part-3
// cross-product block — Kid/Solo/Orch below).
//
// One runnable, SELF-ASSERTING file exercising every Frame construct the Go
// backend supports. Construct tags are `// [tag]` comments above each
// construct. TAP output via the inline `ck` closure in main().
//
// GO CALL MODEL (settled): framec translates ONLY Frame syntax and passes
// native Go through unchanged. So:
//   * Own actions / operations / interface methods are invoked with the
//     portable `@@:self.<name>(args)` (lowers to the native Go call, e.g.
//     `s.Note(args)` for an interface method — emitting the transition guard —
//     or `s.note(args)` for an action). Bare native calls also reach them but
//     skip the transition guard.
//   * Child-system calls are user-authored native Go: framec lowers the
//     `$.sensor` state-var reference + the `@@Sensor()` construction, but the
//     CALL itself (`$.sensor.Bump()`) is plain Go method-call syntax.
//
// GO IDIOMS:
//   * `:=`, `for` (Frame has NO while/for keyword — loops are native Go;
//     `for` replaces the `while` other backends' fixtures use).
//   * `@@:data.x` lowers to an `any`-typed map read, so interpolate it with
//     `fmt.Sprintf("%v", @@:data.x)`, never `+`.
//   * A composed sub-system state var is pointer-typed (`*Sensor`) because
//     `@@Sensor()` returns `*Sensor`.
//   * Interface method names are capitalized in the emitted Go (`Start`,
//     `Submit`, ...); call them capitalized from native code.
//
// EXCLUSION — ASYNC: Go is NOT one of the async-layered backends. The Go
// backend has no async/await (Go models concurrency with goroutines/channels),
// and framec REJECTS `async` for the Go target as a hard compile error
// (frame_quickstart.md: "go ... async is a framec error"; frame_language.md
// Go row: "No async/await keyword"). The async @@system in the python/rust
// fixtures is therefore intentionally omitted here — its inclusion would not
// compile. This is a language-capability exclusion, not a coverage gap.
// ============================================================================

// [attr: main] [attr: persist JSON] [attr: save op] [attr: load op]
@@[main]
@@[persist(string)]
@@[save(SaveState)]
@@[load(LoadState)]
@@system Job {

	// [section: operations]
	operations:
		// [op: typed params + return, native `return` passthrough]
		clamp(v: int, hi: int): int {
			if v > hi {
				return hi
			}
			return v
		}

	// [section: interface]
	interface:
		start(id: string)
		submit(task: string)
		tick()
		pause()
		resume()
		finish()
		spin(n: int): int
		status(): string
		counter(): int
		depth(): int
		trace_of(): string
		scratch_of(): int
		// [const read via interface method]
		capacity(): int
		// [bool field read in a guard]
		set_verbose(v: bool)
		is_verbose(): bool
		// [internal operation call: self.clamp(...) inside a handler]
		clamp_in(v: int, hi: int)
		get_clamped(): int

	// [section: machine]
	machine:

		// [state: initial]
		$Begin {
			// [handler: enter, no args]
			$>() {
				s.trace = s.trace + "Begin>;"
			}
			start(id: string) {
				s.job_id = id
				// [action invocation via @@:self -> native s.note(...)]
				@@:self.note("N;")
				// [transition: labeled + enter-args]
				-> ("seed") $Idle
			}
			status(): string { @@:("begin"); return; }
			trace_of(): string { @@:(s.trace); return; }
			counter(): int { @@:(s.attempts); return; }
			// [const read]
			capacity(): int { @@:(s.MAX); return; }
			set_verbose(v: bool) { s.verbose = v }
			// [bool read in a guard / conditional]
			is_verbose(): bool {
				if s.verbose {
					@@:(true)
				} else {
					@@:(false)
				}
				return;
			}
		}

		// [state: HSM parent]
		$Working {
			status(): string { @@:("working"); return; }
			counter(): int { @@:(s.attempts); return; }
			depth(): int { @@:(s.stack_depth); return; }
			trace_of(): string { @@:(s.trace); return; }
		}

		// [state: HSM child => parent]
		$Idle => $Working {
			// [state var w/ type + init]
			$.i: int = 0

			// [handler: enter w/ param]
			$>(seed: string) {
				s.trace = s.trace + "Idle>(" + seed + ");"
			}
			// [handler: exit]
			<$() {
				s.trace = s.trace + "Idle<;"
			}
			submit(task: string) {
				// [native control: terminal conditional]
				if task == "" {
					-> $Rejected
				} else {
					s.attempts = s.attempts + 1
					// [transition: state-args -> $Active(task)]
					-> $Active(task)
				}
			}
			pause() {
				// [modal: push current state, transition to $Paused]
				push$
				-> $Paused
			}
			// [HSM: forward unhandled event to parent]
			status(): string { => $^ }
			depth(): int { => $^ }
			spin(n: int): int {
				// [native control: loop over a state var $.i — Go `for`]
				for $.i < n {
					$.i = $.i + 1
				}
				@@:($.i)
				return;
			}
		}

		// [state: typed state parameter (receives state args)]
		$Active(task: string) {
			$>() {
				s.trace = s.trace + "Active>(" + task + ");"
			}
			<$(why: string) {
				s.trace = s.trace + "Active<(" + why + ");"
			}
			tick() {
				s.scratch = s.scratch + 1
				// [native control: NON-TERMINAL conditional — mutate, fall through]
				if s.attempts < s.max_attempts {
					s.attempts = s.attempts + 1
				}
				s.trace = s.trace + fmt.Sprintf("tick%d;", s.attempts)
			}
			finish() {
				// [transition: decorated exit-args AND enter-args]
				("done") -> ("finished") $Done
			}
			status(): string { @@:("active"); return; }
			counter(): int { @@:(s.attempts); return; }
			trace_of(): string { @@:(s.trace); return; }
			scratch_of(): int { @@:(s.scratch); return; }
			// [internal operation call: clamp() as self.clamp(...) inside a handler]
			clamp_in(v: int, hi: int) {
				s.clamped = @@:self.clamp(v, hi)
			}
			get_clamped(): int { @@:(s.clamped); return; }
		}

		// [state: modal (pushed)]
		$Paused {
			$>() {
				s.stack_depth = s.stack_depth + 1
			}
			<$() {
				s.stack_depth = s.stack_depth - 1
			}
			pause() {
				// [modal: nested push]
				push$
				-> $Paused
			}
			resume() {
				// [modal: pop back to the pushed state]
				-> pop$
			}
			status(): string { @@:("paused"); return; }
			depth(): int { @@:(s.stack_depth); return; }
		}

		$Rejected {
			status(): string { @@:("rejected"); return; }
			counter(): int { @@:(s.attempts); return; }
			trace_of(): string { @@:(s.trace); return; }
		}

		// [state: final]
		$Done {
			$>(why: string) {
				s.trace = s.trace + "Done>(" + why + ");"
			}
			status(): string { @@:("done"); return; }
			counter(): int { @@:(s.attempts); return; }
			depth(): int { @@:(s.stack_depth); return; }
			trace_of(): string { @@:(s.trace); return; }
		}

	// [section: actions]
	actions:
		note(str: string) {
			s.trace = s.trace + str
		}

	// [section: domain]
	domain:
		// [decl: const field]
		const MAX: int = 99
		// [decl: typed domain vars + init]
		job_id: string = ""
		attempts: int = 0
		max_attempts: int = 3
		stack_depth: int = 0
		trace: string = ""
		// [decl: bool domain field — exercised in a guard + persist round-trip]
		verbose: bool = false
		clamped: int = 0
		// [attr: @@[no_persist] — excluded from save/load, resets on restore]
		@@[no_persist] scratch: int = 0
}

// ============================================================================
// MULTI-SYSTEM COMPOSITION — Controller holds + delegates to Sensor.
// The sub-system instance is held in a POINTER-typed state var (`*Sensor`),
// constructed in the enter handler via @@Sensor(), and called natively.
// ============================================================================
@@[persist(string)]
@@[save(SaveState)]
@@[load(LoadState)]
@@system Sensor {
	interface:
		bump()
		read(): int
	machine:
		$S {
			bump() {
				s.val = s.val + 1
			}
			read(): int { @@:(s.val); return; }
		}
	domain:
		val: int = 0
}

@@[persist(string)]
@@[save(SaveState)]
@@[load(LoadState)]
@@system Controller {
	interface:
		tick()
		total(): int
		count(): int
	machine:
		$C {
			// [composition: hold a sub-system instance in a pointer state var]
			$.sensor: *Sensor = nil
			$>() {
				$.sensor = @@Sensor()
			}
			tick() {
				s.seen = s.seen + 1
				// [control: native child-system call — $.sensor reference is
				//  lowered, the CALL is user-authored Go (case-mapped by hand)]
				$.sensor.Bump()
			}
			total(): int { @@:($.sensor.Read()); return; }
			count(): int { @@:(s.seen); return; }
		}
	domain:
		seen: int = 0
}

// ============================================================================
// CROSS-PRODUCT BLOCK (contract Part 3 — the distilled framec#159 family).
// `tick` is deliberately on FOUR systems here (Controller, Orch, Kid, Solo):
// the indexed portable call must case-map (`tick` -> `Tick`) via the VISIBLE
// leading-group element spelling `[]*Kid` (rule 1) — method-name inference is
// impossible by construction. This is the exact Go shape of the #159 reopen
// (GhostGame._tick_all fanning tick(dt) to the ghosts).
// ============================================================================
@@system Kid {
	interface:
		tick(dt: float64)
		probe(): int
	machine:
		$S {
			tick(dt: float64) {
				s.n = s.n + 1
			}
			probe(): int { @@:(s.n); return; }
		}
	domain:
		n: int = 0
}

@@system Solo {
	// [collision: SAME interface method names as Kid — a sibling child type]
	interface:
		tick(dt: float64)
		probe(): int
	machine:
		$S {
			tick(dt: float64) {
				s.p = s.p + 10
			}
			probe(): int { @@:(s.p); return; }
		}
	domain:
		p: int = 0
}

@@system Orch {
	interface:
		// [collision: orchestrator declares `tick` itself — caller-collision]
		tick(dt: float64)
		adopt(k: *Kid)
		kidval(i: int): int
		lastval(): int
		soloval(): int
	machine:
		$S {
			adopt(k: *Kid) {
				s.kids = append(s.kids, k)
			}
			tick(dt: float64) { @@:self._tickall(dt); }
			// [ref: indexed cross-system call, native-param index — case-maps
			//  to s.kids[i].Probe() via the visible []*Kid element type]
			kidval(i: int): int { @@:(@@:self.kids[i].probe()); return; }
			// [ref: indexed cross-system call, FRAME-EXPRESSION index]
			lastval(): int { @@:(@@:self.kids[len(@@:self.kids)-1].probe()); return; }
			// [ref: scalar sibling with the SAME collided method names]
			soloval(): int { @@:(@@:self.solo.probe()); return; }
		}
	actions:
		_tickall(dt: float64) {
			for i := 0; i < len(@@:self.kids); i++ {
				// [ref: indexed × cross-system × caller/sibling-collision —
				//  the framec#159 Go reopen shape; case-maps to .Tick(dt)]
				@@:self.kids[i].tick(dt)
			}
			// [ref: scalar field, collided name — case-maps to .Tick(dt)]
			@@:self.solo.tick(dt)
		}
	domain:
		// [domain: slice-of-systems, VISIBLE leading-group element spelling]
		kids: []*Kid
		// [domain: scalar sibling child of a DIFFERENT type, identical methods]
		solo: *Solo = @@Solo()
}

// ============================================================================
// CONSTRUCT PROBE — the remaining reference/transition constructs:
// @@:event, @@:params.x, @@:data.x (set+read), @@:return(e) short-circuit,
// @@:system.state.name, labeled transition, forward transition (-> => $S),
// forward WITH state args (#128), reentrant @@:self.m(), const read, action.
// ============================================================================
@@[persist(string)]
@@[save(SaveState)]
@@[load(LoadState)]
@@system Probe {
	interface:
		echo(x: string): string
		fire()
		relay()
		ping()
		here(): string
		evt(): string
		cap(): int
		log(): string
		classify(n: int): string
		guard(): int
		outer_data(): string
		inner_data()
		fwd()

	machine:

		$A {
			echo(x: string): string {
				// [ref: @@:params.x set into @@:data, then read back]
				@@:data.tmp = @@:params.x
				@@:(fmt.Sprintf("echo:%v", @@:data.tmp))
				return;
			}
			// [ref: @@:data call-scope isolation across a reentrant @@:self call]
			outer_data(): string {
				@@:data.k = "outer"
				@@:self.inner_data()  // inner gets its OWN @@:data scope
				@@:(fmt.Sprintf("%v", @@:data.k))  // must still read "outer"
				return;
			}
			inner_data() {
				@@:data.k = "inner"
			}
			// [native control: elif ladder + nested conditional, 4 branches]
			classify(n: int): string {
				if n < 0 {
					@@:("neg")
				} else if n == 0 {
					@@:("zero")
				} else {
					if n > 100 {
						@@:("big")
					} else {
						@@:("pos")
					}
				}
				return;
			}
			// [ref: @@:return(e) SHORT-CIRCUITS trailing code]
			guard(): int {
				@@:return(s.LIMIT)
				@@:self.helper("LEAK;")  // must NOT run
			}
			fire() {
				// [ref: @@:event records the current event name]
				s.last = @@:event
				// [transition: labeled]
				-> "fired" $B
			}
			relay() {
				// [transition: forward (re-dispatch event to $B)]
				-> => $B
			}
			fwd() {
				// [transition: forward WITH state args (#128)]
				-> => $C("payload")
			}
			ping() {
				// [action invocation + reentrant @@:self interface call]
				@@:self.helper("ping;")
				@@:self.fire()
			}
			// [ref: @@:system.state.name]
			here(): string { @@:(@@:system.state.name); return; }
			evt(): string { @@:return(s.last) }
			// [decl: const read]
			cap(): int { @@:(s.LIMIT); return; }
			log(): string { @@:(s.trace); return; }
		}

		$B {
			relay() {
				// handles the re-dispatched event
				s.trace = s.trace + "B.relay;"
			}
			here(): string { @@:("B"); return; }
			evt(): string { @@:return(s.last) }
			log(): string { @@:(s.trace); return; }
		}

		// [state: target of a forward transition carrying a state arg (#128)]
		$C(tok: string) {
			fwd() {
				s.trace = s.trace + "C.fwd(" + tok + ");"
			}
			here(): string { @@:("C"); return; }
			log(): string { @@:(s.trace); return; }
		}

	// [section: actions]
	actions:
		helper(str: string) {
			s.trace = s.trace + str
		}

	domain:
		// [decl: const field, read via s.LIMIT]
		const LIMIT: int = 50
		trace: string = ""
		last: string = ""
}

// ============================================================================
// DRIVER — TAP, fresh machine per scenario, asserts every path.
// ============================================================================
func main() {
	_ = strings.Contains // keep strings live for the contains() asserts below
	fmt.Println("TAP version 14")
	n := 0
	ck := func(cond bool, desc string) {
		n++
		if cond {
			fmt.Printf("ok %d - %s\n", n, desc)
		} else {
			fmt.Printf("not ok %d - %s\n", n, desc)
		}
	}

	// ----- operations (instance form) -----
	j0 := @@Job()
	ck(j0.Clamp(150, 99) == 99, "operation clamp(150,99)=99")
	ck(j0.Clamp(5, 99) == 5, "operation clamp(5,99)=5")

	// ----- HSM forward via => $^ + terminal conditional + action -----
	a := @@Job()
	a.Start("J1")
	ck(a.Status() == "working", "Idle forwards status via => $^ to parent")
	a.Submit("")
	ck(a.Status() == "rejected", "submit('') terminal conditional -> $Rejected")
	ck(strings.Contains(a.Trace_of(), "N;"), "action note() invoked from start()")

	// ----- state-args + non-terminal conditional + exit/enter args -----
	b := @@Job()
	b.Start("J2")
	b.Submit("payload")
	ck(b.Status() == "active", "submit(task) state-args -> $Active(task)")
	b.Tick()
	b.Tick()
	b.Tick()
	b.Tick()
	ck(b.Counter() == 3, "non-terminal conditional clamps attempts at max_attempts=3")
	ck(strings.Contains(b.Trace_of(), "tick3"), "trailing read of mutated field ran after the if")
	b.Finish()
	ck(b.Status() == "done", "finish() exit-args -> $Done")
	ck(strings.Contains(b.Trace_of(), "Active<(done)"), "exit handler received exit arg 'done'")
	ck(strings.Contains(b.Trace_of(), "Done>(finished)"), "enter handler received enter arg (exit+enter form)")

	// ----- single-level modal: push$/pop$ with depth() + second => $^ path -----
	c := @@Job()
	c.Start("J3")
	c.Pause()
	ck(c.Status() == "paused" && c.Depth() == 1, "push$ -> $Paused; $Paused.$> set depth=1")
	c.Resume()
	ck(c.Status() == "working" && c.Depth() == 0,
		"-> pop$ ran $Paused.<$ (depth->0) and depth() forwards via => $^ to $Working")

	// ----- nested modal stack: two push$, two -> pop$ prove a real stack -----
	cn := @@Job()
	cn.Start("J3b")
	cn.Pause()
	cn.Pause()
	ck(cn.Status() == "paused", "nested push$ twice -> still $Paused")
	cn.Resume()
	cn.Resume()
	ck(cn.Status() == "working", "two -> pop$ restore through the stack to $Idle")

	// ----- while-style loop over a state var (native Go `for`) -----
	d := @@Job()
	d.Start("J4")
	ck(d.Spin(5) == 5, "loop over state var $.i -> 5")

	// ----- const read + bool guard -----
	cap := @@Job()
	ck(cap.Capacity() == 99, "const MAX read via capacity() interface method = 99")
	ck(cap.Is_verbose() == false, "bool field default false read in guard")
	cap.Set_verbose(true)
	ck(cap.Is_verbose() == true, "bool field set true, read back true in guard")

	// ----- internal operation call (self.clamp) inside a handler -----
	ci := @@Job()
	ci.Start("CI")
	ci.Submit("payload") // -> $Active
	ci.Clamp_in(250, 99)
	ck(ci.Get_clamped() == 99, "operation clamp() called internally (self.clamp) inside handler = 99")
	ci.Clamp_in(7, 99)
	ck(ci.Get_clamped() == 7, "internal self.clamp(7,99) = 7")

	// ----- persist: FULL round-trip incl. state-arg survival + no_persist reset -----
	e := @@Job()
	e.Start("J5")
	e.Submit("z")
	e.Tick()
	snap := e.SaveState()
	e2 := @@Job()
	e2.LoadState(snap)
	ck(e2.Trace_of() == e.Trace_of() && strings.Contains(e2.Trace_of(), "Active>(z)"),
		"persist restores FULL trace incl. state-arg 'z' (deep equality)")
	ck(e2.Counter() == e.Counter() && e2.Status() == "active",
		"persist restores domain + current state")
	ck(e.Scratch_of() == 1 && e2.Scratch_of() == 0,
		"@@[no_persist] field excluded from blob (restore resets it to default 0)")

	// ----- persist: bool domain field survives JSON round-trip -----
	vp := @@Job()
	vp.Set_verbose(true)
	vsnap := vp.SaveState()
	vp2 := @@Job()
	vp2.LoadState(vsnap)
	ck(vp2.Is_verbose() == true, "persist: bool field survived save/restore")

	// ----- multi-system composition + ISOLATION (two independent Controllers) -----
	ctrl1 := @@Controller()
	ctrl1.Tick()
	ctrl1.Tick()
	ctrl2 := @@Controller()
	ctrl2.Tick()
	ctrl2.Tick()
	ctrl2.Tick()
	ck(ctrl1.Total() == 2 && ctrl2.Total() == 3, "multi-system: two Controllers hold INDEPENDENT Sensors")
	ck(ctrl1.Count() == 2 && ctrl2.Count() == 3, "multi-system: each Controller's own domain isolated")

	// ----- construct probe -----
	pr := @@Probe()
	ck(pr.Echo("hi") == "echo:hi", "@@:params.x + @@:data set/read")
	ck(pr.Here() == "A" && pr.Cap() == 50, "@@:system.state.name + const read")
	ck(pr.Classify(-1) == "neg" && pr.Classify(0) == "zero" && pr.Classify(50) == "pos" && pr.Classify(200) == "big",
		"elif ladder + nested conditional (4 branches)")
	ck(pr.Guard() == 50 && !strings.Contains(pr.Log(), "LEAK;"),
		"@@:return(e) short-circuits trailing code (vs @@:(e))")
	pr.Fire()
	ck(pr.Here() == "B" && pr.Evt() == "fire", "@@:event recorded + labeled transition -> $B")

	pr2 := @@Probe()
	pr2.Relay()
	ck(pr2.Here() == "B" && strings.Contains(pr2.Log(), "B.relay;"), "forward transition -> => $B re-dispatched relay")

	pr3 := @@Probe()
	pr3.Ping()
	ck(strings.Contains(pr3.Log(), "ping;") && pr3.Here() == "B", "action invocation + reentrant @@:self.fire()")

	pr4 := @@Probe()
	pr4.Fwd()
	ck(pr4.Here() == "C" && strings.Contains(pr4.Log(), "C.fwd(payload)"),
		"forward transition WITH state args -> => $C(arg) [#128]")

	pr5 := @@Probe()
	ck(pr5.Outer_data() == "outer",
		"@@:data call-scope isolated across reentrant @@:self call")

	// --- CROSS-PRODUCT BLOCK (contract Part 3 / framec#159 family) ---
	o := @@Orch()
	ka := @@Kid()
	kb := @@Kid()
	kc := @@Kid()
	o.Adopt(ka)
	o.Adopt(kb)
	o.Adopt(kc)
	o.Tick(0.16)
	o.Tick(0.16)
	ck(o.Kidval(0) == 2 && o.Kidval(1) == 2 && o.Kidval(2) == 2,
		"x-product: indexed @@:self.kids[i].tick case-mapped + 3 kids independent (collided name, 4 tick-bearing systems)")
	ck(o.Lastval() == 2, "x-product: Frame-expression index @@:self.kids[len(...)-1].probe()")
	ck(o.Soloval() == 20, "x-product: scalar sibling with identical method names dispatched to Solo")
	ka.Tick(1.0) // [control: native pre-lowered call]
	ck(o.Kidval(0) == 3 && o.Kidval(1) == 2, "x-product: control native call touches only kid 0")

	fmt.Printf("1..%d\n", n)
}
