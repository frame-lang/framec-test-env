@@[target("php")]

# ============================================================================
# MAXIMAL FRAME COVERAGE FIXTURE — php
# One runnable, self-asserting file exercising every Frame construct the PHP
# backend supports. TAP output via ck(). The matrix runner executes this file
# directly with `php` (framec emits the leading `<?php`).
#
# PHP idioms: own actions/operations/interface methods use the portable
# `@@:self.name(args)` (-> $this->name(args)); child-system calls are native PHP
# the user authors (`$this->sensor->bump()`). Method names are emitted verbatim
# (lowercase here). Native control flow is PHP `if (...) { } else if (...) { }`
# and `while (...) { }` with `;`-terminated statements, written directly in
# handler bodies. Domain fields are read/written natively as `$this->field`.
# Persist serializes via JSON (PHP's json_encode/json_decode are built in).
#
# #144: a non-constant domain initializer (`@@Sensor()`, `new X()`) is lowered
# into the constructor — the multi-system composition below exercises that fix.
#
# PHP is NOT async-layered (no `@@[async]`), so the async/E703 surface is out of
# scope for this fixture — it is covered by the matrix async suite.
# ============================================================================

# ============================================================================
# CORE SYSTEM — HSM, modal stack, all 7 statements, transitions, references,
# const, actions, operations, persist round-trip, typed fields (int/bool/
# double/string), internal operation call.
# ============================================================================
@@[main]
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@[create(make)]
@@system Job {

    # [section: operations]
    operations:
        # [op: typed params + return, native return passthrough + conditional in op body]
        clamp(v: int, hi: int): int {
            if ($v > $hi) {
                return $hi;
            }
            return $v;
        }

    # [section: interface]
    interface:
        start(id: string)
        submit(task: string)
        tick()
        pause()
        resume()
        finish()
        spin(n: int): int
        status(): string
        counter(): int
        depth(): int
        trace_of(): string
        scratch_of(): int
        # [bool/double coverage + const read + internal op call]
        set_verbose(v: bool)
        is_verbose(): bool
        set_ratio(r: double)
        get_ratio(): double
        capacity(): int
        clamp_in(v: int, hi: int)
        get_clamped(): int

    # [section: machine]
    machine:

        # [state: initial]
        $Begin {
            # [handler: enter, no args]
            $>() {
                $this->trace = $this->trace . "Begin>;";
            }
            start(id: string) {
                $this->job_id = $id;
                @@:self.note("N;");                 # [action invocation via @@:self]
                -> ("seed") $Idle
            }
            status(): string { @@:("begin") }
            trace_of(): string { @@:($this->trace) }
            counter(): int { @@:($this->attempts) }
            # [bool setter/getter — exercised + persist round-tripped]
            set_verbose(v: bool) { $this->verbose = $v; }
            # [bool read in a guard]
            is_verbose(): bool {
                if ($this->verbose) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }
            set_ratio(r: double) { $this->ratio = $r; }
            get_ratio(): double { @@:($this->ratio) }
            # [const read via interface method]
            capacity(): int { @@:($this->max) }
        }

        # [state: HSM parent]
        $Working {
            status(): string { @@:("working") }
            counter(): int { @@:($this->attempts) }
            depth(): int { @@:($this->stack_depth) }
            trace_of(): string { @@:($this->trace) }
        }

        # [state: HSM child => parent]
        $Idle => $Working {
            # [state var w/ type + init]
            $.i: int = 0

            # [handler: enter w/ param]
            $>(seed: string) {
                $this->trace = $this->trace . "Idle>(" . $seed . ");";
            }
            # [handler: exit]
            <$() {
                $this->trace = $this->trace . "Idle<;";
            }
            submit(task: string) {
                # [native control: terminal conditional w/ transitions]
                if ($task == "") {
                    -> $Rejected
                } else {
                    $this->attempts = $this->attempts + 1;
                    -> $Active(task)
                }
            }
            pause() {
                push$
                -> $Paused
            }
            # [transition forwarding via => $^ to HSM parent]
            status(): string { => $^ }
            depth(): int { => $^ }
            spin(n: int): int {
                # [native control: while loop over state var $.i]
                while ($.i < $n) {
                    $.i = $.i + 1;
                }
                @@:($.i)
            }
        }

        # [state: typed state parameter (receives state args)]
        $Active(task: string) {
            $>() {
                $this->trace = $this->trace . "Active>(" . $task . ");";
            }
            <$(why: string) {
                $this->trace = $this->trace . "Active<(" . $why . ");";
            }
            tick() {
                $this->scratch = $this->scratch + 1;
                # [native control: NON-TERMINAL conditional — mutate, fall through]
                if ($this->attempts < $this->max_attempts) {
                    $this->attempts = $this->attempts + 1;
                }
                $this->trace = $this->trace . "tick" . $this->attempts . ";";
            }
            finish() {
                ("done") -> ("finished") $Done       # [exit-args + enter-args transition]
            }
            status(): string { @@:("active") }
            counter(): int { @@:($this->attempts) }
            trace_of(): string { @@:($this->trace) }
            scratch_of(): int { @@:($this->scratch) }
            # [internal operation call: clamp() invoked as @@:self.clamp(...) inside a handler]
            clamp_in(v: int, hi: int) {
                $this->clamped = @@:self.clamp($v, $hi);
            }
            get_clamped(): int { @@:($this->clamped) }
            # [bool/double getters + const read reachable in $Active for persist-restore reads]
            is_verbose(): bool {
                if ($this->verbose) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }
            get_ratio(): double { @@:($this->ratio) }
            capacity(): int { @@:($this->max) }
        }

        # [state: modal (pushed)]
        $Paused {
            $>() {
                $this->stack_depth = $this->stack_depth + 1;
            }
            <$() {
                $this->stack_depth = $this->stack_depth - 1;
            }
            pause() {
                push$
                -> $Paused
            }
            resume() {
                -> pop$
            }
            status(): string { @@:("paused") }
            depth(): int { @@:($this->stack_depth) }
        }

        $Rejected {
            status(): string { @@:("rejected") }
            counter(): int { @@:($this->attempts) }
            trace_of(): string { @@:($this->trace) }
        }

        # [state: final]
        $Done {
            $>(why: string) {
                $this->trace = $this->trace . "Done>(" . $why . ");";
            }
            status(): string { @@:("done") }
            counter(): int { @@:($this->attempts) }
            depth(): int { @@:($this->stack_depth) }
            trace_of(): string { @@:($this->trace) }
        }

    # [section: actions]
    actions:
        note(s: string) {
            $this->trace = $this->trace . $s;
        }

    # [section: domain]
    domain:
        # [decl: const field — read AND persisted (#139: emitted mutable)]
        const max: int = 99
        # [decl: typed domain vars + init]
        job_id: string = ""
        attempts: int = 0
        max_attempts: int = 3
        stack_depth: int = 0
        trace: string = ""
        # [decl: bool + double domain fields — guards/getters + persist round-trip]
        verbose: bool = false
        ratio: double = 1.5
        clamped: int = 0
        # [attr: @@[no_persist] — excluded from the serialized blob, resets on restore]
        @@[no_persist]
        scratch: int = 0
}

# ============================================================================
# MULTI-SYSTEM COMPOSITION — Controller holds + delegates to Sensor.
# framec lowers the $.sensor reference + @@Sensor() construction (assigned in
# the constructor per #144); the call ($this->sensor->bump()) is native PHP.
# ============================================================================
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Sensor {
    interface:
        bump()
        read(): int
    machine:
        $S {
            bump() {
                $this->val = $this->val + 1;
            }
            read(): int { @@:($this->val) }
        }
    domain:
        val: int = 0
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Controller {
    interface:
        tick()
        total(): int
        count(): int
    machine:
        $C {
            tick() {
                $this->seen = $this->seen + 1;
                $this->sensor->bump();               # native call into child system
            }
            total(): int { @@:($this->sensor->read()) }
            count(): int { @@:($this->seen) }
        }
    domain:
        # [composition: hold a sub-system instance as a typed domain field (#144)]
        sensor: Sensor = @@Sensor()
        seen: int = 0
}

# ============================================================================
# CONSTRUCT PROBE — the remaining reference/transition constructs:
# @@:event, @@:params.x, @@:data.x (set+read, call-scope isolation),
# @@:return(e) short-circuit, @@:system.state.name, labeled transition,
# forward transition (-> => $S), forward WITH state args (#128), reentrant
# @@:self, const read, action invocation, elif ladder + nested conditional.
# ============================================================================
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Probe {

    interface:
        echo(x: string): string
        fire()
        relay()
        ping()
        here(): string
        evt(): string
        cap(): int
        log(): string
        classify(n: int): string
        guard(): int
        outer_data(): string
        inner_data()
        fwd()

    machine:

        $A {
            echo(x: string): string {
                @@:data.tmp = @@:params.x
                @@:("echo:" . @@:data.tmp)
            }
            # [@@:data call-scope isolation across a reentrant @@:self call]
            outer_data(): string {
                @@:data.k = "outer"
                @@:self.inner_data();                # inner gets its OWN @@:data scope
                @@:(@@:data.k)                        # must still read "outer"
            }
            inner_data() {
                @@:data.k = "inner"
            }
            # [elif ladder + nested conditional — 4 branches]
            classify(n: int): string {
                if ($n < 0) {
                    @@:("neg")
                } else if ($n == 0) {
                    @@:("zero")
                } else {
                    if ($n > 100) {
                        @@:("big")
                    } else {
                        @@:("pos")
                    }
                }
            }
            # [@@:return(e) short-circuits trailing code (vs @@:(e))]
            guard(): int {
                @@:return($this->limit)
                @@:self.helper("LEAK;");
            }
            fire() {
                $this->last = @@:event
                -> "fired" $B                        # [transition: labeled]
            }
            relay() {
                -> => $B                              # [transition: forward (re-dispatch)]
            }
            fwd() {
                -> => $C("payload")                   # [transition: forward WITH state args (#128)]
            }
            ping() {
                @@:self.helper("ping;");              # [action invocation via @@:self]
                @@:self.fire()                        # [ref: reentrant self-call]
            }
            here(): string { @@:(@@:system.state.name) }
            evt(): string { @@:return($this->last) }
            cap(): int { @@:($this->limit) }          # [decl: const read]
            log(): string { @@:($this->trace) }
        }

        $B {
            relay() {
                $this->trace = $this->trace . "B.relay;";   # handles re-dispatched event
            }
            here(): string { @@:("B") }
            evt(): string { @@:return($this->last) }
            log(): string { @@:($this->trace) }
        }

        # [state: target of a forward transition carrying a state arg (#128 fixed)]
        $C(tok: string) {
            fwd() {
                $this->trace = $this->trace . "C.fwd(" . $tok . ");";
            }
            here(): string { @@:("C") }
            log(): string { @@:($this->trace) }
        }

    # [section: actions]
    actions:
        helper(s: string) {
            $this->trace = $this->trace . $s;
        }

    domain:
        const limit: int = 50
        trace: string = ""
        last: string = ""
}

# ============================================================================
# DRIVER — TAP, fresh machine per scenario, asserts every path.
# ============================================================================
$tap_n = 0;
function ck($cond, $desc) {
    global $tap_n;
    $tap_n += 1;
    echo ($cond ? "ok " : "not ok ") . $tap_n . " - " . $desc . "\n";
}

echo "TAP version 14\n";

# ----- operations (instance form, factory-renamed make) -----
$j0 = Job::make();
ck($j0->clamp(150, 99) == 99, "operation clamp(150,99)=99 (conditional in op body)");
ck($j0->clamp(5, 99) == 5, "operation clamp(5,99)=5 (native return passthrough)");

# ----- HSM forward via => $^ + terminal conditional + action -----
$a = @@Job();
$a->start("J1");
ck($a->status() == "working", "Idle forwards status via => \$^ to parent \$Working");
$a->submit("");
ck($a->status() == "rejected", "submit('') terminal conditional -> \$Rejected");
ck(strpos($a->trace_of(), "N;") !== false, "action note() invoked from start() via @@:self");

# ----- state-args + non-terminal conditional + trailing read -----
$b = @@Job();
$b->start("J2");
$b->submit("payload");
ck($b->status() == "active", "submit(task) state-args -> \$Active(task)");
$b->tick();
$b->tick();
$b->tick();
$b->tick();
ck($b->counter() == 3, "non-terminal conditional clamps attempts at max_attempts=3");
ck(strpos($b->trace_of(), "tick3") !== false, "trailing read of mutated field ran after the if");

# ----- exit-args + enter-args transition -----
$b->finish();
ck($b->status() == "done", "finish() exit+enter-args -> \$Done");
ck(strpos($b->trace_of(), "Active<(done)") !== false, "exit handler received exit arg 'done'");
ck(strpos($b->trace_of(), "Done>(finished)") !== false, "enter handler received enter arg 'finished'");

# ----- single-level modal: push$ / -> pop$ + second => $^ path -----
$c = @@Job();
$c->start("J3");
$c->pause();
ck($c->status() == "paused" && $c->depth() == 1, "push\$ -> \$Paused; \$Paused.\$> set depth=1");
$c->resume();
ck($c->status() == "working" && $c->depth() == 0,
   "-> pop\$ ran \$Paused.<\$ (depth->0) and depth() forwards via => \$^ to \$Working");

# ----- nested modal stack — two push$, two -> pop$ prove a real stack -----
$cn = @@Job();
$cn->start("J3b");
$cn->pause();
$cn->pause();
ck($cn->status() == "paused", "nested push\$ twice -> still \$Paused");
$cn->resume();
$cn->resume();
ck($cn->status() == "working", "two -> pop\$ restore through the stack to \$Idle");

# ----- while loop over a state var -----
$d = @@Job();
$d->start("J4");
ck($d->spin(5) == 5, "while loop over state var \$.i -> 5");

# ----- const read via interface method -----
$cap = @@Job();
ck($cap->capacity() == 99, "const max read via capacity() interface method = 99");

# ----- bool read in a guard -----
$bv = @@Job();
ck($bv->is_verbose() == false, "bool field default false read in guard");
$bv->set_verbose(true);
ck($bv->is_verbose() == true, "bool field set true, read back true in guard");

# ----- double getter -----
$fr = @@Job();
ck($fr->get_ratio() == 1.5, "double field default 1.5 via getter");
$fr->set_ratio(2.75);
ck($fr->get_ratio() == 2.75, "double field set 2.75, read back");

# ----- internal operation call: clamp() called as @@:self.clamp(...) inside a handler -----
$ci = @@Job();
$ci->start("CI");
$ci->submit("payload");                       # -> $Active
$ci->clamp_in(250, 99);
ck($ci->get_clamped() == 99, "operation clamp() called internally (@@:self.clamp) = 99");
$ci->clamp_in(7, 99);
ck($ci->get_clamped() == 7, "internal @@:self.clamp(7,99) = 7");

# ----- persist — deep round-trip incl. state-arg survival + const + no_persist -----
$e = @@Job();
$e->set_verbose(true);                        # set in $Begin (setters live there)
$e->set_ratio(3.0625);                        # exact in double; survives JSON
$e->start("J5");
$e->submit("z");                              # -> $Active(z)
$e->tick();                                   # attempts -> 1, scratch -> 1
$snap = $e->save_state();
ck($e->scratch_of() == 1, "persist: @@[no_persist] scratch holds 1 before save");

$e2 = @@Job();
$e2->restore_state($snap);
ck($e2->trace_of() == $e->trace_of() && strpos($e2->trace_of(), "Active>(z)") !== false,
   "persist restores FULL trace incl. state-arg 'z' (deep equality)");
ck($e2->counter() == $e->counter() && $e2->status() == "active",
   "persist restores domain + current state (\$Active)");
ck($e2->is_verbose() == true && $e2->get_ratio() == 3.0625,
   "persist round-trips bool + double fields through JSON");
ck($e2->capacity() == 99,
   "persist: const max survives save/restore (#139: emitted mutable)");
ck($e->scratch_of() == 1 && $e2->scratch_of() == 0,
   "@@[no_persist] scratch excluded from blob (restore resets to default 0)");

# ----- multi-system composition + ISOLATION (two independent Controllers) -----
$k1 = @@Controller();
$k1->tick();
$k1->tick();
$k2 = @@Controller();
$k2->tick();
$k2->tick();
$k2->tick();
ck($k1->total() == 2 && $k2->total() == 3, "multi-system: two Controllers hold INDEPENDENT Sensors");
ck($k1->count() == 2 && $k2->count() == 3, "multi-system: each Controller's own domain isolated");

# ----- construct probe -----
$pr = @@Probe();
ck($pr->echo("hi") == "echo:hi", "@@:params.x + @@:data set/read");
ck($pr->here() == "A" && $pr->cap() == 50, "@@:system.state.name + const read");
ck($pr->classify(-1) == "neg" && $pr->classify(0) == "zero" && $pr->classify(50) == "pos" && $pr->classify(200) == "big",
   "elif ladder + nested conditional (4 branches)");
ck($pr->guard() == 50 && strpos($pr->log(), "LEAK;") === false,
   "@@:return(e) short-circuits trailing code (vs @@:(e))");
$pr->fire();
ck($pr->here() == "B" && $pr->evt() == "fire", "@@:event recorded + labeled transition -> \$B");

$pr2 = @@Probe();
$pr2->relay();
ck($pr2->here() == "B" && strpos($pr2->log(), "B.relay;") !== false, "forward transition -> => \$B re-dispatched relay");

$pr3 = @@Probe();
$pr3->ping();
ck(strpos($pr3->log(), "ping;") !== false && $pr3->here() == "B", "action invocation + reentrant @@:self.fire()");

$pr4 = @@Probe();
$pr4->fwd();
ck($pr4->here() == "C" && strpos($pr4->log(), "C.fwd(payload)") !== false,
   "forward transition WITH state args -> => \$C(arg) [#128 fixed]");

$pr5 = @@Probe();
ck($pr5->outer_data() == "outer",
   "@@:data call-scope isolated across reentrant @@:self call");

echo "1.." . $tap_n . "\n";
