@@[target("kotlin")]

// ============================================================================
// MAXIMAL FRAME COVERAGE FIXTURE — kotlin
// One runnable, self-asserting file exercising every Frame construct the Kotlin
// backend supports. TAP output via ck(). The matrix runner (kotlin_batch.sh)
// prepends `@file:JvmName("Runner")` + `package frametest.<id>`, batch-compiles
// every .kt into one JAR with the coroutines + Jackson jars on the classpath,
// then dispatches each test's top-level main() reflectively (Runner.main).
//
// KOTLIN CALL MODEL: own actions/operations/interface methods use the portable
// `@@:self.name(args)` (-> this.name(args)); child-system calls are native
// Kotlin the user authors (this.sensor.bump()), with the child held in a typed
// domain field. Kotlin uses native `else if`, braces, lowercase true/false,
// and capitalized native types (Int/String/Boolean/Double).
//
// KOTLIN ASYNC MODEL (RFC-0043): UNLIKE Java/C++, the Kotlin casing is truly
// coroutine-layered — interface methods are `suspend fun`, the in-flight gate
// is a real kotlinx.coroutines.sync.Mutex, and a *concurrent* E703 trip IS
// reproducible: a second driver entering while the first suspends throws
// IllegalStateException("E703: system busy: ..."). The whole driver runs inside
// runBlocking; operations stay SYNC (non-suspend, gate-bypassing) even in an
// @@[async] system.
//
// CONST + PERSIST (#139): a `const` domain field is emitted as `var` (NOT val)
// so it serializes through Jackson and compiles clean — verified below by a
// const that is BOTH read AND survives save/restore.
// ============================================================================

import kotlinx.coroutines.async
import kotlinx.coroutines.delay
import kotlinx.coroutines.runBlocking

// ============================================================================
// CORE SYSTEM — HSM, modal stack, all 7 statements, transitions, references,
// const (#139: persisted, emitted as var), actions, operations (+conditional in
// op body), persist round-trip, typed fields (Int/Boolean/Double/String),
// internal operation call.
// ============================================================================
@@[main]
@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@[create(make)]
@@system Job {

    // [section: operations]
    operations:
        // [op: typed params + return, native return passthrough + conditional in op body]
        clamp(v: Int, hi: Int): Int {
            if (v > hi) {
                return hi
            }
            return v
        }

    // [section: interface]
    interface:
        start(id: String)
        submit(task: String)
        tick()
        pause()
        resume()
        finish()
        spin(n: Int): Int
        status(): String
        counter(): Int
        depth(): Int
        trace_of(): String
        scratch_of(): Int
        // [boolean/double coverage + const read + internal op call]
        set_verbose(v: Boolean)
        is_verbose(): Boolean
        set_ratio(r: Double)
        get_ratio(): Double
        capacity(): Int
        clamp_in(v: Int, hi: Int)
        get_clamped(): Int

    // [section: machine]
    machine:

        // [state: initial]
        $Begin {
            // [handler: enter, no args]
            $>() {
                this.trace = this.trace + "Begin>;"
            }
            start(id: String) {
                this.job_id = id
                @@:self.note("N;")                  // [action invocation via @@:self]
                -> ("seed") $Idle
            }
            status(): String { @@:("begin") }
            trace_of(): String { @@:(this.trace) }
            counter(): Int { @@:(this.attempts) }
            // [boolean setter/getter — exercised + persist round-tripped]
            set_verbose(v: Boolean) { this.verbose = v }
            // [boolean read in a guard]
            is_verbose(): Boolean {
                if (this.verbose) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }
            set_ratio(r: Double) { this.ratio = r }
            get_ratio(): Double { @@:(this.ratio) }
            // [const read via interface method]
            capacity(): Int { @@:(this.MAX) }
        }

        // [state: HSM parent]
        $Working {
            status(): String { @@:("working") }
            counter(): Int { @@:(this.attempts) }
            depth(): Int { @@:(this.stack_depth) }
            trace_of(): String { @@:(this.trace) }
        }

        // [state: HSM child => parent]
        $Idle => $Working {
            // [state var w/ type + init]
            $.i: Int = 0

            // [handler: enter w/ param]
            $>(seed: String) {
                this.trace = this.trace + "Idle>(" + seed + ");"
            }
            // [handler: exit]
            <$() {
                this.trace = this.trace + "Idle<;"
            }
            submit(task: String) {
                // [native control: terminal conditional w/ transitions]
                if (task == "") {
                    -> $Rejected
                } else {
                    this.attempts = this.attempts + 1
                    -> $Active(task)
                }
            }
            pause() {
                push$
                -> $Paused
            }
            // [transition forwarding via => $^ to HSM parent]
            status(): String { => $^ }
            depth(): Int { => $^ }
            spin(n: Int): Int {
                // [native control: while loop over state var $.i]
                while ($.i < n) {
                    $.i = $.i + 1
                }
                @@:($.i)
            }
        }

        // [state: typed state parameter (receives state args)]
        $Active(task: String) {
            $>() {
                this.trace = this.trace + "Active>(" + task + ");"
            }
            <$(why: String) {
                this.trace = this.trace + "Active<(" + why + ");"
            }
            tick() {
                this.scratch = this.scratch + 1
                // [native control: NON-TERMINAL conditional — mutate, fall through]
                if (this.attempts < this.max_attempts) {
                    this.attempts = this.attempts + 1
                }
                this.trace = this.trace + "tick" + this.attempts + ";"
            }
            finish() {
                ("done") -> ("finished") $Done       // [exit-args + enter-args transition]
            }
            status(): String { @@:("active") }
            counter(): Int { @@:(this.attempts) }
            trace_of(): String { @@:(this.trace) }
            scratch_of(): Int { @@:(this.scratch) }
            // [internal operation call: clamp() invoked as @@:self.clamp(...) inside a handler]
            clamp_in(v: Int, hi: Int) {
                this.clamped = @@:self.clamp(v, hi)
            }
            get_clamped(): Int { @@:(this.clamped) }
            // [boolean/double getters + const read reachable in $Active for persist-restore reads]
            is_verbose(): Boolean {
                if (this.verbose) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }
            get_ratio(): Double { @@:(this.ratio) }
            capacity(): Int { @@:(this.MAX) }
        }

        // [state: modal (pushed)]
        $Paused {
            $>() {
                this.stack_depth = this.stack_depth + 1
            }
            <$() {
                this.stack_depth = this.stack_depth - 1
            }
            pause() {
                push$
                -> $Paused
            }
            resume() {
                -> pop$
            }
            status(): String { @@:("paused") }
            depth(): Int { @@:(this.stack_depth) }
        }

        $Rejected {
            status(): String { @@:("rejected") }
            counter(): Int { @@:(this.attempts) }
            trace_of(): String { @@:(this.trace) }
        }

        // [state: final]
        $Done {
            $>(why: String) {
                this.trace = this.trace + "Done>(" + why + ");"
            }
            status(): String { @@:("done") }
            counter(): Int { @@:(this.attempts) }
            depth(): Int { @@:(this.stack_depth) }
            trace_of(): String { @@:(this.trace) }
        }

    // [section: actions]
    actions:
        note(s: String) {
            this.trace = this.trace + s
        }

    // [section: domain]
    domain:
        // [decl: const field — read AND persisted (#139: emitted as var, not val)]
        const MAX: Int = 99
        // [decl: typed domain vars + init]
        job_id: String = ""
        attempts: Int = 0
        max_attempts: Int = 3
        stack_depth: Int = 0
        trace: String = ""
        // [decl: boolean + double domain fields — guards/getters + persist round-trip]
        verbose: Boolean = false
        ratio: Double = 1.5
        clamped: Int = 0
        // [attr: @@[no_persist] — excluded from the serialized blob, resets on restore]
        @@[no_persist]
        scratch: Int = 0
}

// ============================================================================
// MULTI-SYSTEM COMPOSITION — Controller holds + delegates to Sensor.
// framec lowers the sensor domain field + @@Sensor() construction; the call
// (this.sensor.bump()) is user-authored native Kotlin.
// ============================================================================
@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Sensor {
    interface:
        bump()
        read(): Int
    machine:
        $S {
            bump() {
                this.count = this.count + 1
            }
            read(): Int { @@:(this.count) }
        }
    domain:
        // NB: field is `count`, not `val` — `val` is a reserved Kotlin keyword
        // (the Python/Java fixtures' Sensor.val field name is illegal here).
        count: Int = 0
}

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Controller {
    interface:
        tick()
        total(): Int
        count(): Int
    machine:
        $C {
            tick() {
                this.seen = this.seen + 1
                this.sensor.bump()                   // native call into child system
            }
            total(): Int { @@:(this.sensor.read()) }
            count(): Int { @@:(this.seen) }
        }
    domain:
        // [composition: hold a sub-system instance as a typed domain field]
        sensor: Sensor = @@Sensor()
        seen: Int = 0
}

// ============================================================================
// CONSTRUCT PROBE — the remaining reference/transition constructs:
// @@:event, @@:params.x, @@:data.x (set+read, call-scope isolation),
// @@:return(e) short-circuit, @@:system.state.name, labeled transition,
// forward transition (-> => $S), forward WITH state args (#128), reentrant
// @@:self, const read, action invocation, else-if ladder + nested conditional.
// ============================================================================
@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Probe {

    interface:
        echo(x: String): String
        fire()
        relay()
        ping()
        here(): String
        evt(): String
        cap(): Int
        log(): String
        classify(n: Int): String
        guard(): Int
        outer_data(): String
        inner_data()
        fwd()

    machine:

        $A {
            echo(x: String): String {
                @@:data.tmp = @@:params.x
                @@:("echo:" + @@:data.tmp)
            }
            // [@@:data call-scope isolation across a reentrant @@:self call]
            outer_data(): String {
                @@:data.k = "outer"
                @@:self.inner_data()                 // inner gets its OWN @@:data scope
                @@:(@@:data.k)                       // must still read "outer"
            }
            inner_data() {
                @@:data.k = "inner"
            }
            // [else-if ladder + nested conditional — 4 branches]
            classify(n: Int): String {
                if (n < 0) {
                    @@:("neg")
                } else if (n == 0) {
                    @@:("zero")
                } else {
                    if (n > 100) {
                        @@:("big")
                    } else {
                        @@:("pos")
                    }
                }
            }
            // [@@:return(e) short-circuits trailing code (vs @@:(e))]
            guard(): Int {
                @@:return(this.LIMIT)
                @@:self.helper("LEAK;")
            }
            fire() {
                this.last = @@:event
                -> "fired" $B                        // [transition: labeled]
            }
            relay() {
                -> => $B                             // [transition: forward (re-dispatch)]
            }
            fwd() {
                -> => $C("payload")                  // [transition: forward WITH state args (#128)]
            }
            ping() {
                @@:self.helper("ping;")              // [action invocation via @@:self]
                @@:self.fire()                       // [ref: reentrant self-call]
            }
            here(): String { @@:(@@:system.state.name) }
            evt(): String { @@:return(this.last) }
            cap(): Int { @@:(this.LIMIT) }           // [decl: const read]
            log(): String { @@:(this.trace) }
        }

        $B {
            relay() {
                this.trace = this.trace + "B.relay;"   // handles re-dispatched event
            }
            here(): String { @@:("B") }
            evt(): String { @@:return(this.last) }
            log(): String { @@:(this.trace) }
        }

        // [state: target of a forward transition carrying a state arg (#128 fixed)]
        $C(tok: String) {
            fwd() {
                this.trace = this.trace + "C.fwd(" + tok + ");"
            }
            here(): String { @@:("C") }
            log(): String { @@:(this.trace) }
        }

    // [section: actions]
    actions:
        helper(s: String) {
            this.trace = this.trace + s
        }

    domain:
        const LIMIT: Int = 50
        trace: String = ""
        last: String = ""
}

// ============================================================================
// ASYNC SYSTEM — @@[async] Pump: suspend interface methods + a SYNC operation
// bypass + the E703 single-driver gate. UNLIKE Java/C++, Kotlin's gate is a real
// coroutine Mutex, so a *concurrent* trip IS reproducible: while drain()
// suspends at delay(), a second driver entering throws IllegalStateException
// with the "E703: system busy: ..." message. We exercise BOTH the concurrent
// trip AND that the gate clears for sequential calls (no stuck gate).
// ============================================================================
@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@[async]
@@system Pump {
    operations:
        // [op: SYNC bypass — operations are not suspend even in an @@[async] system]
        peek(): Int {
            @@:(this.level)
        }
    interface:
        async push(): Int
        async drain(): Int
        async slow(): Int
    machine:
        $P {
            push(): Int {
                this.level = this.level + 1
                @@:(this.level)
            }
            drain(): Int {
                this.level = 0
                @@:(this.level)
            }
            // [suspending handler — holds the gate across delay() so a concurrent
            //  entrant trips E703]
            slow(): Int {
                delay(50)
                this.level = this.level + 1
                @@:(this.level)
            }
        }
    domain:
        level: Int = 0
}

// ============================================================================
// DRIVER — TAP, fresh machine per scenario, asserts every path.
// Whole driver runs in runBlocking so suspend interface methods can be awaited.
// ============================================================================
var _n = 0
fun ck(c: Boolean, d: String) {
    _n++
    println((if (c) "ok " else "not ok ") + _n + " - " + d)
}

fun main() = runBlocking {
    println("TAP version 14")

    // ----- operations (instance form, factory-renamed make) -----
    val j0 = Job.make()
    ck(j0.clamp(150, 99) == 99, "operation clamp(150,99)=99 (conditional in op body)")
    ck(j0.clamp(5, 99) == 5, "operation clamp(5,99)=5 (native return passthrough)")

    // ----- HSM forward via => $^ + terminal conditional + action -----
    val a = @@Job()
    a.start("J1")
    ck(a.status() == "working", "Idle forwards status via => \$^ to parent \$Working")
    a.submit("")
    ck(a.status() == "rejected", "submit('') terminal conditional -> \$Rejected")
    ck(a.trace_of().contains("N;"), "action note() invoked from start() via @@:self")

    // ----- state-args + non-terminal conditional + trailing read -----
    val b = @@Job()
    b.start("J2")
    b.submit("payload")
    ck(b.status() == "active", "submit(task) state-args -> \$Active(task)")
    b.tick()
    b.tick()
    b.tick()
    b.tick()
    ck(b.counter() == 3, "non-terminal conditional clamps attempts at max_attempts=3")
    ck(b.trace_of().contains("tick3"), "trailing read of mutated field ran after the if")

    // ----- exit-args + enter-args transition -----
    b.finish()
    ck(b.status() == "done", "finish() exit+enter-args -> \$Done")
    ck(b.trace_of().contains("Active<(done)"), "exit handler received exit arg 'done'")
    ck(b.trace_of().contains("Done>(finished)"), "enter handler received enter arg 'finished'")

    // ----- single-level modal: push$ / -> pop$ + second => $^ path -----
    val c = @@Job()
    c.start("J3")
    c.pause()
    ck(c.status() == "paused" && c.depth() == 1, "push\$ -> \$Paused; \$Paused.\$> set depth=1")
    c.resume()
    ck(c.status() == "working" && c.depth() == 0,
        "-> pop\$ ran \$Paused.<\$ (depth->0) and depth() forwards via => \$^ to \$Working")

    // ----- nested modal stack — two push$, two -> pop$ prove a real stack -----
    val cn = @@Job()
    cn.start("J3b")
    cn.pause()
    cn.pause()
    ck(cn.status() == "paused", "nested push\$ twice -> still \$Paused")
    cn.resume()
    cn.resume()
    ck(cn.status() == "working", "two -> pop\$ restore through the stack to \$Idle")

    // ----- while loop over a state var -----
    val d = @@Job()
    d.start("J4")
    ck(d.spin(5) == 5, "while loop over state var \$.i -> 5")

    // ----- const read via interface method -----
    val cap = @@Job()
    ck(cap.capacity() == 99, "const MAX read via capacity() interface method = 99")

    // ----- boolean read in a guard -----
    val bv = @@Job()
    ck(bv.is_verbose() == false, "boolean field default false read in guard")
    bv.set_verbose(true)
    ck(bv.is_verbose() == true, "boolean field set true, read back true in guard")

    // ----- double getter -----
    val fr = @@Job()
    ck(fr.get_ratio() == 1.5, "double field default 1.5 via getter")
    fr.set_ratio(2.75)
    ck(fr.get_ratio() == 2.75, "double field set 2.75, read back")

    // ----- internal operation call: clamp() called as @@:self.clamp(...) inside a handler -----
    val ci = @@Job()
    ci.start("CI")
    ci.submit("payload")                             // -> $Active
    ci.clamp_in(250, 99)
    ck(ci.get_clamped() == 99, "operation clamp() called internally (@@:self.clamp) = 99")
    ci.clamp_in(7, 99)
    ck(ci.get_clamped() == 7, "internal @@:self.clamp(7,99) = 7")

    // ----- persist — deep round-trip incl. state-arg survival + const + no_persist -----
    val e = @@Job()
    e.set_verbose(true)                              // set in $Begin (setters live there)
    e.set_ratio(3.0625)                              // exact in double; survives JSON
    e.start("J5")
    e.submit("z")                                    // -> $Active(z)
    e.tick()                                         // attempts -> 1, scratch -> 1
    val snap = e.save_state()
    ck(e.scratch_of() == 1, "persist: @@[no_persist] scratch holds 1 before save")

    val e2 = @@Job()
    e2.restore_state(snap)
    ck(e2.trace_of() == e.trace_of() && e2.trace_of().contains("Active>(z)"),
        "persist restores FULL trace incl. state-arg 'z' (deep equality)")
    ck(e2.counter() == e.counter() && e2.status() == "active",
        "persist restores domain + current state (\$Active)")
    ck(e2.is_verbose() == true && e2.get_ratio() == 3.0625,
        "persist round-trips boolean + double fields through JSON")
    ck(e2.capacity() == 99,
        "persist: const MAX survives save/restore + compiles (#139: emitted as var)")
    ck(e.scratch_of() == 1 && e2.scratch_of() == 0,
        "@@[no_persist] scratch excluded from blob (restore resets to default 0)")

    // ----- multi-system composition + ISOLATION (two independent Controllers) -----
    val k1 = @@Controller()
    k1.tick()
    k1.tick()
    val k2 = @@Controller()
    k2.tick()
    k2.tick()
    k2.tick()
    ck(k1.total() == 2 && k2.total() == 3, "multi-system: two Controllers hold INDEPENDENT Sensors")
    ck(k1.count() == 2 && k2.count() == 3, "multi-system: each Controller's own domain isolated")

    // ----- construct probe -----
    val pr = @@Probe()
    ck(pr.echo("hi") == "echo:hi", "@@:params.x + @@:data set/read")
    ck(pr.here() == "A" && pr.cap() == 50, "@@:system.state.name + const read")
    ck(pr.classify(-1) == "neg" && pr.classify(0) == "zero" && pr.classify(50) == "pos" && pr.classify(200) == "big",
        "else-if ladder + nested conditional (4 branches)")
    ck(pr.guard() == 50 && !pr.log().contains("LEAK;"),
        "@@:return(e) short-circuits trailing code (vs @@:(e))")
    pr.fire()
    ck(pr.here() == "B" && pr.evt() == "fire", "@@:event recorded + labeled transition -> \$B")

    val pr2 = @@Probe()
    pr2.relay()
    ck(pr2.here() == "B" && pr2.log().contains("B.relay;"), "forward transition -> => \$B re-dispatched relay")

    val pr3 = @@Probe()
    pr3.ping()
    ck(pr3.log().contains("ping;") && pr3.here() == "B", "action invocation + reentrant @@:self.fire()")

    val pr4 = @@Probe()
    pr4.fwd()
    ck(pr4.here() == "C" && pr4.log().contains("C.fwd(payload)"),
        "forward transition WITH state args -> => \$C(arg) [#128 fixed]")

    val pr5 = @@Probe()
    ck(pr5.outer_data() == "outer",
        "@@:data call-scope isolated across reentrant @@:self call")

    // ----- ASYNC: suspend interface, awaited inside runBlocking -----
    val pump = @@Pump()
    pump.init()                                      // API-parity no-op (suspend)
    val r1 = pump.push()
    val r2 = pump.push()
    ck(r1 == 1 && r2 == 2, "async: two awaited push() calls increment level 1,2")
    ck(pump.peek() == 2, "async: SYNC op peek() bypasses async gate, reads level=2")
    val r3 = pump.drain()
    ck(r3 == 0 && pump.peek() == 0, "async: awaited drain() resets level to 0")

    // ----- ASYNC gate CYCLES — sequential awaited calls each clear the gate -----
    val g = @@Pump()
    g.init()
    var cycled = true
    for (k in 0 until 5) {
        val rk = g.push()                            // would throw E703 if the gate stuck
        if (rk != k + 1) cycled = false
    }
    ck(cycled && g.peek() == 5, "async: gate CYCLES across 5 sequential awaited push() calls (no stuck E703)")

    // ----- ASYNC CONCURRENT E703 trip — Kotlin's Mutex gate is real -----
    // slow() holds the gate across delay(50); a second driver entering before it
    // settles throws IllegalStateException("E703: system busy: ...").
    val gx = @@Pump()
    gx.init()
    val d1 = async { runCatching { gx.slow() } }
    delay(5)                                         // let d1 acquire the gate
    val d2 = async { runCatching { gx.push() } }
    val rr1 = d1.await()
    val rr2 = d2.await()
    val ex = rr2.exceptionOrNull()
    ck(rr1.isSuccess && rr1.getOrNull() == 1,
        "async: slow() wins the gate and completes (level=1)")
    ck(ex is IllegalStateException && (ex.message ?: "").startsWith("E703: system busy:"),
        "async: CONCURRENT entry trips the E703 busy-gate (Kotlin Mutex)")
    // gate must clear after the in-flight call settles — next call succeeds
    val after = gx.push()
    ck(after == 2, "async: gate cleared after slow() settled (next push() succeeds, no stuck E703)")

    // ----- async persist round-trip -----
    val ap1 = @@Pump()
    ap1.init()
    ap1.push()
    ap1.push()                                       // level -> 2
    val asnap = ap1.save_state()
    val ap2 = @@Pump()
    ap2.restore_state(asnap)
    ck(ap2.peek() == 2, "async persist: restored Pump retains level=2 (sync op peek())")

    println("1.." + _n)
}
