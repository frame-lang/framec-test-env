@@[target("ruby")]

# ============================================================================
# MAXIMAL FRAME COVERAGE FIXTURE — ruby
# CONTRACT: governed by tests/common/positive/max_coverage/README.md
# (brought to contract 2026-07-03: Part-3 cross-product block Kid/Solo/Orch).
# One runnable, self-asserting file exercising every Frame construct the Ruby
# backend supports. TAP output via ck(). The matrix runner executes this file
# directly with `ruby`.
#
# Ruby idioms: own actions/operations/interface methods use the portable
# `@@:self.name(args)` (-> self.name(args)); child-system calls are native Ruby
# the user authors (`self.sensor.bump()`). Method names are emitted verbatim, so
# they are written snake_case here. Native control flow is Ruby `if/elsif/else/
# end` and `while/end` written directly in handler bodies. Persist serializes
# via JSON, so the driver requires 'json' (native passthrough preserves it).
#
# Ruby is NOT async-layered (no `@@[async]`), so the async/E703 surface is out
# of scope for this fixture — it is covered by the matrix async suite.
# ============================================================================

require 'json'

# ============================================================================
# CORE SYSTEM — HSM, modal stack, all 7 statements, transitions, references,
# const, actions, operations, persist round-trip, typed fields (int/bool/
# double/string), internal operation call.
# ============================================================================
@@[main]
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@[create(make)]
@@system Job {

    # [section: operations]
    operations:
        # [op: typed params + return, native return passthrough + conditional in op body]
        clamp(v: int, hi: int): int {
            if v > hi
                return hi
            end
            return v
        }

    # [section: interface]
    interface:
        start(id: string)
        submit(task: string)
        tick()
        pause()
        resume()
        finish()
        spin(n: int): int
        status(): string
        counter(): int
        depth(): int
        trace_of(): string
        scratch_of(): int
        # [bool/double coverage + const read + internal op call]
        set_verbose(v: bool)
        is_verbose(): bool
        set_ratio(r: double)
        get_ratio(): double
        capacity(): int
        clamp_in(v: int, hi: int)
        get_clamped(): int

    # [section: machine]
    machine:

        # [state: initial]
        $Begin {
            # [handler: enter, no args]
            $>() {
                self.trace = self.trace + "Begin>;"
            }
            start(id: string) {
                self.job_id = id
                @@:self.note("N;")                  # [action invocation via @@:self]
                -> ("seed") $Idle
            }
            status(): string { @@:("begin") }
            trace_of(): string { @@:(self.trace) }
            counter(): int { @@:(self.attempts) }
            # [bool setter/getter — exercised + persist round-tripped]
            set_verbose(v: bool) { self.verbose = v }
            # [bool read in a guard]
            is_verbose(): bool {
                if self.verbose
                    @@:(true)
                else
                    @@:(false)
                end
            }
            set_ratio(r: double) { self.ratio = r }
            get_ratio(): double { @@:(self.ratio) }
            # [const read via interface method]
            capacity(): int { @@:(self.max) }
        }

        # [state: HSM parent]
        $Working {
            status(): string { @@:("working") }
            counter(): int { @@:(self.attempts) }
            depth(): int { @@:(self.stack_depth) }
            trace_of(): string { @@:(self.trace) }
        }

        # [state: HSM child => parent]
        $Idle => $Working {
            # [state var w/ type + init]
            $.i: int = 0

            # [handler: enter w/ param]
            $>(seed: string) {
                self.trace = self.trace + "Idle>(" + seed + ");"
            }
            # [handler: exit]
            <$() {
                self.trace = self.trace + "Idle<;"
            }
            submit(task: string) {
                # [native control: terminal conditional w/ transitions]
                if task == ""
                    -> $Rejected
                else
                    self.attempts = self.attempts + 1
                    -> $Active(task)
                end
            }
            pause() {
                push$
                -> $Paused
            }
            # [transition forwarding via => $^ to HSM parent]
            status(): string { => $^ }
            depth(): int { => $^ }
            spin(n: int): int {
                # [native control: while loop over state var $.i]
                while $.i < n
                    $.i = $.i + 1
                end
                @@:($.i)
            }
        }

        # [state: typed state parameter (receives state args)]
        $Active(task: string) {
            $>() {
                self.trace = self.trace + "Active>(" + task + ");"
            }
            <$(why: string) {
                self.trace = self.trace + "Active<(" + why + ");"
            }
            tick() {
                self.scratch = self.scratch + 1
                # [native control: NON-TERMINAL conditional — mutate, fall through]
                if self.attempts < self.max_attempts
                    self.attempts = self.attempts + 1
                end
                self.trace = self.trace + "tick" + self.attempts.to_s + ";"
            }
            finish() {
                ("done") -> ("finished") $Done       # [exit-args + enter-args transition]
            }
            status(): string { @@:("active") }
            counter(): int { @@:(self.attempts) }
            trace_of(): string { @@:(self.trace) }
            scratch_of(): int { @@:(self.scratch) }
            # [internal operation call: clamp() invoked as @@:self.clamp(...) inside a handler]
            clamp_in(v: int, hi: int) {
                self.clamped = @@:self.clamp(v, hi)
            }
            get_clamped(): int { @@:(self.clamped) }
            # [bool/double getters + const read reachable in $Active for persist-restore reads]
            is_verbose(): bool {
                if self.verbose
                    @@:(true)
                else
                    @@:(false)
                end
            }
            get_ratio(): double { @@:(self.ratio) }
            capacity(): int { @@:(self.max) }
        }

        # [state: modal (pushed)]
        $Paused {
            $>() {
                self.stack_depth = self.stack_depth + 1
            }
            <$() {
                self.stack_depth = self.stack_depth - 1
            }
            pause() {
                push$
                -> $Paused
            }
            resume() {
                -> pop$
            }
            status(): string { @@:("paused") }
            depth(): int { @@:(self.stack_depth) }
        }

        $Rejected {
            status(): string { @@:("rejected") }
            counter(): int { @@:(self.attempts) }
            trace_of(): string { @@:(self.trace) }
        }

        # [state: final]
        $Done {
            $>(why: string) {
                self.trace = self.trace + "Done>(" + why + ");"
            }
            status(): string { @@:("done") }
            counter(): int { @@:(self.attempts) }
            depth(): int { @@:(self.stack_depth) }
            trace_of(): string { @@:(self.trace) }
        }

    # [section: actions]
    actions:
        note(s: string) {
            self.trace = self.trace + s
        }

    # [section: domain]
    domain:
        # [decl: const field — read AND persisted (#139: emitted mutable)]
        const max: int = 99
        # [decl: typed domain vars + init]
        job_id: string = ""
        attempts: int = 0
        max_attempts: int = 3
        stack_depth: int = 0
        trace: string = ""
        # [decl: bool + double domain fields — guards/getters + persist round-trip]
        verbose: bool = false
        ratio: double = 1.5
        clamped: int = 0
        # [attr: @@[no_persist] — excluded from the serialized blob, resets on restore]
        @@[no_persist]
        scratch: int = 0
}

# ============================================================================
# MULTI-SYSTEM COMPOSITION — Controller holds + delegates to Sensor.
# framec lowers the $.sensor reference + @@Sensor() construction; the call
# (self.sensor.bump()) is user-authored native Ruby.
# ============================================================================
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Sensor {
    interface:
        bump()
        read(): int
    machine:
        $S {
            bump() {
                self.val = self.val + 1
            }
            read(): int { @@:(self.val) }
        }
    domain:
        val: int = 0
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Controller {
    interface:
        tick()
        total(): int
        count(): int
    machine:
        $C {
            tick() {
                self.seen = self.seen + 1
                self.sensor.bump()                   # [control: native child call]
            }
            total(): int { @@:(self.sensor.read()) }
            count(): int { @@:(self.seen) }
        }
    domain:
        # [composition: hold a sub-system instance as a typed domain field]
        sensor: Sensor = @@Sensor()
        seen: int = 0
}

# ============================================================================
# CROSS-PRODUCT BLOCK (contract Part 3 — the distilled framec#159 family).
# `tick` on FOUR systems; Ruby is OO passthrough — the indexed splice must
# survive intact (self.kids[i].tick(dt)), incl. the Frame-expression index.
# ============================================================================
@@system Kid {
    interface:
        tick(dt)
        probe(): int
    machine:
        $S {
            tick(dt) {
                self.n = self.n + 1
            }
            probe(): int {
                @@:(self.n)
            }
        }
    domain:
        n: int = 0
}

@@system Solo {
    # [collision: SAME interface method names as Kid — a sibling child type]
    interface:
        tick(dt)
        probe(): int
    machine:
        $S {
            tick(dt) {
                self.p = self.p + 10
            }
            probe(): int {
                @@:(self.p)
            }
        }
    domain:
        p: int = 0
}

@@system Orch {
    interface:
        # [collision: orchestrator declares `tick` itself — caller-collision]
        tick(dt)
        adopt(k)
        kidval(i: int): int
        lastval(): int
        soloval(): int
    machine:
        $S {
            adopt(k) {
                @@:self.kids.push(k)
            }
            tick(dt) {
                @@:self._tickall(dt)
            }
            # [ref: indexed cross-system call, native-param index]
            kidval(i: int): int {
                @@:(@@:self.kids[i].probe())
            }
            # [ref: indexed cross-system call, FRAME-EXPRESSION index]
            lastval(): int {
                @@:(@@:self.kids[@@:self.kids.length - 1].probe())
            }
            # [ref: scalar sibling with the SAME collided method names]
            soloval(): int {
                @@:(@@:self.solo.probe())
            }
        }
    actions:
        _tickall(dt) {
            i = 0
            while i < @@:self.kids.length
                # [ref: indexed × cross-system × caller/sibling-collision]
                @@:self.kids[i].tick(dt)
                i = i + 1
            end
            # [ref: scalar field, collided name]
            @@:self.solo.tick(dt)
        }
    domain:
        # [domain: array-of-systems + scalar sibling of a DIFFERENT type]
        kids = []
        solo = @@Solo()
}

# ============================================================================
# CONSTRUCT PROBE — the remaining reference/transition constructs:
# @@:event, @@:params.x, @@:data.x (set+read, call-scope isolation),
# @@:return(e) short-circuit, @@:system.state.name, labeled transition,
# forward transition (-> => $S), forward WITH state args (#128), reentrant
# @@:self, const read, action invocation, elif ladder + nested conditional.
# ============================================================================
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Probe {

    interface:
        echo(x: string): string
        fire()
        relay()
        ping()
        here(): string
        evt(): string
        cap(): int
        log(): string
        classify(n: int): string
        guard(): int
        outer_data(): string
        inner_data()
        fwd()

    machine:

        $A {
            echo(x: string): string {
                @@:data.tmp = @@:params.x
                @@:("echo:" + @@:data.tmp)
            }
            # [@@:data call-scope isolation across a reentrant @@:self call]
            outer_data(): string {
                @@:data.k = "outer"
                @@:self.inner_data()                 # inner gets its OWN @@:data scope
                @@:(@@:data.k)                        # must still read "outer"
            }
            inner_data() {
                @@:data.k = "inner"
            }
            # [elif ladder + nested conditional — 4 branches]
            classify(n: int): string {
                if n < 0
                    @@:("neg")
                elsif n == 0
                    @@:("zero")
                else
                    if n > 100
                        @@:("big")
                    else
                        @@:("pos")
                    end
                end
            }
            # [@@:return(e) short-circuits trailing code (vs @@:(e))]
            guard(): int {
                @@:return(self.limit)
                @@:self.helper("LEAK;")
            }
            fire() {
                self.last = @@:event
                -> "fired" $B                        # [transition: labeled]
            }
            relay() {
                -> => $B                              # [transition: forward (re-dispatch)]
            }
            fwd() {
                -> => $C("payload")                   # [transition: forward WITH state args (#128)]
            }
            ping() {
                @@:self.helper("ping;")               # [action invocation via @@:self]
                @@:self.fire()                        # [ref: reentrant self-call]
            }
            here(): string { @@:(@@:system.state.name) }
            evt(): string { @@:return(self.last) }
            cap(): int { @@:(self.limit) }            # [decl: const read]
            log(): string { @@:(self.trace) }
        }

        $B {
            relay() {
                self.trace = self.trace + "B.relay;"   # handles re-dispatched event
            }
            here(): string { @@:("B") }
            evt(): string { @@:return(self.last) }
            log(): string { @@:(self.trace) }
        }

        # [state: target of a forward transition carrying a state arg (#128 fixed)]
        $C(tok: string) {
            fwd() {
                self.trace = self.trace + "C.fwd(" + tok + ");"
            }
            here(): string { @@:("C") }
            log(): string { @@:(self.trace) }
        }

    # [section: actions]
    actions:
        helper(s: string) {
            self.trace = self.trace + s
        }

    domain:
        const limit: int = 50
        trace: string = ""
        last: string = ""
}

# ============================================================================
# DRIVER — TAP, fresh machine per scenario, asserts every path.
# ============================================================================
$n = 0
def ck(cond, desc)
  $n += 1
  puts((cond ? "ok " : "not ok ") + $n.to_s + " - " + desc)
end

puts("TAP version 14")

# ----- operations (instance form, factory-renamed make) -----
j0 = Job.make
ck(j0.clamp(150, 99) == 99, "operation clamp(150,99)=99 (conditional in op body)")
ck(j0.clamp(5, 99) == 5, "operation clamp(5,99)=5 (native return passthrough)")

# ----- HSM forward via => $^ + terminal conditional + action -----
a = @@Job()
a.start("J1")
ck(a.status() == "working", "Idle forwards status via => $^ to parent $Working")
a.submit("")
ck(a.status() == "rejected", "submit('') terminal conditional -> $Rejected")
ck(a.trace_of().include?("N;"), "action note() invoked from start() via @@:self")

# ----- state-args + non-terminal conditional + trailing read -----
b = @@Job()
b.start("J2")
b.submit("payload")
ck(b.status() == "active", "submit(task) state-args -> $Active(task)")
b.tick()
b.tick()
b.tick()
b.tick()
ck(b.counter() == 3, "non-terminal conditional clamps attempts at max_attempts=3")
ck(b.trace_of().include?("tick3"), "trailing read of mutated field ran after the if")

# ----- exit-args + enter-args transition -----
b.finish()
ck(b.status() == "done", "finish() exit+enter-args -> $Done")
ck(b.trace_of().include?("Active<(done)"), "exit handler received exit arg 'done'")
ck(b.trace_of().include?("Done>(finished)"), "enter handler received enter arg 'finished'")

# ----- single-level modal: push$ / -> pop$ + second => $^ path -----
c = @@Job()
c.start("J3")
c.pause()
ck(c.status() == "paused" && c.depth() == 1, "push$ -> $Paused; $Paused.$> set depth=1")
c.resume()
ck(c.status() == "working" && c.depth() == 0,
   "-> pop$ ran $Paused.<$ (depth->0) and depth() forwards via => $^ to $Working")

# ----- nested modal stack — two push$, two -> pop$ prove a real stack -----
cn = @@Job()
cn.start("J3b")
cn.pause()
cn.pause()
ck(cn.status() == "paused", "nested push$ twice -> still $Paused")
cn.resume()
cn.resume()
ck(cn.status() == "working", "two -> pop$ restore through the stack to $Idle")

# ----- while loop over a state var -----
d = @@Job()
d.start("J4")
ck(d.spin(5) == 5, "while loop over state var $.i -> 5")

# ----- const read via interface method -----
cap = @@Job()
ck(cap.capacity() == 99, "const max read via capacity() interface method = 99")

# ----- bool read in a guard -----
bv = @@Job()
ck(bv.is_verbose() == false, "bool field default false read in guard")
bv.set_verbose(true)
ck(bv.is_verbose() == true, "bool field set true, read back true in guard")

# ----- double getter -----
fr = @@Job()
ck(fr.get_ratio() == 1.5, "double field default 1.5 via getter")
fr.set_ratio(2.75)
ck(fr.get_ratio() == 2.75, "double field set 2.75, read back")

# ----- internal operation call: clamp() called as @@:self.clamp(...) inside a handler -----
ci = @@Job()
ci.start("CI")
ci.submit("payload")                         # -> $Active
ci.clamp_in(250, 99)
ck(ci.get_clamped() == 99, "operation clamp() called internally (@@:self.clamp) = 99")
ci.clamp_in(7, 99)
ck(ci.get_clamped() == 7, "internal @@:self.clamp(7,99) = 7")

# ----- persist — deep round-trip incl. state-arg survival + const + no_persist -----
e = @@Job()
e.set_verbose(true)                          # set in $Begin (setters live there)
e.set_ratio(3.0625)                          # exact in double; survives JSON
e.start("J5")
e.submit("z")                                # -> $Active(z)
e.tick()                                     # attempts -> 1, scratch -> 1
snap = e.save_state()
ck(e.scratch_of() == 1, "persist: @@[no_persist] scratch holds 1 before save")

e2 = @@Job()
e2.restore_state(snap)
ck(e2.trace_of() == e.trace_of() && e2.trace_of().include?("Active>(z)"),
   "persist restores FULL trace incl. state-arg 'z' (deep equality)")
ck(e2.counter() == e.counter() && e2.status() == "active",
   "persist restores domain + current state ($Active)")
ck(e2.is_verbose() == true && e2.get_ratio() == 3.0625,
   "persist round-trips bool + double fields through JSON")
ck(e2.capacity() == 99,
   "persist: const max survives save/restore (#139: emitted mutable)")
ck(e.scratch_of() == 1 && e2.scratch_of() == 0,
   "@@[no_persist] scratch excluded from blob (restore resets to default 0)")

# ----- multi-system composition + ISOLATION (two independent Controllers) -----
k1 = @@Controller()
k1.tick()
k1.tick()
k2 = @@Controller()
k2.tick()
k2.tick()
k2.tick()
ck(k1.total() == 2 && k2.total() == 3, "multi-system: two Controllers hold INDEPENDENT Sensors")
ck(k1.count() == 2 && k2.count() == 3, "multi-system: each Controller's own domain isolated")

# ----- construct probe -----
pr = @@Probe()
ck(pr.echo("hi") == "echo:hi", "@@:params.x + @@:data set/read")
ck(pr.here() == "A" && pr.cap() == 50, "@@:system.state.name + const read")
ck(pr.classify(-1) == "neg" && pr.classify(0) == "zero" && pr.classify(50) == "pos" && pr.classify(200) == "big",
   "elif ladder + nested conditional (4 branches)")
ck(pr.guard() == 50 && !pr.log().include?("LEAK;"),
   "@@:return(e) short-circuits trailing code (vs @@:(e))")
pr.fire()
ck(pr.here() == "B" && pr.evt() == "fire", "@@:event recorded + labeled transition -> $B")

pr2 = @@Probe()
pr2.relay()
ck(pr2.here() == "B" && pr2.log().include?("B.relay;"), "forward transition -> => $B re-dispatched relay")

pr3 = @@Probe()
pr3.ping()
ck(pr3.log().include?("ping;") && pr3.here() == "B", "action invocation + reentrant @@:self.fire()")

pr4 = @@Probe()
pr4.fwd()
ck(pr4.here() == "C" && pr4.log().include?("C.fwd(payload)"),
   "forward transition WITH state args -> => $C(arg) [#128 fixed]")

pr5 = @@Probe()
ck(pr5.outer_data() == "outer",
   "@@:data call-scope isolated across reentrant @@:self call")

# --- CROSS-PRODUCT BLOCK (contract Part 3 / framec#159 family) ---
o = @@Orch()
ka = @@Kid()
kb = @@Kid()
kc = @@Kid()
o.adopt(ka)
o.adopt(kb)
o.adopt(kc)
o.tick(0.16)
o.tick(0.16)
ck(o.kidval(0) == 2 && o.kidval(1) == 2 && o.kidval(2) == 2,
   "x-product: indexed @@:self.kids[i].tick + 3 kids independent (collided name)")
ck(o.lastval() == 2, "x-product: Frame-expression index kids[len-1].probe()")
ck(o.soloval() == 20, "x-product: scalar sibling with identical method names")
ka.tick(1.0) # [control: native call]
ck(o.kidval(0) == 3 && o.kidval(1) == 2, "x-product: control native call touches only kid 0")

puts("1.." + $n.to_s)
