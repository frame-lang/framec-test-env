@@[target("erlang")]

%% ============================================================================
%% MAXIMAL FRAME COVERAGE FIXTURE — erlang
%% ONE @@system (E406): Erlang is one system per file. Every Frame construct
%% this backend supports is packed here; all probe states are reachable from
%% the initial $Boot via start(tag). Native code is Erlang (++ concat,
%% brace-if -> case-of lowering / RFC-0051, erlang:integer_to_list/1).
%%
%% Excluded BY LANGUAGE: async, native while, multi-system composition.
%%
%% All 7 Erlang backend defects this fixture originally surfaced (#132 A-G) are
%% now FIXED and EXERCISED here (no longer authored-around):
%%   A. reserved-word state name ($End -> quoted 'end' atom).
%%   B. uppercase const name (const LIMIT -> lowercase Erlang record field).
%%   C. $Active(task) state-arg read INSIDE the $> enter handler.
%%   D. brace-if inside an operation body (clamp) lowered to case-of.
%%   E. @@:data.k set + read (call-scoped data) in echo().
%%   F. @@:return(e) short-circuits: trailing self.note("LEAK;") must NOT run.
%%   G. -> pop$ fires the popped state's <$ exit handler ($Paused.<$ -> depth--).
%% ============================================================================

%% [attr: main] [persist(binary)] [save op] [load op] [factory rename]
@@[main]
@@[persist(binary)]
@@[save(save_state)]
@@[load(restore_state)]
@@[create(make)]
@@system MaxErlang {

    %% [section: operations] (typed params + return passthrough)
    operations:
        clamp(v: int, hi: int): int {
            %% [D: brace-if inside an operation body — lowered to case-of]
            if v > hi {
                @@:(hi)
            } else {
                @@:(v)
            }
        }

    %% [section: interface]
    interface:
        start(tag: str)
        submit(task: str)
        tick()
        pause()
        resume()
        finish()
        pump()
        echo(x: str): str
        classify(n: int): str
        guard(): int
        fire()
        relay()
        fwd()
        ping()
        here(): str
        evt(): str
        cap(): int
        status(): str
        counter(): int
        depth(): int
        spin_done(): int
        trace_of(): str
        scratch_of(): int
        last_of(): str

    %% [section: machine]
    machine:

        %% [state: initial — dispatches to a probe subgraph by tag]
        $Boot {
            %% [handler: enter, no args]
            $>() {
                self.trace = self.trace ++ "Boot>;"
            }
            start(tag: str) {
                self.job_id = tag
                @@:self.note("N;")
                %% [native elif ladder — handler brace-if lowers to case-of]
                if tag == "probe" {
                    -> $A
                } else if tag == "spin" {
                    -> $Spinning
                } else {
                    -> ("seed") $Idle
                }
            }
            status(): str {
                @@:("boot")
            }
            trace_of(): str {
                @@:(self.trace)
            }
            counter(): int {
                @@:(self.attempts)
            }
        }

        %% [state: HSM parent]
        $Working {
            status(): str {
                @@:("working")
            }
            counter(): int {
                @@:(self.attempts)
            }
            depth(): int {
                @@:(self.stack_depth)
            }
            spin_done(): int {
                @@:(self.spins)
            }
            trace_of(): str {
                @@:(self.trace)
            }
        }

        %% [state: HSM child => parent]
        $Idle => $Working {
            %% [handler: enter w/ param (enter-arg capitalizes correctly)]
            $>(seed: str) {
                self.trace = self.trace ++ "Idle>(" ++ seed ++ ");"
            }
            %% [handler: exit, no args]
            <$() {
                self.trace = self.trace ++ "Idle<;"
            }
            submit(task: str) {
                if task == "" {
                    -> $Rejected
                } else {
                    self.attempts = self.attempts + 1
                    self.pending = task
                    -> $Active(task)
                }
            }
            pause() {
                push$
                -> $Paused
            }
            %% [transition: forward to parent => $^]
            status(): str {
                => $^
            }
            depth(): int {
                => $^
            }
            spin_done(): int {
                => $^
            }
        }

        %% [state: typed state parameter (receives state args)]
        $Active(task: str) {
            %% [C: state-arg `task` read INSIDE the $> enter handler]
            $>() {
                self.trace = self.trace ++ "Active>(" ++ task ++ ");"
            }
            <$(why: str) {
                self.trace = self.trace ++ "Active<(" ++ why ++ ");"
            }
            %% [native non-terminal mutating conditional — case lowering]
            %% [ref: state-arg `task` read inside a regular handler]
            tick() {
                self.scratch = self.scratch + 1
                if self.attempts < self.max_attempts {
                    self.attempts = self.attempts + 1
                }
                self.trace = self.trace ++ "tick" ++ erlang:integer_to_list(self.attempts) ++ "[" ++ task ++ "];"
            }
            finish() {
                ("done") -> ("finished") $End
            }
            status(): str {
                @@:("active")
            }
            counter(): int {
                @@:(self.attempts)
            }
            trace_of(): str {
                @@:(self.trace)
            }
            scratch_of(): int {
                @@:(self.scratch)
            }
        }

        %% [state: iteration via driver-pumped self-transition (NO native while)]
        $Spinning {
            $>() {
                self.trace = self.trace ++ "Spin>;"
            }
            pump() {
                self.spins = self.spins + 1
                if self.spins < self.spin_target {
                    -> $Spinning
                } else {
                    -> ("seed") $Idle
                }
            }
            status(): str {
                @@:("spinning")
            }
            spin_done(): int {
                @@:(self.spins)
            }
            trace_of(): str {
                @@:(self.trace)
            }
        }

        %% [state: modal (pushed)]
        $Paused {
            $>() {
                self.stack_depth = self.stack_depth + 1
            }
            <$() {
                self.stack_depth = self.stack_depth - 1
            }
            pause() {
                push$
                -> $Paused
            }
            resume() {
                -> pop$
            }
            status(): str {
                @@:("paused")
            }
            depth(): int {
                @@:(self.stack_depth)
            }
        }

        $Rejected {
            status(): str {
                @@:("rejected")
            }
            counter(): int {
                @@:(self.attempts)
            }
            trace_of(): str {
                @@:(self.trace)
            }
        }

        %% [state: final — A: reserved-word state name -> quoted 'end' atom]
        $End {
            $>(why: str) {
                self.trace = self.trace ++ "Done>(" ++ why ++ ");"
            }
            status(): str {
                @@:("done")
            }
            counter(): int {
                @@:(self.attempts)
            }
            depth(): int {
                @@:(self.stack_depth)
            }
            trace_of(): str {
                @@:(self.trace)
            }
        }

        %% ====================================================================
        %% CONSTRUCT PROBE SUBGRAPH ($A/$B/$C) — reached via start("probe").
        %% @@:event, @@:params.x, @@:data set/read, @@:return, elif ladder,
        %% labeled/forward/decorated-forward transitions, reentrant @@:self.m()
        %% ====================================================================
        $A {
            %% [E: @@:data.k set then read (call-scoped); + @@:params.x]
            echo(x: str): str {
                @@:data.k = @@:params.x
                @@:("echo:" ++ @@:data.k)
            }
            %% [native elif ladder + nested conditional]
            classify(n: int): str {
                if n < 0 {
                    @@:("neg")
                } else if n == 0 {
                    @@:("zero")
                } else {
                    if n > 100 {
                        @@:("big")
                    } else {
                        @@:("pos")
                    }
                }
            }
            %% [F: @@:return(e) short-circuits — the trailing note() must NOT run]
            guard(): int {
                @@:return(self.LIMIT)
                @@:self.note("LEAK;")
            }
            fire() {
                self.last = @@:event
                -> "fired" $B               %% [transition: labeled]
            }
            relay() {
                -> => $B                     %% [transition: forward (re-dispatch)]
            }
            fwd() {
                -> => $C("payload")          %% [transition: forward WITH state args #128]
            }
            ping() {
                @@:self.helper("ping;")         %% [action invocation]
                @@:self.fire()               %% [ref: reentrant self-call]
            }
            here(): str {
                @@:(@@:system.state.name)
            }
            evt(): str {
                @@:return(self.last)
            }
            cap(): int {
                @@:(self.LIMIT)             %% [B: uppercase const read]
            }
            trace_of(): str {
                @@:(self.trace)
            }
            last_of(): str {
                @@:(self.last)
            }
        }

        $B {
            relay() {
                self.trace = self.trace ++ "B.relay;"
            }
            here(): str {
                @@:("B")
            }
            evt(): str {
                @@:return(self.last)
            }
            trace_of(): str {
                @@:(self.trace)
            }
            last_of(): str {
                @@:(self.last)
            }
        }

        %% [state: target of a decorated forward transition carrying state arg #128]
        $C(tok: str) {
            fwd() {
                self.trace = self.trace ++ "C.fwd(" ++ tok ++ ");"
            }
            here(): str {
                @@:("C")
            }
            trace_of(): str {
                @@:(self.trace)
            }
        }

    %% [section: actions]
    actions:
        note(s: str) {
            self.trace = self.trace ++ s
        }
        helper(s: str) {
            self.trace = self.trace ++ s
        }

    %% [section: domain]
    domain:
        %% [B: uppercase const name -> lowercase Erlang record field]
        const max_val: int = 99
        const LIMIT: int = 50
        %% [decl: typed domain vars + init]
        job_id: str = ""
        pending: str = ""
        attempts: int = 0
        max_attempts: int = 3
        stack_depth: int = 0
        spins: int = 0
        spin_target: int = 5
        trace: str = ""
        last: str = ""
        %% [attr: @@[no_persist] — field excluded from the serialized blob]
        @@[no_persist]
        scratch: int = 0
}
