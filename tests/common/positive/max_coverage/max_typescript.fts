@@[target("typescript")]

// ============================================================================
// MAXIMAL FRAME COVERAGE FIXTURE — typescript
// CONTRACT: governed by tests/common/positive/max_coverage/README.md
// (brought to contract 2026-07-03: Part-3 cross-product block Kid/Solo/Orch).
// One runnable, self-asserting file exercising every Frame construct this
// backend supports. Construct tags are `//` comment lines above each construct.
// TAP output, driven + type-checked by real `tsc`/`tsx`/`node`.
// TS is typed JS: every interface param/return, domain field, state-arg, and
// the driver carries explicit TS types so the emitted .ts type-checks clean
// (tsc --noEmit, no implicit-any). TS persist = JSON serialized to a string;
// async = Promise-based with the single-driver E703 busy-gate.
// ============================================================================

// [attr: main] [attr: persist] [attr: save op] [attr: load op] [attr: factory rename]
@@[main]
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@[create(make)]
@@system Job {

    // [section: operations]
    operations:
        // [op: typed params + return, native return passthrough, conditional in op body]
        clamp(v: number, hi: number): number {
            if (v > hi) {
                return hi;
            }
            return v;
        }

    // [section: interface]
    interface:
        start(id: string)
        submit(task: string)
        tick()
        pause()
        resume()
        finish()
        spin(n: number): number
        status(): string
        counter(): number
        depth(): number
        trace_of(): string
        scratch_of(): number
        // [typed bool/float coverage + const read + internal op call]
        set_verbose(v: boolean)
        is_verbose(): boolean
        set_ratio(r: number)
        get_ratio(): number
        capacity(): number
        clamp_in(v: number, hi: number)
        get_clamped(): number

    // [section: machine]
    machine:

        // [state: initial]
        $Begin {
            // [handler: enter, no args]
            $>() {
                this.trace = this.trace + "Begin>;";
            }
            start(id: string) {
                this.job_id = id;
                this.note("N;");
                -> ("seed") $Idle
            }
            status(): string {
                @@:("begin")
            }
            trace_of(): string {
                @@:(this.trace)
            }
            counter(): number {
                @@:(this.attempts)
            }
            // [bool setter/getter + bool read in a guard]
            set_verbose(v: boolean) {
                this.verbose = v;
            }
            is_verbose(): boolean {
                if (this.verbose) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }
            // [float setter/getter]
            set_ratio(r: number) {
                this.ratio = r;
            }
            get_ratio(): number {
                @@:(this.ratio)
            }
            // [const read via interface method]
            capacity(): number {
                @@:(this.MAX)
            }
        }

        // [state: HSM parent]
        $Working {
            status(): string {
                @@:("working")
            }
            counter(): number {
                @@:(this.attempts)
            }
            depth(): number {
                @@:(this.stack_depth)
            }
            trace_of(): string {
                @@:(this.trace)
            }
        }

        // [state: HSM child => parent]
        $Idle => $Working {
            // [handler: enter w/ param]
            $>(seed: string) {
                this.trace = this.trace + "Idle>(" + seed + ");";
            }
            // [handler: exit]
            <$() {
                this.trace = this.trace + "Idle<;";
            }
            submit(task: string) {
                if (task === "") {
                    -> $Rejected
                } else {
                    this.attempts = this.attempts + 1;
                    -> $Active(task)
                }
            }
            pause() {
                push$
                -> $Paused
            }
            status(): string {
                => $^
            }
            depth(): number {
                => $^
            }
            spin(n: number): number {
                $.i = 0;
                while ($.i < n) {
                    $.i = $.i + 1;
                }
                @@:($.i)
            }
        }

        // [state: typed state parameter (receives state args)]
        $Active(task: string) {
            $>() {
                this.trace = this.trace + "Active>(" + task + ");";
            }
            <$(why: string) {
                this.trace = this.trace + "Active<(" + why + ");";
            }
            tick() {
                this.scratch = this.scratch + 1;
                if (this.attempts < this.max_attempts) {
                    this.attempts = this.attempts + 1;
                }
                this.trace = this.trace + "tick" + this.attempts + ";";
            }
            finish() {
                ("done") -> ("finished") $Done
            }
            status(): string {
                @@:("active")
            }
            counter(): number {
                @@:(this.attempts)
            }
            trace_of(): string {
                @@:(this.trace)
            }
            scratch_of(): number {
                @@:(this.scratch)
            }
            // [internal operation call: this.clamp(...) invoked inside a handler]
            clamp_in(v: number, hi: number) {
                this.clamped = this.clamp(v, hi);
            }
            get_clamped(): number {
                @@:(this.clamped)
            }
            // [bool/float getters reachable post-restore in $Active]
            is_verbose(): boolean {
                if (this.verbose) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }
            get_ratio(): number {
                @@:(this.ratio)
            }
        }

        // [state: modal (pushed)]
        $Paused {
            $>() {
                this.stack_depth = this.stack_depth + 1;
            }
            <$() {
                this.stack_depth = this.stack_depth - 1;
            }
            pause() {
                push$
                -> $Paused
            }
            resume() {
                -> pop$
            }
            status(): string {
                @@:("paused")
            }
            depth(): number {
                @@:(this.stack_depth)
            }
        }

        $Rejected {
            status(): string {
                @@:("rejected")
            }
            counter(): number {
                @@:(this.attempts)
            }
            trace_of(): string {
                @@:(this.trace)
            }
        }

        // [state: final]
        $Done {
            $>(why: string) {
                this.trace = this.trace + "Done>(" + why + ");";
            }
            status(): string {
                @@:("done")
            }
            counter(): number {
                @@:(this.attempts)
            }
            depth(): number {
                @@:(this.stack_depth)
            }
            trace_of(): string {
                @@:(this.trace)
            }
        }

    // [section: actions]
    actions:
        note(s: string) {
            this.trace = this.trace + s;
        }

    // [section: domain]
    domain:
        // [decl: const field]
        const MAX: number = 99
        // [decl: typed domain vars + init]
        job_id: string = ""
        attempts: number = 0
        max_attempts: number = 3
        stack_depth: number = 0
        trace: string = ""
        // [decl: bool + float domain fields — guards/getters + persist round-trip]
        verbose: boolean = false
        ratio: number = 1.5
        clamped: number = 0
        // [attr: @@[no_persist] — field excluded from the serialized blob]
        @@[no_persist]
        scratch: number = 0
}

// ============================================================================
// ASYNC SYSTEM — [attr: @@[async]] async interface + await + sync-op bypass
// + the single-driver E703 busy-gate (TS is an async-layered backend).
// ============================================================================
@@[async]
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Pump {

    // [op: SYNC operation — bypasses the async gate even in an async system]
    operations:
        level(): number {
            @@:(this.ticks)
        }

    interface:
        async fill()                    // [async interface method]
        async drain()

    machine:

        $Empty {
            fill() {
                await delay()           // [native await inside handler]
                this.ticks = this.ticks + 1;
                -> $Full
            }
        }

        $Full {
            drain() {
                await delay()
                -> $Empty
            }
        }

    domain:
        ticks: number = 0
}

// ============================================================================
// MULTI-SYSTEM COMPOSITION — Controller holds + delegates to Sensor
// ============================================================================
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Sensor {
    interface:
        bump()
        read(): number
    machine:
        $S {
            bump() {
                this.val = this.val + 1;
            }
            read(): number {
                @@:(this.val)
            }
        }
    domain:
        val: number = 0
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Controller {
    interface:
        tick()
        total(): number
        count(): number
    machine:
        $C {
            // [composition: hold a sub-system instance in a state var]
            $.sensor: Sensor = null;
            $>() {
                $.sensor = @@Sensor();
            }
            tick() {
                this.seen = this.seen + 1;
                $.sensor.bump();
            }
            total(): number {
                @@:($.sensor.read())
            }
            count(): number {
                @@:(this.seen)
            }
        }
    domain:
        seen: number = 0
}

// ============================================================================
// CROSS-PRODUCT BLOCK (contract Part 3 — the distilled framec#159 family).
// `tick` is deliberately on FOUR systems (Controller/Orch/Kid/Solo). TypeScript is
// an OO passthrough target: the indexed splice must survive intact —
// this.kids[i].tick(dt) — including the Frame-expression index.
// ============================================================================
@@system Kid {
    interface:
        tick(dt: number)
        probe(): number
    machine:
        $S {
            tick(dt: number) {
                this.n = this.n + 1;
            }
            probe(): number {
                @@:(this.n)
            }
        }
    domain:
        n: number = 0
}

@@system Solo {
    // [collision: SAME interface method names as Kid — a sibling child type]
    interface:
        tick(dt: number)
        probe(): number
    machine:
        $S {
            tick(dt: number) {
                this.p = this.p + 10;
            }
            probe(): number {
                @@:(this.p)
            }
        }
    domain:
        p: number = 0
}

@@system Orch {
    interface:
        // [collision: orchestrator declares `tick` itself — caller-collision]
        tick(dt: number)
        adopt(k)
        kidval(i: number): number
        lastval(): number
        soloval(): number
    machine:
        $S {
            adopt(k) {
                @@:self.kids.push(k);
            }
            tick(dt: number) {
                @@:self._tickall(dt);
            }
            // [ref: indexed cross-system call, native-param index]
            kidval(i: number): number {
                @@:(@@:self.kids[i].probe())
            }
            // [ref: indexed cross-system call, FRAME-EXPRESSION index]
            lastval(): number {
                @@:(@@:self.kids[@@:self.kids.length - 1].probe())
            }
            // [ref: scalar sibling with the SAME collided method names]
            soloval(): number {
                @@:(@@:self.solo.probe())
            }
        }
    actions:
        _tickall(dt: number) {
            for (let i = 0; i < @@:self.kids.length; i++) {
                // [ref: indexed × cross-system × caller/sibling-collision]
                @@:self.kids[i].tick(dt);
            }
            // [ref: scalar field, collided name]
            @@:self.solo.tick(dt);
        }
    domain:
        // [domain: array-of-systems + scalar sibling of a DIFFERENT type —
        //  TS is static (E605): annotate; Kid[] keeps the element visible]
        kids: Kid[] = []
        solo: Solo = @@Solo()
}

// ============================================================================
// CONSTRUCT PROBE — the remaining reference/transition constructs:
// @@:event, @@:params.x, @@:data.x (set+read), @@:return(e), @@:system.state.name,
// labeled transition, forward transition (-> => $S), reentrant @@:self.m(),
// const read, action invocation, elif ladder + nested conditional.
// ============================================================================
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Probe {

    interface:
        echo(x: string): string
        fire()
        relay()
        ping()
        here(): string
        evt(): string
        cap(): number
        log(): string
        classify(n: number): string
        guard(): number
        outer_data(): string
        inner_data()
        fwd()

    machine:

        $A {
            echo(x: string): string {
                @@:data.tmp = @@:params.x
                @@:("echo:" + @@:data.tmp)
            }
            outer_data(): string {
                @@:data.k = "outer"
                @@:self.inner_data()              // reentrant: inner gets its OWN @@:data scope
                @@:(@@:data.k)                    // must still read "outer" (call-scope isolation)
            }
            inner_data() {
                @@:data.k = "inner"
            }
            classify(n: number): string {
                if (n < 0) {
                    @@:("neg")
                } else if (n === 0) {
                    @@:("zero")
                } else {
                    if (n > 100) {
                        @@:("big")
                    } else {
                        @@:("pos")
                    }
                }
            }
            guard(): number {
                @@:return(this.LIMIT)
                this.helper("LEAK;");
            }
            fire() {
                this.last = @@:event
                -> "fired" $B                     // [transition: labeled]
            }
            relay() {
                -> => $B                          // [transition: forward (re-dispatch event)]
            }
            fwd() {
                -> => $C("payload")               // [transition: forward WITH state args (#128)]
            }
            ping() {
                this.helper("ping;");             // [action invocation: this.<action>()]
                @@:self.fire()                    // [ref: reentrant self-call]
            }
            here(): string {
                @@:(@@:system.state.name)
            }
            evt(): string {
                @@:return(this.last)
            }
            cap(): number {
                @@:(this.LIMIT)                   // [decl: const read]
            }
            log(): string {
                @@:(this.trace)
            }
        }

        $B {
            relay() {
                this.trace = this.trace + "B.relay;";  // handles the re-dispatched event
            }
            here(): string {
                @@:("B")
            }
            evt(): string {
                @@:return(this.last)
            }
            log(): string {
                @@:(this.trace)
            }
        }

        // [state: target of a forward transition carrying a state arg (#128 fixed)]
        $C(tok: string) {
            fwd() {
                this.trace = this.trace + "C.fwd(" + tok + ");";
            }
            here(): string {
                @@:("C")
            }
            log(): string {
                @@:(this.trace)
            }
        }

    // [section: actions]
    actions:
        helper(s: string) {
            this.trace = this.trace + s;
        }

    domain:
        // [decl: const field, read via this.LIMIT]
        const LIMIT: number = 50
        trace: string = ""
        last: string = ""
}

// ============================================================================
// DRIVER — TAP, fresh machine per scenario, asserts every path.
// Auto-runs on import() (TestRunner.ts dynamically imports the module).
// ============================================================================
function delay(): Promise<void> { return Promise.resolve(); }

let _n: number = 0;
const _ck = (cond: boolean, desc: string): void => {
    _n++;
    console.log((cond ? "ok " : "not ok ") + _n + " - " + desc);
};

async function _async_tests(): Promise<void> {
    const p = @@Pump();
    await p.init();
    await p.fill();
    _ck(p.level() === 1, "async fill(): awaited + mutated + transitioned to $Full");
    await p.drain();
    await p.fill();
    _ck(p.level() === 2, "async drain() really transitioned $Full->$Empty (fill accepted again -> 2)");

    // E703 single-driver busy-gate: a SECOND concurrent driver is rejected.
    const q = @@Pump();
    await q.init();
    const results = await Promise.allSettled([q.fill(), q.fill()]);
    const tripped = results.some(
        (r) => r.status === "rejected" && String((r as PromiseRejectedResult).reason).includes("E703"),
    );
    _ck(tripped, "concurrent fill() trips the async busy-gate (E703)");

    // async persist round-trip: drive to level 2, save, restore into fresh Pump.
    const ap1 = @@Pump();
    await ap1.init();
    await ap1.fill();           // -> $Full, ticks=1
    await ap1.drain();          // -> $Empty
    await ap1.fill();           // -> $Full, ticks=2
    const asnap: string = ap1.save_state();
    const ap2 = @@Pump();
    ap2.restore_state(asnap);
    _ck(ap2.level() === 2, "async persist: restored Pump retains ticks=2 (sync op level())");
}

async function main(): Promise<void> {
    console.log("TAP version 14");

    // operations (instance form via renamed factory)
    const j0 = Job.make();
    _ck(j0.clamp(150, 99) === 99, "operation clamp(150,99)=99 (conditional in op body)");
    _ck(j0.clamp(5, 99) === 5, "operation clamp(5,99)=5");

    const a = @@Job();
    a.start("J1");
    _ck(a.status() === "working", "Idle forwards status via => $^ to parent");
    a.submit("");
    _ck(a.status() === "rejected", "submit('') terminal conditional -> $Rejected");
    _ck(a.trace_of().includes("N;"), "action note() invoked from start()");

    const b = @@Job();
    b.start("J2");
    b.submit("payload");
    _ck(b.status() === "active", "submit(task) state-args -> $Active(task)");
    b.tick();
    b.tick();
    b.tick();
    b.tick();
    _ck(b.counter() === 3, "non-terminal conditional clamps attempts at max_attempts=3");
    _ck(b.trace_of().includes("tick3"), "trailing read of mutated field ran after the if");

    b.finish();
    _ck(b.status() === "done", "finish() exit-args -> $Done");
    _ck(b.trace_of().includes("Active<(done)"), "exit handler received exit arg 'done'");
    _ck(b.trace_of().includes("Done>(finished)"), "enter handler received enter arg (exit+enter form)");

    // operation called internally as this.clamp(...) inside a handler
    const ci = @@Job();
    ci.start("CI");
    ci.submit("payload");                 // -> $Active
    ci.clamp_in(250, 99);
    _ck(ci.get_clamped() === 99, "operation clamp() called internally (this.clamp) inside handler = 99");
    ci.clamp_in(7, 99);
    _ck(ci.get_clamped() === 7, "internal this.clamp(7,99) = 7");

    // single-level modal: push$/pop$ with depth() asserted — exercises $Paused.$>
    // (+1), $Paused.<$ (-1), and the SECOND => $^ path ($Idle.depth() -> $Working)
    const c = @@Job();
    c.start("J3");
    c.pause();
    _ck(c.status() === "paused" && c.depth() === 1, "push$ -> $Paused; $Paused.$> set depth=1");
    c.resume();
    _ck(c.status() === "working" && c.depth() === 0,
        "-> pop$ ran $Paused.<$ (depth->0) and depth() forwards via => $^ to $Working");

    // nested modal stack — two push$, two -> pop$ prove a real stack (not a slot)
    const cn = @@Job();
    cn.start("J3b");
    cn.pause();
    cn.pause();
    _ck(cn.status() === "paused", "nested push$ twice -> still $Paused");
    cn.resume();
    cn.resume();
    _ck(cn.status() === "working", "two -> pop$ restore through the stack to $Idle");

    const d = @@Job();
    d.start("J4");
    _ck(d.spin(5) === 5, "while loop over state var $.i -> 5");

    // const read + bool guard + float getter via interface methods
    const cap = @@Job();
    _ck(cap.capacity() === 99, "const MAX read via capacity() interface method = 99");
    const bv = @@Job();
    _ck(bv.is_verbose() === false, "bool field default false read in guard");
    bv.set_verbose(true);
    _ck(bv.is_verbose() === true, "bool field set true, read back true in guard");
    const fr = @@Job();
    _ck(fr.get_ratio() === 1.5, "float field default 1.5 via getter");
    fr.set_ratio(2.75);
    _ck(fr.get_ratio() === 2.75, "float field set 2.75, read back");

    // persist — FULL deep equality incl. state-arg survival across restore
    const e = @@Job();
    e.start("J5");
    e.submit("z");
    e.tick();
    const snap: string = e.save_state();
    const e2 = @@Job();
    e2.restore_state(snap);
    _ck(e2.trace_of() === e.trace_of() && e2.trace_of().includes("Active>(z)"),
        "persist restores FULL trace incl. state-arg 'z' (deep equality)");
    _ck(e2.counter() === e.counter() && e2.status() === "active",
        "persist restores domain + current state");
    _ck(e.scratch_of() === 1 && e2.scratch_of() === 0,
        "@@[no_persist] field excluded from blob (restore resets it to default 0)");

    // bool + float persist round-trip (JSON path)
    const fp1 = @@Job();
    fp1.set_verbose(true);
    fp1.set_ratio(3.0625);                // exact in f64; survives JSON
    fp1.start("FP");
    fp1.submit("payload");                // -> $Active (where getters are reachable)
    const fsnap: string = fp1.save_state();
    const fp2 = @@Job();
    fp2.restore_state(fsnap);
    _ck(fp2.status() === "active", "bool/float persist: restored machine back in $Active");
    _ck(fp2.is_verbose() === true, "bool/float persist: bool field survived save/restore");
    _ck(fp2.get_ratio() === 3.0625, "bool/float persist: float field survived JSON round-trip");

    // async (incl. E703 gate + async persist)
    await _async_tests();

    // multi-system composition + ISOLATION (two independent Controllers)
    const c1 = @@Controller();
    c1.tick();
    c1.tick();
    const c2 = @@Controller();
    c2.tick();
    c2.tick();
    c2.tick();
    _ck(c1.total() === 2 && c2.total() === 3, "multi-system: two Controllers hold INDEPENDENT Sensors");
    _ck(c1.count() === 2 && c2.count() === 3, "multi-system: each Controller's own domain isolated");

    // construct probe
    const pr = @@Probe();
    _ck(pr.echo("hi") === "echo:hi", "@@:params.x + @@:data set/read");
    _ck(pr.here() === "A" && pr.cap() === 50, "@@:system.state.name + const read");
    _ck(pr.classify(-1) === "neg" && pr.classify(0) === "zero" && pr.classify(50) === "pos" && pr.classify(200) === "big",
        "elif ladder + nested conditional (4 branches)");
    _ck(pr.guard() === 50 && !pr.log().includes("LEAK;"),
        "@@:return(e) short-circuits trailing code (vs @@:(e))");
    pr.fire();
    _ck(pr.here() === "B" && pr.evt() === "fire", "@@:event recorded + labeled transition -> $B");

    const pr2 = @@Probe();
    pr2.relay();
    _ck(pr2.here() === "B" && pr2.log().includes("B.relay;"), "forward transition -> => $B re-dispatched relay");

    const pr3 = @@Probe();
    pr3.ping();
    _ck(pr3.log().includes("ping;") && pr3.here() === "B", "action invocation + reentrant @@:self.fire()");

    const pr4 = @@Probe();
    pr4.fwd();
    _ck(pr4.here() === "C" && pr4.log().includes("C.fwd(payload)"),
        "forward transition WITH state args -> => $C(arg) [#128 fixed]");

    const pr5 = @@Probe();
    _ck(pr5.outer_data() === "outer",
        "@@:data call-scope isolated across reentrant @@:self call");

    // --- CROSS-PRODUCT BLOCK (contract Part 3 / framec#159 family) ---
    const o = @@Orch();
    const ka = @@Kid();
    const kb = @@Kid();
    const kc = @@Kid();
    o.adopt(ka);
    o.adopt(kb);
    o.adopt(kc);
    o.tick(0.16);
    o.tick(0.16);
    _ck(o.kidval(0) === 2 && o.kidval(1) === 2 && o.kidval(2) === 2,
        "x-product: indexed @@:self.kids[i].tick + 3 kids independent (collided name)");
    _ck(o.lastval() === 2, "x-product: Frame-expression index kids[len-1].probe()");
    _ck(o.soloval() === 20, "x-product: scalar sibling with identical method names");
    ka.tick(1.0); // [control: native call]
    _ck(o.kidval(0) === 3 && o.kidval(1) === 2, "x-product: control native call touches only kid 0");

    console.log("1.." + _n);
}

main();
