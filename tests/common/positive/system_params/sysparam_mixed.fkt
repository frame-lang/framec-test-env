@@[target("kotlin")]

@@system Robot($(x: Int), name: String) {
    interface:
        describe(): String
    machine:
        $Start(x: Int) {
            describe(): String {
                @@:(this.name + "@" + x)
            return;
            }
        }
    domain:
        name: String = name
}

fun main() {
    val r = @@Robot($(7), "R2D2")
    val v = r.describe()
    if (v != "R2D2@7") {
        println("FAIL got $v")
        kotlin.system.exitProcess(1)
    }
    println("ok 1 - sysparam_mixed")
}
