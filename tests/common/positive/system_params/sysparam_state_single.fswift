@@[target("swift")]

@@system Robot($(x: Int)) {
    interface:
        get_x(): Int

    machine:
        $Start(x: Int) {
            get_x(): Int { @@:(x)
            return; }
        }
}

let r = @@Robot($(42))
let v = r.get_x()
if v != 42 { fatalError("FAIL got \(v)") }
print("ok 1 - sysparam_state_single")
