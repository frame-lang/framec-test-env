@@[target("gdscript")]
extends SceneTree

@@system Greeter(name: String) {
    interface:
        greet(): String

    machine:
        $Idle {
            greet(): String {
                @@:("hello, " + self.name)
                return
            }
        }

    domain:
        name = name
}

func main():
    var g = @@Greeter("world")
    var s = g.greet()
    if s != "hello, world":
        print("FAIL got " + s)
        return
    print("ok 1 - sysparam_domain_str")

func _init():
    main()
    quit()
