@@[target("kotlin")]

@@system Greeter(name: String) {
    interface:
        greet(): String
    machine:
        $Idle {
            greet(): String {
                @@:("hello, " + this.name)
            return;
            }
        }
    domain:
        name: String = name
}

fun main() {
    val g = @@Greeter("world")
    val v = g.greet()
    if (v != "hello, world") {
        println("FAIL got $v")
        kotlin.system.exitProcess(1)
    }
    println("ok 1 - sysparam_domain_str")
}
