@@[target("gdscript")]

# Filesystem Freeze — VFS fs/super.c semantics. 3-level HSM:
#   $Active => $Readable => $Mounted
#   $Frozen => $Readable => $Mounted
# $Mounted provides read/sync/unmount for all mounted sub-states.
# $Active adds write/freeze. $Frozen overrides write to block and adds thaw.
# $Freezing is transient, bypasses $Readable (state in flux during flush).

extends SceneTree

@@system Filesystem {
    interface:
        mount(device: String): String
        unmount(): String
        freeze(): String
        thaw(): String
        write(data: String): String
        read(): String
        sync(): String
        status(): String
        read_count(): int
        write_count(): int

    machine:
        $Unmounted {
            mount(device: String): String {
                self.device = device
                @@:("mounted")
                -> $Active
            }
            status(): String { @@:("unmounted") }
            read_count(): int { @@:(self.reads) }
            write_count(): int { @@:(self.writes) }
        }

        $Active => $Readable {
            write(data: String): String {
                self.writes = self.writes + 1
                @@:("wrote")
            }
            freeze(): String {
                @@:("freezing")
                -> $Freezing
            }
            status(): String { @@:("active") }
            => $^
        }

        $Freezing => $Mounted {
            $>() {
                self.flush_pending_writes()
                -> $Frozen
            }
            status(): String { @@:("freezing") }
            => $^
        }

        $Frozen => $Readable {
            write(data: String): String {
                @@:("BLOCKED")
            }
            thaw(): String {
                @@:("thawed")
                -> $Active
            }
            status(): String { @@:("frozen") }
            => $^
        }

        $Readable => $Mounted {
            => $^
        }

        $Mounted {
            read(): String {
                self.reads = self.reads + 1
                @@:("read")
            }
            sync(): String {
                @@:("synced")
            }
            unmount(): String {
                @@:("unmounting")
                -> $Unmounting
            }
            read_count(): int { @@:(self.reads) }
            write_count(): int { @@:(self.writes) }
        }

        $Unmounting {
            $>() {
                self.flush_pending_writes()
                self.release_resources()
                -> $Unmounted
            }
        }

    actions:
        flush_pending_writes() {}
        release_resources() {}

    domain:
        device: String = ""
        writes: int = 0
        reads: int = 0
}


func check_str(label, actual, expected):
    if actual != expected:
        print("FAIL: " + label + " — expected '" + str(expected) + "', got '" + str(actual) + "'")
        quit(1)

func check_int(label, actual, expected):
    if actual != expected:
        print("FAIL: " + label + " — expected " + str(expected) + ", got " + str(actual))
        quit(1)

func test_mount_write_read():
    var fs = @@Filesystem()
    check_str("initial unmounted", fs.status(), "unmounted")
    check_str("mount", fs.mount("/dev/sda1"), "mounted")
    check_str("active state", fs.status(), "active")
    check_str("write 1", fs.write("hello"), "wrote")
    check_str("read 1", fs.read(), "read")
    check_str("sync via HSM", fs.sync(), "synced")
    check_int("read count incremented", fs.read_count(), 1)
    check_int("write count incremented", fs.write_count(), 1)
    print("PASS: mount + write + read + sync")

func test_freeze_blocks_writes_allows_reads():
    var fs = @@Filesystem()
    fs.mount("/dev/sda1")
    fs.write("before freeze")
    fs.freeze()
    check_str("in frozen state", fs.status(), "frozen")
    check_str("write blocked", fs.write("nope"), "BLOCKED")
    check_str("read still works", fs.read(), "read")
    check_int("read count 1", fs.read_count(), 1)
    check_int("write count unchanged", fs.write_count(), 1)
    print("PASS: freeze blocks writes, allows reads (3-level HSM)")

func test_thaw_restores_write():
    var fs = @@Filesystem()
    fs.mount("/dev/sda1")
    fs.freeze()
    check_str("thaw", fs.thaw(), "thawed")
    check_str("back to active", fs.status(), "active")
    check_str("write works again", fs.write("post-thaw"), "wrote")
    print("PASS: thaw restores write capability")

func test_unmount_forwards_via_hsm():
    var fs = @@Filesystem()
    fs.mount("/dev/sda1")
    check_str("unmount from Active", fs.unmount(), "unmounting")
    check_str("eventually unmounted", fs.status(), "unmounted")
    print("PASS: unmount forwards from Active via $Readable to $Mounted")

func test_freeze_impossible_when_unmounted():
    var fs = @@Filesystem()
    # GDScript returns null when no handler exists.
    var ret = fs.freeze()
    if ret != null:
        print("FAIL: freeze unmounted expected null, got non-null")
        quit(1)
    check_str("still unmounted", fs.status(), "unmounted")
    print("PASS: freeze on unmounted fs is no-op")

func test_read_count_accumulates_across_states():
    var fs = @@Filesystem()
    fs.mount("/dev/sda1")
    fs.read()
    fs.read()
    fs.freeze()
    fs.read()
    fs.thaw()
    fs.read()
    check_int("reads across Active/Frozen/Active", fs.read_count(), 4)
    print("PASS: read count spans states (domain var)")

func _init():
    test_mount_write_read()
    test_freeze_blocks_writes_allows_reads()
    test_thaw_restores_write()
    test_unmount_forwards_via_hsm()
    test_freeze_impossible_when_unmounted()
    test_read_count_accumulates_across_states()
    print("PASS: all filesystem freeze tests passed")
    quit()
