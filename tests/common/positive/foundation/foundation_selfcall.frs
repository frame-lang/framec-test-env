// M1 Foundation — selfcall: reentrant `@@:self.g()` in expr position + the return slot,
// with the reentrancy guard the kernel model requires.
@@system SelfCall {
    interface:
        f(): i32
        g(): i32

    machine:
        $A {
            f(): i32 {
                let x = @@:self.g();
                @@:(x)
            }
            g(): i32 {
                @@:(7)
            }
        }
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut m = @@SelfCall();
    let v = m.f();
    if v == 7 {
        println!("ok 1 - foundation_selfcall reentrant dispatch");
    } else {
        println!("not ok 1 - foundation_selfcall reentrant dispatch # v={}", v);
    }
}
