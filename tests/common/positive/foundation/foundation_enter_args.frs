// M1 Foundation — enter_args: `-> (99) $B` delivers an enter arg to `$>(a: i32)`.
@@system EnterArgs {
    interface:
        go()

    machine:
        $A {
            go() {
                -> (99) $B
            }
        }
        $B {
            $>(a: i32) {
                @@:self.got = a
            }
        }

    domain:
        got: i32 = 0
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut m = @@EnterArgs();
    m.go();
    if m.got == 99 {
        println!("ok 1 - foundation_enter_args enter-arg delivery");
    } else {
        println!("not ok 1 - foundation_enter_args enter-arg delivery # got={}", m.got);
    }
}
