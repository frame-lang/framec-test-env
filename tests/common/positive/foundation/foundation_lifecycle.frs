// M1 Foundation — lifecycle: `$>()` enter handlers fired by the kernel drain.
@@system Lifecycle {
    interface:
        go()

    machine:
        $A {
            $>() {
                @@:self.entered = 1
            }
            go() {
                -> $B
            }
        }
        $B {
            $>() {
                @@:self.entered = 2
            }
        }

    domain:
        entered: i32 = 0
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut m = @@Lifecycle();
    // __create ran $A's $> (entered=1); go() transitions to $B, whose $> runs on drain (entered=2).
    m.go();
    if m.entered == 2 {
        println!("ok 1 - foundation_lifecycle enter drain");
    } else {
        println!("not ok 1 - foundation_lifecycle enter drain # entered={}", m.entered);
    }
}
