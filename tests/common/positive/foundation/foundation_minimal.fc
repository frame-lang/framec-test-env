// M1 Foundation — minimal: 1 state, 1 interface method, `@@:self.x = 1`, one domain field.
// C-native types (Frame is type-ignorant; the type text is the user's, verbatim).
@@system Minimal {
    interface:
        go()

    machine:
        $A {
            go() {
                @@:self.x = 1
            }
        }

    domain:
        x: int = 0
}

int main(void) {
    printf("TAP version 14\n");
    printf("1..1\n");
    Minimal* m = @@Minimal();
    Minimal_go(m);
    if (m->x == 1) {
        printf("ok 1 - foundation_minimal domain assign\n");
    } else {
        printf("not ok 1 - foundation_minimal domain assign # x=%d\n", m->x);
    }
    return 0;
}
