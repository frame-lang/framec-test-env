// M1 Foundation — minimal: 1 state, 1 interface method, `@@:self.x = 1`, one domain field.
// Java-native types (Frame is type-ignorant; the type text is the user's, verbatim).
@@system Minimal {
    interface:
        go()

    machine:
        $A {
            go() {
                @@:self.x = 1
            }
        }

    domain:
        x: int = 0
}

class Main {
    public static void main(String[] args) {
        Minimal m = @@Minimal();
        m.go();
        if (m.x == 1) {
            System.out.println("ok 1 - foundation_minimal domain assign");
        } else {
            System.out.println("not ok 1 - foundation_minimal domain assign # x=" + m.x);
        }
    }
}
