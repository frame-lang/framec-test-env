// M1 Foundation — transition: 2 states, a flat `-> $B` transition + kernel drain.
@@system Transition {
    interface:
        go()

    machine:
        $A {
            go() {
                -> $B
            }
        }
        $B {
        }
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut m = @@Transition();
    m.go();
    // The transition + drain must complete without panicking.
    println!("ok 1 - foundation_transition drain");
}
