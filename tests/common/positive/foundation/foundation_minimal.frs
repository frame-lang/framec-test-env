// M1 Foundation — minimal: 1 state, 1 interface method, `@@:self.x = 1`, one domain field.
// Rust-native types (Frame is type-ignorant; legacy passes `int` through as invalid Rust).
@@system Minimal {
    interface:
        go()

    machine:
        $A {
            go() {
                @@:self.x = 1
            }
        }

    domain:
        x: i32 = 0
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut m = @@Minimal();
    m.go();
    if m.x == 1 {
        println!("ok 1 - foundation_minimal domain assign");
    } else {
        println!("not ok 1 - foundation_minimal domain assign # x={}", m.x);
    }
}
