// M1 Foundation — value_return: `f(): i32 { @@:(5) }` exercises the return slot.
@@system ValueReturn {
    interface:
        f(): i32

    machine:
        $A {
            f(): i32 {
                @@:(5)
            }
        }
}

fn main() {
    println!("TAP version 14");
    println!("1..1");
    let mut m = @@ValueReturn();
    let v = m.f();
    if v == 5 {
        println!("ok 1 - foundation_value_return return slot");
    } else {
        println!("not ok 1 - foundation_value_return return slot # v={}", v);
    }
}
