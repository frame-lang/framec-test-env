@@[target("cpp_23")]

// C3 — async_distinct_instances_parallel

#include <iostream>
#include <string>

@@[async]
@@system WorkerSys {
    interface:
        async work(label: std::string): std::string

    machine:
        $S {
            work(label: std::string): std::string { @@:(label) }
        }
}

int main() {
    auto sa = @@WorkerSys();
    auto sb = @@WorkerSys();
    sa.init().get();
    sb.init().get();

    auto ra = sa.work("from_a").get();
    auto rb = sb.work("from_b").get();
    if (ra != "from_a") { std::cout << "FAIL sa: " << ra << std::endl; return 1; }
    if (rb != "from_b") { std::cout << "FAIL sb: " << rb << std::endl; return 1; }

    std::cout << "PASS: async_distinct_instances_parallel" << std::endl;
    return 0;
}
