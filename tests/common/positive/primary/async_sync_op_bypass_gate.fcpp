@@[target("cpp_23")]

// C4 — async_sync_op_bypass_gate

#include <iostream>
#include <string>

@@[async]
@@system Holder {
    operations:
        get_count: int {
            @@:(this->count)
        }

    interface:
        async slow_work(): std::string

    machine:
        $S {
            slow_work(): std::string {
                this->count = this->count + 1;
                @@:(std::string("done"))
            }
        }

    domain:
        count: int = 0
}

int main() {
    auto s = @@Holder();
    s.init().get();

    if (s.get_count() != 0) { std::cout << "FAIL initial" << std::endl; return 1; }

    auto r = s.slow_work().get();
    if (r != "done") { std::cout << "FAIL dispatch: " << r << std::endl; return 1; }
    if (s.get_count() != 1) { std::cout << "FAIL after: " << s.get_count() << std::endl; return 1; }

    int n2 = s.get_count();
    int n3 = s.get_count();
    if (n2 != 1 || n3 != 1) { std::cout << "FAIL sequential" << std::endl; return 1; }

    std::cout << "PASS: async_sync_op_bypass_gate" << std::endl;
    return 0;
}
