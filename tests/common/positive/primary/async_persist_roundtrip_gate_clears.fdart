@@[target("dart")]

import 'dart:convert';

// C5 — async_persist_roundtrip_gate_clears

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@[async]
@@system Counter {
    interface:
        async bump(): int

    machine:
        $S {
            bump(): int {
                await Future.delayed(Duration.zero);
                this.value = this.value + 1;
                @@:(this.value)
            }
        }

    domain:
        value: int = 0
}

Future<void> main() async {
    final s1 = @@Counter();
    await s1.init();

    final v1 = await s1.bump();
    if (v1 != 1) throw Exception("s1: $v1");

    final snap = s1.save_state();
    final s2 = @@Counter();
    s2.restore_state(snap);

    final v2 = await s2.bump();
    if (v2 != 2) throw Exception("s2: $v2");

    final v3 = await s2.bump();
    if (v3 != 3) throw Exception("s2 second: $v3");

    print("PASS: async_persist_roundtrip_gate_clears");
}
