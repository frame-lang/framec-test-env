@@[target("cpp")]

#include <iostream>
#include <nlohmann/json.hpp>

@@[persist(std::string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Counter {
    interface:
        bump()
        value(): int

    machine:
        $Active {
            bump() { this->n = this->n + 1; }
            value(): int { @@:(this->n) return; }
        }

    domain:
        n: int = 0
}@@[persist(std::string)]
@@[save(save_state)]
@@[load(restore_state)]


@@[main]
@@system Container {
    interface:
        tick()
        get_n(): int

    machine:
        $Active {
            tick() {
                this->n = this->n + 10;
                this->counter->bump();
            }
            get_n(): int { @@:(this->n) return; }
        }

    domain:
        n: int = 0
        counter: Counter = @@Counter()
}

int main() {
    auto c1 = @@Container();
    c1.tick();
    c1.tick();
    if (c1.get_n() != 20) { std::cout << "FAIL pre n: " << c1.get_n() << std::endl; return 1; }

    std::string snap = c1.save_state();
    auto c2 = @@Container();

    c2.restore_state(snap);
    if (c2.get_n() != 20) { std::cout << "FAIL post n: " << c2.get_n() << std::endl; return 1; }

    std::cout << "PASS: 82_persist_multi_system" << std::endl;
    return 0;
}
