@@[target("dart")]

// C6 — async_composition_parent_child

@@[async]
@@system Child {
    interface:
        async work(): String

    machine:
        $S {
            work(): String { @@:("from_child") }
        }
}

@@[async]
@@[main]
@@system Parent {
    interface:
        async chain(): String
        async direct(): String

    machine:
        $S {
            chain(): String {
                final r = await this.child.work();
                @@:("parent_saw:" + r)
            }
            direct(): String { @@:("parent_direct") }
        }

    domain:
        child: Child = @@Child()
}

Future<void> main() async {
    final p = @@Parent();
    await p.init();

    final r1 = await p.direct();
    if (r1 != "parent_direct") throw Exception("direct: $r1");

    final r2 = await p.chain();
    if (r2 != "parent_saw:from_child") throw Exception("chain: $r2");

    print("PASS: async_composition_parent_child");
}
