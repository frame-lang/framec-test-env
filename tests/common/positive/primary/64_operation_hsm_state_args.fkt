@@[target("kotlin")]

@@system OpHsmStateArgs {
    operations:
        add_offset(x: Int, off: Int): Int {
            return x + off
        }

    interface:
        enter_active(t: Int)
        classify(v: Int): Int

    machine:
        $Idle {
            enter_active(t: Int) {
                -> $Active(t)
            }
            classify(v: Int): Int {
                @@:(-1)
            }
        }

        $Active => $Frame(threshold: Int) {
            enter_active(t: Int) {
                -> $Active(t)
            }
            classify(v: Int): Int {
                val r = this.add_offset(v, threshold)
                @@:(r)
            }
        }

        $Frame {
        }
    domain:
        n : Int = 0
}

fun main() {
    println("=== Test 64: Operations × HSM × state-args (Kotlin) ===")
    val s = @@OpHsmStateArgs()

    val pre = s.classify(5)
    if (pre != -1) { println("FAIL: pre $pre"); kotlin.system.exitProcess(1) }
    println("1. Idle classify(5) = $pre")

    s.enter_active(10)
    val r = s.classify(5)
    if (r != 15) { println("FAIL: r $r"); kotlin.system.exitProcess(1) }
    println("2. classify(5) with threshold=10 → $r")

    val r2 = s.classify(7)
    if (r2 != 17) { println("FAIL: r2 $r2"); kotlin.system.exitProcess(1) }
    println("3. classify(7) with threshold=10 → $r2")

    s.enter_active(100)
    val r3 = s.classify(5)
    if (r3 != 105) { println("FAIL: r3 $r3"); kotlin.system.exitProcess(1) }
    println("4. classify(5) with threshold=100 → $r3")

    println("PASS: 64_operation_hsm_state_args")
}
