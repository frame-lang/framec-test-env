@@[target("kotlin")]

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Counter {
    interface:
        bump()
        value(): Int

    machine:
        $Active {
            bump() { this.n = this.n + 1 }
            value(): Int { @@:(this.n) }
        }

    domain:
        n: Int = 0
}@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]


@@[main]
@@system Container {
    interface:
        tick()
        get_n(): Int

    machine:
        $Active {
            tick() {
                this.n = this.n + 10
                this.counter.bump()
            }
            get_n(): Int { @@:(this.n) }
        }

    domain:
        n: Int = 0
        counter: Counter = @@Counter()
}

fun main() {
    val c1 = @@Container()
    c1.tick()
    c1.tick()
    check(c1.get_n() == 20) { "FAIL pre n: ${c1.get_n()}" }

    val snap = c1.save_state()
    val c2 = @@Container()

    c2.restore_state(snap)
    check(c2.get_n() == 20) { "FAIL post n: ${c2.get_n()}" }

    println("PASS: 82_persist_multi_system")
}
