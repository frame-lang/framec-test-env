@@[target("erlang")]
@@[persist]
@@[save(save_state)]
@@[load(load_state)]
@@system DomainListDict {
    interface:
        push(v: int)
        sizeL(): int
        getAt(i: int): int
        put(k: string, v: int)
        sizeD(): int
        getV(k: string): int
    machine:
        $Active {
            push(v: int)        { self.items = self.items ++ [V] }
            sizeL(): int        { @@:(length(self.items)) }
            getAt(i: int): int  { @@:(case (I >= 0) andalso (I < length(self.items)) of true -> lists:nth(I + 1, self.items); false -> -1 end) }
            put(k: string, v: int)  { self.scores = maps:put(K, V, self.scores) }
            sizeD(): int        { @@:(maps:size(self.scores)) }
            getV(k: string): int    { @@:(maps:get(K, self.scores, -1)) }
        }
    domain:
        items = []
        scores = #{}
}
