@@[target("gdscript")]

# GDScript-unique — async_gd_optional_typing
#
# RFC-0043 (GDScript): GDScript supports optional static typing.
# Casing methods should be callable both with and without explicit
# type annotations on the caller side.

extends SceneTree

@@[async]
@@system Sys {
    interface:
        async work(label: String): String
        async count(): int

    machine:
        $S {
            work(label: String): String { @@:("done:" + label) }
            count(): int { @@:(42) }
        }
}

func _init():
    var s = @@Sys()
    await s.init()

    # Typed receiver.
    var r1: String = await s.work("A")
    assert(r1 == "done:A", "typed: " + str(r1))

    # Untyped receiver.
    var r2 = await s.work("B")
    assert(r2 == "done:B", "untyped: " + str(r2))

    # int return.
    var r3: int = await s.count()
    assert(r3 == 42, "count: " + str(r3))

    print("PASS: async_gd_optional_typing")
    quit()
