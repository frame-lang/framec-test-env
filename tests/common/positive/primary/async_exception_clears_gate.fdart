@@[target("dart")]

// C1 — async_exception_clears_gate
//
// RFC-0043 (Dart): handler throws during await → casing's try/finally
// MUST clear busy/in_flight → next interface call succeeds (no
// StateError for E703 from a stuck gate).

@@[async]
@@system Crashable {
    interface:
        async boom(): String
        async peek(): String

    machine:
        $S {
            boom(): String {
                throw Exception("handler crash");
            }
            peek(): String {
                @@:("ok")
            }
        }
}

Future<void> main() async {
    final s = @@Crashable();
    await s.init();

    // First call: handler throws. Casing's try/finally MUST clear gate.
    Exception? caught;
    try {
        await s.boom();
    } on Exception catch (e) {
        caught = e;
    }
    if (caught == null) throw Exception("expected boom() to throw");
    if (!caught.toString().contains("handler crash")) {
        throw Exception("unexpected: ${caught.toString()}");
    }

    // Second call: gate must be clear. Stuck gate would throw StateError.
    final result = await s.peek();
    if (result != "ok") throw Exception("expected 'ok', got '$result'");

    print("PASS: async_exception_clears_gate");
}
