@@[target("dart")]

// C3 — async_distinct_instances_parallel

@@[async]
@@system WorkerSys {
    interface:
        async work(label: String): String

    machine:
        $S {
            work(label: String): String {
                await Future.delayed(Duration(milliseconds: 50));
                @@:(label)
            }
        }
}

Future<void> main() async {
    final sa = @@WorkerSys();
    final sb = @@WorkerSys();
    await sa.init();
    await sb.init();

    final results = await Future.wait([sa.work("from_a"), sb.work("from_b")]);
    if (results.length != 2) throw Exception("expected 2");
    if (!(results.contains("from_a") && results.contains("from_b"))) {
        throw Exception("unexpected: $results");
    }

    print("PASS: async_distinct_instances_parallel");
}
