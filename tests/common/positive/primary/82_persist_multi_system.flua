@@[target("lua")]

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Counter {
    interface:
        bump()
        value(): int

    machine:
        $Active {
            bump() { self.n = self.n + 1 }
            value(): int { @@:(self.n) return }
        }

    domain:
        n: int = 0
}@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]


@@[main]
@@system Container {
    interface:
        tick()
        get_n(): int

    machine:
        $Active {
            tick() {
                self.n = self.n + 10
                self.counter:bump()
            }
            get_n(): int { @@:(self.n) return }
        }

    domain:
        n: int = 0
        counter = @@Counter()
}

local c1 = @@Container()
c1:tick()
c1:tick()
if c1:get_n() ~= 20 then
    print("FAIL pre n: " .. tostring(c1:get_n()))
    os.exit(1)
end

local snap = c1:save_state()
local c2 = @@Container()

c2:restore_state(snap)
if c2:get_n() ~= 20 then
    print("FAIL post n: " .. tostring(c2:get_n()))
    os.exit(1)
end

print("PASS: 82_persist_multi_system")
