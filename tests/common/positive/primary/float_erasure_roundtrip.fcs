@@[target("csharp")]

// Runtime regression for framec#77 — float values through the object
// erasure layer (state_vars dict + _return slot). Bare literals box as
// double; declared-type (float) unboxing is exact-match and throws
// InvalidCastException at runtime while compiling cleanly.

using System;

@@[main]
@@system Roundtrip {
    interface:
        bump()
        peek(): float
        radius(): float
        early(): float
    machine:
        $S {
            $.cool: float = 0.0

            bump() { $.cool = $.cool + 1.5 }
            peek(): float { @@:($.cool) }
            radius(): float { @@:(32.0) }
            early(): float { @@:return(18.0) }
        }
}

class Program {
    static void Main() {
        var p = @@Roundtrip();
        p.bump();
        p.bump();
        float got = p.peek();
        if (got != 3.0f) { Console.WriteLine("FAIL peek: " + got); Environment.Exit(1); }
        float rad = p.radius();
        if (rad != 32.0f) { Console.WriteLine("FAIL radius: " + rad); Environment.Exit(1); }
        float er = p.early();
        if (er != 18.0f) { Console.WriteLine("FAIL early: " + er); Environment.Exit(1); }
        Console.WriteLine("PASS: float_erasure_roundtrip");
    }
}
