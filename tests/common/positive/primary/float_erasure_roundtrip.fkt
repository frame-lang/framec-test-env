@@[target("kotlin")]

// Runtime regression for framec#77 — Float values through the Any erasure
// layer. Bare literals are Double; the declared-type  cast throws
// ClassCastException at runtime while compiling cleanly.

@@[main]
@@system Roundtrip {
    interface:
        bump()
        peek(): Float
        radius(): Float
    machine:
        $S {
            $.cool: Float = 0.0

            bump() { $.cool = $.cool + 1.5 }
            peek(): Float { @@:($.cool) }
            radius(): Float { @@:(32.0) }
        }
}

fun main() {
    val p = @@Roundtrip()
    p.bump()
    p.bump()
    val got = p.peek()
    if (got != 3.0f) { println("FAIL peek: " + got); kotlin.system.exitProcess(1) }
    val rad = p.radius()
    if (rad != 32.0f) { println("FAIL radius: " + rad); kotlin.system.exitProcess(1) }
    println("PASS: float_erasure_roundtrip")
}
