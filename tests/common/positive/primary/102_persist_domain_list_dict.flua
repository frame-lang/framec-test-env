@@[target("lua")]

-- Test 102: list + dict as PERSISTED domain fields (Lua).
-- Exercises the type-ignorant domain-field path through the native
-- serializer: a list table and a keyed table must round-trip through
-- save_state / restore_state preserving order and key-value pairs.
-- (Lua tables are 1-based; get_at(i) takes a 0-based index.)

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system DomainListDict {
    interface:
        push(v: int)
        size_l(): int
        get_at(i: int): int
        put(k: String, v: int)
        size_d(): int
        get_v(k: String): int

    machine:
        $Active {
            push(v: int)         { table.insert(self.items, v) }
            size_l(): int        { @@:(#self.items) }
            get_at(i: int): int  { @@:(self.items[i + 1] or -1) }
            put(k: String, v: int)  { self.scores[k] = v }
            size_d(): int        { local __c = 0; for _ in pairs(self.scores) do __c = __c + 1 end; @@:(__c) }
            get_v(k: String): int   { @@:(self.scores[k] or -1) }
        }

    domain:
        items: table = {}
        scores: table = {}
}

local s1 = @@DomainListDict()
s1:push(10)
s1:push(20)
s1:push(30)
s1:put("a", 1)
s1:put("b", 2)
s1:put("c", 3)

if s1:size_l() ~= 3 then print("FAIL pre size_l=" .. s1:size_l()); os.exit(1) end
if s1:get_at(0) ~= 10 then print("FAIL pre get_at0"); os.exit(1) end
if s1:size_d() ~= 3 then print("FAIL pre size_d"); os.exit(1) end
if s1:get_v("b") ~= 2 then print("FAIL pre b"); os.exit(1) end

local snap = s1:save_state()

local s2 = @@DomainListDict()
s2:restore_state(snap)

if s2:size_l() ~= 3 then print("FAIL post size_l=" .. s2:size_l()); os.exit(1) end
if s2:get_at(0) ~= 10 then print("FAIL post items[0]=" .. s2:get_at(0)); os.exit(1) end
if s2:get_at(1) ~= 20 then print("FAIL post items[1]=" .. s2:get_at(1)); os.exit(1) end
if s2:get_at(2) ~= 30 then print("FAIL post items[2]=" .. s2:get_at(2)); os.exit(1) end
if s2:size_d() ~= 3 then print("FAIL post size_d=" .. s2:size_d()); os.exit(1) end
if s2:get_v("a") ~= 1 then print("FAIL post a"); os.exit(1) end
if s2:get_v("b") ~= 2 then print("FAIL post b"); os.exit(1) end
if s2:get_v("c") ~= 3 then print("FAIL post c"); os.exit(1) end

print("PASS: 102_persist_domain_list_dict")
