@@[target("php")]

// Test 102: list + dict as PERSISTED domain fields (PHP).
// Exercises the type-ignorant domain-field path through the native
// JSON serializer: a list array and an associative array must
// round-trip through save_state / restore_state preserving order and
// key-value pairs.

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system DomainListDict {
    interface:
        push(v: int)
        size_l(): int
        get_at(i: int): int
        put(k: string, v: int)
        size_d(): int
        get_v(k: string): int

    machine:
        $Active {
            push(v: int)         { $this->items[] = $v; }
            size_l(): int        { @@:(count($this->items)) }
            get_at(i: int): int  { @@:(($i >= 0 && $i < count($this->items)) ? $this->items[$i] : -1) }
            put(k: string, v: int)  { $this->scores[$k] = $v; }
            size_d(): int        { @@:(count($this->scores)) }
            get_v(k: string): int   { @@:(array_key_exists($k, $this->scores) ? $this->scores[$k] : -1) }
        }

    domain:
        items = []
        scores = []
}

$s1 = @@DomainListDict();
$s1->push(10);
$s1->push(20);
$s1->push(30);
$s1->put("a", 1);
$s1->put("b", 2);
$s1->put("c", 3);

if ($s1->size_l() !== 3) { echo "FAIL pre size_l=" . $s1->size_l() . "\n"; exit(1); }
if ($s1->get_at(0) !== 10) { echo "FAIL pre get_at0\n"; exit(1); }
if ($s1->size_d() !== 3) { echo "FAIL pre size_d\n"; exit(1); }
if ($s1->get_v("b") !== 2) { echo "FAIL pre b\n"; exit(1); }

$snap = $s1->save_state();

$s2 = @@DomainListDict();
$s2->restore_state($snap);

if ($s2->size_l() !== 3) { echo "FAIL post size_l=" . $s2->size_l() . "\n"; exit(1); }
if ($s2->get_at(0) !== 10) { echo "FAIL post items[0]=" . $s2->get_at(0) . "\n"; exit(1); }
if ($s2->get_at(1) !== 20) { echo "FAIL post items[1]=" . $s2->get_at(1) . "\n"; exit(1); }
if ($s2->get_at(2) !== 30) { echo "FAIL post items[2]=" . $s2->get_at(2) . "\n"; exit(1); }
if ($s2->size_d() !== 3) { echo "FAIL post size_d=" . $s2->size_d() . "\n"; exit(1); }
if ($s2->get_v("a") !== 1) { echo "FAIL post a\n"; exit(1); }
if ($s2->get_v("b") !== 2) { echo "FAIL post b\n"; exit(1); }
if ($s2->get_v("c") !== 3) { echo "FAIL post c\n"; exit(1); }

echo "PASS: 102_persist_domain_list_dict\n";
