@@[target("php")]

@@system InterpStress {
    interface:
        test_interp(): string
        test_return(): int
        test_multi(): string

    machine:
        $Active {
            $.count: int = 42
            $.label: str = "hello"

            test_interp(): string {
                @@:("count is {$.count}")
                return;
            }

            test_return(): int {
                @@:($.count)
                return;
            }

            test_multi(): string {
                @@:("{$.count} and {$.label}")
                return;
            }
        }
}

$s = @@InterpStress();
$failures = 0;

if ($s->test_interp() !== "count is 42") { echo "FAIL interp: got '" . $s->test_interp() . "'\n"; $failures++; }
if ($s->test_return() !== 42) { echo "FAIL return\n"; $failures++; }
if ($s->test_multi() !== "42 and hello") { echo "FAIL multi: got '" . $s->test_multi() . "'\n"; $failures++; }

if ($failures > 0) {
    echo "FAIL: $failures failures\n";
    exit(1);
}
echo "PASS: stress_interp (3 cases)\n";
