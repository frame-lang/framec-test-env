@@[target("swift")]


@@system StrStateArg {
    interface:
        configure(label: String)
        identify(): String

    machine:
        $Idle {
            configure(label: String) {
                -> $Active(label)
            }
            identify(): String {
                @@:("anonymous")
            }
        }

        $Active => $Frame(label: String) {
            configure(label: String) {
                -> $Active(label)
            }
            identify(): String {
                => $^
            }
        }

        $Frame {
            identify(): String {
                @@:(label)
            }
        }
    domain:
        n : Int = 0
}

let s = @@StrStateArg()
if s.identify() != "anonymous" { print("FAIL idle"); exit(1) }
s.configure("alice")
if s.identify() != "alice" { print("FAIL alice"); exit(1) }
s.configure("bob")
if s.identify() != "bob" { print("FAIL bob"); exit(1) }
print("PASS: 66_hsm_str_state_args")
