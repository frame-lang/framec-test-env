@@[target("java")]

// Runtime regression for framec#77 — float values through the Object
// erasure layer. Bare literals box as Double; the declared-type (float)
// cast unboxes via Float and throws ClassCastException at runtime while
// compiling cleanly.

@@[main]
@@system Roundtrip {
    interface:
        bump()
        peek(): float
        radius(): float
    machine:
        $S {
            $.cool: float = 0.0

            bump() { $.cool = $.cool + 1.5 }
            peek(): float { @@:($.cool) }
            radius(): float { @@:(32.0) }
        }
}

class Main {
    public static void main(String[] args) {
        var p = @@Roundtrip();
        p.bump();
        p.bump();
        float got = p.peek();
        if (got != 3.0f) { System.out.println("FAIL peek: " + got); System.exit(1); }
        float rad = p.radius();
        if (rad != 32.0f) { System.out.println("FAIL radius: " + rad); System.exit(1); }
        System.out.println("PASS: float_erasure_roundtrip");
    }
}
