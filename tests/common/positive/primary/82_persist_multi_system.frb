@@[target("ruby")]

require 'json'

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Counter {
    interface:
        bump()
        value(): int

    machine:
        $Active {
            bump() { self.n = self.n + 1 }
            value(): int { @@:(self.n) return }
        }

    domain:
        n: int = 0
}@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]


@@[main]
@@system Container {
    interface:
        tick()
        get_n(): int

    machine:
        $Active {
            tick() {
                self.n = self.n + 10
                self.counter.bump
            }
            get_n(): int { @@:(self.n) return }
        }

    domain:
        n: int = 0
        counter = @@Counter()
}

c1 = @@Container()
c1.tick
c1.tick
abort("FAIL pre n: #{c1.get_n}") unless c1.get_n == 20

snap = c1.save_state
c2 = @@Container()

c2.restore_state(snap)
abort("FAIL post n: #{c2.get_n}") unless c2.get_n == 20

puts "PASS: 82_persist_multi_system"
