@@[target("csharp")]

// C5 — async_persist_roundtrip_gate_clears

using System;
using System.Threading.Tasks;

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@[async]
@@system Counter {
    interface:
        async bump(): int

    machine:
        $S {
            bump(): int {
                this.value = this.value + 1;
                await Task.Yield();
                @@:(this.value)
            }
        }

    domain:
        value: int = 0
}

class Program {
    public static async Task Main(string[] args) {
        var s1 = @@Counter();
        await s1.init();

        var v1 = await s1.bump();
        if (v1 != 1) throw new Exception($"s1: {v1}");

        var snap = s1.save_state();
        var s2 = @@Counter();
        s2.restore_state(snap);

        var v2 = await s2.bump();
        if (v2 != 2) throw new Exception($"s2: {v2}");

        var v3 = await s2.bump();
        if (v3 != 3) throw new Exception($"s2 second: {v3}");

        Console.WriteLine("PASS: async_persist_roundtrip_gate_clears");
    }
}
