@@[target("swift")]

// Test: const domain field initialized from system param.

@@system Sensor(threshold: Int = 100) {
    interface:
        read(): Int
        calibrate(offset: Int)
        get_threshold(): Int

    machine:
        $Active {
            read(): Int {
                @@:(self.value + self.offset)
                return;
            }
            calibrate(offset: Int) {
                self.offset = offset
            }
            get_threshold(): Int {
                @@:(self.threshold)
                return;
            }
        }

    domain:
        const threshold : Int = threshold
        value : Int = 50
        offset : Int = 0
}

var failures = 0

// Test 1: system param override
let s = @@Sensor(200)
var t = s.get_threshold()
if t != 200 { print("FAIL test 1: expected 200, got \(t)"); failures += 1 }

// Test 2: read returns value + offset
var v = s.read()
if v != 50 { print("FAIL test 2: expected 50, got \(v)"); failures += 1 }

// Test 3: calibrate changes offset
s.calibrate(10)
v = s.read()
if v != 60 { print("FAIL test 3: expected 60, got \(v)"); failures += 1 }

// Test 4: default system param
let s2 = @@Sensor()
var t2 = s2.get_threshold()
if t2 != 100 { print("FAIL test 4: expected 100, got \(t2)"); failures += 1 }

if failures > 0 {
    print("FAIL: const_domain (\(failures) failures)")
    exit(1)
}
print("PASS: const_domain")
