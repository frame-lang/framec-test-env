@@[target("swift")]

// C4 — async_sync_op_bypass_gate
//
// Operations bypass the gate. Sync ops on Swift's casing are emitted
// without `async throws` — call directly.

import Foundation
setvbuf(stdout, nil, _IOLBF, 0)

// Deterministic handshake (was a flaky race, mis-filed as test-env #11): the
// driver must observe `count` AFTER `slow_work` has incremented it and while
// it is suspended at the sleep. `Task.yield()` alone does NOT guarantee the
// child task reached its increment, so `get_count()` intermittently read 0
// ("Fatal error: during: 0"), and framec's Swift `defer` cleanup change
// perturbed timing enough to lose that race ~1-in-60. `slow_work` now signals
// `__started` right after the increment; the driver polls it non-blocking with
// `Task.yield()` (no cooperative-thread blocking, no continuation-set race) so
// the "during" read is ordered after the increment, every time.
let __started = DispatchSemaphore(value: 0)

@@[async]
@@system Holder {
    operations:
        get_count: Int {
            @@:(self.count)
        }

    interface:
        async slow_work(): String

    machine:
        $S {
            slow_work(): String {
                self.count = self.count + 1
                __started.signal()
                try? await Task.sleep(nanoseconds: 50_000_000)
                @@:("done")
            }
        }

    domain:
        count: Int = 0
}

let __sem = DispatchSemaphore(value: 0)
Task {
    do {
        let s = @@Holder()
        await s.initAsync()

        guard s.get_count() == 0 else { fatalError("initial: \(s.get_count())") }

        // Fire async; wait until slow_work has incremented (and is now
        // suspended at the sleep), then read the gate-bypassing sync op.
        async let p = s.slow_work()
        while __started.wait(timeout: .now()) == .timedOut { await Task.yield() }

        let n = s.get_count()
        guard n == 1 else { fatalError("during: \(n)") }

        let r = try await p
        guard r == "done" else { fatalError("final: \(r)") }

        print("PASS: async_sync_op_bypass_gate")
    } catch {
        fatalError("unexpected: \(error)")
    }
    __sem.signal()
}
__sem.wait()
