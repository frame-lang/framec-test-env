@@[target("csharp")]

// C3 — async_distinct_instances_parallel

using System;
using System.Threading.Tasks;

@@[async]
@@system WorkerSys {
    interface:
        async work(label: string): string

    machine:
        $S {
            work(label: string): string {
                await Task.Delay(50);
                @@:(label)
            }
        }
}

class Program {
    public static async Task Main(string[] args) {
        var sa = @@WorkerSys();
        var sb = @@WorkerSys();
        await sa.init();
        await sb.init();

        var results = await Task.WhenAll(sa.work("from_a"), sb.work("from_b"));
        if (results.Length != 2) throw new Exception("expected 2");
        var set = new System.Collections.Generic.HashSet<string>(results);
        if (!set.Contains("from_a") || !set.Contains("from_b")) {
            throw new Exception("unexpected: " + string.Join(",", results));
        }

        Console.WriteLine("PASS: async_distinct_instances_parallel");
    }
}
