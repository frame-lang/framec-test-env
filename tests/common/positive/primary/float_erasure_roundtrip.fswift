@@[target("swift")]

// Runtime regression for framec#77 — Float values through the Any erasure
// layer. Bare literals are Double; the declared-type `as! Float` cast
// traps at runtime while compiling cleanly.

@@[main]
@@system Roundtrip {
    interface:
        bump()
        peek(): Float
        radius(): Float
    machine:
        $S {
            $.cool: Float = 0.0

            bump() { $.cool = $.cool + 1.5 }
            peek(): Float { @@:($.cool) }
            radius(): Float { @@:(32.0) }
        }
}

var p = @@Roundtrip()
p.bump()
p.bump()
let got = p.peek()
if got != 3.0 { print("FAIL peek: \(got)"); exit(1) }
let rad = p.radius()
if rad != 32.0 { print("FAIL radius: \(rad)"); exit(1) }
print("PASS: float_erasure_roundtrip")
