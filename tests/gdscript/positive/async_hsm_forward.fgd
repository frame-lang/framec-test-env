@@[target("gdscript")]

# Async HSM parent forward (port of tests/python/positive/async_hsm_forward.fpy).
# Validates: => $^ default-forward dispatch is awaited in async mode.
# GDScript async is await-based; the async casing wraps each interface call so
# the driver awaits `process(...)` / `other(...)`. The mock transform is a
# native GDScript coroutine (awaited inside the handler body).

extends SceneTree

# Native GDScript helper. Handler bodies run inside the generated machine
# class, where a file-scope func is not reachable via self; a sibling inner
# class IS resolvable by name (same pattern as persist_fidelity_value_type.fgd).
class Xf:
    static func mock_transform(data: String) -> String:
        return data.to_upper()

@@[async]
@@system AsyncHsm {
    interface:
        async process(data: String): String
        async other(data: String): String

    machine:
        $Child => $Parent {
            process(data: String): String {
                var result = await Xf.mock_transform(data)
                @@:("child:" + result)
            }

            # Unhandled events forward to parent via default forward.
            => $^
        }

        $Parent {
            process(data: String): String {
                var result = await Xf.mock_transform(data)
                @@:("parent:" + result)
            }

            other(data: String): String {
                var result = await Xf.mock_transform(data)
                @@:("parent_other:" + result)
            }
        }
}

func _init():
    var s = @@AsyncHsm()
    await s.init()

    # Child handles process directly.
    var r1 = await s.process("hello")
    if r1 != "child:HELLO":
        print("FAIL: expected 'child:HELLO', got '", r1, "'")
        quit(1)
        return

    # Child doesn't handle 'other' — default forward to parent.
    var r2 = await s.other("test")
    if r2 != "parent_other:TEST":
        print("FAIL: expected 'parent_other:TEST', got '", r2, "'")
        quit(1)
        return

    print("PASS: async HSM forward — default forward dispatches to parent")
    quit()
