@@[target("gdscript")]

extends SceneTree

# RFC-0053 compartment fidelity (GDScript): a user-typed value held in a STATE
# VARIABLE ($.sv -> compartment.state_vars) must round-trip faithfully, not just
# a domain field. The reflective encode/revive passes run tree-wide over the
# whole snapshot, so a value nested in the serialized compartment chain is
# reconstructed (via the closed-world registry) while the compartment
# scaffolding passes through untagged.

class Vec2:
    var x: float = 0.0
    var y: float = 0.0

    func _init(px: float = 0.0, py: float = 0.0):
        x = px
        y = py

    func magSq() -> float:
        return x * x + y * y

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Bag {
    interface:
        setv(x: float, y: float)
        getmag(): float

    machine:
        $S {
            $.sv = Vec2.new(0, 0)

            setv(x: float, y: float) {
                $.sv = Vec2.new(x, y)
            }
            getmag(): float { @@:($.sv.magSq()) }
    }

    domain:
        marker: float = 1
}

func _init():
    var b = @@Bag()
    b.register_persist_type("Vec2", Vec2)
    b.setv(3, 4)

    var snap = b.save_state()
    var b2 = @@Bag()
    b2.register_persist_type("Vec2", Vec2)
    b2.restore_state(snap)

    if b2.getmag() == 25:
        print("PASS: persist_fidelity_state_var")
        quit()
    else:
        print("FAIL: getmag=", b2.getmag())
        quit(1)
